    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ChatInfo.UncensorChatLine)
    function UncensorChatLine(chatLine: number)
end

declare namespace C_ChromieTime
