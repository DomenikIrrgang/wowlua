declare namespace C_CVar
    --- Whether the console variables (CVars) have been loaded.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.AreCVarsLoaded)
    function AreCVarsLoaded(): boolean
    --- Returns the current value of a console variable.
    ---
    --- **Parameters**
    --- - `name`: CVar - name of the CVar to query the value of.
    ---
    --- **Returns**
    --- - `value`: current value of the CVar.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.GetCVar)
    function GetCVar(name: string): string?
    --- Returns the bitfield of a console variable.
    ---
    --- **Parameters**
    --- - `name`: CVar - name of the CVar.
    --- - `index`: Bitfield index.
    ---
    --- **Returns**
    --- - `value`: Value of the bitfield.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.GetCVarBitfield)
    function GetCVarBitfield(name: string, index: number): boolean?
    --- Returns the boolean value of a console variable.
    ---
    --- **Parameters**
    --- - `name`: Name of the CVar to query the value of.
    ---
    --- **Returns**
    --- - `value`: Compared to `GetCVar`, "1" would return as true, "0" would return as false
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.GetCVarBool)
    function GetCVarBool(name: string): boolean?
    --- Returns the default value of a console variable.
    ---
    --- =
    ---
    --- **Parameters**
    --- - `name`: Name of the console variable to query.
    ---
    --- **Returns**
    --- - `defaultValue`: Default value of the console variable.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.GetCVarDefault)
    function GetCVarDefault(name: string): string?
    --- Returns information on a console variable.
    ---
    --- **Parameters**
    --- - `name`: Name of the CVar to query the value of. Only accepts console variables (i.e. not console commands).
    ---
    --- **Returns**
    --- - `value`: Current value of the CVar.
    --- - `defaultValue`: Default value of the CVar.
    --- - `isStoredServerAccount`: If the CVar scope is set WoW account-wide. Stored on the server per CVar `synchronizeConfig`
    --- - `isStoredServerCharacter`: If the CVar scope is character-specific. Stored on the server per CVar `synchronizeConfig`
    --- - `isSecure`: If the CVar cannot be set with `SetCVar` while in combat, which would fire `ADDON_ACTION_BLOCKED`. It's also not possible to set these via `/console`. Most nameplate cvars are secure.
    --- - `isReadOnly`: Returns true for `portal`, `serverAlert`, `timingTestError`. These CVars cannot be changed.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.GetCVarInfo)
    function GetCVarInfo(name: string): (string, string, boolean, boolean, boolean, boolean, boolean)
    --- Temporarily registers a custom console variable.
    ---
    --- **Parameters**
    --- - `name`: Name of the custom CVar to set.
    --- - `value`: Initial value of the CVar.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.RegisterCVar)
    function RegisterCVar(name: string, value: string?)
    --- Resets the `ActionCam` cvars.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.ResetTestCVars)
    function ResetTestCVars()
    --- Sets a console variable.
    ---
    --- **Parameters**
    --- - `name`: CVar - Name of the CVar.
    --- - `value`: The new value of the CVar.
    ---
    --- **Returns**
    --- - `success`: Whether the CVar was successfully set. Returns `nil` if attempting to set a secure cvar in combat.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.SetCVar)
    function SetCVar(name: string, value: string?): boolean
    --- Sets the bitfield of a console variable.
    ---
    --- **Parameters**
    --- - `name`: Name of the CVar to set the bitfield of.
    --- - `index`: Bitfield index.
    --- - `value`: The new value of the bitfield.
    ---
    --- **Returns**
    --- - `success`: Whether the CVar was successfully set.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_CVar.SetCVarBitfield)
    function SetCVarBitfield(name: string, index: number, value: boolean): boolean
end

