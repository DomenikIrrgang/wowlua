declare namespace C_SpellBook
    --- Casts the spell in a spellbook slot.
    ---
    --- **Parameters**
    --- - `targetSelf`: If true, spell will target the current player; Otherwise, targets the player's current target
    --- - `spellBookItemSlotIndex`: The slot's index in the spellbook.
    --- - `spellBookItemSpellBank`: Which spellbook: the player's or the pet's.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.CastSpellBookItem)
    function CastSpellBookItem(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank, targetSelf: boolean?)
    --- Returns true if player knows any Disenchant spells.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.ContainsAnyDisenchantSpell)
    function ContainsAnyDisenchantSpell(): boolean
    --- Returns the ID of the base spell of the given spell, or nil when the spell is unknown.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.FindBaseSpellByID)
    function FindBaseSpellByID(spellID: number): number?
    --- Returns the spellbook slot of the flyout that holds the given spell.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.FindFlyoutSlotBySpellID)
    function FindFlyoutSlotBySpellID(spellID: number): number
    --- If found, returns the first slot position of a SpellBookItem matching the specified spell and criteria
    ---
    --- **Parameters**
    --- - `includeHidden`: If true, search includes SpellBookItems that are hidden from the SpellBook UI (ex: spells that have been replaced, are also in a Flyout, etc)
    --- - `includeFlyouts`: If true, search includes Flyout SpellBookItems containing the specified spell
    --- - `includeFutureSpells`: If true, search includes SpellBookItems for spells that have not yet been learned
    --- - `includeOffSpec`: If true, search includes SpellBookItems belonging to non-active specializations; If spell is in active and inactive spec, the active spec slot will always be returned
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.FindSpellBookSlotForSpell)
    function FindSpellBookSlotForSpell(spellIdentifier: SpellIdentifier, includeHidden: boolean?, includeFlyouts: boolean?, includeFutureSpells: boolean?, includeOffSpec: boolean?): (number?, SpellBookSpellBank?)
    --- Returns the ID of the spell that currently overrides the given spell, or the spell's own ID when none does.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.FindSpellOverrideByID)
    function FindSpellOverrideByID(spellID: number): number?
    --- Returns general, class, and active spec spells that are learned at the specified level.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetCurrentLevelSpells)
    function GetCurrentLevelSpells(level: number): number[]?
    --- Returns the number of tabs in the spellbook.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetNumSpellBookSkillLines)
    function GetNumSpellBookSkillLines(): number
    --- Returns the spellbook index of the given skill line.
    ---
    --- **Returns**
    --- - `skillIndex`: Will be nil if the specified SkillLine could not be found, or if it is not one of the player's tracked skill lines
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSkillLineIndexByID)
    function GetSkillLineIndexByID(skillLineID: number): number?
    --- Returns nothing if item doesn't exist or isn't a spell
    ---
    --- **Returns**
    --- - `autoCastAllowed`: True if this spell is allowed to be auto-cast
    --- - `autoCastEnabled`: True if auto-casting this spell is currently enabled (usually by the player)
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemAutoCast)
    function GetSpellBookItemAutoCast(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): (boolean?, boolean?)
    --- Returns number of times a SpellBookItem can be cast, typically based on availability of things like required reagent items; Always returns 0 if item is not found or is not a spell
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemCastCount)
    function GetSpellBookItemCastCount(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): number | Secret<number>
    --- Returns a duration object describing the active recharge time for a spellbook item.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemChargeDuration)
    function GetSpellBookItemChargeDuration(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): LuaDurationObject?
    --- Returns a table of info about the charges of a charge-accumulating SpellBookItem; May return nil if item is not found or is not charge-based
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemCharges)
    function GetSpellBookItemCharges(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): SpellChargeInfoSecret?
    --- Returns the cooldown info of a spell.
    ---
    --- **Parameters**
    --- - `spellBookItemSlotIndex`: Spellbook slot index, ranging from 1 through the total number of spells across all tabs and pages
    ---
    --- **Returns**
    --- - `spellCooldownInfo`: Returns nil if item doesn't exist or if this kind of item doesn't display cooldowns (ex: future or offspec spells)
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemCooldown)
    function GetSpellBookItemCooldown(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): SpellCooldownInfoSecret?
    --- Returns a duration object describing the active cooldown duration for a spellbook item.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemCooldownDuration)
    function GetSpellBookItemCooldownDuration(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank, ignoreGCD: boolean?): LuaDurationObject?
    --- Returns the description of the spell in a spellbook slot.
    ---
    --- **Parameters**
    --- - `spellBookItemSlotIndex`: The slot's index in the spellbook.
    --- - `spellBookItemSpellBank`: Which spellbook: the player's or the pet's.
    ---
    --- **Returns**
    --- - `description`: May be empty if spell's data isn't loaded yet; Listen for SPELL_TEXT_UPDATE event, or use SpellMixin to load asynchronously
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemDescription)
    function GetSpellBookItemDescription(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): string?
    --- Returns info for a spellbook item.
    ---
    --- **Parameters**
    --- - `spellBookItemSlotIndex`: Spellbook slot index, ranging from 1 through the total number of spells across all tabs and pages
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemInfo)
    function GetSpellBookItemInfo(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): SpellBookItemInfo?
    --- Returns the level the spell is learned at; May return a different value if the player is currently Level Linked with another player; Returns 0 if item is not a Spell
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemLevelLearned)
    function GetSpellBookItemLevelLearned(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): number
    --- Returns a chat link for the spell in a spellbook slot.
    ---
    --- **Parameters**
    --- - `glyphID`: A glyph to include in the link.
    --- - `spellBookItemSlotIndex`: The slot's index in the spellbook.
    --- - `spellBookItemSpellBank`: Which spellbook: the player's or the pet's.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.GetSpellBookItemLink)
