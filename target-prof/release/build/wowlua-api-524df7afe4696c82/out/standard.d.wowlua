    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ChatInfo.RegisterAddonMessagePrefix)
    function RegisterAddonMessagePrefix(prefix: string): RegisterAddonMessagePrefixResult
