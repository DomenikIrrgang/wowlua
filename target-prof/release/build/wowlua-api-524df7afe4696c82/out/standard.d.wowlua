declare namespace C_AddOnProfiler
    --- Adds a measured event to any ongoing measured calls. If no such calls are currently taking place, this function does nothing.
    ---
    --- **Parameters**
    --- - `name`: User-defined string describing the measured event. This should be kept under 48 bytes to avoid memory allocations.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.AddMeasuredCallEvent)
    function AddMeasuredCallEvent(name: stringView)
    --- Internal API for telemetry.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.AddPerformanceMessageShown)
    function AddPerformanceMessageShown(msg: AddOnPerformanceMessage)
    --- Optimized check for determining if AddOns are severely impacting UI performance.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.CheckForPerformanceMessage)
    function CheckForPerformanceMessage(): AddOnPerformanceMessage?
    --- Returns an addon specific performance metric
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried. Blizzard addons cannot be queried.
    ---
    --- **Returns**
    --- - `result`: The value corresponding to the requested metric. Time values are measured in milliseconds.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.GetAddOnMetric)
    function GetAddOnMetric(name: string, metric: AddOnProfilerMetric): number
    --- Overall profiling data for the entire application (not just the UI)
    ---
    --- **Returns**
    --- - `result`: The value corresponding to the requested metric. Time values are measured in milliseconds.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.GetApplicationMetric)
    function GetApplicationMetric(metric: AddOnProfilerMetric): number
    --- Returns the specified performance metric, measured across all user-installed addons.
    ---
    --- **Returns**
    --- - `result`: The value corresponding to the requested metric. Time values are measured in milliseconds.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.GetOverallMetric)
    function GetOverallMetric(metric: AddOnProfilerMetric): number
    --- Returns the number of profiling clock ticks that occur within a single real-time second.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.GetTicksPerSecond)
    function GetTicksPerSecond(): number
    --- Get the top K addons for a given metric
    ---
    --- **Parameters**
    --- - `k`: number of results to return
    ---
    --- **Returns**
    --- - `results`: Returns the top K addons for a given metric.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.GetTopKAddOnsForMetric)
    function GetTopKAddOnsForMetric(metric: AddOnProfilerMetric, k: number): AddOnProfilerResult[]
    --- Returns whether profiling is enabled. Currently this is always true.
    ---
    --- **Returns**
    --- - `enabled`: True if profiling is enabled. Currently this is always true.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.IsEnabled)
    function IsEnabled(): boolean
    --- Performs a profiled measurement of a single function call with any supplied arguments.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOnProfiler.MeasureCall)
    function MeasureCall(func: LuaValueVariant, ...: LuaValueVariant): (AddOnProfilerCallResults, ...LuaValueVariant)
end

declare namespace C_AddOns
    --- Sets an addon to be disabled.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be disabled, or an index from 1 to `C_AddOns.GetNumAddOns`. Blizzard addons cannot be disabled.
    --- - `character`: The name or GUID of the character, excluding the realm name. If omitted, disables the addon for all characters.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.DisableAddOn)
    function DisableAddOn(name: uiAddon, character: string?)
    --- Sets all addons to be disabled.
    ---
    --- **Parameters**
    --- - `character`: The name or GUID of the character, excluding the realm name. If omitted, disables all addons for all characters.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.DisableAllAddOns)
    function DisableAllAddOns(character: string?)
    --- Whether the addon is installed.
    ---
    --- **Parameters**
    --- - `name`: The addon's name or index.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.DoesAddOnExist)
    function DoesAddOnExist(name: uiAddon): boolean
    --- Whether the addon failed to load.
    ---
    --- **Parameters**
    --- - `name`: The addon's name or index.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.DoesAddOnHaveLoadError)
    function DoesAddOnHaveLoadError(name: uiAddon): boolean
    --- Sets an addon to be enabled.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be enabled, or an index from 1 to `C_AddOns.GetNumAddOns`. Blizzard addons can only be enabled by name.
    --- - `character`: The name or GUID of the character, excluding the realm name. If omitted, enables the addon for all characters.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.EnableAddOn)
    function EnableAddOn(name: uiAddon, character: string?)
    --- Sets all addons to be enabled.
    ---
    --- **Parameters**
    --- - `character`: The name or GUID of the character, excluding the realm name. If omitted, enables all addons for all characters.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.EnableAllAddOns)
    function EnableAllAddOns(character: string?)
    --- Returns a list of TOC dependencies.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried, or an index from 1 to `C_AddOns.GetNumAddOns`. Blizzard addons can only be queried by name.
    ---
    --- **Returns**
    --- - `deps`: A list of addon names that are a dependency.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnDependencies)
    function GetAddOnDependencies(name: uiAddon): (...string)
    --- Queries the enabled state of an addon, optionally for a specific character.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried, or an index from 1 to `C_AddOns.GetNumAddOns`. The state of Blizzard addons can only be queried by name.
    --- - `character`: The name or GUID of the character to check against, or omitted/`nil` for all characters
    ---
    --- **Returns**
    --- - `state`: The enabled state of the addon.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnEnableState)
    function GetAddOnEnableState(name: uiAddon, character: string?): AddOnEnableState
    --- Returns information about an AddOn.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried, or an index from 1 to `C_AddOns.GetNumAddOns`. The state of Blizzard addons can only be queried by name.
    ---
    --- **Returns**
    --- - `name`: The name of the AddOn (the folder name).
    --- - `title`: The localized title of the AddOn as listed in the .toc file.
    --- - `notes`: The localized notes about the AddOn from its .toc file.
    --- - `loadable`: Indicates if the AddOn is loaded or eligible to be loaded on this or another character, true if it is, false if it is not.
    --- - `reason`: The reason why the AddOn cannot be loaded. This is nil if the addon is loadable, otherwise it contains a string token indicating the reason that can be localized by prepending "ADDON_".
    --- - `security`: Indicates the security status of the AddOn. This is currently "INSECURE" for all user provided addons, "SECURE_PROTECTED" for guarded Blizzard addons, and "SECURE" for all other Blizzard AddOns.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnInfo)
    function GetAddOnInfo(name: uiAddon): (string, string, string, boolean, string, string)
    --- Returns the value of the Interface directive in an addon TOC file.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnInterfaceVersion)
    function GetAddOnInterfaceVersion(name: uiAddon): number
    --- Returns the addon table (passed as the second argument of ... to files) for any addon that opts in through setting AllowAddOnTableAccess: 1 in the toc file. Insecure code cannot query addon tables from Blizzard addons.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnLocalTable)
    function GetAddOnLocalTable(name: uiAddon): LuaValueVariant
    --- Returns the TOC metadata of an addon.
    ---
    --- **Parameters**
    --- - `name`: The name or index of the addon, case insensitive.
    --- - `variable`: Variable name, case insensitive. May be `Title, Notes, Author, Version`, or anything starting with `X-`
    ---
    --- **Returns**
    --- - `value`: The value of the variable, `nil` if not defined.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnMetadata)
    function GetAddOnMetadata(name: uiAddon, variable: string): string
    --- Returns the addon's folder name.
    ---
    --- **Parameters**
    --- - `index`: The addon's index or name.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnName)
    function GetAddOnName(index: uiAddon): string
    --- Returns the addon's notes from its TOC file.
    ---
    --- **Parameters**
    --- - `name`: The addon's name or index.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnNotes)
    function GetAddOnNotes(name: uiAddon): string
    --- Returns a list of optional TOC dependencies.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried, or an index from 1 to `C_AddOns.GetNumAddOns`. The state of Blizzard addons can only be queried by name.
    ---
    --- **Returns**
    --- - `deps`: A list of addon names that are an optional dependency.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnOptionalDependencies)
    function GetAddOnOptionalDependencies(name: uiAddon): (...string)
    --- Returns whether the addon is secure (Blizzard's) or insecure.
    ---
    --- **Parameters**
    --- - `name`: The addon's name or index.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnSecurity)
    function GetAddOnSecurity(name: uiAddon): AddOnSecurityStatus
    --- Returns the addon's title from its TOC file, or its name without one.
    ---
    --- **Parameters**
    --- - `name`: The addon's name or index.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetAddOnTitle)
    function GetAddOnTitle(name: uiAddon): string
    --- Returns the number of AddOns.
    ---
    --- **Returns**
    --- - `numAddOns`: The number of user installed addons. Blizzard addons are not counted.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetNumAddOns)
    function GetNumAddOns(): number
    --- Whether addon scripts are disallowed on this beta client.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.GetScriptsDisallowedForBeta)
    function GetScriptsDisallowedForBeta(): boolean
    --- Whether the addon is enabled by default, unless its TOC file's `DefaultState` is disabled.
    ---
    --- **Parameters**
    --- - `name`: The addon's name or index.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.IsAddOnDefaultEnabled)
    function IsAddOnDefaultEnabled(name: uiAddon): boolean
    --- Returns true if the specified addon is load-on-demand.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried, or an index from 1 to `C_AddOns.GetNumAddOns`. The state of Blizzard addons can only be queried by name.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.IsAddOnLoadOnDemand)
    function IsAddOnLoadOnDemand(name: uiAddon): boolean
    --- Returns whether the addon can be loaded, and the reason when it cannot, such as `DISABLED` or `MISSING`.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried, or an index from 1 to `C_AddOns.GetNumAddOns`. The state of Blizzard addons can only be queried by name.
    --- - `character`: The name or GUID of the character to check against, or omitted/`nil` for all characters
    --- - `demandLoaded`: Whether to check it as a load-on-demand addon.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.IsAddOnLoadable)
    function IsAddOnLoadable(name: uiAddon, character: string?, demandLoaded: boolean?): (boolean, string)
    --- Returns true if the specified addon is loaded.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried, or an index from 1 to `C_AddOns.GetNumAddOns`. The state of Blizzard addons can only be queried by name.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.IsAddOnLoaded)
    function IsAddOnLoaded(name: uiAddon): (boolean, boolean)
    --- Whether out-of-date addons are kept from loading.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.IsAddonVersionCheckEnabled)
    function IsAddonVersionCheckEnabled(): boolean
    --- Loads the specified LoadOnDemand addon.
    ---
    --- **Parameters**
    --- - `name`: The name of the addon to be queried, or an index from 1 to `C_AddOns.GetNumAddOns`. The state of Blizzard addons can only be queried by name.
    ---
    --- **Returns**
    --- - `loaded`: `true` if the addon was loaded successfully, or if it has already been loaded.
    --- - `value`: Locale-independent reason why the addon could not be loaded e.g. `"DISABLED"`, otherwise returns `nil` if the addon was loaded.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.LoadAddOn)
    function LoadAddOn(name: uiAddon): (boolean?, string?)
    --- Undoes the changes to the addons' enabled states since they were last saved.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.ResetAddOns)
    function ResetAddOns()
    --- Resets the addons' disabled states.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.ResetDisabledAddOns)
    function ResetDisabledAddOns()
    --- Saves the addons' enabled states.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.SaveAddOns)
    function SaveAddOns()
    --- Sets whether out-of-date addons are kept from loading.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AddOns.SetAddonVersionCheck)
    function SetAddonVersionCheck(enabled: boolean)
end

declare namespace C_AdventureMap
    --- Returns the texture kit of the open adventure map.
