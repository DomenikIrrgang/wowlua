declare namespace C_AccountInfo
    --- Converts a battle.net account GUID to battle.net ID.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountInfo.GetIDFromBattleNetAccountGUID)
    function GetIDFromBattleNetAccountGUID(battleNetAccountGUID: string): number
    --- Returns whether a GUID is a batle.net account type.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountInfo.IsGUIDBattleNetAccountType)
    function IsGUIDBattleNetAccountType(guid: string): boolean
    --- Returns whether a GUID is related to the local (self) account.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountInfo.IsGUIDRelatedToLocalAccount)
    function IsGUIDRelatedToLocalAccount(guid: string): boolean
end

declare namespace C_AccountStore
    --- Starts buying the item from the account store.
    ---
    --- **Parameters**
    --- - `itemID`: The account store item's ID.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.BeginPurchase)
    function BeginPurchase(itemID: number): boolean
    --- Returns the IDs of the store front's categories.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.GetCategories)
    function GetCategories(storeFrontID: number): number[]
    --- Returns information about the account store category.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.GetCategoryInfo)
    function GetCategoryInfo(categoryID: number): AccountStoreCategoryInfo
    --- Returns the IDs of the items in the account store category.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.GetCategoryItems)
    function GetCategoryItems(categoryID: number): number[]
    --- Returns how much of the account store currency the player has.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.GetCurrencyAvailable)
    function GetCurrencyAvailable(currencyID: number): number
    --- Returns the ID of the currency the store front uses.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.GetCurrencyIDForStore)
    function GetCurrencyIDForStore(storeFrontID: number): number?
    --- Returns information about the account store currency.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.GetCurrencyInfo)
    function GetCurrencyInfo(currencyID: number): AccountStoreCurrencyInfo
    --- Returns information about the account store item.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.GetItemInfo)
    function GetItemInfo(itemID: number): AccountStoreItemInfo?
    --- Returns the state of the store front.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.GetStoreFrontState)
    function GetStoreFrontState(storeFrontID: number): AccountStoreState
    --- Requests a refund of the account store item.
    ---
    --- **Parameters**
    --- - `itemID`: The account store item's ID.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.RefundItem)
    function RefundItem(itemID: number): boolean
    --- Requests up-to-date information about the store front from the server.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.RequestStoreFrontInfoUpdate)
    function RequestStoreFrontInfoUpdate(storeFrontID: number)
end

declare namespace C_AchievementInfo
    --- Whether guild achievements are enabled.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementInfo.AreGuildAchievementsEnabled)
    function AreGuildAchievementsEnabled(): boolean
    --- Returns any reward item for an achievement.
    ---
    --- **Parameters**
    --- - `achievementID`: AchievementID
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementInfo.GetRewardItemID)
    function GetRewardItemID(achievementID: number): number?
    --- Returns the next achievement in a series.
    ---
    --- **Parameters**
    --- - `achievementID`: AchievementID
    ---
    --- **Returns**
    --- - `supercedingAchievements`: Only returns the next ID in a series even though it's in a table.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementInfo.GetSupercedingAchievements)
    function GetSupercedingAchievements(achievementID: number): number[]
    --- Whether the achievement is a guild achievement.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementInfo.IsGuildAchievement)
    function IsGuildAchievement(achievementId: number): boolean
    --- Whether the ID belongs to an existing achievement.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementInfo.IsValidAchievement)
    function IsValidAchievement(achievementId: number): boolean
    --- Sets a portrait texture for the unit being achievement compared.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementInfo.SetPortraitTexture)
    function SetPortraitTexture(textureObject: Texture)
end

declare namespace C_AchievementTelemetry
    --- Reports that the achievement was linked in a community.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementTelemetry.LinkAchievementInClub)
    function LinkAchievementInClub(achievementID: number)
    --- Reports that the achievement was linked in a whisper.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementTelemetry.LinkAchievementInWhisper)
    function LinkAchievementInWhisper(achievementID: number)
    --- Reports that the achievements window was opened.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AchievementTelemetry.ShowAchievements)
    function ShowAchievements()
end

declare namespace C_ActionBar
    --- Used in conjunction with `ACTION_RANGE_CHECK_UPDATE` to inform the UI when an action goes in or out of range with its current target.
    ---
    --- **Parameters**
    --- - `enable`: True if changes in range for the action should dispatch ActionRangeCheckUpdate. False if the action no longer needs the event.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.EnableActionRangeCheck)
    function EnableActionRangeCheck(actionID: number, enable: boolean)
    --- Returns the list of action bar slots that contain the Assisted Combat action spell.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.FindAssistedCombatActionButtons)
    function FindAssistedCombatActionButtons(): number[]?
    --- Returns the action slots that hold the flyout.
    ---
    --- **Parameters**
    --- - `setToSearch`: Which action bars to search.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.FindFlyoutActionButtons)
    function FindFlyoutActionButtons(flyoutID: number): number[]?
    --- Returns the action slots that hold the pet action.
    ---
    --- **Parameters**
    --- - `setToSearch`: Which action bars to search.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.FindPetActionButtons)
    function FindPetActionButtons(petActionID: number): number[]?
    --- Returns the list of action bar slots that contain a specified spell.
    ---
    --- **Parameters**
    --- - `spellID`: Expects a base spell, so if a spell is overridden the base ID should be provided.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.FindSpellActionButtons)
    function FindSpellActionButtons(spellID: SpellIdentifier | Secret<SpellIdentifier>): number[]?
    --- Force updates some internals for an action button slot.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.ForceUpdateAction)
    function ForceUpdateAction(slotID: number, suppressEvents: boolean?)
    --- Returns whether the action slot's pet action can autocast, and whether its autocast is on.
    ---
    --- **Parameters**
    --- - `actionID`: The action slot.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.GetActionAutocast)
    function GetActionAutocast(actionID: number): (boolean, boolean)
    --- Returns the action bar page the main bar shows.
