    function IsSpellBookItemUsable(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): (boolean, boolean)
    --- Returns true if a spell should be found in the spellbook. This function can also return true for spells that aren't known, such as override spells granted by an aura linked to class talents
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.IsSpellInSpellBook)
    function IsSpellInSpellBook(spellID: number, spellBank: SpellBookSpellBank?, includeOverrides: boolean?): boolean
