declare event LOC_RESULT(result: string)
--- Fires when a pending logout or quit is cancelled. Blizzard hides the logout and quit countdown dialogs.
---
--- *Description by wowlua: the API's documentation has none.*
declare event LOGOUT_CANCEL()
