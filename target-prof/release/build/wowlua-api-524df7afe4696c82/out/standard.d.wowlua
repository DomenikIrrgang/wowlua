declare class AbbreviatedNumberFormatter extends NumericFormatter
    --- Adds a new breakpoint to the formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_AbbreviatedNumberFormatter_AddBreakpoint)
    function AddBreakpoint(breakpoint: NumberAbbreviationBreakpoint)
    --- Removes all configured breakpoints from the formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_AbbreviatedNumberFormatter_ClearBreakpoints)
    function ClearBreakpoints()
