--- *Description by wowlua: the API's documentation has none.*
declare event AUCTION_HOUSE_SHOW()
--- Fires when the player wins a commodity auction. Blizzard's UI prints "You won an auction for …" to chat (`ERR_AUCTION_COMMODITY_WON_S`).
---
--- **Parameters**
--- - `commodityName`: The commodity's name.
--- - `commodityQuantity`: How many were won.
---
--- *Description by wowlua: the API's documentation has none.*
declare event AUCTION_HOUSE_SHOW_COMMODITY_WON_NOTIFICATION(commodityName: string, commodityQuantity: number)
--- Fires when an auction house action fails. Blizzard's UI shows the error text in the error frame and closes an open buyout popup.
---
--- **Parameters**
--- - `error`: What went wrong (`Enum.AuctionHouseError`).
---
--- *Description by wowlua: the API's documentation has none.*
declare event AUCTION_HOUSE_SHOW_ERROR(error: AuctionHouseError)
--- Fires when the auction house has a notice that includes text, such as an item name. Blizzard's UI prints it to chat as a system message.
---
--- **Parameters**
--- - `auctionID`: The auction the notice is about, if any.
--- - `notification`: Which notice it is (`Enum.AuctionHouseNotification`).
--- - `text`: The text placed into the notice.
---
--- *Description by wowlua: the API's documentation has none.*
declare event AUCTION_HOUSE_SHOW_FORMATTED_NOTIFICATION(notification: AuctionHouseNotification, text: string, auctionID: number?)
--- Fires when the auction house has a notice for the player. Blizzard's UI prints it to chat as a system message.
---
--- **Parameters**
--- - `notification`: Which notice it is (`Enum.AuctionHouseNotification`).
---
--- *Description by wowlua: the API's documentation has none.*
declare event AUCTION_HOUSE_SHOW_NOTIFICATION(notification: AuctionHouseNotification)
--- Fires when a throttled auction house request is dropped instead of being sent.
---
--- *Description by wowlua: the API's documentation has none.*
declare event AUCTION_HOUSE_THROTTLED_MESSAGE_DROPPED()
