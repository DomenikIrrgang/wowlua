declare namespace C_TableUtil
    --- Returns counts of the entries in the given table.
    ---
    --- **Returns**
    --- - `numTableNodes`: Total number of elements within the table
    --- - `numArrayNodes`: Total number of elements within the table that had integral keys in the range [1..numTableNodes]
    --- - `maxArrayIndex`: Largest integral key within the table, or zero if no such keys were found
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function count(table: unknown): (number?, number?, number?)
    --- Creates a new table with space reserved for the given number of entries.
    ---
    --- **Parameters**
    --- - `arraySizeHint`: Number of array entries to reserve space for.
    --- - `nodeSizeHint`: Number of hash entries to reserve space for.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function create(arraySizeHint: number, nodeSizeHint: number?): unknown
    --- Given two tables, finds the first index in the range (1, #t1) and (1, #t2) where two elements compare as inequal, or nil if no such elements are found.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_TableUtil.FindIndexedMismatch)
    function FindIndexedMismatch(t1: unknown, t2: unknown): number?
    --- Marks a supplied table as frozen, preventing any modifications to its contents, or replacement of its metatable. If the table has a pre-existing metatable with a '__newindex' table or function, assignments will pass through without raising errors. For tainted code, only tables created by the same addon making this function call are permitted to be frozen.
    function freeze(table: unknown)
    --- Returns true if a table has been marked as frozen.
    function isfrozen(table: unknown): boolean
end

