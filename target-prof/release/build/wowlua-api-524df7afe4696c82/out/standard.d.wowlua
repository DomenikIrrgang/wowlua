    function IsSpellKnownOrInSpellBook(spellID: number, spellBank: SpellBookSpellBank?, includeOverrides: boolean?): boolean
    --- Puts the spell in a spellbook slot on the cursor.
    ---
    --- **Parameters**
    --- - `spellBookItemSlotIndex`: The slot's index in the spellbook.
    --- - `spellBookItemSpellBank`: Which spellbook: the player's or the pet's.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.PickupSpellBookItem)
    function PickupSpellBookItem(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank)
    --- Turns autocast of the spell in a spellbook slot on or off.
    ---
    --- **Parameters**
    --- - `spellBookItemSlotIndex`: The slot's index in the spellbook.
    --- - `spellBookItemSpellBank`: Which spellbook: the player's or the pet's.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.SetSpellBookItemAutoCastEnabled)
    function SetSpellBookItemAutoCastEnabled(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank, enabled: boolean)
    --- Returns true if the SpellBookIem has a min and/or max range greater than 0; Will always return false if it is not a spell
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.SpellBookItemHasRange)
    function SpellBookItemHasRange(spellBookItemSlotIndex: number, spellBookItemSpellBank: SpellBookSpellBank): boolean
    --- Toggles autocast of the spell in a spellbook slot.
    ---
    --- **Parameters**
    --- - `spellBookItemSlotIndex`: The slot's index in the spellbook.
    --- - `spellBookItemSpellBank`: Which spellbook: the player's or the pet's.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.ToggleSpellBookItemAutoCast)
