--- *Description by wowlua: the API's documentation has none.*
declare event LEAVE_PARTY_CONFIRMATION(reason: LeavePartyConfirmReason)
--- Fires when a pending group invite to the player is cancelled. Blizzard's UI hides the invite dialog.
---
--- *Description by wowlua: the API's documentation has none.*
declare event PARTY_INVITE_CANCEL()
--- Fires when someone invites the player to a group. Blizzard's UI flashes the client icon and shows an invite dialog, or a role selection when roles are asked for; answer with `AcceptGroup` or `DeclineGroup`.
---
--- **Parameters**
--- - `allowMultipleRoles`: Whether more than one role may be chosen.
--- - `inviterGUID`: The inviter's GUID.
--- - `isDamage`: Whether the damage role is asked for.
--- - `isHealer`: Whether the healer role is asked for.
--- - `isNativeRealm`: Despite the name, Blizzard's UI treats `true` as a cross-realm invite and shows its cross-realm invite text.
--- - `isTank`: Whether the tank role is asked for.
--- - `name`: The name of the player who sent the invite.
--- - `questSessionActive`: Whether the player is in an active quest session (Party Sync).
---
--- *Description by wowlua: the API's documentation has none.*
declare event PARTY_INVITE_REQUEST(name: string, isTank: boolean, isHealer: boolean, isDamage: boolean, isNativeRealm: boolean, allowMultipleRoles: boolean, inviterGUID: string, questSessionActive: boolean)
