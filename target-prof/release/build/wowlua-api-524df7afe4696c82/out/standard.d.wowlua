    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_Sound.PlaySoundWithOptions)
    function PlaySoundWithOptions(params: PlaySoundParams): (boolean?, SoundHandle?)
