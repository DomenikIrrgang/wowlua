declare class SecondsFormatter
    --- Returns true if the given number of seconds is within an appropriate range for approximated formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_CanApproximate)
    function CanApproximate(seconds: DurationSecondsDouble): boolean
    --- Returns true if the formatter can promote values to higher interval bands.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_CanRoundUpIntervals)
    function CanRoundUpIntervals(): boolean
    --- Returns true if the formatter should round the final unit up rather than down.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_CanRoundUpLastUnit)
    function CanRoundUpLastUnit(): boolean
    --- Returns the unit count that a given number of seconds will use for formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_EvaluateDesiredUnitCount)
    function EvaluateDesiredUnitCount(seconds: DurationSecondsDouble): number
    --- Returns the maximum interval band that a given number of seconds will use for formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_EvaluateMaxInterval)
    function EvaluateMaxInterval(seconds: DurationSecondsDouble): SecondsFormatterInterval
    --- Returns the minimum interval band that a given number of seconds will use for formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_EvaluateMinInterval)
    function EvaluateMinInterval(seconds: DurationSecondsDouble): SecondsFormatterInterval
    --- Formats a number of seconds and returns the resulting string.
    ---
    --- **Parameters**
    --- - `abbreviation`: Optional abbreviation mode to use in-place of the default.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_Format)
    function Format(seconds: DurationSecondsDouble, abbreviation: SecondsFormatterAbbreviation?): string
    --- Returns formatted string representing a zero second duration.
    ---
    --- **Parameters**
    --- - `abbreviation`: Optional abbreviation mode to use in-place of the default.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_FormatZero)
    function FormatZero(abbreviation: SecondsFormatterAbbreviation?): string
    --- Returns the threshold below which numeric values are formatted as approximated strings.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetApproximationSeconds)
    function GetApproximationSeconds(): DurationSecondsDouble
    --- Returns true if the formatter should lowercase all unit format strings.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetConvertToLower)
    function GetConvertToLower(): boolean
    --- Returns the default abbreviation mode used for formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetDefaultAbbreviation)
    function GetDefaultAbbreviation(): SecondsFormatterAbbreviation?
    --- Returns the desired unit count for formatting.
    ---
    --- **Returns**
    --- - `count`: Nil if configured to use a curve.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetDesiredUnitCount)
    function GetDesiredUnitCount(): number?
    --- Returns the desired unit count curve for formatting.
    ---
    --- **Returns**
    --- - `curve`: Nil if configured to static unit count.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetDesiredUnitCountCurve)
    function GetDesiredUnitCountCurve(): LuaCurveObject?
    --- Returns the maximum interval band permitted for formatting.
    ---
    --- **Returns**
    --- - `interval`: Nil if configured to use a curve.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetMaxInterval)
    function GetMaxInterval(): SecondsFormatterInterval?
    --- Returns the maximum interval band curve permitted for formatting.
    ---
    --- **Returns**
    --- - `curve`: Nil if configured to static interval band.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetMaxIntervalCurve)
    function GetMaxIntervalCurve(): LuaCurveObject?
    --- Returns the threshold below which a value will be formatted as a decimal number of seconds with one place for milliseconds (eg. '3.4')
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetMillisecondsThreshold)
    function GetMillisecondsThreshold(): DurationSecondsDouble
    --- Returns the minimum interval band permitted for formatting.
    ---
    --- **Returns**
    --- - `interval`: Nil if configured to use a curve.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetMinInterval)
    function GetMinInterval(): SecondsFormatterInterval?
    --- Returns the minimum interval band curve permitted for formatting.
    ---
    --- **Returns**
    --- - `curve`: Nil if configured to static interval band.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetMinIntervalCurve)
    function GetMinIntervalCurve(): LuaCurveObject?
    --- Returns how fractional seconds are rounded when not displaying milliseconds.
    ---
    --- **Returns**
    --- - `rounding`: The configured rounding mode.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetRounding)
    function GetRounding(): SecondsFormatterRounding
    --- Returns the whitespace stripping mode of the formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_GetStripIntervalWhitespace)
    function GetStripIntervalWhitespace(): SecondsFormatterIntervalWhitespace
    --- Resets all stored configuration of the formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_Reset)
    function Reset()
    --- Configures the formatter to render numeric values between zero and this value as approximated strings (eg. '< 1m').
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetApproximationSeconds)
    function SetApproximationSeconds(seconds: DurationSecondsDouble)
    --- Configures the formatter to promote intervals if values are large enough (eg. '60m' -> '1h').
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetCanRoundUpIntervals)
    function SetCanRoundUpIntervals(canRound: boolean)
    --- Configures the formatter to round the last formatted unit up, rather than down.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetCanRoundUpLastUnit)
    function SetCanRoundUpLastUnit(canRound: boolean)
    --- Configures the formatter to convert all interval format strings to lowercase.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetConvertToLower)
    function SetConvertToLower(convert: boolean)
    --- Sets the default abbreviation mode used for formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetDefaultAbbreviation)
    function SetDefaultAbbreviation(abbreviation: SecondsFormatterAbbreviation)
    --- Sets the desired unit count used for formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetDesiredUnitCount)
    function SetDesiredUnitCount(count: number)
    --- Sets the desired unit count used for formatting to a curve that will be evaluated with seconds values to produce a desired unit count.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetDesiredUnitCountCurve)
    function SetDesiredUnitCountCurve(curve: LuaCurveObject)
    --- Sets the maximum interval band used for formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetMaxInterval)
    function SetMaxInterval(interval: SecondsFormatterInterval)
    --- Sets the maximum interval band used for formatting to a curve that will be evaluated with seconds values to produce a value matching a SecondsFormatterInterval enum member.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetMaxIntervalCurve)
    function SetMaxIntervalCurve(curve: LuaCurveObject)
    --- Sets the threshold below which a value will be formatted as a decimal number of seconds with one place for milliseconds (eg. '3.4')
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetMillisecondsThreshold)
    function SetMillisecondsThreshold(threshold: DurationSecondsDouble)
    --- Sets the minimum interval band used for formatting.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetMinInterval)
    function SetMinInterval(interval: SecondsFormatterInterval)
    --- Sets the minimum interval band used for formatting to a curve that will be evaluated with seconds values to produce a value matching a SecondsFormatterInterval enum member.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetMinIntervalCurve)
    function SetMinIntervalCurve(curve: LuaCurveObject)
    --- Sets how fractional seconds are rounded when not displaying milliseconds.
    ---
    --- **Parameters**
    --- - `rounding`: The rounding mode to use.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetRounding)
    function SetRounding(rounding: SecondsFormatterRounding)
    --- Sets the whitespace stripping mode for the formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SecondsFormatter_SetStripIntervalWhitespace)
    function SetStripIntervalWhitespace(strip: SecondsFormatterIntervalWhitespace)
end

