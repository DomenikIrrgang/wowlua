--- *Description by wowlua: the API's documentation has none.*
declare event ZONE_CHANGED_NEW_AREA()
--- Fires when the player explores a new part of the map. Blizzard's map redraws its explored overlays.
---
--- *Description by wowlua: the API's documentation has none.*
declare event MAP_EXPLORATION_UPDATED()
--- Fires when the player stops talking to a merchant.
---
--- *Description by wowlua: the API's documentation has none.*
declare event MERCHANT_CLOSED()
--- Fires when item data for the merchant's filtered item list changes.
---
--- **Parameters**
--- - `itemID`: The item that changed.
---
--- *Description by wowlua: the API's documentation has none.*
declare event MERCHANT_FILTER_ITEM_UPDATE(itemID: number)
--- Fires when the player starts talking to a merchant.
---
--- *Description by wowlua: the API's documentation has none.*
declare event MERCHANT_SHOW()
--- Fires when the merchant's items change. Blizzard's merchant frame redraws on its next update.
---
--- *Description by wowlua: the API's documentation has none.*
declare event MERCHANT_UPDATE()
--- Fires when a group member pings the minimap. Blizzard's docs mark it as a restricted callback event with secret payloads; Blizzard's minimap plays the ping sound.
---
--- **Parameters**
--- - `unitTarget`: The unit that pinged.
--- - `x`: The horizontal position of the ping.
--- - `y`: The vertical position of the ping.
---
--- *Description by wowlua: the API's documentation has none.*
declare event MINIMAP_PING(unitTarget: string, y: number, x: number)
--- Fires when what the minimap tracks changes. Blizzard's minimap tracking menu and quest offer pins refresh.
---
--- *Description by wowlua: the API's documentation has none.*
declare event MINIMAP_UPDATE_TRACKING()
--- Fires when the minimap's zoom changes. Blizzard's minimap updates its zoom buttons.
---
--- *Description by wowlua: the API's documentation has none.*
declare event MINIMAP_UPDATE_ZOOM()
--- Fires when the player enters or leaves a quest's objective area on the map. Blizzard's quest item buttons update.
---
