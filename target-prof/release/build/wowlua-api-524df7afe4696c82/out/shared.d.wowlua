---
--- **Parameters**
--- - `binding`: The name of the key (eg. "BUTTON1", "1", "CTRL-G")
--- - `checkOverride`: if true, override bindings will be checked, otherwise, only default (bindings.xml/SetBinding) bindings are consulted.
---
--- **Returns**
--- - `action`: action command performed by the binding. If no action is bound to the key, an empty string is returned.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_GetBindingAction)
declare function GetBindingAction(binding: string, checkOverride: boolean?): string
--- Returns the keys bound to the given command.
---
--- **Parameters**
--- - `command`: The name of the command to get key bindings for (e.g. MOVEFORWARD, TOGGLEFRIENDSTAB)
---
--- **Returns**
--- - `key`: The string representation(s) of all the key(s) bound to this command (e.g. W, CTRL-F)
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_GetBindingKey)
declare function GetBindingKey(command: string): string
--- Returns the string for the given key and prefix. Essentially a specialized getglobal() for bindings.
---
--- **Parameters**
--- - `key`: The name of the key (e.g. "UP", "SHIFT-PAGEDOWN")
--- - `prefix`: The prefix of the variable name you're looking for. Usually "KEY_" or "BINDING_NAME_".
--- - `abbreviate`: Whether to return an abbreviated version of the modifier keys
---
--- **Returns**
--- - `text`: The value of the global variable derived from the prefix and key name you specified. For example, "UP" and "KEY_" would return the value of the global variable KEY_UP which is "Up Arrow" in the english locale. If the global variable doesn't exist for the combination specified, it appears to just return the key name you specified. Modifier key prefixes are stripped from the input and added back in to the output. The third parameter, if true, causes the function to simply substitute the abbreviations 'c', 'a', 's', and 'st' for the strings CTRL, ALT, SHIFT, and STRG (German client only) in the result.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_GetBindingText)
declare function GetBindingText(key: string?, prefix: string?, abbreviate: boolean?): string
