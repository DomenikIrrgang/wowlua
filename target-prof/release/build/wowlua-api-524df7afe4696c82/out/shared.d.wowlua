    function HookScript(scriptType: "OnShow", handler: ((self: Self) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnHide", handler: ((self: Self) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnEnable", handler: ((self: Self) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnDisable", handler: ((self: Self) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnUpdate", handler: ((self: Self, elapsed: number) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnEvent", handler: ((self: Self, event: string, ...unknown) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnEnter", handler: ((self: Self, motion: boolean) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnLeave", handler: ((self: Self, motion: boolean) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnMouseDown", handler: ((self: Self, button: string) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnMouseUp", handler: ((self: Self, button: string) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnMouseWheel", handler: ((self: Self, delta: number) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnDragStart", handler: ((self: Self, button: string) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnDragStop", handler: ((self: Self) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnReceiveDrag", handler: ((self: Self) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnSizeChanged", handler: ((self: Self, width: number, height: number) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnAttributeChanged", handler: ((self: Self, name: string, value: unknown) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnKeyDown", handler: ((self: Self, key: string) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnKeyUp", handler: ((self: Self, key: string) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnChar", handler: ((self: Self, text: string) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnHyperlinkClick", handler: ((self: Self, link: string, text: string, button: string, ...unknown) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnHyperlinkEnter", handler: ((self: Self, link: string, text: string, ...unknown) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: "OnHyperlinkLeave", handler: ((self: Self, link: string, text: string, ...unknown) -> ()), bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    function HookScript(scriptType: ScriptCinematicModel, handler: function, bindingType: LE_SCRIPT_BINDING_TYPE?): boolean
    --- Sets the widget script handler.
