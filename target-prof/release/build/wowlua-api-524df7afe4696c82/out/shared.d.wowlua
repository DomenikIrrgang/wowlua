declare namespace C_BlackMarket
    --- Closes the Black Market window.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_BlackMarket.Close)
    function Close()
    --- Returns info for a Black Market auction.
    ---
    --- You can use `GetHotItem` to retrieve information about a "Hot Item!" auction picked by the server, `GetItemInfoByIndex` to iterate through all auctions, and `GetItemInfoByID` to retrieve information about specific auctions. These three functions have identical return values.
    ---
    --- **Parameters**
    --- - `marketID`: black market auction ID.
    --- - `index`: black market auction index, ascending from 1 to `C_BlackMarket.GetNumItems`()
    ---
    --- **Returns**
    --- - `name`: item name; nil if no such auction exists.
    --- - `texture`: icon texture path.
    --- - `quantity`: amount of the item included in the auction.
    --- - `itemType`: item type, e.g. "Quest", "Mail", or "Companion Pet"
    --- - `level`: item level requirement.
    --- - `levelType`: e.g. "REQ_LEVEL_ABBR"
    --- - `sellerName`: localized name of the NPC "selling" the item.
    --- - `minBid`: minimum amount of copper you can bid for this item.
    --- - `minIncrement`: minimum amount of copper you must increase the current bid by.
    --- - `currBid`: the maximum current bid in copper.
    --- - `youHaveHighBid`: true if your bid on this item is currently the highest bid, false otherwise.
    --- - `numBids`: number of bids made on this item.
    --- - `timeLeft`: token indicating remaining auction duration, 0 for completed auctions, larger values indicate larger remaining durations. For a localized text version, use `_G["AUCTION_TIME_LEFT" .. timeLeft]`.
    --- - `link`: Chat link of the item being auctioned.
    --- - `marketID`: Black Market auction ID of this auction.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_BlackMarket.GetItemInfoByID)
    function GetItemInfoByID(marketID: number): (string?, string, number, string, boolean, number, string, string, number, number, number, boolean, number, number, string, number, number)
    --- Returns information about an item on the Black Market Auction House: name, texture, quantity, type, usability, level, seller, bids, time left, link, market ID and quality. Takes the item's index.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function GetItemInfoByIndex(index: number): (string, string, number, string, boolean, number, string, string, number, number, number, boolean, number, number, string, number, number)
    --- Returns information about the Black Market Auction House's featured item: name, texture, quantity, type, usability, level, seller, bids, time left, link, market ID and quality.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function GetHotItem(): (string, string, number, string, boolean, number, string, string, number, number, number, boolean, number, number, string, number, number)
    --- Returns the number of auctions on the Black Market Auction House.
    ---
    --- **Returns**
    --- - `numItems`: number of auctions on the black market.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_BlackMarket.GetNumItems)
    function GetNumItems(): number
    --- Returns whether the black market is only viewable and bids are disabled.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_BlackMarket.IsViewOnly)
    function IsViewOnly(): boolean
    --- Places a bid on a black market auction.
    ---
    --- **Parameters**
    --- - `marketID`: black market auction ID (**not** line index!) to bid on.
    --- - `bid`: bid amount, in copper.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_BlackMarket.ItemPlaceBid)
    function ItemPlaceBid(marketID: number, bid: number)
    --- Requests updated black market auction information from the server.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_BlackMarket.RequestItems)
    function RequestItems()
end

