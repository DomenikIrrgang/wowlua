declare function GetRaidProfileSavedPosition(profile: unknown?, ...: unknown): (...unknown)
--- Returns info for a member of your raid.
---
--- **Parameters**
--- - `raidIndex`: The index of a raid member between 1 and `MAX_RAID_MEMBERS` (40). It's discouraged to use `GetNumGroupMembers`() since there can be "holes" between raid1 to raid40.
---
--- **Returns**
--- - `name`: raid member's name. Returns "Name-Server" for cross-realm players.
--- - `rank`: Returns 2 if the raid member is the leader of the raid, 1 if the raid member is promoted to assistant, and 0 otherwise.
--- - `subgroup`: The raid party this character is currently a member of. Raid subgroups are numbered as on the standard raid window.
--- - `level`: The level of the character. If this character is offline, the level will show as 0 (not nil).
--- - `class`: The character's class (localized), with the first letter capitalized (e.g. "Priest"). This function works as normal for offline characters.
--- - `fileName`: The system representation of the character's class; always in english, always fully capitalized.
--- - `zone`: The name of the zone this character is currently in. This is the value returned by GetRealZoneText. It is the same value you see if you mouseover their portrait (if in group). If the character is offline, this value will be the string "Offline".
--- - `online`: Returns 1 if raid member is online, nil otherwise.
--- - `isDead`: Returns 1 if raid member is dead (hunters Feigning Death are considered alive), nil otherwise.
--- - `role`: The player's role within the raid ("maintank" or "mainassist").
--- - `isML`: Returns 1 if the raid member is master looter, nil otherwise
--- - `combatRole`: Returns the combat role of the player if one is selected, i.e. "DAMAGER", "TANK" or "HEALER". Returns "NONE" otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_GetRaidRosterInfo)
declare function GetRaidRosterInfo(raidIndex: number): (string, number, number, number?, string, string, string?, boolean?, boolean?, string, boolean?, string)
