--- - `key`: Any binding string accepted by World of Warcraft. For example: "ALT-CTRL-F", "SHIFT-T", "W", "BUTTON4".
--- - `item`: Item name (or item string) you want the binding to use. For example: "Hearthstone", "item:6948"
---
--- **Returns**
--- - `ok`: 1 if the binding has been changed successfully, nil otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SetBindingItem)
declare function SetBindingItem(key: string, item: string): boolean?
--- Sets a binding to click the specified button object.
---
--- **Parameters**
--- - `key`: Any binding string accepted by World of Warcraft. For example: "ALT-CTRL-F", "SHIFT-T", "W", "BUTTON4".
--- - `name`: Id or name of the macro you wish to execute.
---
--- **Returns**
--- - `success`: true if the binding has been changed successfully, false otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SetBindingMacro)
declare function SetBindingMacro(key: string, name: unknown): boolean
--- Sets a binding to cast the specified spell.
---
--- **Parameters**
--- - `key`: Any binding string accepted by World of Warcraft. For example: "ALT-CTRL-F", "SHIFT-T", "W", "BUTTON4".
--- - `spell`: Name of the spell you wish to cast when the binding is pressed.
---
--- **Returns**
--- - `ok`: 1 if the binding has been changed successfully, nil otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SetBindingSpell)
declare function SetBindingSpell(key: string, spell: string): boolean?
