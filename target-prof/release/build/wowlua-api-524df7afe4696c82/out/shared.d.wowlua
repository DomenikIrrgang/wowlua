declare class Region extends ScriptRegion
    --- Returns the region's opacity.
    ---
    --- **Returns**
    --- - `alpha`: The alpha of the region. `0` is fully transparent, `1` is fully opaque.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_GetAlpha)
    function GetAlpha(): AspectSecret<SingleColorValue, SingleColorValue | Secret<SingleColorValue>>
    --- Returns the layer in which the region is drawn.
    ---
    --- **Returns**
    --- - `layer`: Layer in which this layered region is rendered, e.g. "ARTWORK"
    --- - `sublayer`: The sublevel within the returned layer, between -8 and 7.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_GetDrawLayer)
    function GetDrawLayer(): (DrawLayer, number)
    --- Returns the effective scale of the region.
    ---
    --- **Returns**
    --- - `effectiveScale`: The effective scale after propagating from the parent region. This is equal to `f:GetScale() * f:GetParent():GetScale()`
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_GetEffectiveScale)
    function GetEffectiveScale(): AspectSecret<number, number | Secret<number>>
    --- Returns the scale of the region.
    ---
    --- **Returns**
    --- - `scale`: The scale of the region.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_GetScale)
    function GetScale(): AspectSecret<number, number | Secret<number>>
    --- Returns the vertex color shading of the region.
    ---
    --- **Returns**
    --- - `colorR`: Red component
    --- - `colorG`: Green component
    --- - `colorB`: Blue component
    --- - `colorA`: Alpha (opacity) of the texture
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_GetVertexColor)
    function GetVertexColor(): (AspectSecret<number, number | Secret<number>>, AspectSecret<number, number | Secret<number>>, AspectSecret<number, number | Secret<number>>, AspectSecret<number, number | Secret<number>>)
    --- Returns true if the region is ignoring parent alpha.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_IsIgnoringParentAlpha)
    function IsIgnoringParentAlpha(): boolean
    --- Returns true if the region is ignoring parent scale.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_IsIgnoringParentScale)
    function IsIgnoringParentScale(): boolean
    --- Returns true if the region is fully loaded.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_IsObjectLoaded)
    function IsObjectLoaded(): boolean
    --- Sets the opacity of the region.
    ---
    --- **Parameters**
    --- - `alpha`: The alpha of the region. `0` is fully transparent, `1` is fully opaque.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_SetAlpha)
    function SetAlpha(alpha: SingleColorValue | Secret<SingleColorValue>)
    --- Sets the region's opacity to one of two values depending on a boolean, which may be a secret.
    ---
    --- **Parameters**
    --- - `alphaIfFalse`: The opacity when `value` is false.
    --- - `alphaIfTrue`: The opacity when `value` is true.
    --- - `value`: Picks `alphaIfTrue` or `alphaIfFalse`.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_SetAlphaFromBoolean)
    function SetAlphaFromBoolean(value: boolean | Secret<boolean>, alphaIfTrue: (SingleColorValue | Secret<SingleColorValue>)?, alphaIfFalse: (SingleColorValue | Secret<SingleColorValue>)?)
    --- Sets the layer in which the region is drawn.
    ---
    --- **Parameters**
    --- - `layer`: Layer to draw the region in, e.g. "BACKGROUND" or "ARTWORK".
    --- - `sublevel`: Integer between -8 and 7 (inclusive) from back to front, further subdividing each layer.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_SetDrawLayer)
    function SetDrawLayer(layer: DrawLayer, sublevel: number?)
    --- Sets whether the region should ignore its parent's alpha.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_SetIgnoreParentAlpha)
    function SetIgnoreParentAlpha(ignore: boolean)
    --- Sets whether the region should ignore its parent's scale.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_SetIgnoreParentScale)
    function SetIgnoreParentScale(ignore: boolean)
    --- Sets the size scaling of the region.
    ---
    --- **Parameters**
    --- - `scale`: The scale of the region. Must be greater than 0.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_SetScale)
    function SetScale(scale: number)
    --- Sets the vertex shading color of the region.
    ---
    --- **Parameters**
    --- - `colorR`: Red component
    --- - `colorG`: Green component
    --- - `colorB`: Blue component
    --- - `a`: Alpha (opacity) of the texture
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_SetVertexColor)
    function SetVertexColor(colorR: number | Secret<number>, colorG: number | Secret<number>, colorB: number | Secret<number>, a: (SingleColorValue | Secret<SingleColorValue>)?)
    --- Sets the region's vertex color to one of two colors depending on a boolean, which may be a secret.
    ---
    --- **Parameters**
    --- - `colorIfFalse`: The color when `value` is false.
    --- - `colorIfTrue`: The color when `value` is true.
    --- - `value`: Picks `colorIfTrue` or `colorIfFalse`.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_SetVertexColorFromBoolean)
    function SetVertexColorFromBoolean(value: boolean | Secret<boolean>, colorIfTrue: colorRGBA | Secret<colorRGBA>, colorIfFalse: colorRGBA | Secret<colorRGBA>)
    --- Adjusts the x and y offset of the region.
    ---
    --- **Parameters**
    --- - `x`: Offset right (negative for left).
    --- - `y`: Offset up (negative for down).
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_AdjustPointsOffset)
    function AdjustPointsOffset(x: uiUnit, y: uiUnit)
    --- Removes all anchor points from the region.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_ClearAllPoints)
    function ClearAllPoints()
    --- Removes one anchor point from the region.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Region_ClearPoint)
    function ClearPoint(point: FramePoint)
    --- Resets the x and y offset on the region to zero.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_ClearPointsOffset)
    function ClearPointsOffset()
    --- Returns the number of anchor points for the region.
    ---
    --- **Returns**
    --- - `numPoints`: The number of anchor points for the region. Returns `0` if there are no points.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_GetNumPoints)
    function GetNumPoints(): number
    --- Returns an anchor point for the region.
    ---
    --- **Parameters**
    --- - `anchorIndex`: Index between 1 and GetNumPoints.
    --- - `resolveCollapsed`: See SetCollapsesLayout.
    ---
    --- **Returns**
    --- - `point`: Point on this region at which it is anchored to another.
    --- - `relativeTo`: Reference to the other region to which this region is anchored.
    --- - `relativePoint`: Point on the other region to which this region is anchored.
    --- - `offsetX`: Offset right (negative for left).
    --- - `offsetY`: Offset up (negative for down).
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_GetPoint)
    function GetPoint(anchorIndex: number?, resolveCollapsed: boolean?): (FramePoint, ScriptRegion, FramePoint, uiUnit, uiUnit)
    --- Returns an anchor point by name for the region.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_GetPointByName)
    function GetPointByName(point: FramePoint, resolveCollapsed: boolean?): (FramePoint, ScriptRegion, FramePoint, uiUnit, uiUnit)
    --- Positions the region the same as another region.
    ---
    --- **Parameters**
    --- - `relativeTo`: The reference or name of a region.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_SetAllPoints)
    function SetAllPoints(relativeTo: ScriptRegion?, doResize: boolean?)
    --- Sets the region's height.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_SetHeight)
    function SetHeight(height: uiUnit)
    --- Sets an anchor point for the region.
    ---
    --- **Parameters**
    --- - `point`: FramePoint - The point of this region.
    --- - `relativeTo`: The reference or name of the other region. For example `UIParent` or `"UIParent"`.
    --- - `relativePoint`: FramePoint - The point of the other region to anchor to. If omitted, defaults to `point`.
    --- - `offsetX`: Offset right (negative for left). Requires `offsetY` to be specified.
    --- - `offsetY`: Offset up (negative for down). Requires `offsetX` to be specified.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_ScriptRegionResizing_SetPoint)
    function SetPoint(point: FramePoint, relativeTo: unknown?, relativePoint: FramePoint?, offsetX: uiUnit?, offsetY: uiUnit?)
    function SetPoint(point: FramePoint, relativeTo: unknown?, ofsx: number?, ofsy: number?)
    function SetPoint(point: FramePoint, ofsx: number?, ofsy: number?)
    --- Sets the x and y offsets of all of the region's anchor points.
    ---
