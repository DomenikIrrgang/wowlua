    --- Removes a single point from the curve. Raises an error if the supplied point index is out of range.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_CurveObject_RemovePoint)
    function RemovePoint(index: number)
    --- Replaces all points on the curve.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_CurveObject_SetPoints)
    function SetPoints(point: vector2[])
    --- Resets all state on the curve, and clears the secret values flag.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_CurveObject_SetToDefaults)
    function SetToDefaults()
end

declare class CurveObjectBase
    --- Returns the configured type of the curve.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_CurveObjectBase_GetType)
    function GetType(): number
    --- Returns true if the curve has been configured with any secret values. Curves with secret values always produce secret results when evaluated.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_CurveObjectBase_HasSecretValues)
    function HasSecretValues(): boolean
    --- Changes the evaluation type of the curve.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_CurveObjectBase_SetType)
    function SetType(type: number)
end

declare class DurationObject
    --- Copies another duration object and assigns it to this one.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_Assign)
    function Assign(other: DurationObject)
    --- Returns a copy of this duration object.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_Copy)
    function Copy(): DurationObject
    --- Calculates the elapsed duration in seconds and evaluates it against a supplied curve.
    ---
    --- **Returns**
    --- - `result`: If no curve is specified, a floating point percentage value. Else, the result of evaluating the curve with the percentage as the input.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_EvaluateElapsedDuration)
    function EvaluateElapsedDuration(curve: CurveObjectBase, modifier: number?): AspectSecret<LuaCurveEvaluatedResult, LuaCurveEvaluatedResult | Secret<LuaCurveEvaluatedResult>>
    --- Calculates the elapsed duration as a percentage value and evaluates it against a supplied curve.
    ---
    --- **Returns**
    --- - `result`: If no curve is specified, a floating point percentage value. Else, the result of evaluating the curve with the percentage as the input.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_EvaluateElapsedPercent)
    function EvaluateElapsedPercent(curve: CurveObjectBase, modifier: number?): AspectSecret<LuaCurveEvaluatedResult, LuaCurveEvaluatedResult | Secret<LuaCurveEvaluatedResult>>
    --- Calculates the remaining duration in seconds and evaluates it against a supplied curve.
    ---
    --- **Returns**
    --- - `result`: If no curve is specified, a floating point percentage value. Else, the result of evaluating the curve with the percentage as the input.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_EvaluateRemainingDuration)
    function EvaluateRemainingDuration(curve: CurveObjectBase, modifier: number?): AspectSecret<LuaCurveEvaluatedResult, LuaCurveEvaluatedResult | Secret<LuaCurveEvaluatedResult>>
    --- Calculates the remaining duration as a percentage value and evaluates it against a supplied curve.
    ---
    --- **Returns**
    --- - `result`: If no curve is specified, a floating point percentage value. Else, the result of evaluating the curve with the percentage as the input.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_EvaluateRemainingPercent)
    function EvaluateRemainingPercent(curve: CurveObjectBase, modifier: number?): AspectSecret<LuaCurveEvaluatedResult, LuaCurveEvaluatedResult | Secret<LuaCurveEvaluatedResult>>
    --- Returns the current time of the clock source used by this object.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetClockTime)
    function GetClockTime(): FrameTime
    --- Calculates the elapsed duration of the stored time span.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetElapsedDuration)
    function GetElapsedDuration(modifier: number?): DurationSeconds
    --- Calculates the elapsed duration as a percentage value.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetElapsedPercent)
    function GetElapsedPercent(modifier: number?): number
    --- Calculates the end time of the stored time span.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetEndTime)
    function GetEndTime(modifier: number?): FrameTime
    --- Returns the divisor used to convert a duration from real time to base time.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetModRate)
    function GetModRate(): number
    --- Calculates the remaining duration of the stored time span.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetRemainingDuration)
    function GetRemainingDuration(modifier: number?): DurationSeconds
    --- Calculates the remaining duration as a percentage value.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetRemainingPercent)
    function GetRemainingPercent(modifier: number?): number
    --- Calculates the start time of the stored time span.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetStartTime)
    function GetStartTime(modifier: number?): FrameTime
    --- Calculates the total duration of the stored time span.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_GetTotalDuration)
    function GetTotalDuration(modifier: number?): DurationSeconds
    --- Returns true if the duration has been configured with any secret values.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_HasSecretValues)
    function HasSecretValues(): boolean
    --- Returns true if the duration object is measuring a zero duration time span.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_IsZero)
    function IsZero(): boolean
    --- Resets the duration object to represent a zero duration time span.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_Reset)
    function Reset()
    --- Configures the duration object to represent an end time and a duration.
    ---
    --- **Parameters**
    --- - `modRate`: Optional divisor for converting this time span to a base time.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_SetTimeFromEnd)
    function SetTimeFromEnd(endTime: FrameTime, duration: DurationSeconds, modRate: number?)
    --- Configures the duration object to represent a start time and a duration.
    ---
    --- **Parameters**
    --- - `modRate`: Optional divisor for converting this time span to a base time.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_SetTimeFromStart)
    function SetTimeFromStart(startTime: FrameTime, duration: DurationSeconds, modRate: number?)
    --- Configures the duration object to represent a fixed start and end time span. If the end time is earlier than the start time, the duration will clamp to zero.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_SetTimeSpan)
    function SetTimeSpan(startTime: FrameTime, endTime: FrameTime)
    --- Resets all state on the duration, and clears the secret values flag.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_DurationObject_SetToDefaults)
    function SetToDefaults()
end

declare class HousingCatalogSearcher
    --- Returns all catalog entries being searched (note these are NOT search results, this is the source collection of what's being searched)
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetAllSearchItems)
    function GetAllSearchItems(): HousingCatalogEntryID[]
    --- Returns the most recent search result entries
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetCatalogSearchResults)
    function GetCatalogSearchResults(): HousingCatalogEntryID[]
    --- Returns the housing editor mode the search is for.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetEditorModeContext)
    function GetEditorModeContext(): number?
    --- Whether a filter tag of the search is turned on.
    ---
    --- **Parameters**
    --- - `groupID`: The filter group the tag belongs to.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetFilterTagStatus)
    function GetFilterTagStatus(groupID: number, tagID: number): boolean
    --- Returns the category the search is limited to.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetFilteredCategoryID)
    function GetFilteredCategoryID(): number?
    --- Returns the subcategory the search is limited to.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetFilteredSubcategoryID)
    function GetFilteredSubcategoryID(): number?
    --- Returns the total number of entries being searched through
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetNumSearchItems)
    function GetNumSearchItems(): number
    --- Returns the total number of owned instances across all most recent search result entries
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetSearchCount)
    function GetSearchCount(): number
    --- Returns the search text.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetSearchText)
    function GetSearchText(): string?
    --- Returns how the search results are sorted.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_GetSortType)
    function GetSortType(): number
    --- Whether the filter for decor allowed indoors is on.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsAllowedIndoorsActive)
    function IsAllowedIndoorsActive(): boolean
    --- Whether the filter for decor allowed outdoors is on.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsAllowedOutdoorsActive)
    function IsAllowedOutdoorsActive(): boolean
    --- Whether the filter for collected decor is on.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsCollectedActive)
    function IsCollectedActive(): boolean
    --- Whether the search shows only customizable decor.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsCustomizableOnlyActive)
    function IsCustomizableOnlyActive(): boolean
    --- Whether the search lists each decor record only once.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsDistinctPerRecordIDActive)
    function IsDistinctPerRecordIDActive(): boolean
    --- Whether the search shows only decor that gives a first acquisition bonus.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsFirstAcquisitionBonusOnlyActive)
    function IsFirstAcquisitionBonusOnlyActive(): boolean
    --- Whether the search shows only owned decor.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsOwnedOnlyActive)
    function IsOwnedOnlyActive(): boolean
    --- Whether a search is running.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsSearchInProgress)
    function IsSearchInProgress(): boolean
    --- Whether the filter for uncollected decor is on.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_IsUncollectedActive)
    function IsUncollectedActive(): boolean
    --- Run search with all current param values
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_RunSearch)
    function RunSearch()
    --- Set the toggle state of all filter tags within a specific group; If active, only entries that match Any of the tags in the group will be included in search results
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetAllInFilterTagGroup)
    function SetAllInFilterTagGroup(groupID: number, active: boolean)
    --- Search parameter; If true, entries that can be placed in house interiors will be included in the search; Note many decor objects can be placed both indoors and outdoors, so having only this toggled on may still include decor that can also be placed outdoors
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetAllowedIndoors)
    function SetAllowedIndoors(isActive: boolean)
    --- Search parameter; If true, entries that can be placed outside in plots will be included in the search; Note many decor objects can be placed both indoors and outdoors, so having only this toggled on may still include decor that can also be placed indoors
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetAllowedOutdoors)
    function SetAllowedOutdoors(isActive: boolean)
    --- If true, searcher automatically updates results whenever search param values are changed
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetAutoUpdateOnParamChanges)
    function SetAutoUpdateOnParamChanges(autoUpdateActive: boolean)
    --- Search parameter; If true, includes all owned entries, including those that are in storage OR placed in an owned house or plot; See IsOwnedOnlyActive for a more exclusive toggle
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetCollected)
    function SetCollected(isActive: boolean)
    --- Search parameter; If true, catalog entries that cannot be customized (ie dyed) will be excluded from the search
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetCustomizableOnly)
    function SetCustomizableOnly(isActive: boolean)
    --- Search parameter; If true, only the first entry per recordID will be included
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetDistinctPerRecordID)
    function SetDistinctPerRecordID(isActive: boolean)
    --- Search parameter; If set, limits search results to only entries that are used/valid in the specified editor mode
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetEditorModeContext)
    function SetEditorModeContext(editorModeContext: number?)
    --- Set the toggle state of a single filter tag within a specific group
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetFilterTagStatus)
    function SetFilterTagStatus(groupID: number, tagID: number, active: boolean)
    --- Search parameter; If set, limits search results to only those within the specified category
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetFilteredCategoryID)
    function SetFilteredCategoryID(categoryID: number?)
    --- Search parameter; If set, limits search results to only those within the specified subcategory
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetFilteredSubcategoryID)
    function SetFilteredSubcategoryID(subcategoryID: number?)
    --- Search parameter; If true, excludes any entries that do not reward house xp when acquired for the first time
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetFirstAcquisitionBonusOnly)
    function SetFirstAcquisitionBonusOnly(isActive: boolean)
    --- Search parameter; If true, only entries that you own, and have instances of available in storage, will be included; This does not include entries that you own but have all been placed in a house; See IsCollectedActive for param that includes placed entries
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetOwnedOnly)
    function SetOwnedOnly(isActive: boolean)
    --- Sets the function called when the search results update.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetResultsUpdatedCallback)
    function SetResultsUpdatedCallback(callback: HousingCatalogSearchResultsUpdatedCallback)
    --- Search parameter; If set, multiple text fields are checked for instances of the text, including name, category, subcategory, and data tags
    ---
    --- **Parameters**
    --- - `searchText`: Supports advanced search tokens (`'"'` `'-'` and `'|'`), case and accent insensitive; Set nil to clear out the search text
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetSearchText)
    function SetSearchText(searchText: string?)
    --- Sets how the search results are sorted.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetSortType)
    function SetSortType(sortType: number)
    --- Search parameter; If true, includes entries that are not owned, meaning not available in storage nor placed in any owned houses or plots
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_SetUncollected)
    function SetUncollected(isActive: boolean)
    --- Turns the filter for decor allowed indoors on or off.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleAllowedIndoors)
    function ToggleAllowedIndoors()
    --- Turns the filter for decor allowed outdoors on or off.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleAllowedOutdoors)
    function ToggleAllowedOutdoors()
    --- Turns the filter for collected decor on or off.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleCollected)
    function ToggleCollected()
    --- Turns showing only customizable decor on or off.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleCustomizableOnly)
    function ToggleCustomizableOnly()
    --- Turns listing each decor record only once on or off.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleDistinctPerRecordID)
    function ToggleDistinctPerRecordID()
    --- Turns a filter tag of the search on or off.
    ---
    --- **Parameters**
    --- - `groupID`: The filter group the tag belongs to.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleFilterTag)
    function ToggleFilterTag(groupID: number, tagID: number)
    --- Turns showing only decor that gives a first acquisition bonus on or off.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleFirstAcquisitionBonusOnly)
    function ToggleFirstAcquisitionBonusOnly()
    --- Turns showing only owned decor on or off.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleOwnedOnly)
    function ToggleOwnedOnly()
    --- Turns the filter for uncollected decor on or off.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_HousingCatalogSearcher_ToggleUncollected)
    function ToggleUncollected()
end

