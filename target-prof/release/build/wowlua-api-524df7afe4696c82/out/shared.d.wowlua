    function SetScript(scriptType: "OnAttributeChanged", handler: (((self: Self, name: string, value: unknown) -> ()))?)
    function SetScript(scriptType: "OnKeyDown", handler: (((self: Self, key: string) -> ()))?)
    function SetScript(scriptType: "OnKeyUp", handler: (((self: Self, key: string) -> ()))?)
    function SetScript(scriptType: "OnChar", handler: (((self: Self, text: string) -> ()))?)
    function SetScript(scriptType: "OnHyperlinkClick", handler: (((self: Self, link: string, text: string, button: string, ...unknown) -> ()))?)
