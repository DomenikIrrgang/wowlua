--- Returns info for an item transaction from the guild bank.
---
--- **Parameters**
--- - `tab`: Tab number, ascending from 1 to GetNumGuildBankTabs().
--- - `index`: Transaction index, ascending from 1 to GetNumGuildBankTransactions(tab). Higher indices correspond to more recent entries.
---
--- **Returns**
--- - `type`: Transaction type. ("deposit", "withdraw" or "move")
--- - `name`: Name of player who made the transaction.
--- - `itemLink`: itemLink of transaction item.
--- - `count`: Amount of items.
--- - `tab1`: For type=="move", this is the origin tab.
--- - `tab2`: For type=="move", this is the destination tab.
--- - `year`: The number of years since this transaction took place.
--- - `month`: The number of months since this transaction took place.
--- - `day`: The number of days since this transaction took place.
--- - `hour`: The number of hours since this transaction took place.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_GetGuildBankTransaction)
declare function GetGuildBankTransaction(tab: number, index: number): (string, string, string, number, number, number, number, number, number, number)
