    "List": {
      "description": "An object of items by key, or a list of them (recorded from Lua, a\ntable keyed 1, 2, 3 is a list and an empty one `{}`; the world reads\neither with `pairs`).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
