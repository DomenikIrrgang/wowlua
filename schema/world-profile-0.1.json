{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World profile",
  "description": "The world a wowlua test or run starts in (tests/profiles/<name>.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "This schema's URL, for editors.",
      "type": [
        "string",
        "null"
      ]
    },
    "client": {
      "description": "The client a recorded profile comes from (`/stdtest snapshot`).",
      "type": [
        "string",
        "null"
      ]
    },
    "leaderBoards": {
      "description": "The leader boards a snapshot recorded (kept, not applied)."
    },
    "character": {
      "description": "The player's character (`mock.setPlayer`).",
      "anyOf": [
        {
          "$ref": "#/$defs/UnitData"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "description": "Item data by item ID (`mock.defineItem`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List"
        },
        {
          "type": "null"
        }
      ]
    },
    "spells": {
      "description": "Spell data by spell ID (`mock.defineSpell`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List2"
        },
        {
          "type": "null"
        }
      ]
    },
    "money": {
      "description": "The character's money, in copper.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "stats": {
      "description": "The character's stats by key (`mock.player:setStats`).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "equipment": {
      "description": "What is worn, by slot ID or the client's slot name\n(`MainHandSlot`): an item ID or an item.",
      "anyOf": [
        {
          "$ref": "#/$defs/List3"
        },
        {
          "type": "null"
        }
      ]
    },
    "bags": {
      "description": "The bags by bag ID (0 the backpack).",
      "anyOf": [
        {
          "$ref": "#/$defs/List4"
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "description": "The action bars' actions by slot (`mock.setAction`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List5"
        },
        {
          "type": "null"
        }
      ]
    },
    "macros": {
      "description": "The account's and the character's macros (`mock.setMacros`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Macros"
        },
        {
          "type": "null"
        }
      ]
    },
    "mounts": {
      "description": "The mount journal by mount ID (`mock.setMounts`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List7"
        },
        {
          "type": "null"
        }
      ]
    },
    "toys": {
      "description": "The toy box by item ID (`mock.setToys`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List8"
        },
        {
          "type": "null"
        }
      ]
    },
    "appearances": {
      "description": "The wardrobe (`mock.setAppearances`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Appearances"
        },
        {
          "type": "null"
        }
      ]
    },
    "channels": {
      "description": "The chat channels the character is in (`mock.setChannels`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Channels"
        },
        {
          "type": "null"
        }
      ]
    },
    "position": {
      "description": "Where the character is (`mock.moveTo`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Position"
        },
        {
          "type": "null"
        }
      ]
    },
    "auras": {
      "description": "The character's auras (`mock.player:applyAura`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List11"
        },
        {
          "type": "null"
        }
      ]
    },
    "units": {
      "description": "The units around: creatures and other players (`mock.spawnUnit`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List12"
        },
        {
          "type": "null"
        }
      ]
    },
    "cvars": {
      "description": "CVars by name.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/Scalar"
      }
    },
    "screen": {
      "description": "The screen the client draws on, over the manifest's `test.screen`\n(decision T482): its size, DPI scale and UI scale.",
      "anyOf": [
        {
          "$ref": "#/$defs/TestScreen"
        },
        {
          "type": "null"
        }
      ]
    },
    "bindings": {
      "description": "Key bindings: key to action (`SetBinding`).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "savedVariables": {
      "description": "SavedVariables by global name, as the addon finds them at load.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
