{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World profile",
  "description": "The world a wowlua test or run starts in (tests/profiles/<name>.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "This schema's URL, for editors.",
      "type": [
        "string",
        "null"
      ]
    },
    "client": {
      "description": "The client a recorded profile comes from (`/stdtest snapshot`).",
      "type": [
        "string",
        "null"
      ]
    },
    "leaderBoards": {
      "description": "The leader boards a snapshot recorded (kept, not applied)."
    },
    "character": {
      "description": "The player's character (`mock.setPlayer`).",
      "anyOf": [
        {
          "$ref": "#/$defs/UnitData"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "description": "Item data by item ID (`mock.defineItem`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List"
        },
        {
          "type": "null"
        }
      ]
    },
    "spells": {
      "description": "Spell data by spell ID (`mock.defineSpell`): to override what the\nclient's tables answer.",
      "anyOf": [
        {
          "$ref": "#/$defs/List2"
        },
        {
          "type": "null"
        }
      ]
    },
    "trained": {
      "description": "The spells the character has trained, by spell ID\n(`mock.player:learn`; decision T500).",
      "anyOf": [
        {
          "$ref": "#/$defs/List3"
        },
        {
          "type": "null"
        }
      ]
    },
    "money": {
      "description": "The character's money, in copper.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "stats": {
      "description": "The character's stats by key (`mock.player:setStats`).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "equipment": {
      "description": "What is worn, by slot ID or the client's slot name\n(`MainHandSlot`): an item ID or an item.",
      "anyOf": [
        {
          "$ref": "#/$defs/List4"
        },
        {
          "type": "null"
        }
      ]
    },
    "bags": {
      "description": "The bags by bag ID (0 the backpack).",
      "anyOf": [
        {
          "$ref": "#/$defs/List5"
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "description": "The action bars' actions by slot (`mock.setAction`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List6"
        },
        {
          "type": "null"
        }
      ]
    },
    "macros": {
      "description": "The account's and the character's macros (`mock.setMacros`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Macros"
        },
        {
          "type": "null"
        }
      ]
    },
    "mounts": {
      "description": "The mount journal by mount ID (`mock.setMounts`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List8"
        },
        {
          "type": "null"
        }
      ]
    },
    "toys": {
      "description": "The toy box by item ID (`mock.setToys`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List9"
        },
        {
          "type": "null"
        }
      ]
    },
    "appearances": {
      "description": "The wardrobe (`mock.setAppearances`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Appearances"
        },
        {
          "type": "null"
        }
      ]
    },
    "channels": {
      "description": "The chat channels the character is in (`mock.setChannels`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Channels"
        },
        {
          "type": "null"
        }
      ]
    },
    "position": {
      "description": "Where the character is (`mock.moveTo`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Position"
        },
        {
          "type": "null"
        }
      ]
    },
    "auras": {
      "description": "The character's auras (`mock.player:applyAura`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List11"
        },
        {
          "type": "null"
        }
      ]
    },
    "units": {
      "description": "The units around: creatures and other players (`mock.spawnUnit`).",
      "anyOf": [
        {
          "$ref": "#/$defs/List12"
        },
        {
          "type": "null"
        }
      ]
    },
    "cvars": {
      "description": "CVars by name.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/Scalar"
      }
    },
    "screen": {
      "description": "The screen the client draws on, over the manifest's `test.screen`\n(decision T482): its size, DPI scale and UI scale.",
      "anyOf": [
        {
          "$ref": "#/$defs/TestScreen"
        },
        {
          "type": "null"
        }
      ]
    },
    "bindings": {
      "description": "Key bindings: key to action (`SetBinding`).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "savedVariables": {
      "description": "SavedVariables by global name, as the addon finds them at load.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "UnitData": {
      "description": "A unit's data (the character's, or a unit's around).",
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastName": {
          "description": "A WoW Forever character's last name.",
          "type": [
            "string",
            "null"
          ]
        },
        "realm": {
          "type": [
            "string",
            "null"
          ]
        },
        "guid": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "description": "The level (`UnitLevel`); -1: a boss's ?? level. The character's is\n1 to the flavor's max level (the flavor table's `max-level`: 60 on\ncamelot, 60 on vanilla, 70 on tbc, 90 on standard).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "class": {
          "description": "The class by file name (`WARRIOR`).",
          "type": [
            "string",
            "null"
          ]
        },
        "classId": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "race": {
          "description": "The race by file name (`Human`). Its faction follows it, and the\ncharacter knows its racial spells (decision T513).",
          "type": [
            "string",
            "null"
          ]
        },
        "sex": {
          "description": "1 unknown, 2 male, 3 female.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "health": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "healthMax": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "maxHealth": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "power": {
          "description": "The shown power's amount (`UnitPower(unit)`).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "powerMax": {
          "description": "The shown power's maximum (`UnitPowerMax(unit)`); `maxPower` the\nsame.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "maxPower": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "powerType": {
          "description": "The power it shows (`Enum.PowerType`: 0 mana, 1 rage, 3 energy, …);\nby default its class's (a druid's mana).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "powers": {
          "description": "Any of its powers by token (`MANA`, `RAGE`, `ENERGY`,\n`COMBO_POINTS`, …): how much it has and the most it can have. A\nunit has every power its class has (the flavor table's), each at\nthe flavor's default unless named here (decision T512).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/PowerAmount"
          }
        },
        "reaction": {
          "description": "`hostile`, `neutral` or `friendly`.",
          "type": [
            "string",
            "null"
          ]
        },
        "player": {
          "description": "A player character (not a creature).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "dead": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "distance": {
          "description": "Yards from the player. Without `world` the unit stands this far in\nfront of the player; with it, its distance follows the two places\n(decision T515).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "world": {
          "description": "Where it stands, as `UnitPosition` answers it (the player's\ninstance): its distance from the player follows (decision T515).",
          "anyOf": [
            {
              "$ref": "#/$defs/WorldPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "facing": {
          "description": "Radians counter-clockwise from north; facing the player when not\ngiven.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "movement": {
          "description": "How it moves on its own (decision T517).",
          "anyOf": [
            {
              "$ref": "#/$defs/UnitMovement"
            },
            {
              "type": "null"
            }
          ]
        },
        "faction": {
          "description": "`Alliance` or `Horde`: the one a race of either picked (the\nPandaren, the Skyborne), or a creature's. A race of one faction has\nits own (decision T513): another is an error.",
          "type": [
            "string",
            "null"
          ]
        },
        "npcId": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "creatureType": {
          "type": [
            "string",
            "null"
          ]
        },
        "creatureFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "zone": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "pvp": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "PowerAmount": {
      "description": "One of a unit's powers: how much it has (`UnitPower(unit, type)`) and\nthe most it can have (`UnitPowerMax(unit, type)`).",
      "type": "object",
      "properties": {
        "current": {
          "description": "How much it has (`UnitPower(unit, type)`).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "description": "The most it can have (`UnitPowerMax(unit, type)`).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "WorldPosition": {
      "description": "A place in the world, as `UnitPosition` answers it.",
      "type": "object",
      "properties": {
        "y": {
          "description": "North, in yards.",
          "type": "number",
          "format": "double"
        },
        "x": {
          "description": "West, in yards.",
          "type": "number",
          "format": "double"
        },
        "z": {
          "description": "Up, in yards (0 by default).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "instanceID": {
          "description": "The continent's instance ID (0 by default).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "y",
        "x"
      ]
    },
    "UnitMovement": {
      "description": "How a unit moves on its own (decision T517), facing its way, its\ndistance from the player following.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MovementKind"
        },
        "path": {
          "description": "A patrol's waypoints, in order.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/WorldPosition"
          }
        },
        "loop": {
          "description": "A patrol starts again at its first waypoint after the last (true by\ndefault); else it stands at the last.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "speed": {
          "description": "Yards a second: 2.5 (walking) for a patrol, 7 (running) otherwise.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "keep": {
          "description": "Yards it keeps from the player following or coming to them (2:\nmelee reach).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "kind"
      ]
    },
    "MovementKind": {
      "oneOf": [
        {
          "description": "It stands.",
          "type": "string",
          "const": "stand"
        },
        {
          "description": "Along its `path`.",
          "type": "string",
          "const": "patrol"
        },
        {
          "description": "After the player, `keep` yards behind.",
          "type": "string",
          "const": "follow"
        },
        {
          "description": "To the player, stopping `keep` yards away.",
          "type": "string",
          "const": "approach"
        },
        {
          "description": "Away from the player.",
          "type": "string",
          "const": "flee"
        }
      ]
    },
    "List": {
      "description": "An object of items by key, or a list of them (recorded from Lua, a\ntable keyed 1, 2, 3 is a list and an empty one `{}`; the world reads\neither with `pairs`).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Item"
          }
        }
      ]
    },
    "Item": {
      "description": "Item data (`GetItemInfo`'s fields by name).",
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "itemLevel": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "minLevel": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "subType": {
          "type": [
            "string",
            "null"
          ]
        },
        "stackCount": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "equipLoc": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scalar"
            },
            {
              "type": "null"
            }
          ]
        },
        "sellPrice": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "classId": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "subclassId": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "bindType": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "expansionId": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cached": {
          "description": "In the client's cache (true unless false).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "delay": {
          "description": "Seconds until its data loads.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "missing": {
          "description": "The server does not know it.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "Scalar": {
      "description": "A string, number or boolean.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "List2": {
      "description": "An object of items by key, or a list of them (recorded from Lua, a\ntable keyed 1, 2, 3 is a list and an empty one `{}`; the world reads\neither with `pairs`).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Spell"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Spell"
          }
        }
      ]
    },
    "Spell": {
      "description": "Spell data.",
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "iconID": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "petKnown": {
          "description": "The player's pet knows it.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "cooldown": true,
        "charges": true,
        "castTime": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "minRange": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "maxRange": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cached": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "List3": {
      "description": "An object of items by key, or a list of them (recorded from Lua, a\ntable keyed 1, 2, 3 is a list and an empty one `{}`; the world reads\neither with `pairs`).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        }
      ]
    },
    "List4": {
      "description": "An object of items by key, or a list of them (recorded from Lua, a\ntable keyed 1, 2, 3 is a list and an empty one `{}`; the world reads\neither with `pairs`).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemRef"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ItemRef"
          }
        }
      ]
    },
    "ItemRef": {
      "description": "An item ID, or an item stack.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "$ref": "#/$defs/ItemStack"
        }
      ]
    },
    "ItemStack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "format": "double"
        },
        "count": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "link": {
          "type": [
            "string",
            "null"
          ]
        },
        "bound": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "locked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cooldown": {
          "description": "`{ remaining, duration }` in seconds."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "List5": {
      "description": "An object of items by key, or a list of them (recorded from Lua, a\ntable keyed 1, 2, 3 is a list and an empty one `{}`; the world reads\neither with `pairs`).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bag"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Bag"
          }
        }
      ]
    },
    "Bag": {
      "description": "A bag: its size and what is in it by slot.",
      "type": "object",
      "properties": {
        "slots": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/List4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "List6": {
      "description": "An object of items by key, or a list of them (recorded from Lua, a\ntable keyed 1, 2, 3 is a list and an empty one `{}`; the world reads\neither with `pairs`).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Action"
          }
        }
      ]
    },
    "Action": {
      "description": "An action bar slot's action.",
      "type": "object",
      "properties": {
        "type": {
          "description": "`spell`, `item`, `macro`, …",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scalar"
            },
            {
              "type": "null"
            }
          ]
        },
        "subType": {
          "type": [
            "string",
            "null"
          ]
        },
        "texture": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scalar"
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "description": "A number, or `\"\"` as the client reports none.",
