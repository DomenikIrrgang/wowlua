          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "class": {
          "description": "The class by file name (`WARRIOR`).",
          "type": [
            "string",
            "null"
          ]
