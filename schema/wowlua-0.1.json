{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wowlua.json",
  "description": "Manifest of a wowlua package",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "package": {
      "description": "Required, except in a workspace root manifest.",
      "anyOf": [
        {
          "$ref": "#/$defs/Package"
        },
        {
          "type": "null"
        }
      ]
    },
    "addon": {
      "anyOf": [
        {
          "$ref": "#/$defs/Addon"
        },
        {
          "type": "null"
        }
      ]
    },
    "lua-library": {
      "anyOf": [
        {
          "$ref": "#/$defs/LuaLibrarySection"
        },
        {
          "type": "null"
        }
      ]
    },
    "types": {
      "anyOf": [
        {
          "$ref": "#/$defs/TypesSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "flavors": {
      "description": "Supported flavors: flavor IDs or aliases mapped to their settings.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/FlavorSettings"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Dependency"
      }
    },
    "dev-dependencies": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Dependency"
      }
    },
    "addon-dependencies": {
      "anyOf": [
        {
          "$ref": "#/$defs/AddonDependencies"
        },
        {
          "type": "null"
        }
      ]
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "build": {
      "$ref": "#/$defs/Build",
      "default": {
        "src": "src",
        "out": "dist",
        "libs-dir": "libs",
        "flavor-mode": "split",
        "toc-layout": "auto",
        "locales": "client",
        "locales-dir": "locales",
        "locale-base": "enUS"
      }
    },
    "check": {
      "$ref": "#/$defs/Check",
      "default": {
        "mode": "basic"
      }
    },
    "config": {
      "description": "User configuration keys with their default values (§9.9.1).",
      "type": "object",
      "additionalProperties": true
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProfileSettings"
      }
    },
    "minify-levels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/MinifyLevel"
      }
    },
    "publish": {
      "anyOf": [
        {
          "$ref": "#/$defs/Publish"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "$ref": "#/$defs/MetaSettings",
      "default": {
        "runtime": "used"
      }
    },
    "fmt": {
      "$ref": "#/$defs/Fmt",
      "default": {
        "indent": "tab",
        "line-width": 100,
        "quote-style": "double",
        "lua": false
      }
    },
    "test": {
      "$ref": "#/$defs/TestSettings",
      "default": {}
    },
    "compat": {
      "$ref": "#/$defs/Compat",
      "default": {
        "pkgmeta": false,
        "packager-keywords": false
      }
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/$defs/Workspace"
        },
        {
          "type": "null"
        }
      ]
    },
    "stdlib": {
      "$ref": "#/$defs/Stdlib",
      "default": {
        "log": {
          "history-size": 500
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Package": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Package ID: lowercase `[a-z0-9-]`, 2–64 characters.",
          "type": "string"
        },
        "version": {
          "description": "SemVer 2.0 version.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PackageKind",
          "default": "addon"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "description": "SPDX license expression.",
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wowlua": {
          "description": "Required compiler version (semver requirement).",
          "type": [
            "string",
            "null"
          ]
        },
        "main": {
          "description": "Main module of a library (default `src/init.wowlua`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "PackageKind": {
      "type": "string",
      "enum": [
        "addon",
        "library",
        "lua-library",
        "types"
      ]
    },
    "Addon": {
      "type": "object",
      "properties": {
        "name": {
          "description": "AddOn folder and TOC name. Default: PascalCase of `package.name`.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "title-localized": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes-localized": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "category-localized": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon-texture": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon-atlas": {
          "type": [
            "string",
            "null"
          ]
        },
        "load-on-demand": {
          "type": "boolean"
        },
        "default-state": {
          "$ref": "#/$defs/DefaultState",
          "default": "enabled"
        },
        "saved-variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "saved-variables-per-character": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load-saved-variables-first": {
          "type": "boolean"
        },
        "allow-table-access": {
          "type": "boolean"
        },
        "only-beta-and-ptr": {
          "type": "boolean"
        },
        "expose-meta": {
          "type": [
            "string",
            "null"
          ]
        },
        "toc-extra": {
          "description": "Extra TOC directives, emitted verbatim.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/MetaValue"
          }
        },
        "flavor-overrides": {
          "description": "Metadata that differs per flavor: flavor → fields. `null` removes a\nfield for that flavor (§9.3.1).",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AddonOverride"
          }
        },
        "toc-data": {
          "description": "Files of verbatim `## Key: Value` lines appended to a flavor's TOC, for\nbulk or generated metadata (§9.3.2): flavor → files.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "DefaultState": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "MetaValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "AddonOverride": {
      "description": "Per-flavor overrides of addon metadata. An absent field keeps the base\nvalue; `null` removes the field for the flavor.",
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "title-localized": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes-localized": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "category-localized": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon-texture": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon-atlas": {
          "type": [
            "string",
            "null"
          ]
        },
        "toc-extra": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "saved-variables": {
          "description": "This flavor's own SavedVariables (decision T128).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "saved-variables-per-character": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "LuaLibrarySection": {
      "type": "object",
      "properties": {
        "files": {
          "description": "Ordered entry files (`.lua`, `.xml` or a `.toc`).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "license-files": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TypesSection": {
      "type": "object",
      "properties": {
        "declarations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "FlavorSettings": {
      "type": "object",
      "properties": {
        "interface": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "client-folders": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "types": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Dependency": {
      "description": "A dependency: a version requirement string or a source object.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/DependencyDetail"
        }
      ]
    },
    "DependencyDetail": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "registry": {
          "type": [
            "string",
            "null"
          ]
        },
        "git": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "rev": {
          "type": [
            "string",
            "null"
          ]
        },
        "subdir": {
          "type": [
            "string",
            "null"
          ]
        },
        "submodules": {
          "type": "boolean"
        },
        "svn": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "strip-prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "moved-up": {
          "description": "The trailing folders of `subdir` / `strip-prefix` a `.pkgmeta`\n`move-folders` moved up: the files of the folder above stay next to\nthem in the output, like the packager leaves them.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "flavors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundle": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load": {
          "description": "`false`: a `lua-library` that is shipped but not loaded (no entry\nfiles), like the packager ships every external.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "types": {
          "type": [
            "string",
            "null"
          ]
        },
        "install-path": {
          "type": [
            "string",
            "null"
          ]
        },
        "addon-name": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default-features": {
          "type": "boolean",
          "default": true
        },
        "curseforge-slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "AddonDependencies": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AddonDependency"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AddonDependency"
          }
        },
        "load-with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load-managers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "AddonDependency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/AddonDependencyDetail"
        }
      ]
    },
    "AddonDependencyDetail": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "curseforge-slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "flavors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Build": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "default": "src"
        },
        "out": {
          "type": "string",
          "default": "dist"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load-order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flavor-load-order": {
          "description": "Flavors with an order of their own (flavor → like `load-order`),\nwritten by `wowlua init` when the flavors' TOCs disagree.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "libs-dir": {
          "type": "string",
          "default": "libs"
        },
        "flavor-files": {
          "description": "Restricts matching source files to the listed flavors (glob → flavors).",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "variable-files": {
          "description": "TOC file lines with variables (`[Game]`, `[Family]`, `[TextLocale]`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableFile"
          }
        },
        "external-files": {
          "description": "TOC file lines loading files of another AddOn (`../<AddOn>/<path>`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalFile"
          }
        },
        "shared-files": {
          "description": "Sources that are built and shipped but loaded by another AddOn's TOC\ninstead of this one's.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flavor-mode": {
          "$ref": "#/$defs/FlavorMode",
          "default": "split"
        },
        "toc-layout": {
          "$ref": "#/$defs/TocLayout",
          "default": "auto"
        },
        "locales": {
          "$ref": "#/$defs/LocaleLoading",
          "default": "client"
        },
        "locales-dir": {
          "type": "string",
          "default": "locales"
        },
        "locale-base": {
          "type": "string",
          "default": "enUS"
        }
      },
      "additionalProperties": false
    },
    "VariableFile": {
      "description": "A TOC file line with variables (§9.7.1).",
      "type": "object",
      "properties": {
        "path": {
          "description": "Path relative to the package root, e.g. `src/Locales/[TextLocale].lua`.",
          "type": "string"
        },
        "locales": {
          "description": "`[TextLocale]` only: the locales this line loads for.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "flavors": {
          "description": "Restricts the line to these flavors.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "ExternalFile": {
      "description": "A TOC file line loading a file of another AddOn (§9.7.2).",
      "type": "object",
      "properties": {
        "path": {
          "description": "`../<AddOn>/<path>`: the file's path in that AddOn's output, relative\nto this AddOn's folder.",
          "type": "string"
        },
        "flavors": {
          "description": "Restricts the line to these flavors.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "FlavorMode": {
      "type": "string",
      "enum": [
        "split",
        "shared"
      ]
    },
    "TocLayout": {
      "type": "string",
      "enum": [
        "auto",
        "single",
        "per-flavor"
      ]
    },
    "LocaleLoading": {
      "type": "string",
      "enum": [
        "client",
        "all"
      ]
    },
    "Check": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/CheckMode",
          "default": "basic"
        },
        "strict": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lua": {
          "type": "boolean"
        },
        "globals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lints": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/LintSetting"
          }
        }
      },
      "additionalProperties": false
    },
    "CheckMode": {
      "type": "string",
      "enum": [
        "nocheck",
        "basic",
        "strict"
      ]
    },
    "LintSetting": {
      "type": "string",
      "enum": [
        "allow",
        "warn",
        "deny"
      ]
    },
    "ProfileSettings": {
      "description": "Settings of one profile as written in the manifest. Unset values are\ninherited (§9.9).",
      "type": "object",
      "properties": {
        "inherits": {
          "type": [
            "string",
            "null"
          ]
        },
        "debug": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "assertions": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "log-level": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "instrument": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instrument"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime-checks": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeChecks"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile-errors": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "profile-call-paths": {
