{
  "name": "wowlua",
  "displayName": "wowlua",
  "description": "Check, format and outline wowlua addons as you type; debug them and their tests in wowlua's emulated World of Warcraft client, and see their UI as the game draws it.",
  "version": "0.12.0",
  "publisher": "wowlua",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#14120e",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DomenikIrrgang/wowlua"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:wowlua",
    "workspaceContains:**/wowlua.json",
    "onDebugResolve:wowlua",
    "onDebugInitialConfigurations",
    "onView:wowlua.frames",
    "onCommand:wowlua.showUI"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "wowlua.json",
        "url": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json"
      },
      {
        "fileMatch": "**/tests/profiles/*.json",
        "url": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/world-profile-0.1.json"
      }
    ],
    "languages": [
      {
        "id": "wowlua",
        "aliases": [
          "wowlua"
        ],
        "extensions": [
          ".wowlua"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wowlua",
        "scopeName": "source.wowlua",
        "path": "./syntaxes/wowlua.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[wowlua]": {
        "editor.defaultFormatter": "wowlua.wowlua"
      }
    },
    "breakpoints": [
      {
        "language": "wowlua"
      },
      {
        "language": "lua"
      }
    ],
    "configuration": {
      "title": "wowlua",
      "properties": {
        "wowlua.path": {
          "type": "string",
          "default": "wowlua",
          "description": "The wowlua command the extension runs (`wowlua lsp`, `wowlua debug`)."
        },
        "wowlua.languageServer": {
          "type": "boolean",
          "default": true,
          "description": "Check the open files' packages as you type (`wowlua lsp`): errors and warnings in the Problems view, Format Document, the outline."
        },
        "wowlua.ui.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the UI panel (the game's screen) when a wowlua debug session starts."
        },
        "wowlua.ui.refreshInterval": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "How often the UI panel draws the screen while the game runs, in milliseconds (0: only at stops and on Refresh)."
        },
        "wowlua.testCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show \"Run test\" and \"Debug\" above each test and at the top of a test file."
        }
      }
    },
    "debuggers": [
      {
        "type": "wowlua",
        "label": "wowlua: the emulated client",
        "languages": [
          "wowlua",
          "lua"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "test": {
                "type": "string",
                "description": "A test file to run, relative to the package (tests/options.test.wowlua)."
              },
              "filter": {
                "type": "string",
                "description": "Only the tests whose names contain this."
              },
              "addon": {
                "type": "boolean",
                "description": "Run the addon itself, logged in, instead of a test file.",
                "default": false
              },
              "flavor": {
                "type": "string",
                "description": "The flavor to run (camelot, standard, vanilla, \u2026); the package's first by default."
              },
              "clock": {
                "type": "string",
                "enum": [
                  "realtime",
                  "manual"
                ],
                "description": "realtime: a game frame every 1/60 s; manual: time stands still until asked.",
                "default": "realtime"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first line runs.",
                "default": false
              },
              "debugBlizzardUI": {
                "type": "boolean",
                "description": "Step into Blizzard's UI code too.",
                "default": false
              },
              "wowluaPath": {
                "type": "string",
                "description": "The wowlua command for this configuration (else the `wowlua.path` setting)."
              },
              "profile": {
                "type": "string",
                "description": "A world profile to start in (tests/profiles/<name>.json: the character, its gear, bags, world), over the manifest's test.profile."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "wowlua",
            "request": "launch",
            "name": "wowlua: run the addon",
            "addon": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "wowlua: run the addon",
            "description": "The addon in the emulated client, logged in.",
            "body": {
              "type": "wowlua",
              "request": "launch",
              "name": "wowlua: run the addon",
              "addon": true
            }
          },
          {
            "label": "wowlua: debug a test file",
            "description": "One test file, optionally some of its tests.",
            "body": {
              "type": "wowlua",
              "request": "launch",
              "name": "wowlua: debug a test",
              "test": "^\"tests/${1:file}.test.wowlua\"",
              "filter": "^\"${2}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "wowlua.showUI",
        "title": "Show UI",
        "category": "wowlua",
        "icon": "$(device-desktop)"
      },
      {
        "command": "wowlua.refreshFrames",
        "title": "Refresh Frames",
        "category": "wowlua",
        "icon": "$(refresh)"
      },
      {
        "command": "wowlua.outlineFrame",
        "title": "Outline in the UI",
        "category": "wowlua"
      },
      {
        "command": "wowlua.zoomToFrame",
        "title": "Zoom to Frame in the UI",
        "category": "wowlua",
        "icon": "$(zoom-in)"
      },
      {
        "command": "wowlua.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "wowlua"
      },
      {
        "command": "wowlua.showCoverageReport",
        "title": "Show Coverage Report",
        "category": "wowlua",
        "icon": "$(graph)"
      }
    ],
    "views": {
      "debug": [
        {
          "id": "wowlua.frames",
          "name": "wowlua Frames",
          "when": "debugType == 'wowlua'"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "wowlua.refreshFrames",
          "when": "view == wowlua.frames",
          "group": "navigation"
        },
        {
          "command": "wowlua.showUI",
          "when": "view == wowlua.frames",
          "group": "navigation"
        },
        {
          "command": "wowlua.showCoverageReport",
          "when": "view == workbench.view.testCoverage",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "wowlua.showCoverageReport",
          "when": "resourceFilename == coverage.html",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "wowlua.showCoverageReport",
          "when": "resourceFilename == coverage.html",
          "group": "navigation"
        }
      ],
      "debug/toolBar": [
        {
          "command": "wowlua.showUI",
          "when": "debugType == 'wowlua'"
        }
      ],
      "commandPalette": [
        {
          "command": "wowlua.outlineFrame",
          "when": "false"
        },
        {
          "command": "wowlua.zoomToFrame",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "wowlua.zoomToFrame",
          "when": "view == wowlua.frames && viewItem == frame",
          "group": "inline"
        }
      ]
    }
  }
}
