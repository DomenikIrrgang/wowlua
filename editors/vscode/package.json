{
  "name": "wowlua",
  "displayName": "wowlua",
  "description": "Debug wowlua addons and their tests in wowlua's emulated World of Warcraft client, and see their UI as the game draws it.",
  "version": "0.10.0",
  "publisher": "wowlua",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DomenikIrrgang/wowlua"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:wowlua",
    "onDebugInitialConfigurations",
    "onView:wowlua.frames",
    "onCommand:wowlua.showUI"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wowlua",
        "aliases": [
          "wowlua"
        ],
        "extensions": [
          ".wowlua"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "wowlua"
      },
      {
        "language": "lua"
      }
    ],
    "configuration": {
      "title": "wowlua",
      "properties": {
        "wowlua.path": {
          "type": "string",
          "default": "wowlua",
          "description": "The wowlua command the debugger runs (`wowlua debug`)."
        },
        "wowlua.ui.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the UI panel (the game's screen) when a wowlua debug session starts."
        },
        "wowlua.ui.refreshInterval": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "How often the UI panel draws the screen while the game runs, in milliseconds (0: only at stops and on Refresh)."
        }
      }
    },
    "debuggers": [
      {
        "type": "wowlua",
        "label": "wowlua: the emulated client",
        "languages": [
          "wowlua",
          "lua"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "test": {
                "type": "string",
                "description": "A test file to run, relative to the package (tests/options.test.wowlua)."
              },
              "filter": {
                "type": "string",
                "description": "Only the tests whose names contain this."
              },
              "addon": {
                "type": "boolean",
                "description": "Run the addon itself, logged in, instead of a test file.",
                "default": false
              },
              "flavor": {
                "type": "string",
                "description": "The flavor to run (camelot, standard, vanilla, \u2026); the package's first by default."
              },
              "clock": {
                "type": "string",
                "enum": [
                  "realtime",
                  "manual"
                ],
                "description": "realtime: a game frame every 1/60 s; manual: time stands still until asked.",
                "default": "realtime"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first line runs.",
                "default": false
              },
              "debugBlizzardUI": {
                "type": "boolean",
                "description": "Step into Blizzard's UI code too.",
                "default": false
              },
              "wowluaPath": {
                "type": "string",
                "description": "The wowlua command for this configuration (else the `wowlua.path` setting)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "wowlua",
            "request": "launch",
            "name": "wowlua: run the addon",
            "addon": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "wowlua: run the addon",
            "description": "The addon in the emulated client, logged in.",
            "body": {
              "type": "wowlua",
              "request": "launch",
              "name": "wowlua: run the addon",
              "addon": true
            }
          },
          {
            "label": "wowlua: debug a test file",
            "description": "One test file, optionally some of its tests.",
            "body": {
              "type": "wowlua",
              "request": "launch",
              "name": "wowlua: debug a test",
              "test": "^\"tests/${1:file}.test.wowlua\"",
              "filter": "^\"${2}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "wowlua.showUI",
        "title": "Show UI",
        "category": "wowlua",
        "icon": "$(device-desktop)"
      },
      {
        "command": "wowlua.refreshFrames",
        "title": "Refresh Frames",
        "category": "wowlua",
        "icon": "$(refresh)"
      },
      {
        "command": "wowlua.outlineFrame",
        "title": "Outline in the UI",
        "category": "wowlua"
      }
    ],
    "views": {
      "debug": [
        {
          "id": "wowlua.frames",
          "name": "wowlua Frames",
          "when": "debugType == 'wowlua'"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "wowlua.refreshFrames",
          "when": "view == wowlua.frames",
          "group": "navigation"
        },
        {
          "command": "wowlua.showUI",
          "when": "view == wowlua.frames",
          "group": "navigation"
        }
      ],
      "debug/toolBar": [
        {
          "command": "wowlua.showUI",
          "when": "debugType == 'wowlua'"
        }
      ],
      "commandPalette": [
        {
          "command": "wowlua.outlineFrame",
          "when": "false"
        }
      ]
    }
  }
}
