{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "wowlua",
  "scopeName": "source.wowlua",
  "fileTypes": [
    "wowlua"
  ],
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#decorator"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#annotation"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "name": "comment.block.wowlua",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.wowlua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.wowlua"
            }
          }
        },
        {
          "begin": "---",
          "end": "$",
          "name": "comment.line.documentation.wowlua",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.wowlua"
            }
          }
        },
        {
          "begin": "--",
          "end": "$",
          "name": "comment.line.double-dash.wowlua",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.wowlua"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\\\"",
          "end": "\\\"|$",
          "name": "string.quoted.double.wowlua",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.wowlua",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "name": "string.quoted.other.multiline.wowlua"
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.interpolated.wowlua",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "begin": "\\{",
              "end": "\\}",
              "name": "meta.embedded.expression.wowlua",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.wowlua"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.wowlua"
                }
              },
              "contentName": "source.wowlua",
              "patterns": [
                {
                  "include": "#statements"
                }
              ]
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "match": "\\\\(?:[abfnrtv\\\\\\\"'`{}\\n]|\\d{1,3}|x[0-9A-Fa-f]{2}|z|u\\{[0-9A-Fa-f]+\\})",
          "name": "constant.character.escape.wowlua"
        }
      ]
    },
    "decorator": {
      "patterns": [
        {
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "punctuation.decorator.wowlua"
            },
            "2": {
              "name": "entity.name.function.decorator.wowlua"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(export)\\b(?=\\s+(?:local|function|const|class|abstract|interface|enum|type|declare|overload)\\b)",
          "captures": {
            "1": {
              "name": "storage.modifier.export.wowlua"
            }
          }
        },
        {
          "match": "\\b(declare)\\s+(function|global|class|interface|namespace|event|message|module)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.declare.wowlua"
            },
            "2": {
              "name": "storage.type.wowlua"
            }
          }
        },
        {
          "begin": "^\\s*(import)\\b(?=\\s+(?:type\\b|internal\\b|\\*|_\\b|[A-Za-z_]))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.wowlua"
            }
          },
          "end": "(?<=[\\\"'])|$",
          "patterns": [
            {
              "match": "\\b(?:type|internal)\\b(?=\\s+[A-Za-z_*])",
              "name": "storage.modifier.wowlua"
            },
            {
              "match": "\\b(?:from|as)\\b",
              "name": "keyword.control.import.wowlua"
            },
            {
              "match": "\\*",
              "name": "keyword.operator.wowlua"
            },
            {
              "include": "#strings"
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "variable.other.readwrite.alias.wowlua"
            }
          ]
        },
        {
          "match": "\\b(abstract\\s+)?(class|interface|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.wowlua"
            },
            "2": {
              "name": "storage.type.wowlua"
            },
            "3": {
              "name": "entity.name.type.wowlua"
            }
          }
        },
        {
          "match": "\\b(extends|implements)\\s+([A-Za-z_][A-Za-z0-9_.]*)((?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_.]*)*)",
          "captures": {
            "1": {
              "name": "storage.modifier.wowlua"
            },
            "2": {
              "name": "entity.other.inherited-class.wowlua"
            },
            "3": {
              "patterns": [
                {
                  "match": "[A-Za-z_][A-Za-z0-9_.]*",
                  "name": "entity.other.inherited-class.wowlua"
                }
              ]
            }
          }
        },
        {
          "match": "(?:^\\s*(?:export\\s+)?|(?<=\\bexport)\\s+)(type)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<|=))",
          "captures": {
            "1": {
              "name": "storage.type.wowlua"
            },
            "2": {
              "name": "entity.name.type.alias.wowlua"
            }
          }
        },
        {
          "match": "(?:^\\s*(?:export\\s+)?|(?<=\\bexport)\\s+)(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.wowlua"
            },
            "2": {
              "name": "variable.other.constant.wowlua"
            }
          }
        },
        {
          "match": "\\b(function)\\s+((?:[A-Za-z_][A-Za-z0-9_]*[.:])*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.wowlua"
            },
            "2": {
              "name": "entity.name.namespace.wowlua"
            },
            "3": {
              "name": "entity.name.function.wowlua"
            }
          }
        },
        {
          "match": "\\b(?:private|protected|public|static|readonly|abstract|override|overload)\\b(?=\\s+[A-Za-z_])",
          "name": "storage.modifier.wowlua"
        },
        {
          "match": "\\b(get|set)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "storage.type.accessor.wowlua"
            },
            "2": {
              "name": "entity.name.function.wowlua"
            }
          }
        },
        {
          "match": "\\bconstructor\\b(?=\\s*\\()",
          "name": "storage.type.constructor.wowlua"
        }
      ]
    },
    "annotation": {
      "patterns": [
        {
          "begin": "(?:(?<=[A-Za-z0-9_\\)\\]?])\\s*(:)|(?<=[A-Za-z0-9_\\]])(\\?:))(?=\\s)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.annotation.wowlua"
            },
            "2": {
              "name": "punctuation.separator.annotation.wowlua"
            }
          },
          "end": "(?=[=,;\\)\\}\\]]|\\b(?:then|do|return|local|end|if|elseif|else|for|while|repeat|until|function|and|or|not)\\b|$)",
          "name": "meta.type.annotation.wowlua",
          "patterns": [
            {
              "include": "#types"
            }
          ]
        },
        {
          "begin": "(::)",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.cast.wowlua"
            }
          },
          "end": "(?=[=,;\\)\\}\\]]|\\b(?:then|do|return|local|end|if|elseif|else|for|while|repeat|until|function|and|or|not)\\b|$)",
          "name": "meta.type.cast.wowlua",
          "patterns": [
            {
              "include": "#types"
            }
          ]
        },
        {
          "begin": "(?<=[A-Za-z0-9_])<(?=\\s*[A-Za-z_][A-Za-z0-9_]*\\s*(?:,|>|extends\\b|=))",
          "end": ">|(?=$)",
          "name": "meta.type.parameters.wowlua",
          "patterns": [
            {
              "include": "#types"
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(?:number|string|boolean|any|unknown|never|nil|table|thread|userdata|true|false|Self)\\b",
          "name": "support.type.primitive.wowlua"
        },
        {
          "match": "\\bextends\\b",
          "name": "storage.modifier.wowlua"
        },
        {
          "match": "\\b(?:typeof|keyof|is)\\b",
          "name": "keyword.operator.type.wowlua"
        },
        {
          "include": "#strings"
        },
        {
          "match": "-?\\b\\d+(?:\\.\\d+)?\\b",
          "name": "constant.numeric.wowlua"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.wowlua"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.spread.wowlua"
        },
        {
          "match": "[|&?]",
          "name": "keyword.operator.type.wowlua"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)",
          "name": "variable.parameter.wowlua"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "name": "entity.name.type.wowlua"
        },
        {
          "begin": "<",
          "end": ">|(?=$)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.begin.wowlua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.wowlua"
            }
          },
          "patterns": [
            {
              "include": "#types"
            }
          ]
        },
        {
          "begin": "\\(",
          "end": "\\)|(?=$)",
          "patterns": [
            {
              "include": "#types"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}|(?=$)",
          "patterns": [
            {
              "include": "#types"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]|(?=$)",
          "patterns": [
            {
              "include": "#types"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:if|then|else|elseif|end|for|in|while|do|repeat|until|return|break|goto)\\b",
          "name": "keyword.control.wowlua"
        },
        {
          "match": "(?:^|(?<=\\bdo)|(?<=\\bthen)|(?<=\\belse)|(?<=;))\\s*(continue)\\b(?!\\s*[=(.\\[:])",
          "captures": {
            "1": {
              "name": "keyword.control.wowlua"
            }
          }
        },
        {
          "match": "\\b(?:function)\\b",
          "name": "keyword.declaration.function.wowlua"
        },
        {
          "match": "\\blocal\\b",
          "name": "storage.modifier.local.wowlua"
        },
        {
          "match": "\\b(?:and|or|not)\\b",
          "name": "keyword.operator.logical.wowlua"
        },
        {
          "match": "\\b(?:nil|true|false)\\b",
          "name": "constant.language.wowlua"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.self.wowlua"
        },
        {
          "match": "\\bsuper\\b",
          "name": "variable.language.super.wowlua"
        },
        {
          "match": "\\.\\.\\.",
          "name": "variable.parameter.vararg.wowlua"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f_]*(?:\\.[0-9A-Fa-f_]*)?(?:[pP][+-]?\\d+)?\\b",
          "name": "constant.numeric.hex.wowlua"
        },
        {
          "match": "(?:\\b\\d[\\d_]*(?:\\.[\\d_]*)?|\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?\\b",
          "name": "constant.numeric.wowlua"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "(?<=:)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[\\(\\\"'{`])",
          "captures": {
            "1": {
              "name": "entity.name.function.method.wowlua"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.wowlua"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\?\\?=|\\?\\?|\\?\\.|\\?:",
          "name": "keyword.operator.optional.wowlua"
        },
        {
          "match": "\\.\\.=|//=|\\+=|-=|\\*=|/=|%=|\\^=|&=|\\|=|<<=|>>=",
          "name": "keyword.operator.assignment.compound.wowlua"
        },
        {
          "match": "==|~=|<=|>=|<|>",
          "name": "keyword.operator.comparison.wowlua"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.concatenation.wowlua"
        },
        {
          "match": "//|\\+|-|\\*|/|%|\\^|#",
          "name": "keyword.operator.arithmetic.wowlua"
        },
        {
          "match": "<<|>>|&|\\||~",
          "name": "keyword.operator.bitwise.wowlua"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.wowlua"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.property.wowlua"
        },
        {
          "match": "\\b[A-Z][A-Z0-9_]+\\b",
          "name": "variable.other.constant.wowlua"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.readwrite.wowlua"
        }
      ]
    }
  }
}
