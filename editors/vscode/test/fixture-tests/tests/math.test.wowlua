-- The test explorer's fixture (editors/vscode/test/suite.js).
import test, skip, cases, expect from "wowlua:test"
import add from "/main"

@test("adds two numbers")
local function adds()
    expect(add(1, 2)).toBe(3)
end

@test("fails on purpose")
local function fails()
    expect(add(1, 1)).toBe(3)
end

@skip("not yet")
@test("waits")
local function waits()
end

@cases({ { 1, 1, 2 }, { 2, 3, 5 } })
@test("sums")
local function sums(a: number, b: number, sum: number)
    expect(add(a, b)).toBe(sum)
end
