-- Typed Demo: the gold earned and spent this session. Type /tdemo.
import Ledger from "./ledger"
import Source, format from "./money"
import info, debug from "wowlua:log"

const KEEP = 5

local ledger: Ledger? = nil
local source: Source = Source.Other

-- The warband bank exists only on the mainline client. The build is shared
-- between flavors, so the API needs a flavor guard (E2030 without it).
local function warbandGold(): number?
    if WOW_PROJECT_ID == WOW_PROJECT_MAINLINE then
        return C_Bank.FetchDepositedMoney(Enum.BankType.Account)
    end
    return nil
end

local frame = CreateFrame("Frame")
frame:RegisterEvent("PLAYER_LOGIN")
frame:RegisterEvent("PLAYER_MONEY")
frame:RegisterEvent("MERCHANT_SHOW")
frame:RegisterEvent("MERCHANT_CLOSED")
frame:RegisterEvent("LOOT_OPENED")
frame:RegisterEvent("LOOT_CLOSED")
frame:SetScript("OnEvent", function(_, event: string)
    if event == "PLAYER_LOGIN" then
        local db = TypedDemoDB ?? { sessions = 0 }
        db.sessions += 1
        TypedDemoDB = db
        ledger = Ledger.new(GetMoney(), KEEP)
        print(`Typed Demo: session {db.sessions}, {format(GetMoney())}. Type /tdemo.`)
        info(`session {db.sessions} started`)
        -- Every 30 seconds: the session's result so far, in the log (the
        -- dev window's Log tab; info messages stay out of the chat).
        C_Timer.NewTicker(30, function()
            if ledger then
                info(`net this session: {format(ledger.net)}`)
            end
        end)
    elseif event == "MERCHANT_SHOW" then
        source = Source.Vendor
    elseif event == "LOOT_OPENED" then
        source = Source.Loot
    elseif event == "MERCHANT_CLOSED" or event == "LOOT_CLOSED" then
        source = Source.Other
    elseif event == "PLAYER_MONEY" and ledger then
        local change = ledger:update(GetMoney(), GetTime(), source)
        if change then
            debug(`money changed by {change.amount} ({change.kind})`)
        end
    end
end)

-- Runtime checks (dev builds): a value from the WoW API that does not match
-- its declared type is caught where it enters a checked function.
@checked
local function greet(name: string)
    print(`Typed Demo: hello, {name}`)
end

_G.SLASH_TYPEDDEMO1 = "/tdemo"
SlashCmdList.TYPEDDEMO = function(message: string)
    if message == "check" then
        -- `UnitName` is nil without a target; the cast only asserts the type.
        greet(UnitName("target") :: string)
        return
    end
    if not ledger then
        print("Typed Demo: not loaded yet")
        return
    end
    print(ledger:summary())
    local bank = warbandGold()
    if bank then
        print(`warband bank: {format(bank)}`)
    end
end
