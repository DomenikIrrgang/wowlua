-- Core Demo: the core standard library in one addon, without third-party
-- libraries: events, saved variables, a settings page, a minimap button,
-- keybindings and addon messages. Type /coredemo.
import onLoad, onLogin, onLogout from "wowlua:lifecycle"
import event from "wowlua:events"
import slash, router from "wowlua:slash"
import * as saved from "wowlua:saved"
import after, throttle from "wowlua:timer"
import outOfCombat, onCombatChange, inCombat from "wowlua:combat"
import hook from "wowlua:hooks"
import print from "wowlua:log"
import binding, header from "wowlua:bindings"
import * as settings from "wowlua:settings"
import * as launcher from "wowlua:launcher"
import * as comm from "wowlua:comm"

interface Settings
    logins: number
    greet: boolean
    scale: number
    lastLogout?: string
    minimap: { hide?: boolean, minimapPos?: number }
end

local db = saved.bind("CoreDemoDB", {
    version = 1,
    defaults = { logins = 0, greet = true, scale = 1, minimap = {} } :: Settings,
    profiles = true,
})

local box: Frame? = nil

@onLoad
local function countLogin()
    db.logins += 1
end

@onLogin
local function greet()
    if db.greet then
        print(`login #{db.logins}, profile {saved.handle(db).profiles?:current()}. Type /coredemo for commands.`)
    end
    after(3, function() print("three seconds after login (wowlua:timer)") end)
end

@onLogout
local function goodbye()
    db.lastLogout = date("%Y-%m-%d %H:%M")
end

-- Fires often; @throttle keeps it to one line per second.
@event("PLAYER_TARGET_CHANGED")
@throttle(1)
local function targetChanged()
    print("target:", UnitName("target") or "none")
end

onCombatChange(function(entering: boolean)
    print(entering and "combat started" or "combat ended")
end)

-- Creating and showing frames waits for the end of combat.
@outOfCombat
local function showBox()
    if not box then
        local f = CreateFrame("Frame", nil, UIParent, "BackdropTemplate")
        f:SetSize(160, 40)
        f:SetPoint("CENTER", 0, 200)
        f:SetBackdrop({ bgFile = "Interface\\Buttons\\WHITE8X8" })
        f:SetBackdropColor(0.1, 0.1, 0.12, 0.85)
        local label = f:CreateFontString(nil, "OVERLAY", "GameFontNormal")
        label:SetPoint("CENTER")
        label:SetText("Core Demo")
        box = f
    end
    box:SetScale(db.scale)
    box:SetShown(not box:IsShown())
    print("box toggled (out of combat)")
end

-- A keybinding under the "Core Demo" header (the compiler generates Bindings.xml).
header("COREDEMO", "Core Demo")

@binding("COREDEMO_TOGGLE_BOX", { label = "Toggle the box", header = "COREDEMO" })
local function toggleBox()
    showBox()
end

-- Interface > AddOns > Core Demo: controls bound to the saved settings.
settings.register({
    title = "Core Demo",
    store = db,
    controls = {
        settings.header("Core Demo"),
        settings.checkbox("greet", { label = "Greet at login" }),
        settings.slider("scale", { label = "Box scale", min = 0.5, max = 2, step = 0.1 }),
        settings.keybinding("COREDEMO_TOGGLE_BOX", { label = "Toggle the box" }),
    },
})

-- A minimap button (or LibDBIcon's, when another addon loaded it) and an
-- Addon Compartment entry.
launcher.register({
    icon = "Interface\\Icons\\INV_Misc_QuestionMark",
    label = "Core Demo",
    onClick = function(button: string)
        if button == "RightButton" then
            settings.open()
        else
            showBox()
        end
    end,
    tooltip = function(tip: GameTooltip)
        tip:AddLine("Core Demo")
        tip:AddLine("Left click: toggle the box. Right click: settings.", 1, 1, 1)
    end,
    minimap = { store = db, key = "minimap" },
})

-- Addon messages: /coredemo ping asks the guild or group, every Core Demo
-- answers with its login count.
local channel = comm.open("CoreDemo")
channel:onMessage(function(msg: string, sender: string, distribution: string)
    if msg == "ping" then
        channel:send(`pong {db.logins}`, comm.Distribution.Whisper, sender)
    elseif msg:find("^pong") then
        print(`{sender} answered: {msg} ({distribution})`)
    end
end)

local function ping()
    local where = comm.Distribution.Guild
    if IsInGroup() then
        where = comm.Distribution.Group
    end
    channel:send("ping", where)
    print("ping sent")
end

@hook("ToggleGameMenu")
local function afterGameMenu()
    print("game menu toggled (wowlua:hooks)")
end

local commands = router({
    status = {
        help = "Show the saved data",
        run = function()
            local profiles = saved.handle(db).profiles
            print(`logins {db.logins}, scale {db.scale}, greet {db.greet}, profile {profiles?:current()}, in combat {inCombat()}`)
        end,
    },
    scale = {
        args = { "number" },
        help = "Set the box's scale",
        run = function(value: number)
            db.scale = value
            print("scale", value)
        end,
    },
    greet = {
        args = { "boolean" },
        help = "Greet at login (on/off)",
        run = function(enabled: boolean)
            db.greet = enabled
            print("greet", enabled)
        end,
    },
    profile = {
        args = { "string" },
        help = "Switch to (or create) a profile",
        run = function(name: string)
            saved.handle(db).profiles?:use(name)
            print("profile", name, "scale", db.scale)
        end,
    },
    box = { help = "Toggle the box (waits for the end of combat)", run = function() showBox() end },
    ping = { help = "Ask other Core Demo users in your guild or group", run = function() ping() end },
    options = { help = "Open the settings page", run = function() settings.open() end },
    reset = {
        help = "Reset this profile",
        run = function()
            saved.handle(db):reset()
            print("profile reset")
        end,
    },
})

@slash("/coredemo", "/cdemo")
local function command(msg: string)
    commands:dispatch(msg)
end
