-- Core Demo in the emulated client with Blizzard's UI (`test.blizzard-ui`).
import test, expect, beforeEach from "wowlua:test"
import * as mock from "wowlua:mock"

-- The chat lines since the test started.
local seen = 0
local function newLines(): string[]
    local all = mock.printed()
    local out: string[] = {}
    for i = seen + 1, #all do
        out[#out + 1] = all[i]
    end
    seen = #all
    return out
end

local function said(text: string): boolean
    for _, line in ipairs(newLines()) do
        if line:find(text, 1, true) then
            return true
        end
    end
    return false
end

@beforeEach
local function skipOldLines()
    newLines()
end

@test("greets at login with the login count")
local function greets()
    expect(mock.printed()).toContain("|cff33ff99CoreDemo|r: login #1, profile Default. Type /coredemo for commands.")
end

@test("speaks again three seconds after login")
local function afterThreeSeconds()
    mock.waitSeconds(3)
    expect(said("three seconds after login")).toBe(true)
end

@test("/coredemo status shows the saved data")
local function status()
    mock.slash("/coredemo status")
    expect(said("logins 1, scale 1, greet true, profile Default, in combat false")).toBe(true)
end

@test("/coredemo scale stores the scale")
local function scale()
    mock.slash("/coredemo scale 1.5")
    mock.slash("/coredemo status")
    expect(said("scale 1.5")).toBe(true)
end

@test("the box waits for the end of combat")
local function boxAfterCombat()
    mock.player:enterCombat()
    mock.slash("/coredemo box")
    expect(said("box toggled")).toBe(false)
    mock.player:leaveCombat()
    mock.nextFrame()
    expect(said("box toggled (out of combat)")).toBe(true)
end

@test("the key binding toggles the box")
local function binding()
    SetBinding("CTRL-B", "COREDEMO_TOGGLE_BOX")
    mock.pressKey("CTRL-B")
    expect(said("box toggled")).toBe(true)
end

@test("a new target is announced once a second at most")
local function targets()
    local hogger = mock.spawnUnit({ name = "Hogger", level = 11 })
    local murloc = mock.spawnUnit({ name = "Murloc", level = 5 })
    mock.player:target(hogger)
    mock.player:target(murloc)
    mock.waitSeconds(1.5)
    local lines = newLines()
    expect(lines).toContain("|cff33ff99CoreDemo|r: target: Hogger")
    expect(lines).toContain("|cff33ff99CoreDemo|r: target: Murloc")
    expect(#lines).toBe(2)
end

@test("profiles keep their own settings")
local function profiles()
    mock.slash("/coredemo scale 2")
    mock.slash("/coredemo profile Healer")
    expect(said("profile Healer scale 1")).toBe(true)
    mock.slash("/coredemo profile Default")
    expect(said("profile Default scale 2")).toBe(true)
end
