--- The Blizzard addons loaded: the client's startup set when StdTest loads.
local function blizzardLoaded(): string[]
    const out: string[] = {}
    if not (C_AddOns and C_AddOns.IsAddOnLoaded) then
        return out
    end
    for _, name in ipairs(BLIZZARD_ADDONS) do
        if C_AddOns.IsAddOnLoaded(name) then
            out[#out + 1] = name
        end
    end
    return out
end

-- Taken as StdTest loads (Blizzard's startup addons are loaded by then).
const LOADED_AT_START = blizzardLoaded()

