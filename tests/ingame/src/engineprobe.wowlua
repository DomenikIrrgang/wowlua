--- A value in full: tables to depth 4, keys sorted, secrets marked.
local function deep(v: any, depth: number): string
    if type(v) ~= "table" or issecretvalue(v) then
        return show(v)
    end
    if depth >= 4 then
        return "table"
    end
    const keys: string[] = {}
    const values: { [string]: any } = {}
    for k, inner in pairs(v :: table) do
        const key = tostring(k)
        keys[#keys + 1] = key
        values[key] = inner
    end
    table.sort(keys)
    const parts: string[] = {}
    for _, k in ipairs(keys) do
        parts[#parts + 1] = `{k}={deep(values[k], depth + 1)}`
    end
    return `\{{table.concat(parts, ",")}\}`
end

--- What each load-time call returns.
local function loadCalls(): { [string]: string }
    const out: { [string]: string } = {}
    for _, name in ipairs(LOAD_CALLS) do
        local f: any = G
        for part in name:gmatch("[^.]+") do
            f = type(f) == "table" and f[part] or nil
        end
        if type(f) ~= "function" then
            out[name] = "absent"
        else
            const packed = { pcall(f) }
            if not packed[1] then
                out[name] = `error: {tostring(packed[2])}`
            else
                const parts: string[] = {}
                for i = 2, select("#", unpack(packed)) do
                    parts[#parts + 1] = deep(packed[i], 1)
                end
                out[name] = `{#parts}: {table.concat(parts, ", ")}`
            end
        end
    end
    return out
end

--- Every `Enum` and `Constants` table the client has, field by field (the
--- documentation lacks some: `Enum.GameMode`, values of
--- `Constants.InventoryConstants`).
local function tables(root: any): { [string]: string }
    const out: { [string]: string } = {}
    if type(root) ~= "table" then
        return out
    end
    for name, t in pairs(root) do
        if type(t) == "table" then
            for field, value in pairs(t) do
                out[`{tostring(name)}.{tostring(field)}`] = show(value)
            end
        else
            out[tostring(name)] = show(t)
        end
    end
    return out
end

