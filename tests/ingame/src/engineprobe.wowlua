local function hidden(): { [string]: string }
    const out: { [string]: string } = {
        enumMetatable = type(getmetatable(G.Enum)),
        constantsMetatable = type(getmetatable(G.Constants)),
    }
    const lists: { root: string, names: string[] }[] = {
        { root = "Enum", names = HIDDEN_ENUMS },
        { root = "Constants", names = HIDDEN_CONSTANTS },
    }
    for _, list in ipairs(lists) do
        const root: any = G[list.root]
        for _, name in ipairs(list.names) do
            for _, n in ipairs({ name, `{name}Meta` }) do
                const t = type(root) == "table" and root[n] or nil
                out[`{list.root}.{n}`] = type(t)
                if type(t) == "table" then
                    for field, value in pairs(t) do
                        out[`{list.root}.{n}.{tostring(field)}`] = show(value)
                    end
                end
            end
        end
    end
    return out
end

--- `C_ColorOverrides.GetColorForQuality` for each item quality, as
--- Blizzard's ColorManager.lua calls it at load.
local function qualityColors(): { [string]: string }
    const out: { [string]: string } = {}
    const meta: any = G.Enum.ItemQualityMeta
    if not (G.C_ColorOverrides and meta) then
        return { absent = "C_ColorOverrides or Enum.ItemQualityMeta" }
    end
    for i = 0, meta.NumValues - 1 do
        local ok, c = pcall(G.C_ColorOverrides.GetColorForQuality, i)
        if not ok then
            out[tostring(i)] = `error: {tostring(c)}`
        elseif type(c) == "table" then
            out[tostring(i)] = `{show(c.r)}, {show(c.g)}, {show(c.b)}, {show(c.a)}`
        else
            out[tostring(i)] = show(c)
        end
    end
    return out
end

--- `GetInventorySlotInfo` for each slot name (Blizzard's TransmogShared
--- calls it at load).
local function slotInfo(): { [string]: string }
    const out: { [string]: string } = {}
    for _, name in ipairs({
        "AMMOSLOT", "HEADSLOT", "NECKSLOT", "SHOULDERSLOT", "SHIRTSLOT", "CHESTSLOT", "WAISTSLOT",
        "LEGSSLOT", "FEETSLOT", "WRISTSLOT", "HANDSSLOT", "FINGER0SLOT", "FINGER1SLOT",
        "TRINKET0SLOT", "TRINKET1SLOT", "BACKSLOT", "MAINHANDSLOT", "SECONDARYHANDSLOT",
        "RANGEDSLOT", "TABARDSLOT", "BAG0SLOT", "BAG1SLOT", "BAG2SLOT", "BAG3SLOT",
        "REAGENTBAG0SLOT", "NOSUCHSLOT",
    }) do
        out[name] = results(G.GetInventorySlotInfo, name)
    end
    return out
end

--- A frame Blizzard's secure code made (`StoreFrame`), from addon code:
--- whether it is forbidden, and the error a method gives.
local function forbidden(): { [string]: string }
    const f: any = G.StoreFrame
    if type(f) ~= "table" then
        return { absent = "StoreFrame" }
    end
    return {
        IsForbidden = results(function() return f:IsForbidden() end),
        GetObjectType = results(function() return f:GetObjectType() end),
        IsShown = results(function() return f:IsShown() end),
    }
end

--- The errors the client's Blizzard code raised this session, as
--- Blizzard's ScriptErrorsFrame keeps them (shown or not): message, count,
--- the stack's first lines.
local function blizzardErrors(): { [string]: string }
    const out: { [string]: string } = {}
    const frame: any = G.ScriptErrorsFrame
    if type(frame) ~= "table" or type(frame.errorData) ~= "table" then
        return { absent = "ScriptErrorsFrame.errorData" }
    end
    for i, e in ipairs(frame.errorData :: any[]) do
        if type(e) == "table" then
            const stack = tostring(e.stack or "")
            const lines: string[] = {}
            for line in stack:gmatch("[^\n]+") do
                if #lines < 4 then
                    lines[#lines + 1] = line
                end
            end
            out[tostring(i)] = `{tostring(e.count)}x {tostring(e.message):sub(1, 300)} | {table.concat(lines, " | ")}`
        end
    end
    out.total = tostring(#(frame.errorData :: any[]))
    return out
end

--- Every global number and boolean (`LE_*`: the client's own; others
--- Blizzard's code set).
local function scalars(): { [string]: string }
    const out: { [string]: string } = {}
    for name, v in pairs(G) do
        const t = type(v)
        if type(name) == "string" and (t == "number" or t == "boolean") then
            out[name] = show(v)
        end
    end
    return out
end

--- Every CVar the client has (`ConsoleGetAllCommands`, as Blizzard's
--- console lists them) and its default; other commands by type, counted.
local function allCVars(): { [string]: string }
    const out: { [string]: string } = {}
    if not (G.ConsoleGetAllCommands and C_CVar and C_CVar.GetCVarDefault) then
        return { absent = "ConsoleGetAllCommands or C_CVar.GetCVarDefault" }
    end
    local ok, commands = pcall(G.ConsoleGetAllCommands)
    if not ok or type(commands) ~= "table" then
        return { error = tostring(commands) }
    end
    const cvarType = G.Enum.ConsoleCommandType and G.Enum.ConsoleCommandType.Cvar
    const counts: { [string]: number } = {}
    for _, info in ipairs(commands :: any[]) do
        const t = tostring(info.commandType)
        counts[t] = (counts[t] or 0) + 1
        if info.commandType == cvarType and type(info.command) == "string" then
            out[info.command] = results(C_CVar.GetCVarDefault, info.command)
        end
    end
    for t, n in pairs(counts) do
        out[`#type {t}`] = tostring(n)
    end
    return out
end

--- The CVars `C_CVar.GetCVarInfo` flags (secure: addons may not set them;
--- read-only; locked from the user), by name, sorted.
local function cvarFlags(): { [string]: string }
    if not (G.ConsoleGetAllCommands and C_CVar and C_CVar.GetCVarInfo) then
        return { absent = "ConsoleGetAllCommands or C_CVar.GetCVarInfo" }
    end
    const cvarType = G.Enum.ConsoleCommandType and G.Enum.ConsoleCommandType.Cvar
    const lists: { [string]: string[] } = { secure = {}, readOnly = {}, locked = {} }
    for _, info in ipairs(G.ConsoleGetAllCommands() :: any[]) do
        if info.commandType == cvarType and type(info.command) == "string" then
            local ok, _, _, _, _, locked, secure, readOnly = pcall(C_CVar.GetCVarInfo, info.command)
            if ok then
                if secure then
                    table.insert(lists.secure, info.command)
                end
                if readOnly then
                    table.insert(lists.readOnly, info.command)
                end
                if locked then
                    table.insert(lists.locked, info.command)
                end
            end
        end
    end
    const out: { [string]: string } = {}
    for name, list in pairs(lists) do
        table.sort(list)
        out[name] = table.concat(list, " ")
    end
    out["GetCVarInfo(SoftTargetEnemy)"] = results(C_CVar.GetCVarInfo, "SoftTargetEnemy")
    return out
end

--- Font heights as the client reports them after `SetFont` (it snaps
--- some heights: XML 13 reads back 12), per font file, on a font object
--- (`GetFont`, `GetFontInfo`) and a font string; and how Lua-set colors
--- read back (eight bits each, as XML's?).
local function fontHeights(): { [string]: string }
    const out: { [string]: string } = {}
    const font = G.StdTestProbeFont ?? CreateFont("StdTestProbeFont")
    const holder = CreateFrame("Frame", nil, UIParent)
    const fs = holder:CreateFontString()
    for _, file in ipairs({ "Fonts\\FRIZQT__.TTF", "Fonts\\ARIALN.TTF", "Fonts\\MORPHEUS.TTF", "Fonts\\SKURRI.TTF" }) do
        const parts: string[] = {}
        for h = 1, 80 do
            font:SetFont(file, h, "")
            local _, got = font:GetFont()
            const info = G.GetFontInfo and G.GetFontInfo(font)
            fs:SetFont(file, h, "")
            local _, inString = fs:GetFont()
            parts[#parts + 1] = `{h}={tostring(got)}/{tostring(info and info.height)}/{tostring(inString)}`
        end
        out[file] = table.concat(parts, " ")
    end
    font:SetFont("Fonts\\FRIZQT__.TTF", 13.5, "OUTLINE")
    out["13.5 OUTLINE"] = results(font.GetFont, font)
    font:SetTextColor(0.82, 0.5, 0.123, 0.3)
    out["font SetTextColor(0.82, 0.5, 0.123, 0.3)"] = results(font.GetTextColor, font)
    fs:SetTextColor(0.82, 0.5, 0.123, 0.3)
    out["fontstring SetTextColor(0.82, 0.5, 0.123, 0.3)"] = results(fs.GetTextColor, fs)
    const tex = holder:CreateTexture()
    tex:SetVertexColor(0.82, 0.5, 0.123, 0.3)
    out["texture SetVertexColor(0.82, 0.5, 0.123, 0.3)"] = results(tex.GetVertexColor, tex)
    font:SetShadowColor(0.82, 0.5, 0.123, 0.3)
    out["font SetShadowColor(0.82, 0.5, 0.123, 0.3)"] = results(font.GetShadowColor, font)
    const fresh = G.StdTestProbeFontFresh ?? CreateFont("StdTestProbeFontFresh")
    out["fresh font GetTextColor"] = results(fresh.GetTextColor, fresh)
    holder:Hide()
    return out
end

--- Each CVar's default (`C_CVar.GetCVarDefault`; not the player's value).
local function cvarDefaults(): { [string]: string }
    const out: { [string]: string } = {}
    if not (C_CVar and C_CVar.GetCVarDefault) then
        return { absent = "C_CVar.GetCVarDefault" }
    end
    for _, name in ipairs(CVARS) do
        out[name] = results(C_CVar.GetCVarDefault, name)
    end
    return out
end

local function units(): { [string]: string }
    const out: { [string]: string } = {}
    for _, call in ipairs({
        { "UnitName", "player" }, { "UnitGUID", "player" }, { "UnitClass", "player" },
        { "UnitLevel", "player" }, { "UnitRace", "player" }, { "UnitSex", "player" },
        { "UnitPowerType", "player" }, { "UnitExists", "target" }, { "UnitExists", "targettarget" },
        { "UnitExists", "nameplate1" }, { "UnitExists", "none" }, { "UnitName", "none" },
        { "UnitIsUnit", "player", "player" }, { "UnitReaction", "player", "player" },
        { "UnitCanAttack", "player", "player" }, { "UnitInParty", "player" },
        { "UnitInRaid", "player" }, { "UnitIsPlayer", "player" }, { "UnitAffectingCombat", "player" },
        { "GetNumGroupMembers" }, { "IsInGroup" }, { "IsInRaid" }, { "InCombatLockdown" },
        { "UnitName", "PLAYER" }, { "UnitExists", "Player" }, { "UnitHealth", "player" },
    }) do
        const f = G[call[1]]
        out[`{call[1]}({table.concat({ select(2, unpack(call)) }, ", ")})`] = f and results(f, select(2, unpack(call))) or "absent"
    end
    return out
end

local function timers(done: (r: { [string]: string }) -> ())
    const out: { [string]: string } = {}
    const t = C_Timer.NewTimer(100, function() end)
    out["type(NewTimer)"] = type(t)
    out["NewTimer[0]"] = type(type(t) == "table" and (t :: any)[0] or nil)
    local methods: string[] = {}
    const meta = getmetatable(t)
    if type(meta) == "table" and type(rawget(meta, "__index")) == "table" then
        for name in pairs(rawget(meta, "__index")) do
            methods[#methods + 1] = tostring(name)
        end
    end
    table.sort(methods)
    out["NewTimer methods"] = table.concat(methods, " ")
    out["IsCancelled before"] = results(t.IsCancelled, t)
    t:Cancel()
    out["IsCancelled after"] = results(t.IsCancelled, t)
    out["After returns"] = results(C_Timer.After, 100, function() end)
    -- Timers against OnUpdate within frames.
    const log: string[] = {}
    -- An edit box's `OnTextChanged` for `SetText` (when, how often, for the
    -- same text), against `OnUpdate`, timers and `OnSizeChanged`.
    const text: string[] = {}
    const box = CreateFrame("EditBox")
    box:SetAutoFocus(false)
    box:SetScript("OnTextChanged", function(self: any, userInput: any)
        text[#text + 1] = `changed({tostring(userInput)}, {self:GetText()})`
    end)
    const fresh = CreateFrame("EditBox")
    fresh:SetAutoFocus(false)
    fresh:SetScript("OnTextChanged", function(self: any, userInput: any)
        text[#text + 1] = `fresh({tostring(userInput)}, {self:GetText()})`
    end)
    const sized = CreateFrame("Frame", nil, UIParent)
    sized:SetScript("OnSizeChanged", function(_: any, w: number, h: number)
        text[#text + 1] = `size({w}x{h})`
    end)
    box:SetText("a")
    text[#text + 1] = "set a"
    box:SetText("a")
    text[#text + 1] = "set a again"
    box:SetText("b")
    text[#text + 1] = "set b"
    fresh:SetText("")
    text[#text + 1] = "fresh set empty"
    sized:SetSize(10, 10)
    -- An anchored frame's `OnSizeChanged`: when, against the same marks.
    const sizes: string[] = {}
    const anchored = CreateFrame("Frame", nil, UIParent)
    anchored:SetPoint("CENTER")
    anchored:SetScript("OnSizeChanged", function(_: any, w: number, h: number)
        sizes[#sizes + 1] = `size({w}x{h})`
    end)
    anchored:SetSize(12, 14)
    sizes[#sizes + 1] = "set 12x14"
    const f = CreateFrame("Frame")
    local frames = 0
    f:SetScript("OnUpdate", function()
        frames += 1
        log[#log + 1] = `update{frames}`
        text[#text + 1] = `update{frames}`
        sizes[#sizes + 1] = `update{frames}`
        if frames == 2 then
            anchored:SetSize(16, 18)
            sizes[#sizes + 1] = "set 16x18 (in update2)"
        end
        if frames == 1 then
            C_Timer.After(0, function() log[#log + 1] = "after0 (set in update1)" end)
            box:SetText("b")
            text[#text + 1] = "set b (same, in update1)"
        end
        if frames == 2 then
            box:SetText("c")
            box:SetText("b")
            text[#text + 1] = "set c then b (in update2)"
        end
        if frames >= 4 then
            f:SetScript("OnUpdate", nil)
            out.order = table.concat(log, " ")
            out.textChanged = table.concat(text, " ")
            out.sizeChanged = table.concat(sizes, " ")
            done(out)
        end
    end)
    C_Timer.After(0, function()
        log[#log + 1] = "after0"
        text[#text + 1] = "after0"
        sizes[#sizes + 1] = "after0"
    end)
end


-- Dispatch order: frames made A, B, C, D; registered C, A, D, B.
local function dispatchOrder()
    const st = state() :: any
    const seen: string[] = {}
    const made: { [string]: any } = {}
    for _, name in ipairs({ "A", "B", "C", "D" }) do
        made[name] = CreateFrame("Frame")
        made[name]:SetScript("OnEvent", function()
            seen[#seen + 1] = name
            if #seen == 4 then
                st.engineOrder = { registered = "C A D B", made = "A B C D", reached = table.concat(seen, " ") }
                stamp("order")
                for _, f in pairs(made) do
                    f:UnregisterAllEvents()
                end
                say(`engine order: {table.concat(seen, " ")}; type /reload`)
            end
        end)
    end
    for _, name in ipairs({ "C", "A", "D", "B" }) do
        made[name]:RegisterEvent("MODIFIER_STATE_CHANGED")
    end
    say("engine order: press and release Shift once")
end

--- A payload value for the recorder: a table as its keys (and a list's
--- first element's) down to `max` levels, else as `show` gives it.
local function describe(v: any, depth: number, max: number): string
    if type(v) ~= "table" or issecretvalue(v) or depth > max then
        return show(v)
    end
    const keys: string[] = {}
    for k, inner in pairs(v :: table) do
        if type(k) == "string" then
            keys[#keys + 1] = `{k}={describe(inner, depth + 1, max)}`
        end
    end
    table.sort(keys)
    const n = #(v :: any[])
    if n > 0 then
        keys[#keys + 1] = `[{n}]={describe((v :: any[])[1], depth + 1, max)}`
    end
    return `\{{table.concat(keys, ",")}\}`
end

local recorder: any = nil
local recording: { [string]: any }? = nil

local function startRecording(label: string)
    const st = state() :: any
    st.engineRecords = st.engineRecords ?? {}
    const log: string[] = {}
    const start = GetTime()
    recording = { label = label, log = log }
    st.engineRecords[label] = log
    recorder = recorder ?? CreateFrame("Frame")
    recorder:SetScript("OnEvent", function(_, event: string, ...: any)
        if #log >= 3000 or event == "COMBAT_LOG_EVENT_UNFILTERED" then
            return
        end
        const parts: string[] = {}
        -- An aura update's aura data in full (its fields are three deep).
        const max = event == "UNIT_AURA" and 3 or 2
        for i = 1, select("#", ...) do
            parts[#parts + 1] = describe((select(i, ...)), 1, max)
        end
        log[#log + 1] = `{string.format("%.3f", GetTime() - start)} {event}({table.concat(parts, "; ")})`
    end)
    recorder:RegisterAllEvents()
    say(`engine record "{label}": recording every event; /stdtest engine stop when done`)
end

--- `/stdtest engine input`: the scripts a user's input runs, in order: a
--- button to hover and click (with and without Shift), an edit box to
--- click, type "ab" into and press Enter in, a slider to drag, click and
--- wheel (the global mouse events among them); the log fills as you go, then
--- /reload writes it (StdTestState.engineInput).
local function inputProbe()
    const st = state() :: any
    const log: string[] = {}
    st.engineInput = log
    stamp("input")
    const start = GetTime()
    local function note(what: string)
        if #log < 500 then
            log[#log + 1] = `{string.format("%.3f", GetTime() - start)} {what}`
        end
    end
    const b = G.StdTestInputButton or CreateFrame("Button", "StdTestInputButton", UIParent, "UIPanelButtonTemplate")
    b:SetSize(160, 28)
    b:SetPoint("CENTER", 0, 60)
    b:SetText("StdTest: click me")
    b:RegisterForClicks("AnyUp")
    b:Show()
    for _, script in ipairs({ "OnEnter", "OnLeave", "OnMouseDown", "OnMouseUp", "PreClick", "OnClick", "PostClick" }) do
        b:SetScript(script, function(_: any, ...: any)
            const args: string[] = {}
            for i = 1, select("#", ...) do
                args[#args + 1] = tostring((select(i, ...)))
            end
            note(`button {script}({table.concat(args, ", ")}) shift={tostring(IsShiftKeyDown())}`)
        end)
    end
    const e = G.StdTestInputBox or CreateFrame("EditBox", "StdTestInputBox", UIParent, "InputBoxTemplate")
    e:SetSize(160, 24)
    e:SetPoint("CENTER", 0, 20)
    e:SetAutoFocus(false)
    e:SetText("")
    e:Show()
    for _, script in ipairs({ "OnEditFocusGained", "OnEditFocusLost", "OnChar", "OnTextChanged", "OnEnterPressed", "OnEscapePressed", "OnTabPressed" }) do
        e:SetScript(script, function(self: any, ...: any)
            const args: string[] = {}
            for i = 1, select("#", ...) do
                args[#args + 1] = tostring((select(i, ...)))
            end
            note(`box {script}({table.concat(args, ", ")}) text={self:GetText()} focus={tostring(self:HasFocus())}`)
            if script == "OnEnterPressed" or script == "OnEscapePressed" then
                self:ClearFocus()
            end
        end)
    end
    -- A slider to drag and wheel: whether a drag is user input, and
    -- whether it snaps to the step (0 to 10, step 2).
    const sl = G.StdTestInputSlider or CreateFrame("Slider", "StdTestInputSlider", UIParent, "UISliderTemplate")
    sl:SetSize(200, 17)
    sl:SetPoint("CENTER", 0, -20)
    sl:SetMinMaxValues(0, 10)
    sl:SetValueStep(2)
    sl:SetValue(0)
    sl:EnableMouseWheel(true)
    sl:Show()
    for _, script in ipairs({ "OnMouseDown", "OnMouseUp", "OnValueChanged", "OnMouseWheel" }) do
        sl:SetScript(script, function(self: any, ...: any)
            const args: string[] = {}
            for i = 1, select("#", ...) do
                args[#args + 1] = tostring((select(i, ...)))
            end
            note(`slider {script}({table.concat(args, ", ")}) value={tostring(self:GetValue())} dragging={tostring(self:IsDraggingThumb())}`)
        end)
    end
    const m = CreateFrame("Frame")
    m:RegisterEvent("MODIFIER_STATE_CHANGED")
    m:RegisterEvent("GLOBAL_MOUSE_DOWN")
    m:RegisterEvent("GLOBAL_MOUSE_UP")
    m:SetScript("OnEvent", function(_: any, event: string, key: string, down: number)
        note(`{event}({key}, {tostring(down)})`)
    end)
    say("engine input: hover the button, click it, Shift-click it, click the box, type ab, press Enter; drag the slider's thumb right and back, click the slider's bar, wheel over it up and down; then /reload")
end

local function stopRecording()
    if recorder then
        recorder:UnregisterAllEvents()
    end
    const n = recording and #recording.log or 0
    say(`engine record: stopped ({n} events); type /reload so the file is written`)
    recording = nil
end

--- The ADDON_ACTION_* events while `run` runs, and after it returned.
local function watchActions(run: (note: (label: string) -> ()) -> ()): string[]
    const log: string[] = {}
    local current = "(after)"
    const w = CreateFrame("Frame")
    w:RegisterEvent("ADDON_ACTION_FORBIDDEN")
    w:RegisterEvent("ADDON_ACTION_BLOCKED")
    w:SetScript("OnEvent", function(_, event: string, ...: any)
        const parts: string[] = {}
        for i = 1, select("#", ...) do
            parts[#parts + 1] = show((select(i, ...)))
        end
        log[#log + 1] = `{current}: {event}({table.concat(parts, "; ")})`
    end)
    run(function(label: string) current = label end)
    current = "(after)"
    C_Timer.After(0.5, function() w:UnregisterAllEvents() end)
    return log
end

-- Protected functions from addon code, out of combat: only harmless ones
-- (targeting yourself, stopping what is not running).
local function protectedProbe()
    const st = state() :: any
    const out: { [string]: string } = {}
    const calls: any[] = {
        { "TargetUnit", "player" }, { "TargetUnit", {} }, { "TargetUnit" }, { "ClearTarget" },
        { "FocusUnit", "player" }, { "ClearFocus" }, { "TargetLastTarget" }, { "AssistUnit", "player" },
        { "SpellStopCasting" }, { "SpellStopTargeting" }, { "CastSpellByName", "StdTestNoSuchSpell" },
        { "MoveForwardStop" }, { "TurnLeftStop" }, { "StrafeLeftStop" }, { "StopAttack" }, { "PetFollow" },
        { "UnitName", "player" },
    }
    const log = watchActions(function(note: (label: string) -> ())
        for i, call in ipairs(calls) do
            const name = call[1] :: string
            const f = G[name]
            const label = `{i} {name}`
            note(label)
            out[label] = f and results(f, select(2, unpack(call))) or "absent"
        end
        note("(targets)")
        out["target after"] = `{tostring(UnitExists("target"))} {tostring(UnitIsUnit("target", "player"))}`
        out["focus after"] = tostring(UnitExists("focus"))
    end)
    st.engineProtected = { calls = out, events = log }
    stamp("protected")
    C_Timer.After(0.6, function()
        say(`engine protected: {#log} events; type /reload so the file is written`)
    end)
end

-- Protected frames in combat: named and anonymous secure buttons, a plain
-- one; called from addon code half a second after combat starts.
local function blockedProbe()
    const st = state() :: any
    const named = CreateFrame("Button", "StdTestSecureButton", UIParent, "SecureActionButtonTemplate")
    const anon = CreateFrame("Button", nil, UIParent, "SecureActionButtonTemplate")
    const plain = CreateFrame("Button", nil, UIParent)
    const before = {
        ["named IsProtected"] = results(named.IsProtected, named),
        ["anon IsProtected"] = results(anon.IsProtected, anon),
        ["plain IsProtected"] = results(plain.IsProtected, plain),
    }
    const arm = CreateFrame("Frame")
    arm:RegisterEvent("PLAYER_REGEN_DISABLED")
    arm:SetScript("OnEvent", function()
        arm:UnregisterAllEvents()
        const atEvent = tostring(InCombatLockdown())
        C_Timer.After(0.5, function()
            const out: { [string]: string } = { ["InCombatLockdown at the event"] = atEvent }
            for k, v in pairs(before) do
                out[k] = v
            end
            const log = watchActions(function(note: (label: string) -> ())
                out.InCombatLockdown = tostring(InCombatLockdown())
                note("named:Hide")
                out["named:Hide()"] = results(named.Hide, named)
                out["named shown after"] = tostring(named:IsShown())
                note("anon:SetPoint")
                out["anon:SetPoint('CENTER')"] = results(anon.SetPoint, anon, "CENTER")
                out["anon points after"] = tostring(anon:GetNumPoints())
                note("named:SetAlpha")
                out["named:SetAlpha(0.5)"] = results(function() named:SetAlpha(0.5) return named:GetAlpha() end)
                note("named:SetAttribute")
                out["named:SetAttribute('type', 'macro')"] = results(named.SetAttribute, named, "type", "macro")
                note("named:SetScale")
                out["named:SetScale('x')"] = results(named.SetScale, named, "x")
                note("plain:Hide")
                out["plain:Hide()"] = results(plain.Hide, plain)
                out["plain shown after"] = tostring(plain:IsShown())
            end)
            st.engineBlocked = { calls = out, events = log }
            stamp("blocked")
            C_Timer.After(0.6, function()
                say(`engine blocked: {#log} events; leave combat and type /reload`)
            end)
        end)
    end)
    say("engine blocked: armed; enter combat (attack a training dummy or a mob)")
end

-- Addon messages: prefixes, send results, and when a whisper to yourself
-- arrives (only to yourself; the guild only when not in one).
local function commProbe()
    const st = state() :: any
    const out: { [string]: string } = {}
    const arrivals: string[] = {}
    const sentAt: { [string]: number } = {}
    const listener = CreateFrame("Frame")
    listener:RegisterEvent("CHAT_MSG_ADDON")
    listener:SetScript("OnEvent", function(_, _, prefix: string, msg: string, channel: string, sender: string, target: string, ...: any)
        const extra: string[] = {}
        for i = 1, select("#", ...) do
            extra[#extra + 1] = show((select(i, ...)))
        end
        const at = sentAt[msg]
        const delay = at and string.format("%.3f", GetTime() - at) or "?"
        const own = UnitName("player") :: any
        const who = (sender == own and "first name") or (sender:find("-") and "name-realm") or (sender:find(" ") and "first and last name") or "other"
        arrivals[#arrivals + 1] = `{prefix} {msg} {channel} sender={who} target={target == own and "name" or target} after={delay}s rest={table.concat(extra, ";")}`
    end)
    const reg = C_ChatInfo.RegisterAddonMessagePrefix
    out["register StdTestA"] = results(reg, "StdTestA")
    out["register StdTestA again"] = results(reg, "StdTestA")
    out["register 16 chars"] = results(reg, "StdTest123456789")
    out["register 17 chars"] = results(reg, "StdTest1234567890")
    out["register empty"] = results(reg, "")
    out["registered StdTestA"] = results(C_ChatInfo.IsAddonMessagePrefixRegistered, "StdTestA")
    out["registered never"] = results(C_ChatInfo.IsAddonMessagePrefixRegistered, "StdTestNever")
    const me = (UnitName("player")) :: any
    const send = C_ChatInfo.SendAddonMessage
    local n = 0
    local function sendTimed(label: string, ...: any)
        n += 1
        sentAt[`m{n}`] = GetTime()
        out[label] = results(send, ...)
    end
    -- WoW Forever's characters have a first and a last name: which target
    -- reaches yourself.
    local first: any, second: any = UnitName("player")
    local fullName: any, fullRealm: any = UnitFullName("player")
    const realm: any = GetNormalizedRealmName and GetNormalizedRealmName() or fullRealm
    out["UnitName(player) values"] = tostring(select("#", UnitName("player")))
    out["UnitFullName(player) realm is set"] = tostring(fullRealm ~= nil and fullRealm ~= "")
    out["GetNormalizedRealmName is set"] = tostring(realm ~= nil and realm ~= "")
    out["UnitName second value is the realm"] = tostring(second ~= nil and second == fullRealm)
    sendTimed("WHISPER first name", "StdTestA", "m1", "WHISPER", first)
    sendTimed("WHISPER first name, unregistered prefix", "StdTestNever", "m2", "WHISPER", first)
    sendTimed("WHISPER name-realm", "StdTestA", "m3", "WHISPER", `{fullName}-{realm}`)
    if second then
        sendTimed("WHISPER first and last name", "StdTestA", "m4", "WHISPER", `{first} {second}`)
    end
    out["WHISPER no target"] = results(send, "StdTestA", "x", "WHISPER")
    for _, size in ipairs({ 255, 256, 1000, 4000, 4096, 4097, 8192 }) do
        out[`message {size} bytes`] = results(send, "StdTestA", string.rep("x", size), "WHISPER", me)
    end
    out["message with \\0"] = results(send, "StdTestA", "a\0b", "WHISPER", me)
    out["prefix 17 chars"] = results(send, "StdTest1234567890", "x", "WHISPER", me)
    out["chat type NOPE"] = results(send, "StdTestA", "x", "NOPE")
    out["chat type SAY"] = results(send, "StdTestA", "x", "SAY")
    if not IsInGroup() then
        out["PARTY not in a group"] = results(send, "StdTestA", "x", "PARTY")
        out["RAID not in a group"] = results(send, "StdTestA", "x", "RAID")
        out["no chat type, not in a group"] = results(send, "StdTestA", "x")
    end
    if not IsInGuild() then
        out["GUILD not in a guild"] = results(send, "StdTestA", "x", "GUILD")
    end
    out["lockdown"] = results(C_ChatInfo.InChatMessagingLockdown)
    out["prefixes"] = tostring(#(C_ChatInfo.GetRegisteredAddonMessagePrefixes() or {}))
    C_Timer.After(2, function()
        listener:UnregisterAllEvents()
        st.engineComm = { calls = out, arrivals = arrivals }
        say(`engine comm: {#arrivals} messages arrived; type /reload so the file is written`)
    end)
    say("engine comm: probing (two seconds)...")
end

--- Sizes the layout gives: regions sized only by their points
--- (`SetAllPoints`, two corners), and points overriding a set size.
local function layoutSizes(): { [string]: string }
    const parent = CreateFrame("Frame", nil, UIParent)
    parent:SetSize(300, 200)
    parent:SetPoint("CENTER")
    const all = parent:CreateTexture()
    all:SetAllPoints()
    const corners = CreateFrame("Frame", nil, parent)
    corners:SetPoint("TOPLEFT", 10, -10)
    corners:SetPoint("BOTTOMRIGHT", -20, 30)
    const both = CreateFrame("Frame", nil, parent)
    both:SetSize(50, 50)
    both:SetPoint("TOPLEFT")
    both:SetPoint("BOTTOMRIGHT")
    const out: { [string]: string } = {}
    for name, r in pairs({ all = all, corners = corners, both = both } :: { [string]: any }) do
        local w, h = r:GetSize()
        out[name] = `{w} {h} {r:GetWidth()} {r:GetHeight()}`
    end
    parent:Hide()
    return out
end

--- The merchant API's answers now (`/stdtest engine merchant`, at a vendor
--- with the window open, and once away from one), into
--- StdTestState.engineMerchant[open | closed].
local function merchantProbe()
    const st = state() :: any
    const out: { [string]: string } = {}
    -- Results with tables in full.
    local function full(f: any, ...: any): string
        const packed = { pcall(f, ...) }
        if not packed[1] then
            return `error: {tostring(packed[2])}`
        end
        const parts: string[] = {}
        for k = 2, select("#", unpack(packed)) do
            parts[#parts + 1] = deep(packed[k], 0)
        end
        return `{#parts}: {table.concat(parts, ", ")}`
    end
    const M = G.C_MerchantFrame
    const n = (GetMerchantNumItems() :: any) ?? 0
    out.GetMerchantNumItems = full(GetMerchantNumItems)
    for i = 1, math.min(n, 8) do
        out[`C_MerchantFrame.GetItemInfo({i})`] = full(M.GetItemInfo, i)
        out[`GetMerchantItemLink({i})`] = full(G.GetMerchantItemLink, i)
        out[`GetMerchantItemID({i})`] = full(G.GetMerchantItemID, i)
        out[`GetMerchantItemMaxStack({i})`] = full(G.GetMerchantItemMaxStack, i)
        out[`GetMerchantItemCostInfo({i})`] = full(G.GetMerchantItemCostInfo, i)
        out[`CanAffordMerchantItem({i})`] = full(G.CanAffordMerchantItem, i)
        out[`C_MerchantFrame.IsMerchantItemRefundable({i})`] = full(M.IsMerchantItemRefundable, i)
    end
    out["GetMerchantItemLink(999)"] = full(G.GetMerchantItemLink, 999)
    out["C_MerchantFrame.GetItemInfo(999)"] = full(M.GetItemInfo, 999)
    const buyback = (G.GetNumBuybackItems() :: any) ?? 0
    out.GetNumBuybackItems = full(G.GetNumBuybackItems)
    for i = 1, math.min(buyback, 3) do
        out[`GetBuybackItemInfo({i})`] = full(G.GetBuybackItemInfo, i)
        out[`GetBuybackItemLink({i})`] = full(G.GetBuybackItemLink, i)
        out[`C_MerchantFrame.GetBuybackItemID({i})`] = full(M.GetBuybackItemID, i)
    end
    for _, name in ipairs({ "CanMerchantRepair", "GetRepairAllCost", "CanGuildBankRepair", "InRepairMode", "GetMerchantFilter" }) do
        out[name] = full(G[name])
    end
    out["C_MerchantFrame.GetNumJunkItems"] = full(M.GetNumJunkItems)
    out["C_MerchantFrame.IsSellAllJunkEnabled"] = full(M.IsSellAllJunkEnabled)
    out["C_MerchantFrame.GetMerchantCurrencies"] = full(M.GetMerchantCurrencies)
    out["UnitExists(npc)"] = full(UnitExists, "npc")
    out["UnitName(npc)"] = full(UnitName, "npc")
    out["MerchantFrame:IsShown()"] = tostring(G.MerchantFrame and G.MerchantFrame:IsShown())
    st.engineMerchant = st.engineMerchant ?? {}
    const which = n > 0 and "open" or "closed"
    st.engineMerchant[which] = out
    say(`engine merchant: recorded ({which}); type /reload so the file is written`)
end

--- The soft target tokens now (`/stdtest engine soft`, with a soft target
--- shown), into StdTestState.engineSoft.
local function softProbe()
    const st = state() :: any
    const out: { [string]: string } = {}
    for _, unit in ipairs({ "softenemy", "softfriend", "softinteract", "target", "mouseover" }) do
        out[`UnitExists({unit})`] = results(UnitExists, unit)
        out[`UnitName({unit})`] = results(UnitName, unit)
        out[`UnitIsUnit({unit}, target)`] = results(UnitIsUnit, unit, "target")
        out[`UnitCanAttack(player, {unit})`] = results(UnitCanAttack, "player", unit)
    end
    for _, cvar in ipairs({ "SoftTargetEnemy", "SoftTargetFriend", "SoftTargetInteract", "SoftTargetForce", "SoftTargetMatchLocked" }) do
        out[`GetCVar({cvar})`] = results(GetCVar, cvar)
    end
    st.engineSoft = out
    say("engine soft: recorded; type /reload so the file is written")
end

--- When a hidden edit box's `SetText` gets its `OnTextChanged`
--- (`/stdtest engine textchange`): set while its parent is hidden, frames
--- pass, the parent shows, frames pass; into StdTestState.engineTextChange.
local function textChangeProbe()
    const st = state() :: any
    const log: string[] = {}
    const parent = CreateFrame("Frame", nil, UIParent)
    parent:Hide()
    const box = CreateFrame("EditBox", nil, parent)
    box:SetAutoFocus(false)
    box:SetScript("OnTextChanged", function(self: any, userInput: any)
        log[#log + 1] = `changed({tostring(userInput)}, {self:GetText()}, visible {tostring(self:IsVisible())})`
    end)
    box:SetText("hidden")
    log[#log + 1] = "set while hidden"
    local frames = 0
    const ticker = CreateFrame("Frame")
    ticker:SetScript("OnUpdate", function()
        frames += 1
        log[#log + 1] = `update{frames}`
        if frames == 3 then
            parent:Show()
            log[#log + 1] = "parent shown"
        elseif frames == 6 then
            parent:Hide()
            box:SetText("")
            log[#log + 1] = "hidden, set empty"
            parent:Show()
            log[#log + 1] = "shown again in the same frame"
        elseif frames == 9 then
            ticker:SetScript("OnUpdate", nil)
            st.engineTextChange = table.concat(log, " | ")
            say("engine textchange: recorded; type /reload so the file is written")
        end
    end)
end

--- `/stdtest engine keys`: which frames a key reaches and whether its
--- binding still runs. Keyboard frames at two stratas, all passing keys on,
--- and an override binding of J that clicks a button; you press J,
--- Shift-J, J, J as asked (each step moves on 1.5 s after its J). In the
--- third step the top frame keeps that one J (it stops propagation in its
--- handler); in the fourth a keyboard frame without a key script, passing
--- nothing on, is shown. Ends after the fourth J or in 60 seconds, the
--- binding cleared.
--- (A first version recorded a frame that keeps every key: key down goes
--- to each keyboard frame, top first, until one that does not pass it on,
--- its binding not run; key up only to that frame.) Into
--- StdTestState.engineKeys.
local function keysProbe()
    const st = state() :: any
    const log: string[] = {}
    st.engineKeys = log
    stamp("keys")
    local phase = 1
    local finished = false
    local waiting = false
    local function note(what: string)
        if #log < 400 then
            log[#log + 1] = `p{phase} {what}`
        end
    end
    const owner = CreateFrame("Frame")
    const target = G.StdTestKeyTarget or CreateFrame("Button", "StdTestKeyTarget", UIParent)
    target:RegisterForClicks("AnyDown", "AnyUp")
    target:SetScript("OnClick", function(_: any, button: string, down: any)
        note(`binding click {button} down={tostring(down)}`)
    end)
    SetOverrideBindingClick(owner, true, "J", "StdTestKeyTarget")
    const frames: any[] = {}
    local function keyFrame(name: string, strata: FrameStrata, level: number): any
        const f = CreateFrame("Frame", nil, UIParent)
        f:SetFrameStrata(strata)
        f:SetFrameLevel(level)
        f:SetSize(10, 10)
        f:SetPoint("TOPLEFT")
        f:EnableKeyboard(true)
        f:SetPropagateKeyboardInput(true)
        f:SetScript("OnKeyDown", function(self: any, key: string)
            if phase == 3 and name == "top" and key == "J" then
                self:SetPropagateKeyboardInput(false)
            end
            note(`{name} down {key} shift={tostring(IsShiftKeyDown())} propagate={tostring(self:GetPropagateKeyboardInput())}`)
        end)
        f:SetScript("OnKeyUp", function(_: any, key: string)
            note(`{name} up {key}`)
        end)
        frames[#frames + 1] = f
        return f
    end
    const top = keyFrame("top", "DIALOG", 5)
    keyFrame("high", "HIGH", 10)
    -- A keyboard frame that keeps keys but has no key script (as
    -- KeybindListener after it listened): shown for the fourth J only.
    const bare = CreateFrame("Frame", nil, UIParent)
    bare:SetFrameStrata("MEDIUM")
    bare:SetSize(10, 10)
    bare:SetPoint("TOPLEFT")
    bare:SetScript("OnKeyDown", function() end)
    bare:SetScript("OnKeyDown", nil)
    bare:SetPropagateKeyboardInput(false)
    bare:Hide()
    frames[#frames + 1] = bare
    const prompts = {
        "press J once (every frame passes keys on)",
        "press Shift-J once (only J is bound)",
        "press J once more (the top frame keeps this J)",
        "press J once more (a frame without a key script is shown)",
    }
    local function finish()
        if finished then
            return
        end
        finished = true
        ClearOverrideBindings(owner)
        for _, f in ipairs(frames) do
            f:SetPropagateKeyboardInput(true)
            f:EnableKeyboard(false)
            f:Hide()
        end
        say("engine keys: recorded; type /reload so the file is written")
    end
    -- The top frame sees each key first: a J moves on, 1.5 s later.
    top:HookScript("OnKeyDown", function(self: any, key: string)
        if key ~= "J" or waiting or finished then
            return
        end
        waiting = true
        C_Timer.After(1.5, function()
            waiting = false
            self:SetPropagateKeyboardInput(true)
            phase += 1
            bare:SetShown(phase == 4)
            if phase == 4 then
                note(`bare keyboard {tostring(bare:IsKeyboardEnabled())} propagate {tostring(bare:GetPropagateKeyboardInput())}`)
            end
            if phase > #prompts then
                finish()
            else
                say(`engine keys: {prompts[phase]}`)
            end
        end)
    end)
    C_Timer.After(60, finish)
    say(`engine keys: {prompts[1]}`)
end

--- The cursor (`/stdtest engine cursor`, out of combat): a spell, a
--- spellbook item, a macro, an action (taken and put back), a bag item and
--- an equipped item (each taken and put back), each with `GetCursorInfo`
--- and what the cursor holds, the events in between; nothing changed in
--- the end. Into StdTestState.engineCursor.
local function cursorProbe()
    const st = state() :: any
    const A = _G :: any
    -- The character it ran on (its spells, bags, gear): the engine's test
    -- plays it with this one.
    st.engineCursorCharacter = takeSnapshot()
    const log: string[] = {}
    const events = CreateFrame("Frame")
    for _, e in ipairs({ "CURSOR_CHANGED", "ACTIONBAR_SLOT_CHANGED", "ACTIONBAR_SHOWGRID", "ACTIONBAR_HIDEGRID",
        "ITEM_LOCK_CHANGED", "BAG_UPDATE", "BAG_UPDATE_DELAYED", "PLAYER_EQUIPMENT_CHANGED", "UNIT_INVENTORY_CHANGED" }) do
        events:RegisterEvent(e)
    end
    events:SetScript("OnEvent", function(_: any, e: string, ...: any)
        const args: string[] = {}
        for i = 1, select("#", ...) do
            args[#args + 1] = tostring((select(i, ...)))
        end
        log[#log + 1] = `{e}({table.concat(args, ", ")})`
    end)
    local function note(step: string)
        log[#log + 1] = `{step}: info {results(A.GetCursorInfo)} | item {results(A.CursorHasItem)} | spell {results(A.CursorHasSpell)} | macro {results(A.CursorHasMacro)} | money {results(A.CursorHasMoney)}`
    end
    note("start")
    -- A spell, by ID and from the spellbook.
    const item = A.C_SpellBook.GetSpellBookItemInfo(2, 0)
    if item and item.spellID then
        A.C_Spell.PickupSpell(item.spellID)
        note(`PickupSpell({item.spellID})`)
        A.ClearCursor()
        note("ClearCursor")
    end
    A.C_SpellBook.PickupSpellBookItem(2, 0)
    note("PickupSpellBookItem(2, 0)")
    A.ClearCursor()
    note("ClearCursor")
    -- A macro.
    if (A.GetNumMacros()) > 0 then
        A.PickupMacro(1)
        note("PickupMacro(1)")
        A.ClearCursor()
        note("ClearCursor")
    end
    -- An action, taken and put back.
    for slot = 1, 120 do
        if A.C_ActionBar.HasAction(slot) then
            A.PickupAction(slot)
            note(`PickupAction({slot}); HasAction {tostring(A.C_ActionBar.HasAction(slot))}`)
            A.PlaceAction(slot)
            note(`PlaceAction({slot}); HasAction {tostring(A.C_ActionBar.HasAction(slot))}`)
            break
        end
    end
    -- A bag item, taken and put back.
    for slot = 1, A.C_Container.GetContainerNumSlots(0) do
        const info = A.C_Container.GetContainerItemInfo(0, slot)
        if info then
            A.C_Container.PickupContainerItem(0, slot)
            const locked = A.C_Container.GetContainerItemInfo(0, slot)
            note(`PickupContainerItem(0, {slot}); locked {tostring(locked and locked.isLocked)}`)
            A.C_Container.PickupContainerItem(0, slot)
            note(`PickupContainerItem(0, {slot}) again`)
            break
        end
    end
    -- An equipped item, taken and put back.
    for _, slot in ipairs({ 16, 5, 1 }) do
        if A.GetInventoryItemID("player", slot) then
            A.PickupInventoryItem(slot)
            note(`PickupInventoryItem({slot}); locked {tostring(A.IsInventoryItemLocked(slot))}`)
            A.PickupInventoryItem(slot)
            note(`PickupInventoryItem({slot}) again`)
            break
        end
    end
    -- The events of the next frames too.
    C_Timer.After(1, function()
        events:UnregisterAllEvents()
        note("after a second")
        st.engineCursor = log
        stamp("cursor")
        say("engine cursor: recorded; type /reload so the file is written")
    end)
end

export function engineProbe(arg: string?)
    const st = state() :: any
    const words: string[] = {}
    for w in (arg ?? ""):gmatch("%S+") do
        words[#words + 1] = w
    end
    if words[1] == "record" then
        startRecording(words[2] ?? "unnamed")
        return
    elseif words[1] == "stop" then
        stopRecording()
        return
    elseif words[1] == "order" then
        dispatchOrder()
        return
    elseif words[1] == "protected" then
        protectedProbe()
        return
    elseif words[1] == "blocked" then
        blockedProbe()
        return
    elseif words[1] == "comm" then
        commProbe()
        return
    elseif words[1] == "input" then
        inputProbe()
        return
    elseif words[1] == "merchant" then
        merchantProbe()
        return
    elseif words[1] == "soft" then
        softProbe()
        return
    elseif words[1] == "textchange" then
        textChangeProbe()
        return
    elseif words[1] == "scenario" then
        scenarioProbe(words[2] ?? "unnamed")
        return
    elseif words[1] == "keys" then
        keysProbe()
        return
    elseif words[1] == "cursor" then
        cursorProbe()
        return
    elseif words[1] == "answers" then
        answersProbe()
        return
    elseif words[1] == "maps" then
        mapsProbe()
        return
    elseif words[1] == "collections" then
        collectionsProbe()
        return
    elseif words[1] == "traits" then
        traitsProbe()
        return
    elseif words[1] == "tradeskill" then
        tradeSkillProbe()
        return
    elseif words[1] == "achievements" then
        achievementsProbe()
        return
    elseif words[1] == "trainer" then
        trainerProbe()
        return
    elseif words[1] == "group" then
        groupProbe()
        return
    elseif words[1] == "startup" then
        armStartup()
        return
    elseif words[1] == "fullprobe" then
        fullProbe(words[2])
        return
    elseif words[1] == "methodprobe" then
        methodProbe(words[2])
        return
    end
    const probe: { [string]: any } = {
        client = `{(GetBuildInfo())} ({select(2, GetBuildInfo())})`,
        widgets = widgets(),
        identities = identities(),
        errors = errors(),
        order = order(),
        behaviours = behaviours(),
        cvarDefaults = cvarDefaults(),
        enums = tables(G.Enum),
        loadCalls = loadCalls(),
        constants = tables(G.Constants),
        scalars = scalars(),
        hidden = hidden(),
        allCVars = allCVars(),
        cvarFlags = cvarFlags(),
        fontHeights = fontHeights(),
        qualityColors = qualityColors(),
        slotInfo = slotInfo(),
        forbidden = forbidden(),
        blizzardErrors = blizzardErrors(),
        blizzardAtStart = table.concat(LOADED_AT_START, " "),
        blizzardNow = table.concat(blizzardLoaded(), " "),
        units = units(),
        layoutSizes = layoutSizes(),
        getTime = show(GetTime()),
    }
    st.engineProbe = probe
    stamp("probe")
    timers(function(r: { [string]: string })
        probe.timers = r
        say("engine: recorded; type /reload so the file is written")
    end)
    say("engine: probing (timers finish within a second)...")
end
