--- `/stdtest engine scenario <name>` … `/stdtest engine scenario stop`: a
--- piece of gameplay as the client lives it, for the engine to replay: every
--- event with its payload (the combat log's entries that concern the player,
--- the pet or the target, where the client gives them; the combat log
--- tab's lines at the end; no players' chat), after the events Blizzard's
--- UI answers, the client's answers to what its handlers ask (the target's
--- health, the loot's slots, the quest's text…), and the character's world
--- at the start and the end (`/stdtest snapshot`'s). Into
--- StdTestState.engineScenarios[name]. Only reading calls.
import state from "/state"
import takeSnapshot from "/snapshot"
import say from "/harness"

const G = _G :: any

--- One value as text: its type, and the value unless secret or a table.
local function show(v: any): string
    if issecretvalue(v) then
        return `secret {type(v)}`
    end
    const t = type(v)
    if t == "string" or t == "number" or t == "boolean" or t == "nil" then
        return `{t} {tostring(v)}`
    end
    return t
end

--- A value with a table's fields (to `max` deep).
local function describe(v: any, depth: number, max: number): string
    if type(v) ~= "table" or issecretvalue(v) or depth > max then
        return show(v)
    end
    const keys: string[] = {}
    for k, inner in pairs(v :: table) do
        if type(k) == "string" then
            keys[#keys + 1] = `{k}={describe(inner, depth + 1, max)}`
        elseif type(k) == "number" then
            keys[#keys + 1] = `{k}={describe(inner, depth + 1, max)}`
        end
    end
    table.sort(keys)
    return `\{{table.concat(keys, ",")}\}`
end

--- A call as the engine writes calls: `C_X.F(1, "a", nil)`.
local function callText(name: string, ...: any): string
    const args: string[] = {}
    for i = 1, select("#", ...) do
        const v = (select(i, ...))
        if type(v) == "string" then
            args[#args + 1] = string.format("%q", v)
        elseif type(v) == "number" and v == math.floor(v) then
            args[#args + 1] = string.format("%d", v)
        else
            args[#args + 1] = tostring(v)
        end
    end
    return `{name}({table.concat(args, ", ")})`
end

--- The function a dotted global name holds.
local function resolve(name: string): any
    local v: any = G
    for part in name:gmatch("[^.]+") do
        if type(v) ~= "table" then
            return nil
        end
        v = v[part]
    end
    return v
end

--- Units worth asking about (not other players' nameplates).
const UNITS: { [string]: boolean } = { player = true, target = true, targettarget = true, pet = true, focus = true, npc = true }

--- The queries Blizzard's handlers make after an event: `ask(name, ...)`
--- records one call's answer.
const QUERIES: { [string]: (ask: (name: string, ...any) -> any, ...any) -> () } = {
    PLAYER_TARGET_CHANGED = function(ask)
        for _, f in ipairs({ "UnitExists", "UnitName", "UnitGUID", "UnitLevel", "UnitEffectiveLevel", "UnitClassification",
            "UnitCreatureType", "UnitCreatureFamily", "UnitIsPlayer", "UnitIsDead", "UnitIsTapDenied", "UnitAffectingCombat", "UnitHealth", "UnitHealthMax",
            "UnitPower", "UnitPowerMax", "UnitPowerType", "UnitFactionGroup", "UnitSex", "UnitClass", "UnitRace",
            "UnitIsPVP", "UnitPlayerControlled", "UnitIsQuestBoss", "UnitIsBossMob", "UnitIsOtherPlayersPet",
            "GetRaidTargetIndex", "UnitSelectionColor", "UnitInRange", "UnitIsVisible", "UnitIsConnected",
            "UnitIsTrivial", "UnitIsWildBattlePet", "UnitShouldDisplayName" }) do
            ask(f, "target")
        end
        ask("UnitIsUnit", "player", "target")
        for _, f in ipairs({ "UnitIsEnemy", "UnitIsFriend", "UnitCanAttack", "UnitCanAssist" }) do
            ask(f, "player", "target")
        end
        ask("UnitThreatSituation", "player", "target")
        ask("UnitReaction", "player", "target")
        ask("UnitReaction", "target", "player")
        ask("UnitDetailedThreatSituation", "player", "target")
        ask("CheckInteractDistance", "target", 1)
        ask("CheckInteractDistance", "target", 2)
        ask("CheckInteractDistance", "target", 3)
        ask("CheckInteractDistance", "target", 4)
        ask("UnitName", "targettarget")
        ask("UnitExists", "targettarget")
    end,
    UNIT_HEALTH = function(ask, unit)
        if UNITS[unit] then
            ask("UnitHealth", unit)
            ask("UnitHealthMax", unit)
            ask("UnitIsDead", unit)
            ask("UnitIsDeadOrGhost", unit)
        end
    end,
    UNIT_MAXHEALTH = function(ask, unit)
        if UNITS[unit] then
            ask("UnitHealthMax", unit)
        end
    end,
    UNIT_POWER_UPDATE = function(ask, unit)
        if UNITS[unit] then
            ask("UnitPower", unit)
            ask("UnitPowerMax", unit)
            ask("UnitPowerType", unit)
        end
    end,
    UNIT_SPELLCAST_START = function(ask, unit)
        if UNITS[unit] then
            ask("UnitCastingInfo", unit)
        end
    end,
    UNIT_SPELLCAST_CHANNEL_START = function(ask, unit)
        if UNITS[unit] then
            ask("UnitChannelInfo", unit)
        end
    end,
    UNIT_THREAT_LIST_UPDATE = function(ask, unit)
        if unit == "target" then
            ask("UnitDetailedThreatSituation", "player", "target")
            ask("UnitThreatSituation", "player", "target")
        end
    end,
    UNIT_AURA = function(ask, unit)
        if UNITS[unit] then
            for _, filter in ipairs({ "HELPFUL", "HARMFUL" }) do
                for i = 1, 40 do
                    if ask("C_UnitAuras.GetAuraDataByIndex", unit, i, filter) == nil then
                        break
                    end
                end
            end
        end
    end,
    PLAYER_REGEN_DISABLED = function(ask)
        ask("InCombatLockdown")
        ask("UnitAffectingCombat", "player")
    end,
    PLAYER_REGEN_ENABLED = function(ask)
        ask("InCombatLockdown")
        ask("UnitAffectingCombat", "player")
    end,
    ACTIONBAR_UPDATE_COOLDOWN = function(ask)
        for slot = 1, 12 do
            ask("C_ActionBar.GetActionCooldown", slot)
        end
    end,
    ACTIONBAR_UPDATE_USABLE = function(ask)
        for slot = 1, 12 do
            ask("C_ActionBar.IsUsableAction", slot)
        end
    end,
    SPELL_UPDATE_COOLDOWN = function(ask)
        ask("C_Spell.GetSpellCooldown", 61304)
    end,
    LOOT_OPENED = function(ask)
        const n = ask("GetNumLootItems") or 0
        for i = 1, n do
            ask("GetLootSlotInfo", i)
            ask("GetLootSlotLink", i)
            ask("GetLootSlotType", i)
            ask("GetLootSourceInfo", i)
        end
        ask("IsFishingLoot")
        ask("C_PartyInfo.GetLootMethod")
    end,
    LOOT_READY = function(ask)
        ask("GetNumLootItems")
    end,
    PLAYER_XP_UPDATE = function(ask)
        ask("UnitXP", "player")
        ask("UnitXPMax", "player")
        ask("GetXPExhaustion")
        ask("GetRestState")
        ask("IsXPUserDisabled")
    end,
    PLAYER_LEVEL_UP = function(ask)
        ask("UnitLevel", "player")
        ask("UnitXPMax", "player")
    end,
    PLAYER_MONEY = function(ask)
        ask("GetMoney")
    end,
    BAG_UPDATE = function(ask, bag)
        if type(bag) == "number" and bag >= 0 and bag <= 4 then
            const n = ask("C_Container.GetContainerNumSlots", bag) or 0
            for slot = 1, n do
                ask("C_Container.GetContainerItemInfo", bag, slot)
            end
            ask("C_Container.GetContainerNumFreeSlots", bag)
        end
    end,
    UPDATE_INVENTORY_DURABILITY = function(ask)
        for slot = 1, 19 do
            ask("GetInventoryItemDurability", slot)
        end
        ask("GetInventoryAlertStatus", 5)
    end,
    PLAYER_EQUIPMENT_CHANGED = function(ask, slot)
        if type(slot) == "number" then
            ask("GetInventoryItemID", "player", slot)
            ask("GetInventoryItemLink", "player", slot)
        end
    end,
    -- Quests.
    GOSSIP_SHOW = function(ask)
        ask("UnitName", "npc")
        ask("UnitGUID", "npc")
        ask("C_GossipInfo.GetText")
        ask("C_GossipInfo.GetOptions")
        ask("C_GossipInfo.GetAvailableQuests")
        ask("C_GossipInfo.GetActiveQuests")
        ask("C_GossipInfo.GetNumAvailableQuests")
        ask("C_GossipInfo.GetNumActiveQuests")
    end,
    QUEST_GREETING = function(ask)
        ask("GetGreetingText")
        const a = ask("GetNumAvailableQuests") or 0
        for i = 1, a do
            ask("GetAvailableTitle", i)
            ask("GetAvailableQuestInfo", i)
        end
        const n = ask("GetNumActiveQuests") or 0
        for i = 1, n do
            ask("GetActiveTitle", i)
            ask("GetActiveQuestID", i)
        end
    end,
    QUEST_DETAIL = function(ask)
        for _, f in ipairs({ "GetTitleText", "GetQuestText", "GetObjectiveText", "GetQuestID", "GetRewardMoney", "GetRewardXP",
            "GetRewardTitle", "GetRewardSpell", "GetNumQuestRewards", "GetNumQuestChoices", "GetNumRewardCurrencies",
            "GetNumQuestItems", "GetSuggestedGroupNum", "QuestGetAutoAccept", "QuestIsFromAreaTrigger", "GetQuestPortraitGiver" }) do
            ask(f)
        end
        const rewards = ask("GetNumQuestRewards") or 0
        for i = 1, rewards do
            ask("GetQuestItemInfo", "reward", i)
            ask("GetQuestItemLink", "reward", i)
        end
        const choices = ask("GetNumQuestChoices") or 0
        for i = 1, choices do
            ask("GetQuestItemInfo", "choice", i)
            ask("GetQuestItemLink", "choice", i)
        end
        ask("UnitName", "npc")
    end,
    QUEST_PROGRESS = function(ask)
        for _, f in ipairs({ "GetTitleText", "GetProgressText", "IsQuestCompletable", "GetNumQuestItems", "GetQuestID",
            "GetQuestMoneyToGet" }) do
            ask(f)
        end
        const n = ask("GetNumQuestItems") or 0
        for i = 1, n do
            ask("GetQuestItemInfo", "required", i)
            ask("GetQuestItemLink", "required", i)
        end
    end,
    QUEST_COMPLETE = function(ask)
        for _, f in ipairs({ "GetTitleText", "GetRewardText", "GetQuestID", "GetRewardMoney", "GetRewardXP", "GetNumQuestRewards",
            "GetNumQuestChoices", "GetRewardTitle", "GetRewardSpell" }) do
            ask(f)
        end
        const rewards = ask("GetNumQuestRewards") or 0
        for i = 1, rewards do
            ask("GetQuestItemInfo", "reward", i)
            ask("GetQuestItemLink", "reward", i)
        end
        const choices = ask("GetNumQuestChoices") or 0
        for i = 1, choices do
            ask("GetQuestItemInfo", "choice", i)
            ask("GetQuestItemLink", "choice", i)
        end
    end,
    QUEST_ACCEPTED = function(ask, questID)
        ask("C_QuestLog.GetNumQuestLogEntries")
        ask("C_QuestLog.GetLogIndexForQuestID", questID)
        ask("C_QuestLog.GetQuestObjectives", questID)
        ask("C_QuestLog.GetTitleForQuestID", questID)
        ask("C_QuestLog.IsComplete", questID)
        ask("C_QuestLog.GetQuestWatchType", questID)
        ask("C_QuestLog.GetNumQuestWatches")
        const index = ask("C_QuestLog.GetLogIndexForQuestID", questID)
        if index then
            ask("C_QuestLog.GetInfo", index)
        end
    end,
    QUEST_WATCH_UPDATE = function(ask, questID)
        ask("C_QuestLog.GetQuestObjectives", questID)
        ask("C_QuestLog.IsComplete", questID)
    end,
    QUEST_TURNED_IN = function(ask, questID)
        ask("C_QuestLog.IsQuestFlaggedCompleted", questID)
        ask("C_QuestLog.GetNumQuestLogEntries")
    end,
    QUEST_LOG_UPDATE = function(ask)
        const n = ask("C_QuestLog.GetNumQuestLogEntries") or 0
        for i = 1, n do
            ask("C_QuestLog.GetInfo", i)
        end
    end,
    -- Death.
    PLAYER_DEAD = function(ask)
        for _, f in ipairs({ "GetReleaseTimeRemaining", "HasSoulstone", "CanUseSoulstone", "GetCorpseRecoveryDelay",
            "IsEncounterInProgress", "HasNoReleaseAura" }) do
            ask(f)
        end
        ask("UnitIsDead", "player")
        ask("UnitIsDeadOrGhost", "player")
    end,
    PLAYER_ALIVE = function(ask)
        ask("UnitIsGhost", "player")
        ask("UnitIsDeadOrGhost", "player")
        ask("GetCorpseRecoveryDelay")
    end,
    PLAYER_UNGHOST = function(ask)
        ask("UnitIsGhost", "player")
        ask("UnitIsDeadOrGhost", "player")
    end,
    CORPSE_IN_RANGE = function(ask)
        ask("GetCorpseRecoveryDelay")
    end,
    CONFIRM_XP_LOSS = function(ask)
        ask("GetResSicknessDuration")
    end,
    RESURRECT_REQUEST = function(ask)
        ask("GetCorpseRecoveryDelay")
    end,
    -- Services.
    MERCHANT_SHOW = function(ask)
        const n = ask("GetMerchantNumItems") or 0
        for i = 1, n do
            ask("GetMerchantItemInfo", i)
            ask("GetMerchantItemLink", i)
            ask("GetMerchantItemCostInfo", i)
            ask("GetMerchantItemMaxStack", i)
        end
        ask("CanMerchantRepair")
        ask("GetRepairAllCost")
        const b = ask("GetNumBuybackItems") or 0
        for i = 1, b do
            ask("GetBuybackItemInfo", i)
            ask("GetBuybackItemLink", i)
        end
        ask("UnitName", "npc")
    end,
    MERCHANT_UPDATE = function(ask)
        ask("GetRepairAllCost")
        const b = ask("GetNumBuybackItems") or 0
        for i = 1, b do
            ask("GetBuybackItemInfo", i)
        end
    end,
    TRAINER_SHOW = function(ask)
        ask("GetTrainerGreetingText")
        ask("IsTradeskillTrainer")
        const n = ask("GetNumTrainerServices") or 0
        for i = 1, n do
            ask("GetTrainerServiceInfo", i)
            ask("GetTrainerServiceCost", i)
            ask("GetTrainerServiceIcon", i)
            ask("GetTrainerServiceLevelReq", i)
            ask("GetTrainerServiceSkillReq", i)
            ask("GetTrainerServiceDescription", i)
            ask("GetTrainerServiceNumAbilityReq", i)
        end
        ask("GetTrainerSelectionIndex")
        ask("UnitName", "npc")
    end,
    TRAINER_UPDATE = function(ask)
        const n = ask("GetNumTrainerServices") or 0
        for i = 1, n do
            ask("GetTrainerServiceInfo", i)
        end
    end,
    TAXIMAP_OPENED = function(ask)
        const map = ask("GetTaxiMapID")
        if map then
            ask("C_TaxiMap.GetAllTaxiNodes", map)
            ask("C_TaxiMap.GetTaxiNodesForMap", map)
        end
        const n = ask("NumTaxiNodes") or 0
        for i = 1, n do
            ask("TaxiNodeName", i)
            ask("TaxiNodeGetType", i)
            ask("TaxiNodeCost", i)
            ask("TaxiNodePosition", i)
            ask("GetNumRoutes", i)
        end
    end,
}

local recorder: any = nil

--- Starts recording scenario `name`; `stop` ends it.
export function scenarioProbe(name: string)
    const st = state() :: any
    if name == "stop" then
        if recorder then
            recorder:UnregisterAllEvents()
            recorder:SetScript("OnEvent", nil)
        end
        const current = st.engineScenarioRunning
        if current and st.engineScenarios and st.engineScenarios[current] then
            const scenario = st.engineScenarios[current]
            scenario.after = takeSnapshot()
            -- What the combat log tab showed (addons get no combat log
            -- events; Blizzard's log reads it securely).
            const shown: string[] = {}
            const frame = G.COMBATLOG
            if frame and frame.GetNumMessages then
                local ok, n = pcall(frame.GetNumMessages, frame)
                if ok and not issecretvalue(n) then
                    for i = math.max(1, n - 300), n do
                        local okm, text = pcall(frame.GetMessageInfo, frame, i)
                        shown[#shown + 1] = okm and show(text) or "error"
                    end
                end
            end
            scenario.combatLog = shown
        end
        st.engineScenarioRunning = nil
        say(`engine scenario: stopped{current and ` "{current}"` or ""}; type /reload so the file is written`)
        return
    end
    st.engineScenarios = st.engineScenarios ?? {}
    const log: string[] = {}
    const start = GetTime()
    const scenario = { log = log, before = takeSnapshot(), client = `{(GetBuildInfo())} ({select(2, GetBuildInfo())})` }
    st.engineScenarios[name] = scenario
    st.engineScenarioRunning = name
    local function note(what: string)
        if #log < 20000 then
            log[#log + 1] = `{string.format("%.3f", GetTime() - start)} {what}`
        end
    end
    --- One call's answer, logged as `= call -> answer`; its first value.
    local function ask(fname: string, ...: any): any
        const f = resolve(fname)
        if type(f) ~= "function" then
            note(`= {callText(fname, ...)} -> absent`)
            return nil
        end
        const packed = { pcall(f, ...) }
        local text: string
        if not packed[1] then
            text = `error: {issecretvalue(packed[2]) and "<secret>" or tostring(packed[2])}`
        else
            const out: string[] = {}
            for i = 2, select("#", unpack(packed)) do
                out[#out + 1] = describe(packed[i], 1, 3)
            end
            text = `{#out}: {table.concat(out, ", ")}`
        end
        note(`= {callText(fname, ...)} -> {text}`)
        -- Its first value for the handlers' counts; a secret one (health in
        -- combat) is not tested, nothing to count by.
        if not packed[1] or issecretvalue(packed[2]) then
            return nil
        end
        return packed[2]
    end
    recorder = recorder ?? CreateFrame("Frame")
    recorder:SetScript("OnEvent", function(_, event: string, ...: any)
        -- Players' chat is theirs: left out (the game's own messages stay).
        if event:find("^CHAT_MSG_") and not (event:find("^CHAT_MSG_LOOT") or event:find("^CHAT_MSG_MONEY")
            or event:find("^CHAT_MSG_COMBAT_") or event:find("^CHAT_MSG_SYSTEM") or event:find("^CHAT_MSG_SKILL")
            or event:find("^CHAT_MSG_MONSTER_") or event:find("^CHAT_MSG_RAID_BOSS_") or event:find("^CHAT_MSG_OPENING")) then
            return
        end
        if event:find("^BN_") or event:find("^CLUB_") or event:find("^GUILD_") or event == "CHAT_MSG_ADDON" then
            return
        end
        if event == "COMBAT_LOG_EVENT_UNFILTERED" then
            const info = { CombatLogGetCurrentEventInfo() }
            const mine: { [any]: boolean } = {}
            for _, u in ipairs({ "player", "pet", "target" }) do
                const guid = UnitGUID(u)
                if guid then
                    mine[guid] = true
                end
            end
            if not (mine[info[4]] or mine[info[8]]) then
                return
            end
            const parts: string[] = {}
            for i = 1, #info do
                parts[#parts + 1] = describe(info[i], 1, 2)
            end
            note(`COMBAT_LOG_EVENT_UNFILTERED({table.concat(parts, "; ")})`)
            return
        end
        const parts: string[] = {}
        const max = event == "UNIT_AURA" and 3 or 2
        for i = 1, select("#", ...) do
            parts[#parts + 1] = describe((select(i, ...)), 1, max)
        end
        note(`{event}({table.concat(parts, "; ")})`)
        const queries = QUERIES[event]
        if queries then
            queries(ask, ...)
        end
    end)
    recorder:RegisterAllEvents()
    say(`engine scenario "{name}": recording; play it, then /stdtest engine scenario stop`)
end
