-- /stdtest engine maps: the client's map data (every map from the world
-- map and the player's map, down through their children) as Blizzard's UI
-- asks it, into StdTestState.engineMapAnswers[call]
-- in the answers probe's form (`cargo xtask ingest` merges them). The
-- static data, and what each map holds (POIs, flight points, graveyards,
-- the explored areas; what goes on there: delves, events, invasions,
-- bounties): no positions or quests.
import state from "/state"
import stamp from "/state"
import say from "/harness"

local function pack(...: any): { n: number, [number]: any }
    return { n = select("#", ...), ... }
end

--- A value in full: tables to depth 4, keys sorted, secrets marked.
local function show(v: any, depth: number): string
    if issecretvalue(v) then
        return `secret {type(v)}`
    end
    if type(v) == "string" then
        return `string {v}`
    end
    if type(v) ~= "table" then
        return `{type(v)} {tostring(v)}`
    end
    if depth >= 4 then
        return "table"
    end
    const keys: string[] = {}
    const values: { [string]: any } = {}
    for k, inner in pairs(v :: table) do
        const key = tostring(k)
        keys[#keys + 1] = key
        values[key] = inner
    end
    table.sort(keys)
    const parts: string[] = {}
    for _, k in ipairs(keys) do
        parts[#parts + 1] = `{k}={show(values[k], depth + 1)}`
    end
    return `\{{table.concat(parts, ",")}\}`
end

--- The functions asked of each map by its ID alone.
const BY_ID: string[] = {
    "GetMapInfo",
    "GetMapArtID",
    "GetMapArtLayers",
    "GetMapChildrenInfo",
    "GetMapGroupID",
    "GetMapLevels",
    "GetMapLinksForMap",
    "GetMapBannersForMap",
    "GetMapArtBackgroundAtlas",
    "GetMapArtHelpTextPosition",
    "GetMapArtZoneTextPosition",
    "GetMapDisplayInfo",
    "GetMapWorldSize",
    "MapHasArt",
    "IsCityMap",
    "IsMapValidForNavBarDropdown",
    "CanSetUserWaypointOnMap",
}

--- What each map holds, asked by its ID alone (as the world map's data
--- providers ask it).
const CONTENT: string[] = {
    "C_AreaPoiInfo.GetAreaPOIForMap",
    "C_AreaPoiInfo.GetQuestHubsForMap",
    "C_AreaPoiInfo.GetDelvesForMap",
    "C_AreaPoiInfo.GetEventsForMap",
    "C_EncounterJournal.GetDungeonEntrancesForMap",
    "C_TaxiMap.ShouldMapShowTaxiNodes",
    "C_TaxiMap.GetTaxiNodesForMap",
    "C_TaskQuest.DoesMapShowTaskQuestObjectives",
    "C_TaskQuest.GetQuestsOnMap",
    "C_DeathInfo.GetGraveyardsForMap",
    "C_DeathInfo.GetCorpseMapPosition",
    "C_MapExplorationInfo.GetExploredMapTextures",
    "C_FogOfWar.GetFogOfWarForMap",
    "C_Map.GetMapHighlightPulseInfo",
    "C_Map.GetUserWaypointPositionForMap",
    "C_ContributionCollector.GetContributionCollectorsForMap",
    "C_Garrison.GetGarrisonPlotsInstancesForMap",
    "C_GossipInfo.GetPoiForUiMapID",
    "C_InvasionInfo.GetInvasionForUiMapID",
    "C_Navigation.GetNextWaypointForMap",
    "C_ResearchInfo.GetDigSitesForMap",
    "C_PvP.GetBattlefieldVehicles",
    "C_PvP.GetOutdoorPvPWaitTime",
    "C_QuestLog.GetBountiesForMapID",
    "C_QuestLog.GetBountySetInfoForMapID",
    "C_QuestLog.GetZoneStoryInfo",
    "C_QuestLine.GetAvailableQuestLines",
    "C_QuestLine.GetForceVisibleQuests",
}

export function mapsProbe()
    const st = state() :: any
    const out: { [string]: string } = {}
    const M = C_Map :: any
    local asked = 0
    local function ask(call: string, ...: any)
        local ns, name = call:match("^([%w_]+)%.(%w+)")
        const space = (_G :: any)[ns :: string]
        const f = space and space[name :: string]
        if f == nil then
            return
        end
        local ok, packed = pcall(function(...: any): any return pack(f(...)) end, ...)
        asked = asked + 1
        if not ok then
            out[call] = `error: {tostring(packed)}`
            return
        end
        const p = packed :: { n: number, [number]: any }
        const parts: string[] = {}
        for i = 1, p.n do
            parts[#parts + 1] = show(p[i], 0)
        end
        out[call] = `{p.n}: {table.concat(parts, ", ")}`
    end
    -- Every map from the world map (the fallback; Forever has no cosmic
    -- map) and the player's map up, and each one's children down.
    const ids: number[] = {}
    const seen: { [number]: boolean } = {}
    local function add(id: number?)
        if id ~= nil and id > 0 and not seen[id] then
            seen[id] = true
            ids[#ids + 1] = id
        end
    end
    add(946)
    add(M.GetFallbackWorldMapID())
    local up = M.GetBestMapForUnit("player")
    while up ~= nil and up > 0 and not seen[up] do
        add(up)
        const info = M.GetMapInfo(up)
        up = info and info.parentMapID
    end
    local i = 1
    while i <= #ids do
        for _, child in ipairs(M.GetMapChildrenInfo(ids[i]) ?? {}) do
            add(child.mapID)
        end
        i = i + 1
    end
    ask("C_Map.GetFallbackWorldMapID()")
    for _, id in ipairs(ids) do
        for _, name in ipairs(BY_ID) do
            ask(`C_Map.{name}({id})`, id)
        end
        ask(`C_Map.GetMapChildrenInfo({id}, 3)`, id, 3)
        ask(`C_Map.GetMapChildrenInfo({id}, nil, true)`, id, nil, true)
        local layers = M.GetMapArtLayers(id)
        for layer = 1, layers and #layers or 0 do
            ask(`C_Map.GetMapArtLayerTextures({id}, {layer})`, id, layer)
        end
        const group = M.GetMapGroupID(id)
        if group then
            ask(`C_Map.GetMapGroupMembersInfo({group})`, group)
        end
        -- What it holds; each area POI's and quest hub's details.
        for _, name in ipairs(CONTENT) do
            ask(`{name}({id})`, id)
        end
        for _, kind in ipairs({ 0, 3 }) do
            ask(`C_ContentTracking.GetTrackablesOnMap({kind}, {id})`, kind, id)
        end
        const A = C_AreaPoiInfo :: any
        const pois: number[] = {}
        for _, list in ipairs({ A.GetAreaPOIForMap(id) ?? {}, A.GetQuestHubsForMap(id) ?? {} }) do
            for _, poi in ipairs(list :: number[]) do
                pois[#pois + 1] = poi
            end
        end
        for _, poi in ipairs(pois) do
            ask(`C_AreaPoiInfo.GetAreaPOIInfo({id}, {poi})`, id, poi)
        end
        -- Its rectangle on each map above it.
        local info = M.GetMapInfo(id)
        while info and info.parentMapID and info.parentMapID > 0 do
            ask(`C_Map.GetMapRectOnMap({id}, {info.parentMapID})`, id, info.parentMapID)
            info = M.GetMapInfo(info.parentMapID)
        end
    end
    st.engineMapAnswers = out
    stamp("maps")
    say(`engine maps: {#ids} maps, {asked} calls recorded; type /reload so the file is written`)
end
