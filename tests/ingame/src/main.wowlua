-- wowlua StdTest: in-game tests of the standard library.
--   /stdtest          every test: automatic, then guided (target, combat,
--                     /reload), finishing by itself after the reload
--   /stdtest auto     the automatic tests only
--   /stdtest skip     skip the guided step waiting for you
--   /stdtest results  the last summary again
--   /stdtest probe    record the client's Lua environment (then /reload)
--   /stdtest taint    taint experiments on Blizzard secure code (then click, /reload)
--   /stdtest inventory   record every global and what it is (then /reload)
--   /stdtest crashlimit  where results stop, and the calls that crash the client
--   /stdtest restrictions  what combat and other restrictions change (run out of and in combat)
--   /stdtest argcheck  how documented functions check their arguments (then /reload)
--   /stdtest engine    what the client's engine does (also: order, protected, blocked,
--                      record <label>, stop; fullprobe [stop | status | reset]: every
--                      function called with many arguments, reloading by itself)
--   /stdtest sv        how the client writes SavedVariables (risky: values that may
--                      break the file; back it up first)
import slash, router from "wowlua:slash"
import onLogin from "wowlua:lifecycle"
import after from "wowlua:timer"
import run, report, skip, isRunning, say from "/harness"
import type Suite, TestRecord from "/harness"
import state from "/state"
import probe from "/probe"
import taintlab from "/taintlab"
import inventory from "/inventory"
import crashlimit from "/crashlimit"
import restrictions from "/restrictions"
import * as argcheck from "/argcheck"
import engineProbe from "/engineprobe"
import svProbe from "/svprobe"
import _ from "/suites/errors"
import _ from "/suites/events"
import _ from "/suites/lifecycle"
import _ from "/suites/timer"
import _ from "/suites/combat"
import _ from "/suites/hooks"
import _ from "/suites/slash"
import _ from "/suites/saved"
import _ from "/suites/callbacks"
import _ from "/suites/devtools"
import _ from "/suites/locale"
import _ from "/suites/pool"
import _ from "/suites/settings"
import _ from "/suites/launcher"
import _ from "/suites/serialize"
import _ from "/suites/comm"
import _ from "/suites/bindings"
import _ from "/suites/tooltip"
import _ from "/suites/frames"
import _ from "/suites/secret"
import _ from "/suites/unit"
import _ from "/suites/aura"
import _ from "/suites/spell"
import _ from "/suites/item"
import _ from "/suites/media"
import _ from "/suites/jobs"
import _ from "/suites/dialog"
import _ from "/suites/menu"
import _ from "/suites/list"
import _ from "/suites/format"
import _ from "/suites/version"
import _ from "/suites/roster"
import _ from "/suites/secure"
import snapshot from "/snapshot"

local function concat(a: TestRecord[], b: TestRecord[]): TestRecord[]
    local out: TestRecord[] = {}
    for _, r in ipairs(a) do out[#out + 1] = r end
    for _, r in ipairs(b) do out[#out + 1] = r end
    return out
end

local function finish(results: TestRecord[])
    local st = state()
    st.results = results
    st.time = date("%Y-%m-%d %H:%M:%S")
    report(results)
end

local function automatic()
    say("running the automatic tests...")
    run(function(s: Suite): boolean return s.kind == "auto" end, finish)
end

local function everything()
    say("running the automatic tests, then the guided ones...")
    run(function(s: Suite): boolean return s.kind == "auto" end, function(auto: TestRecord[])
        report(auto)
        say("now the guided tests: follow the yellow instructions")
        run(function(s: Suite): boolean return s.kind == "guided" end, function(guided: TestRecord[])
            local all = concat(auto, guided)
            local st = state()
            if st.reload?.pending then
                -- The rest runs after the reload.
                st.results = all
                say("|cffffd200>>> Type /reload to finish (the saved-variables test continues after it)|r")
            else
                finish(all)
            end
        end)
    end)
end

-- After the /reload a guided test asked for: the last suites, then the
-- whole summary.
@onLogin
local function continueAfterReload()
    local st = state()
    if not st.reload?.pending then
        return
    end
    after(3, function()
        say("continuing after the reload...")
        run(function(s: Suite): boolean return s.kind == "reload" end, function(results: TestRecord[])
            finish(concat(st.results or {}, results))
        end)
    end)
end

local commands = router({
    auto = { help = "Run the automatic tests only", run = function() automatic() end },
    skip = { help = "Skip the guided step waiting for you", run = function() skip() end },
    probe = { help = "Record the client's Lua environment (then /reload)", run = function() probe() end },
    inventory = {
        help = "Record every global and what it is (then /reload)",
        run = function() inventory() end,
    },
    engine = {
        args = { "rest" },
        help = "Record what the client's engine does: /stdtest engine [order | protected | blocked | input | merchant | soft | answers | group | startup | fullprobe [stop | status | reset] | record <label> | stop] (then /reload)",
        run = function(arg: string?) engineProbe(arg) end,
    },
    sv = {
        args = { "rest" },
        help = "How the client writes SavedVariables: /stdtest sv [risky] (then /reload)",
        run = function(arg: string?) svProbe(arg) end,
    },
    snapshot = {
        help = "Record the world your character is in, as a world profile for wowlua test (then /reload)",
        run = function() snapshot() end,
    },
    argcheck = {
        help = "Record how documented functions check their arguments (then /reload)",
        run = function()
            const st = state() :: any
            st.argcheck = argcheck.run()
            say(`argcheck: {#argcheck.calls} functions recorded; type /reload so the file is written`)
        end,
    },
    restrictions = {
        help = "Record what addon restrictions change: run out of combat and in combat (then /reload)",
        run = function() restrictions() end,
    },
    crashlimit = {
        args = { "rest" },
        help = "Where many results stop, and which calls crash the client: /stdtest crashlimit <n>",
        run = function(arg: string?) crashlimit(arg) end,
    },
    taint = {
        args = { "rest" },
        help = "Taint experiments on Blizzard's secure code: /stdtest taint <n> (then click, /reload)",
        run = function(arg: string?) taintlab(arg) end,
    },
    results = {
        help = "Show the last summary again",
        run = function()
            local st = state()
            if st.results then
                say(`results of {st.time ?? "the last run"}:`)
                report(st.results)
            else
                say("no results yet: type /stdtest")
            end
        end,
    },
})

@slash("/stdtest")
local function onCommand(msg: string)
    if msg:match("^%s*$") then
        if isRunning() then
            say("a run is in progress (/stdtest skip skips a guided step)")
        else
            everything()
        end
        return
    end
    commands:dispatch(msg)
end
