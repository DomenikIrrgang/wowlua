--- Checks of rules the call form cannot ask (a table argument, a frame):
--- each a label and the code, into StdTestState.engineChecks[label].
const CHECKS: { label: string, code: string }[] = {
    { label = "WrapTextInColor orange", code = [==[C_ColorUtil.WrapTextInColor("ab", CreateColor(1, 0.5, 0))]==] },
    { label = "WrapTextInColor quarter alpha", code = [==[C_ColorUtil.WrapTextInColor("ab", CreateColor(1, 0.5, 0, 0.25))]==] },
    { label = "WrapTextInColor white font", code = [==[C_ColorUtil.WrapTextInColor("ab", WHITE_FONT_COLOR)]==] },
    { label = "WrapTextInColor empty", code = [==[C_ColorUtil.WrapTextInColor("", CreateColor(0, 0, 1))]==] },
    { label = "GenerateTextColorCode orange", code = [==[C_ColorUtil.GenerateTextColorCode(CreateColor(1, 0.5, 0))]==] },
    { label = "GenerateTextColorCode quarter alpha", code = [==[C_ColorUtil.GenerateTextColorCode(CreateColor(0.17, 0.58, 0.02, 0.25))]==] },
    { label = "GenerateHexColor", code = [==[CreateColor(1, 0.5, 0):GenerateHexColor()]==] },
    { label = "ColorSelect set code", code = [==[(function() local c = CreateFrame("ColorSelect") local n = 0 c:SetScript("OnColorSelect", function() n = n + 1 end) c:SetColorRGB(1, 0, 0) local r, g, b = c:GetColorRGB() local h, s, v = c:GetColorHSV() return n, r, g, b, h, s, v, c:GetColorAlpha() end)()]==] },
    { label = "ColorSelect default", code = [==[(function() local c = CreateFrame("ColorSelect") local r, g, b = c:GetColorRGB() return r, g, b, c:GetColorAlpha() end)()]==] },
    { label = "ColorSelect hsv more", code = [==[(function() local c = CreateFrame("ColorSelect") local out = {} for _, hsv in ipairs({ { 0, 1, 1 }, { 60, 0.25, 0.5 }, { 200, 0.7, 0.3 }, { 300, 1, 0.9 }, { 359, 0.1, 1 }, { 120, 0, 0.8 } }) do c:SetColorHSV(hsv[1], hsv[2], hsv[3]) local r, g, b = c:GetColorRGB() local h, sat, v = c:GetColorHSV() out[#out + 1] = string.format("%.17g,%.17g,%.17g/%.17g,%.17g,%.17g", r, g, b, h, sat, v) end return table.concat(out, " ") end)()]==] },
    { label = "ColorSelect rgb roundtrip", code = [==[(function() local c = CreateFrame("ColorSelect") local out = {} for _, rgb in ipairs({ { 0.4, 0.8, 0.4 }, { 0.1, 0.2, 0.3 }, { 1, 0.5, 0 }, { 0.17, 0.58, 0.02 } }) do c:SetColorRGB(rgb[1], rgb[2], rgb[3]) local r, g, b = c:GetColorRGB() local h, sat, v = c:GetColorHSV() out[#out + 1] = string.format("%.17g,%.17g,%.17g/%.17g,%.17g,%.17g", r, g, b, h, sat, v) end return table.concat(out, " ") end)()]==] },
    { label = "ColorSelect hsv", code = [==[(function() local c = CreateFrame("ColorSelect") c:SetColorHSV(120, 0.5, 0.8) return c:GetColorRGB() end)()]==] },
    { label = "Slider default", code = [==[(function() local s = CreateFrame("Slider", nil, UIParent) local a, b = s:GetMinMaxValues() return s:GetValue(), a, b, s:GetValueStep(), s:GetStepsPerPage(), s:GetObeyStepOnDrag(), s:GetOrientation(), s:GetThumbTexture() == nil end)()]==] },
    { label = "Slider set value", code = [==[(function() local s = CreateFrame("Slider", nil, UIParent) local log = {} s:SetScript("OnValueChanged", function(_, v, u) log[#log + 1] = tostring(v) .. ":" .. tostring(u) end) s:SetScript("OnMinMaxChanged", function(_, a, b) log[#log + 1] = "mm" .. tostring(a) .. "," .. tostring(b) end) s:SetMinMaxValues(0, 10) s:SetValue(5) s:SetValue(5) s:SetValue(7.25) return table.concat(log, " "), s:GetValue() end)()]==] },
    { label = "Slider set clamps", code = [==[(function() local s = CreateFrame("Slider", nil, UIParent) local log = {} s:SetScript("OnValueChanged", function(_, v, u) log[#log + 1] = tostring(v) .. ":" .. tostring(u) end) s:SetScript("OnMinMaxChanged", function(_, a, b) log[#log + 1] = "mm" .. tostring(a) .. "," .. tostring(b) end) s:SetMinMaxValues(0, 10) s:SetValue(15) local a = s:GetValue() s:SetValue(-3) return table.concat(log, " "), a, s:GetValue() end)()]==] },
    { label = "Slider set user", code = [==[(function() local s = CreateFrame("Slider", nil, UIParent) local log = {} s:SetScript("OnValueChanged", function(_, v, u) log[#log + 1] = tostring(v) .. ":" .. tostring(u) end) s:SetScript("OnMinMaxChanged", function(_, a, b) log[#log + 1] = "mm" .. tostring(a) .. "," .. tostring(b) end) s:SetMinMaxValues(0, 10) s:SetValue(4, true) s:SetValue(6, false) return table.concat(log, " "), s:GetValue() end)()]==] },
    { label = "Slider set fires at once", code = [==[(function() local s = CreateFrame("Slider", nil, UIParent) local log = {} s:SetScript("OnValueChanged", function(_, v, u) log[#log + 1] = tostring(v) .. ":" .. tostring(u) end) s:SetScript("OnMinMaxChanged", function(_, a, b) log[#log + 1] = "mm" .. tostring(a) .. "," .. tostring(b) end) s:SetMinMaxValues(0, 10) s:SetValue(3) local n = #log s:SetValue(4) return n, #log end)()]==] },
    { label = "Slider step", code = [==[(function() local s = CreateFrame("Slider", nil, UIParent) local log = {} s:SetScript("OnValueChanged", function(_, v, u) log[#log + 1] = tostring(v) .. ":" .. tostring(u) end) s:SetScript("OnMinMaxChanged", function(_, a, b) log[#log + 1] = "mm" .. tostring(a) .. "," .. tostring(b) end) s:SetMinMaxValues(0, 10) s:SetValueStep(2) s:SetValue(3) local a = s:GetValue() s:SetValue(3.4) local b = s:GetValue() s:SetValue(9.5) return table.concat(log, " "), a, b, s:GetValue() end)()]==] },
