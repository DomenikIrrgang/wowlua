local function pack(...: any): { n: number, [number]: any }
    return { n = select("#", ...), ... }
end

--- A value in full: tables to depth 4, keys sorted, secrets marked.
local function show(v: any, depth: number): string
    if issecretvalue(v) then
        return `secret {type(v)}`
    end
    if type(v) == "string" then
        return `string {v}`
    end
    if type(v) ~= "table" then
        return `{type(v)} {tostring(v)}`
    end
    if depth >= 4 then
        return "table"
    end
    const keys: string[] = {}
    const values: { [string]: any } = {}
    for k, inner in pairs(v :: table) do
        const key = tostring(k)
        keys[#keys + 1] = key
        values[key] = inner
    end
    table.sort(keys)
    const parts: string[] = {}
    for _, k in ipairs(keys) do
        parts[#parts + 1] = `{k}={show(values[k], depth + 1)}`
    end
    return `\{{table.concat(parts, ",")}\}`
end

export function answersProbe()
    const st = state() :: any
    const out: { [string]: string } = {}
    for _, call in ipairs(CALLS) do
        const f = loadstring("return " .. call)
        if f == nil then
            out[call] = "syntax"
        else
            local ok, packed = pcall(function(): any return pack((f :: any)()) end)
            if not ok then
                out[call] = `error: {tostring(packed)}`
            else
                const p = packed :: { n: number, [number]: any }
                const parts: string[] = {}
                for i = 1, p.n do
                    parts[#parts + 1] = show(p[i], 0)
                end
                out[call] = `{p.n}: {table.concat(parts, ", ")}`
            end
        end
    end
    st.engineAnswers = out
    stamp("answers")
    const checks: { [string]: string } = {}
    for _, check in ipairs(CHECKS) do
        const f = loadstring("return " .. check.code)
        if f == nil then
            checks[check.label] = "syntax"
        else
            local ok, packed = pcall(function(): any return pack((f :: any)()) end)
            if not ok then
                checks[check.label] = `error: {tostring(packed)}`
            else
                const p = packed :: { n: number, [number]: any }
                const parts: string[] = {}
                for i = 1, p.n do
                    parts[#parts + 1] = show(p[i], 0)
                end
                checks[check.label] = `{p.n}: {table.concat(parts, ", ")}`
            end
        end
    end
    st.engineChecks = checks
    say(`engine answers: {#CALLS} calls recorded; type /reload so the file is written`)
end
