-- wowlua:bindings: keybindings declared in code; the compiler generates
-- Bindings.xml, which the client reads from the AddOn root.
import binding, header from "wowlua:bindings"
import type KeyState from "wowlua:bindings"
import suite from "/harness"

const HEADER = "STDTEST"
header(HEADER, "wowlua StdTest")

local pressed: string[] = {}

@binding("STDTEST_PING", { label = "Ping (StdTest)", header = HEADER })
local function ping()
    pressed[#pressed + 1] = "ping"
end

@binding("STDTEST_HOLD", { label = "Hold (StdTest)", header = HEADER, runOnUp = true })
local function hold(state: KeyState)
    pressed[#pressed + 1] = state
end

local s = suite("bindings")

s:test("the client lists the generated bindings", function(t)
    local listed: { [string]: boolean } = {}
    for i = 1, GetNumBindings() do
        const command = GetBinding(i)
        if command then
            listed[command] = true
        end
    end
    t:ok(listed.STDTEST_PING, "STDTEST_PING is listed")
    t:ok(listed.STDTEST_HOLD, "STDTEST_HOLD is listed")
    t:eq(_G.BINDING_HEADER_STDTEST, "wowlua StdTest", "the header's label")
    t:eq(_G.BINDING_NAME_STDTEST_PING, "Ping (StdTest)", "the binding's label")
end)

-- What each Bindings.xml body does (`RunBinding` is Blizzard-only, so the
-- automatic test calls the dispatch table; the guided one presses a key).
s:test("the dispatch table runs the handlers", function(t)
    const dispatch = _G.StdTest_Bindings
    t:ok(type(dispatch) == "table", "StdTest_Bindings exists")
    if type(dispatch) ~= "table" then return end
    pressed = {}
    dispatch.STDTEST_PING("down")
    dispatch.STDTEST_HOLD("down")
    dispatch.STDTEST_HOLD("up")
    dispatch.STDTEST_MISSING("down")
    t:eq(table.concat(pressed, " "), "ping down up", "the handlers, unknown bindings do nothing")
end)

-- An unusual key, bound for this test only (not saved) and restored.
const KEY = "CTRL-SHIFT-K"

local g = suite("bindings (guided)", "guided")

g:test("a real key press runs the binding", function(t)
    if InCombatLockdown() then
        t:skip("in combat")
        return
    end
    const previous = GetBindingAction(KEY)
    t:ok(SetBinding(KEY, "STDTEST_HOLD"), `{KEY} bound to Hold (StdTest)`)
    pressed = {}
    t:ask(`Press and release {KEY}`)
    t:waitFor(function() return #pressed >= 2 end, 120, "a press and a release")
    t:eq(table.concat(pressed, " "), "down up", "down, then up with runOnUp")
    SetBinding(KEY, previous ~= "" and previous or nil)
end)
