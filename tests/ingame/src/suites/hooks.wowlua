-- wowlua:hooks: post-hooks with hooksecurefunc and HookScript in the client.
import hook, hookScript from "wowlua:hooks"
import suite from "/harness"

local seen: string[] = {}

-- Targets of this suite (globals, as hooks of Blizzard code would be).
_G.StdTestAdd = function(a: number, b: number): (number, string) return a + b, "sum" end
_G.StdTestObject = { get = function(_: table, k: string): string return k .. "!" end }
_G.StdTestDecorated = function(_: number) end
local frame = CreateFrame("Frame", "StdTestHookFrame", UIParent)
frame:Hide()

@hook("StdTestDecorated")
local function afterDecorated(v: number)
    seen[#seen + 1] = `decorated {v}`
end

@hookScript("StdTestHookFrame", "OnShow")
local function shown(f: Frame)
    seen[#seen + 1] = `shown {f:GetName()}`
end

local s = suite("hooks")

s:test("decorated hooks", function(t)
    seen = {}
    _G.StdTestDecorated(4)
    frame:Show()
    frame:Hide()
    t:eq(table.concat(seen, ", "), "decorated 4, shown StdTestHookFrame", "@hook and @hookScript ran")
end)

s:test("results are kept, errors isolated", function(t)
    local args = ""
    hook("StdTestAdd", function(a: number, b: number) args = `{a},{b}` end)
    hook("StdTestAdd", function() error("hook failed") end)
    local sum, label = _G.StdTestAdd(1, 2)
    t:eq(sum, 3, "the original's result")
    t:eq(label, "sum", "all of its results")
    t:eq(args, "1,2", "the hook got the arguments")
    t:ok(t:reported("hook failed"), "the failing hook is reported")
    t:ok(t:reported("[hooks: StdTestAdd]"), "naming the hook")
end)

s:test("methods, objects and Blizzard widgets", function(t)
    local key = ""
    hook("StdTestObject", "get", function(_: table, k: string) key = k end)
    t:eq(_G.StdTestObject:get("x"), "x!", "method result")
    t:eq(key, "x", "method hook")
    local text = ""
    hook(GameTooltip, "SetText", function(_: GameTooltip, value: string) text = value end)
    GameTooltip:SetOwner(UIParent, "ANCHOR_NONE")
    GameTooltip:SetText("StdTest tooltip")
    GameTooltip:Hide()
    t:eq(text, "StdTest tooltip", "GameTooltip:SetText hook")
    local hidden = 0
    hookScript(frame, "OnHide", function() hidden += 1 end)
    frame:Show()
    frame:Hide()
    t:eq(hidden, 1, "hookScript on a frame object")
end)

s:test("missing targets are refused", function(t)
    t:ok(not pcall(hook, "StdTestMissing", "Show", function() end), "a missing table")
    t:ok(not pcall(hookScript, "StdTestMissingFrame", "OnShow", function() end), "a missing frame")
end)
