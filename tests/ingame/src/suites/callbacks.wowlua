-- wowlua:callbacks: registries and their CallbackHandler face.
import * as callbacks from "wowlua:callbacks"
import suite from "/harness"
import type Subscription from "wowlua:events"

interface KillEvents
    Kill: (n: number) -> ()
    Reset: () -> ()
    Solo: () -> ()
end

interface TickEvents
    Tick: () -> ()
end

-- What CallbackHandler passes: the event name first.
interface CompatEvents
    Kill: (n: number) -> ()
end

local s = suite("callbacks")

s:test("on, once, off, offAll, has", function(t)
    local r: callbacks.Registry<KillEvents> = callbacks.registry()
    local got: string[] = {}
    local owner = {}
    r:on("Kill", function(n: number) got[#got + 1] = `kill {n}` end, owner)
    r:once("Kill", function(n: number) got[#got + 1] = `first {n}` end)
    t:ok(r:has("Kill") and not r:has("Reset"), "has")
    r:fire("Kill", 1)
    r:fire("Kill", 2)
    r:offAll(owner)
    r:fire("Kill", 3)
    t:eq(table.concat(got, ", "), "kill 1, first 1, kill 2", "fired in order")
    t:eq(r:has("Kill"), false, "nothing left")
    local sub = r:on("Solo", function() end)
    r:off(sub)
    t:ok(not r:has("Solo") and sub.active == false, "off")
    t:ok(not pcall(r.offAll, r, nil), "offAll(nil) is refused")
end)

s:test("isolated handlers, snapshot fires", function(t)
    local r: callbacks.Registry<TickEvents> = callbacks.registry()
    local log: string[] = {}
    local second: Subscription? = nil
    local added = false
    r:on("Tick", function()
        log[#log + 1] = "one"
        if not added then
            added = true
            r:on("Tick", function() log[#log + 1] = "late" end)
        end
        if second then r:off(second) end
    end)
    r:on("Tick", function() error("callback broke") end)
    second = r:on("Tick", function() log[#log + 1] = "two" end)
    r:fire("Tick")
    r:fire("Tick")
    t:eq(table.concat(log, " "), "one two one late", "changes apply to the next fire")
    t:ok(t:reported("callback broke"), "the error is reported")
end)

s:test("CallbackHandler compatibility", function(t)
    local r: callbacks.Registry<CompatEvents> = callbacks.registry({ compat = "CallbackHandler" })
    local register = assert(r.RegisterCallback)
    local unregister = assert(r.UnregisterCallback)
    local unregisterAll = assert(r.UnregisterAllCallbacks)
    local got: string[] = {}
    local consumer = {}
    function consumer.OnKill(self: table, name: string, n: number) got[#got + 1] = `method {self == consumer} {name} {n}` end
    function consumer.OnArg(_: table, arg: string, name: string, n: number) got[#got + 1] = `arg {arg} {name} {n}` end
    register(consumer, "Kill", "OnKill")
    r:fire("Kill", 1)
    register(consumer, "Kill", "OnArg", "x")
    r:fire("Kill", 2)
    register(consumer, "Kill", function(arg: string, name: string, n: number) got[#got + 1] = `fn {arg} {name} {n}` end, "y")
    r:fire("Kill", 3)
    register("SomeAddon", "Kill", function(_: string, n: number) got[#got + 1] = `string {n}` end)
    r:fire("Kill", 4)
    unregister(consumer, "Kill")
    unregisterAll("SomeAddon")
    r:fire("Kill", 5)
    t:eq(table.concat(got, ", "), "method true Kill 1, arg x Kill 2, fn y Kill 3, fn y Kill 4, string 4", "CallbackHandler semantics")
    t:eq(r:has("Kill"), false, "unregistered")
    t:eq(callbacks.registry().RegisterCallback, nil, "no compat face by default")
end)
