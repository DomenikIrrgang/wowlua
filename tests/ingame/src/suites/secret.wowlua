-- wowlua:secret: helpers for secret values, against the client's own.
-- On WoW: Forever the player's health is secret even out of combat.
import * as secret from "wowlua:secret"
import suite, say from "/harness"

local s = suite("secret")

s:test("the helpers never touch a secret", function(t)
    const hp = UnitHealth("player")
    const known = secret.known(hp, -1)
    t:ok(known == -1 or known > 0, `known: {known}`)
    t:ok(secret.flag(UnitIsUnit("player", "player")), "flag: the player is the player")
    t:ok(not secret.flag(nil), "flag: nil is false")
    -- Widgets take the amount, secret or not.
    const bar = CreateFrame("StatusBar", nil, UIParent)
    bar:SetMinMaxValues(0, secret.amount(UnitHealthMax("player")))
    bar:SetValue(secret.amount(hp))
    const text = UIParent:CreateFontString(nil, "ARTWORK", "GameFontNormal")
    text:SetText(secret.abbreviate(hp))
    bar:Hide()
    text:Hide()
    t:ok(true, "a status bar and a font string took the values")
end)

-- What the client allows on a secret number (reported, not checked: the
-- language's rules follow from it).
s:test("probe: operations on a secret number", function(t)
    const hp = UnitHealth("player")
    if not secret.isSecret(hp) then
        say("probe: the player's health is not secret here")
        t:ok(true, "nothing to probe")
        return
    end
    const raw = hp :: any
    local function try(label: string, fn: () -> any)
        local ok, err = pcall(fn)
        say(`probe: {label}: {ok and "allowed" or ("error: " .. tostring(err))}`)
    end
    try("`v or 0`", function() return raw or 0 end)
    try("`not v`", function() return not raw end)
    try("`v == nil`", function() return raw == nil end)
    try("`type(v)`", function() return type(raw) end)
    try("`v .. \"\"`", function() return raw .. "" end)
    try("`tostring(v)`", function() return tostring(raw) end)
    t:ok(true, "probed")
end)
