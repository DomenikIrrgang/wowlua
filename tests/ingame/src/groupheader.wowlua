-- /stdtest engine groupheader <variant>: a group header updated by addon
-- code, then a later secure update in a fight that lists fewer units
-- (issue #275). In the game an addon that called `SecureGroupHeader_Update`
-- itself had every protected call of such an update refused. The first
-- round (PROBES.md) reproduced it alone; this second one tells where the
-- taint lives: in the file-local tables every header shares (`sortingTable`,
-- `tokenTable`), or in the header the addon updated (its buttons, their
-- attributes).
--
-- Alone, any class, out of combat. Two group headers that list you, both
-- filtered to group 1: A, and B, whose `groupFilter` Blizzard's state driver
-- turns to 2 in a fight (`[combat] 2; 1`), so its update then leaves you
-- out. The variant's addon action, nothing else in between:
--   none     nothing (the control)
--   other    `SecureGroupHeader_Update(A)` from StdTest's code: B, refused
--            in the fight, means shared tables
--   self     `SecureGroupHeader_Update(B)` from StdTest's code
--   rewrite  as self, then a secure update of B with the same unit (an
--            attribute of its own set): clean in the fight means the taint
--            is in what an update with the same unit writes again
-- Then a fight: every refusal (ADDON_ACTION_BLOCKED, ADDON_ACTION_FORBIDDEN)
-- and the functions named, and whether B's button was hidden. Taint lasts
-- until /reload: one variant per session. Into
-- StdTestState.engineGroupHeader2<Variant>, its lines in order.
import state from "/state"
import stamp from "/state"
import say from "/harness"

local G = _G :: any

const VARIANTS: { [string]: { key: string, part: string } } = {
    none = { key = "engineGroupHeader2None", part = "groupheader2-none" },
    other = { key = "engineGroupHeader2Other", part = "groupheader2-other" },
    self = { key = "engineGroupHeader2Self", part = "groupheader2-self" },
    rewrite = { key = "engineGroupHeader2Rewrite", part = "groupheader2-rewrite" },
}

const A = "StdTestProbeHeaderA"
const B = "StdTestProbeHeaderB"

--- A variable's taint, as `issecurevariable` tells it.
local function taintOf(name: string): string
    local secure, by = issecurevariable(name)
    if secure then
        return "secure"
    end
    return `tainted {tostring(by)}`
end

--- A header's shown buttons' units, in order (`-` for none).
local function units(header: any): string
    const list: string[] = {}
    local i = 1
    while true do
        const button = header:GetAttribute(`child{i}`)
        if not button then
            break
        end
        if button:IsShown() then
            list[#list + 1] = tostring(button:GetAttribute("unit"))
        end
        i += 1
    end
    return #list > 0 and table.concat(list, ",") or "-"
end

--- A group header from Blizzard's template, set up as raid frame addons
--- do, listing you alone (group 1).
local function makeHeader(name: string): any
    const h = CreateFrame("Frame", name, UIParent, "SecureGroupHeaderTemplate") :: any
    h:SetAttribute("template", "SecureUnitButtonTemplate")
    h:SetAttribute("showSolo", true)
    h:SetAttribute("showPlayer", true)
    h:SetAttribute("showParty", true)
    h:SetAttribute("showRaid", true)
    h:SetAttribute("groupFilter", "1")
    h:SetPoint("CENTER")
    h:Show()
    return h
end

local running = false
local ran = false

export function groupHeaderProbe(variant: string?)
    const chosen = VARIANTS[variant ?? ""]
    if not chosen then
        say("engine groupheader: name a variant: none (the control), other, self or rewrite; one per session")
        return
    end
    if running then
        say("engine groupheader: already running; follow its last line")
        return
    end
    if ran or G[A] then
        say("engine groupheader: one variant per session; type /reload first")
        return
    end
    if InCombatLockdown() then
        say("engine groupheader: leave combat first")
        return
    end
    if IsInGroup() then
        say("engine groupheader: leave your group first (the probe needs you alone)")
        return
    end
    running = true
    ran = true
    const log: string[] = {}
    const st = state() :: any
    st[chosen.key] = log
    stamp(chosen.part)
    local function note(what: string)
        if #log < 200 then
            log[#log + 1] = what
        end
    end
    note(`client {(GetBuildInfo())} ({select(2, GetBuildInfo())}) variant {variant}`)

    -- The refusals the client fires while the probe runs.
    const refused: string[] = {}
    const watcher = CreateFrame("Frame")
    watcher:RegisterEvent("ADDON_ACTION_BLOCKED")
    watcher:RegisterEvent("ADDON_ACTION_FORBIDDEN")
    local active = true
    watcher:SetScript("OnEvent", function(_: any, event: string, addon: any, fn: any)
        if active and #refused < 2000 then
            refused[#refused + 1] = `{event} {tostring(addon)} {tostring(fn)}`
        end
    end)

    const a = makeHeader(A)
    const b = makeHeader(B)
    G.RegisterAttributeDriver(b, "groupFilter", "[combat] 2; 1")
    -- Each first button made by the header's OnShow, set off by Show from
    -- StdTest's code: its global tells whether that update ran secure.
    note(`shown a={units(a)} {taintOf(`{A}UnitButton1`)} b={units(b)} {taintOf(`{B}UnitButton1`)} refusals={#refused}`)

    if variant == "other" then
        G.SecureGroupHeader_Update(a)
    elseif variant == "self" or variant == "rewrite" then
        G.SecureGroupHeader_Update(b)
    end
    if variant == "rewrite" then
        b:SetAttribute("stdtest-layout", 1)
    end
    note(`after {variant} a={units(a)} b={units(b)} refusals={#refused}`)

    local phase = "wait"
    local inFight = 0
    local seen = false
    local ticker: any = nil
    local function finish(why: string)
        if not active then
            return
        end
        active = false
        running = false
        watcher:UnregisterAllEvents()
        if ticker then
            ticker:Cancel()
        end
        note(why)
        say(`engine groupheader: {why}; type /reload so the file is written`)
    end
    --- The refusals since `from`: their count and each function's count.
    local function summary(from: number): string
        const counts: { [string]: number } = {}
        const order: string[] = {}
        for i = from + 1, #refused do
            const fn = refused[i]
            const had = counts[fn]
            if not had then
                order[#order + 1] = fn
            end
            counts[fn] = (had ?? 0) + 1
        end
        const parts: string[] = {}
        for i = 1, math.min(#order, 8) do
            parts[#parts + 1] = `{order[i]} x{counts[order[i]]}`
        end
        return `refusals={#refused - from}{#parts > 0 and ` {table.concat(parts, "; ")}` or ""}`
    end
    local function ask()
        say("engine groupheader: attack a training dummy or any enemy, stay in the fight 3 seconds, then leave it")
    end
    const fights = CreateFrame("Frame")
    fights:RegisterEvent("PLAYER_REGEN_DISABLED")
    fights:RegisterEvent("PLAYER_REGEN_ENABLED")
    fights:SetScript("OnEvent", function(_: any, event: string)
        if not active then
            return
        end
        if event == "PLAYER_REGEN_DISABLED" and phase == "wait" then
            phase = "fight"
            seen = false
            inFight = #refused
            -- After the state driver has run (it checks every 0.2 seconds).
            C_Timer.After(1.5, function()
                if not active or phase ~= "fight" then
                    return
                end
                seen = true
                const button = G[`{B}UnitButton1`]
                note(`in fight lockdown={tostring(InCombatLockdown())} groupFilter={tostring(b:GetAttribute("groupFilter"))} a={units(a)} b={units(b)} button1 shown={tostring(button and button:IsShown())} {summary(inFight)}`)
            end)
        elseif event == "PLAYER_REGEN_ENABLED" and phase == "fight" then
            phase = "wait"
            if not seen then
                note("fight too short")
                ask()
                return
            end
            note(`fight over {summary(inFight)}`)
            finish("recorded")
        end
    end)
    const deadline = GetTime() + 600
    ticker = C_Timer.NewTicker(1, function()
        if GetTime() > deadline then
            fights:UnregisterAllEvents()
            finish(`stopped in phase {phase}: ten minutes passed`)
        end
    end)
    ask()
end
