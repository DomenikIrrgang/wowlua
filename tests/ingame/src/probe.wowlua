-- `/stdtest probe`: records the client's Lua environment in the saved
-- `StdTestState.luaEnv`, to compare with the declarations of
-- `lua.d.wowlua` (after a /reload writes it to disk).
import state from "/state"
import say from "/harness"

-- Standard library tables a Lua 5.1 host (or a later one) may have.
const LIBRARIES = {
    "string", "table", "math", "coroutine", "os", "io", "debug", "package",
    "bit", "bit32", "utf8", "jit", "ffi",
}

export type LuaEnvironment = {
    version: string,
    --- Library → its members and their types; `false`: absent.
    libraries: { [string]: { [string]: string } | false },
    --- Every global function whose name is all lowercase (the Lua aliases
    --- WoW adds, such as `date`, `strsplit`, `tinsert`).
    lowercase: string[],
    --- Calls that must work for wowlua:format and the runtime.
    calls: { [string]: string },
}

local function try(fn: () -> any): string
    local ok, result = pcall(fn)
    if ok then
        return `ok: {type(result)}`
    end
    return `error: {tostring(result)}`
end

-- Every value a call returns, to check the declared signatures.
local function pack(...: any): (number, any[])
    return select("#", ...), { ... }
end

local function results(fn: () -> ...any): string
    local n, packed = pack(pcall(fn))
    if not packed[1] then
        return `error: {tostring(packed[2])}`
    end
    const parts: string[] = {}
    for i = 2, n do
        local v = packed[i]
        if type(v) == "table" then
            const items: string[] = {}
            for k, x in pairs(v :: table) do
                items[#items + 1] = `{tostring(k)}={tostring(x)}`
            end
            table.sort(items)
            parts[#parts + 1] = `\{{table.concat(items, ",")}\}`
        else
            parts[#parts + 1] = `{type(v)} {tostring(v)}`
        end
    end
    return `{n - 1} values: {table.concat(parts, "; ")}`
end

-- The client's additions to the libraries, called untyped.
const M = math :: any
const S = string :: any
const T = table :: any

export function probe()
    const env: LuaEnvironment = {
        version = tostring(_VERSION),
        libraries = {},
        lowercase = {},
        calls = {},
    }
    for _, name in ipairs(LIBRARIES) do
        const lib = _G[name]
        if type(lib) == "table" then
            const members: { [string]: string } = {}
            for key, value in pairs(lib :: table) do
                members[tostring(key)] = type(value)
            end
            env.libraries[name] = members
        else
            env.libraries[name] = false
        end
    end
    for key, value in pairs(_G) do
        if type(key) == "string" and type(value) == "function" and key:match("^[a-z_][a-z0-9_]*$") then
            env.lowercase[#env.lowercase + 1] = key
        end
    end
    table.sort(env.lowercase)
    env.calls = {
        ["date()"] = try(function() return _G.date() end),
        ['date("*t")'] = try(function() return _G.date("*t") end),
        ["time()"] = try(function() return _G.time() end),
        ["difftime(1, 0)"] = try(function() return _G.difftime(1, 0) end),
        ["os.time()"] = try(function() return (_G.os :: any).time() end),
        ["os.date()"] = try(function() return (_G.os :: any).date() end),
        ["os.clock()"] = try(function() return (_G.os :: any).clock() end),
        ["debugprofilestop()"] = try(function() return _G.debugprofilestop() end),
    }
    const additions: { [string]: string } = {
        ["math.clamp(5, 1, 3)"] = results(function() return M.clamp(5, 1, 3) end),
        ["math.round(2.5)"] = results(function() return M.round(2.5) end),
        ["math.round(2.345, 2)"] = results(function() return M.round(2.345, 2) end),
        ["math.sign(-3)"] = results(function() return M.sign(-3) end),
        ["math.wrap(370, 0, 360)"] = results(function() return M.wrap(370, 0, 360) end),
        ["math.lerp(0, 10, 0.25)"] = results(function() return M.lerp(0, 10, 0.25) end),
        ["math.normalize(5, 0, 10)"] = results(function() return M.normalize(5, 0, 10) end),
        ["math.remap(5, 0, 10, 0, 100)"] = results(function() return M.remap(5, 0, 10, 0, 100) end),
        ["math.saturate(1.5)"] = results(function() return M.saturate(1.5) end),
        ["math.isnan(0/0)"] = results(function() return M.isnan(0 / 0) end),
        ["math.isinf(1/0)"] = results(function() return M.isinf(1 / 0) end),
        ["math.isfinite(1)"] = results(function() return M.isfinite(1) end),
        ['string.startswith("wowlua", "wow")'] = results(function() return S.startswith("wowlua", "wow") end),
        ['string.endswith("wowlua", "lua")'] = results(function() return S.endswith("wowlua", "lua") end),
        ['string.contains("wowlua", "wl")'] = results(function() return S.contains("wowlua", "wl") end),
        ['string.contains("a.b", ".")'] = results(function() return S.contains("a.b", ".") end),
        ['string.ltrim("  a  ")'] = results(function() return S.ltrim("  a  ") end),
        ['string.rtrim("xax", "x")'] = results(function() return S.rtrim("xax", "x") end),
        ['string.concat("a", 1, "b")'] = results(function() return S.concat("a", 1, "b") end),
        ['string.rtgsub("aa", "a", "b")'] = results(function() return S.rtgsub("aa", "a", "b") end),
        ['string.gfind("a", "a")'] = results(function() return S.gfind("a", "a") end),
        ["table.count({1, 2, x = 3})"] = results(function() return T.count({ 1, 2, x = 3 }) end),
        ["table.getcountinfo({1, 2, x = 3})"] = results(function() return T.getcountinfo({ 1, 2, x = 3 }) end),
        ["table.create(4, 2)"] = results(function() return T.create(4, 2) end),
        ['table.contains({"a", "b"}, "b")'] = results(function() return T.contains({ "a", "b" }, "b") end),
        ['table.indexof({"a", "b"}, "b")'] = results(function() return T.indexof({ "a", "b" }, "b") end),
        ['table.indexof({"a"}, "z")'] = results(function() return T.indexof({ "a" }, "z") end),
        ["table.isempty({})"] = results(function() return T.isempty({}) end),
        ["table.keys({x = 1, y = 2})"] = results(function() return T.keys({ x = 1, y = 2 }) end),
        ["table.values({x = 1, y = 2})"] = results(function() return T.values({ x = 1, y = 2 }) end),
        ['table.removevalue({"a", "b", "a"}, "a")'] = results(function()
            const t = { "a", "b", "a" }
            const r = { T.removevalue(t, "a") }
            return #t, unpack(r)
        end),
        ['table.removeunordered({"a", "b", "c"}, 1)'] = results(function()
            const t = { "a", "b", "c" }
            const r = { T.removeunordered(t, 1) }
            return table.concat(t, ","), unpack(r)
        end),
        ["table.freeze(t), then a write"] = results(function()
            const t = {}
            const r = { T.freeze(t) }
            const ok = pcall(function() (t :: any).x = 1 end)
            return T.isfrozen(t), ok, unpack(r)
        end),
        ["table.setn({}, 1)"] = results(function() return T.setn({}, 1) end),
    }
    env.calls["additions"] = "see luaEnvAdditions"
    state().luaEnvAdditions = additions
    state().luaEnv = env
    local present = 0
    for _, name in ipairs(LIBRARIES) do
        if env.libraries[name] then
            present += 1
        end
    end
    say(`probe: {env.version}, {present} libraries, {#env.lowercase} lowercase functions; os {env.libraries.os and "present" or "absent"}`)
    say("probe: saved; type /reload so the file is written")
end
