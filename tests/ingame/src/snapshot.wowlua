-- `/stdtest snapshot`: the world the character is in, as a world profile
-- for `wowlua test` (decision T213), taken by the dev runtime's snapshot
-- (`/wl snapshot`, decision T498). Saved in StdTestState.snapshot (after
-- /reload); `cargo xtask profile <StdTest.lua> <out.json>` writes the
-- profile with the player's name, realm and GUIDs scrubbed.
import state from "/state"
import stamp from "/state"
import say from "/harness"

local _, ns = ...

--- The dev runtime's snapshot (StdTest is installed as a dev build).
local function runtime(): { take: () -> { [string]: any }, prepare: () -> (() -> ()) }
    const s = (ns.__wowlua :: any).snapshot
    if not s then
        error("the snapshot needs a dev build: wowlua install (the dev profile)")
    end
    return s
end

--- The character's world now, as a test profile's data.
export function takeSnapshot(): { [string]: any }
    return runtime().take()
end

export function snapshot()
    -- The toy box lists its toys a frame after its checks change.
    const putBack = runtime().prepare()
    say("snapshot: a moment...")
    C_Timer.After(0.5, function()
        const profile = takeSnapshot()
        putBack()
        const failed = profile.errors :: string[]
        const st = state() :: any
        st.snapshot = profile
        stamp("snapshot")
        say(`snapshot: recorded{#failed > 0 and ` ({#failed} parts failed)` or ""}; type /reload so the file is written`)
    end)
end
