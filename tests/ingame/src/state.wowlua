-- What a run keeps across a /reload: the SavedVariable `StdTestState`
-- (available from @onLoad on).
import type TestRecord from "/harness"

--- The saved suite's data for the test after the /reload.
export type ReloadCheck = { pending: boolean, profileBefore: string, migrationsBefore: number }

export type RunState = { results: TestRecord[]?, time: string?, reload: ReloadCheck?, luaEnv: any?, luaEnvAdditions: { [string]: string }?, luaEnvArithmetic: { [string]: string }?, conformance: { client: string, interface: number, results: { [string]: string }, kinds: { [string]: string } }? }

export function state(): RunState
    if type(StdTestState) ~= "table" then
        StdTestState = {}
    end
    return StdTestState
end

--- Stamps a probe's result `part` (`"answers"`, `"trainer:WARRIOR-911"`,
--- `"scenario:quest"`): when, and on which client, it was recorded
--- (`StdTestState.engineStamps`; `cargo xtask ingest` takes a part only
--- when it is newer than the repository's).
export function stamp(part: string)
    const st = state() :: any
    st.engineStamps = st.engineStamps ?? {}
    st.engineStamps[part] = {
        at = date("%Y-%m-%d %H:%M:%S"),
        client = `{(GetBuildInfo())} ({select(2, GetBuildInfo())})`,
    }
end
