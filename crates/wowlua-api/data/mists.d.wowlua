    --- Whether the scene's light is turned on.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function IsLightVisible(): boolean
    --- Projects a point in the scene onto the screen and returns its 2D position and depth, or nil if it cannot be projected.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function Project3DPointTo2D(pointX: number, pointY: number, pointZ: number): (number?, number?, number?)
    --- Sets whether the scene's models may be drawn overlapping other models.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetAllowOverlappedModels(allowOverlappedModels: boolean)
    --- Sets the camera's far clipping distance.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetCameraFarClip(farClip: number)
    --- Sets the camera's field of view.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetCameraFieldOfView(fov: number)
    --- Sets the camera's near clipping distance.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetCameraNearClip(nearClip: number)
    --- Sets the camera's orientation from its forward, right and up direction vectors.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetCameraOrientationByAxisVectors(forwardX: number, forwardY: number, forwardZ: number, rightX: number, rightY: number, rightZ: number, upX: number, upY: number, upZ: number)
    --- Sets the camera's orientation from yaw, pitch and roll angles.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetCameraOrientationByYawPitchRoll(yaw: number, pitch: number, roll: number)
    --- Sets the x, y and z position of the scene's camera.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetCameraPosition(positionX: number, positionY: number, positionZ: number)
    --- Sets how strongly the model scene is desaturated.
    ---
    --- **Parameters**
    --- - `strength`: Desaturation strength, from 0 (full color) to 1 (grayscale).
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetDesaturation(strength: number)
    --- Sets the scene's draw layer.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetDrawLayer(layer: DrawLayer)
    --- Sets the color of the scene's fog from red, green and blue components.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetFogColor(colorR: number, colorG: number, colorB: number)
    --- Sets the distance at which the scene's fog is at full strength.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetFogFar(far: number)
    --- Sets the distance at which the scene's fog begins.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetFogNear(near: number)
    --- Sets the ambient color of the scene's light from red, green and blue components.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetLightAmbientColor(colorR: number, colorG: number, colorB: number)
    --- Sets the diffuse color of the scene's light from red, green and blue components.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetLightDiffuseColor(colorR: number, colorG: number, colorB: number)
    --- Sets the direction vector of the scene's light.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetLightDirection(directionX: number, directionY: number, directionZ: number)
    --- Sets the x, y and z position of the scene's light.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetLightPosition(positionX: number, positionY: number, positionZ: number)
    --- Sets the type of the scene's light.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetLightType(lightType: ModelLightType)
    --- Turns the scene's light on or off.
    ---
    --- **Parameters**
    --- - `visible`: Whether the light is on.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetLightVisible(visible: boolean?)
    --- Pauses or resumes the scene's animations.
    ---
    --- **Parameters**
    --- - `affectsGlobalPause`: Whether the change also applies to the global animation pause.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetPaused(paused: boolean, affectsGlobalPause: boolean?)
    --- Sets the insets of the scene's view from the frame's edges.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetViewInsets(insets: uiRect)
    --- Sets the horizontal and vertical offset of the scene's view.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function SetViewTranslation(translationX: number, translationY: number)
    --- Takes an actor from the scene's pool of unused actors.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function TakeActor()
end

declare class NamePlate
    --- Returns true if this nameplate permits changes to its hit-test points. Updates are normally blocked for tainted code during combat, except on the tick a unit is first assigned or when untainted code updates hit-test points on the same tick.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_NamePlate_CanChangeHitTestPoints)
    function CanChangeHitTestPoints(): boolean
    --- Clears the anchor points that determine where the mouse interacts with the nameplate.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_NamePlate_ClearAllHitTestPoints)
