declare namespace C_ActionBar
    --- Used in conjunction with `ACTION_RANGE_CHECK_UPDATE` to inform the UI when an action goes in or out of range with its current target.
    ---
    --- **Parameters**
    --- - `enable`: True if changes in range for the action should dispatch ActionRangeCheckUpdate. False if the action no longer needs the event.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.EnableActionRangeCheck)
    function EnableActionRangeCheck(actionID: number, enable: boolean)
    --- Returns the list of action bar slots that contain the Assisted Combat action spell.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.FindAssistedCombatActionButtons)
    function FindAssistedCombatActionButtons(): number[]?
    --- Returns the action slots that hold the pet action.
    ---
    --- **Parameters**
    --- - `setToSearch`: Which action bars to search.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.FindPetActionButtons)
    function FindPetActionButtons(petActionID: number): number[]?
    --- Returns the list of action bar slots that contain a specified spell.
    ---
    --- **Parameters**
    --- - `spellID`: Expects a base spell, so if a spell is overridden the base ID should be provided.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_ActionBar.FindSpellActionButtons)
    function FindSpellActionButtons(spellID: SpellIdentifier): number[]?
