--- Returns information about the specified toon of a RealID friend.
---
--- **Parameters**
--- - `friendIndex`: Ranging from 1 to `BNGetNumFriendGameAccounts`()
--- - `bnetIDGameAccount`: A unique numeric identifier for the friend during this session.
---
--- **Returns**
--- - `hasFocus`: Whether or not this toon is the one currently being displayed in Blizzard's FriendFrame.
--- - `characterName`: The name of the logged in toon/character.
--- - `client`: Either "WoW" (BNET_CLIENT_WOW), "S2" (BNET_CLIENT_S2), "WTCG" (BNET_CLIENT_WTCG), "App" (BNET_CLIENT_APP), "Hero" (BNET_CLIENT_HEROES), "Pro" (BNET_CLIENT_OVERWATCH), "CLNT" (BNET_CLIENT_CLNT), or "D3" (BNET_CLIENT_D3) for World of Warcraft, StarCraft 2, Hearthstone, BNet Application, Heroes of the Storm, Overwatch, another client, or Diablo 3.
--- - `realmName`: The name of the logged in realm.
--- - `realmID`: The ID for the logged in realm.
--- - `faction`: The faction name (i.e., "Alliance" or "Horde").
--- - `race`: The localized race name (e.g., "Blood Elf").
--- - `class`: The localized class name (e.g., "Death Knight").
--- - `guild`: Seems to return "" even if the player is in a guild.
--- - `zoneName`: The localized zone name (e.g., "The Undercity").
--- - `level`: The current level (e.g., "90").
--- - `gameText`: For WoW, returns "`zoneName` - `realmName`". For StarCraft 2 and Diablo 3, returns the location or activity the player is currently engaged in.
--- - `broadcastText`: The Battle.Net broadcast message.
--- - `broadcastTime`: The number of seconds elapsed since the current broadcast message was sent.
--- - `canSoR`: Whether or not this friend can receive a Scroll of Resurrection.
--- - `toonID`: A unique numeric identifier for the friend's character during this session.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_BNGetFriendGameAccountInfo)
declare function BNGetFriendGameAccountInfo(friendIndex: number): (boolean, string, string, string, number, string, string, string, string, string, string, string, string, number, boolean, number, number, boolean, boolean)
declare function BNGetFriendGameAccountInfo(bnetIDGameAccount: number): (boolean, string, string, string, number, string, string, string, string, string, string, string, string, number, boolean, number, number, boolean, boolean)
declare function BNGetFriendGameAccountInfo(guid: string): (boolean, string, string, string, number, string, string, string, string, string, string, string, string, number, boolean, number, number, boolean, boolean)
--- Returns information about the specified RealID friend.
---
--- **Parameters**
--- - `friendIndex`: The index on the friends list for this RealID friend, ranging from 1 to `BNGetNumFriends`()
--- - `bnetAccountID`: A unique numeric identifier for this friend's battle.net account for the current session
---
--- **Returns**
--- - `bnetAccountID`: A temporary ID for the friend's battle.net account during this session.
--- - `accountName`: An escape sequence (starting with |K) representing the friend's full name or BattleTag name.
--- - `battleTag`: A nickname and number that when combined, form a unique string that identifies the friend (e.g., "Nickname#0001").
--- - `isBattleTagPresence`: Whether or not the friend is known by their BattleTag.
--- - `characterName`: The name of the logged in character.
--- - `bnetIDGameAccount`: A unique numeric identifier for the friend's game account during this session.
--- - `client`: See BNET_CLIENT
--- - `isOnline`: Whether or not the friend is online.
--- - `lastOnline`: The number of seconds elapsed since this friend was last online (from the epoch date of January 1, 1970). Returns nil if currently online.
--- - `isAFK`: Whether or not the friend is flagged as Away.
--- - `isDND`: Whether or not the friend is flagged as Busy.
--- - `messageText`: The friend's Battle.Net broadcast message.
--- - `noteText`: The contents of the player's note about this friend.
--- - `isRIDFriend`: Returns true for RealID friends and false for BattleTag friends.
--- - `messageTime`: The number of seconds elapsed since the current broadcast message was sent.
--- - `canSoR`: Whether or not this friend can receive a Scroll of Resurrection.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_BNGetFriendInfo)
declare function BNGetFriendInfo(friendIndex: number): (number, string, string, boolean, string, number, string, boolean, number?, boolean, boolean, string, string, boolean, number, boolean, boolean, boolean)
declare function BNGetFriendInfo(bnetAccountID: number): (number, string, string, boolean, string, number, string, boolean, number?, boolean, boolean, string, string, boolean, number, boolean, boolean, boolean)
declare function BNGetFriendInfoByID(arg1: unknown): (number, string?, string?, unknown, string?, unknown, unknown, unknown, unknown, unknown, unknown, string?, ...unknown)
declare function BNGetGameAccountInfo(arg1: unknown): (unknown, string?, unknown, unknown, number?, unknown, unknown, unknown, unknown, unknown, unknown, string?, ...unknown)
declare function BNGetGameAccountInfoByGUID(arg1: string): (...unknown)
