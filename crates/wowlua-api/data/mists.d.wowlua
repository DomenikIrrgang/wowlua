    --- - `urlType`: Which home page to open.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Browser_NavigateHome)
    function NavigateHome(urlType: string)
    --- Reloads the current page.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Browser_NavigateReload)
    function NavigateReload()
    --- Stops loading the current page.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Browser_NavigateStop)
    function NavigateStop()
    --- Opens the current page in the system's web browser.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Browser_OpenExternalLink)
    function OpenExternalLink()
    --- Opens the support ticket in the browser.
    ---
    --- **Parameters**
    --- - `index`: The ticket's index.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Browser_OpenTicket)
    function OpenTicket(index: number)
    --- Gives the browser keyboard focus.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Browser_SetFocus)
    function SetFocus()
    --- Sets the browser's zoom level.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_Browser_SetZoom)
    function SetZoom(zoom: number)
end

declare class Checkbox
    --- Whether the checkbox is checked.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function GetChecked(): boolean
    --- Returns the texture shown when the checkbox is checked.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function GetCheckedTexture(): Texture
    --- Returns the texture shown when the checkbox is checked and disabled.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function GetDisabledCheckedTexture(): Texture
