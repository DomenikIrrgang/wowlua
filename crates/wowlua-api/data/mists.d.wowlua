declare namespace C_Timer
    --- Schedules a timer.
    ---
    --- **Parameters**
    --- - `seconds`: Time in seconds before the timer finishes.
    --- - `callback`: Callback function to run.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_Timer.After)
    function After(seconds: number, callback: TimerCallback)
    --- Schedules a cancelable repeating timer.
    ---
    --- **Parameters**
    --- - `seconds`: Time in seconds between each iteration.
    --- - `callback`: Callback function to run. It will be supplied a view of the timer handle (`cbObject`) when invoked. The handle returned from the function and the one supplied to the callback are distinct objects that both reference a shared state.
    --- - `iterations`: Number of times to repeat, or indefinite if omitted.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_Timer.NewTicker)
    function NewTicker(seconds: number, callback: (handle: TickerHandle) -> (), iterations: number?): TickerHandle
    --- Schedules a cancelable timer.
    ---
    --- **Parameters**
    --- - `seconds`: Time in seconds between each iteration.
    --- - `callback`: Callback function to run. It will be supplied a view of the timer handle (`cbObject`) when invoked. The handle returned from the function and the one supplied to the callback are distinct objects that both reference a shared state.
    ---
    --- **Returns**
    --- - `cbObject`: Timer handle with `:Cancel()`, `:IsCancelled()` and `:Invoke()` methods.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_Timer.NewTimer)
    function NewTimer(seconds: number, callback: (handle: TimerHandle) -> ()): TimerHandle
end

