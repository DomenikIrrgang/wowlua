declare class AbbreviatedNumberFormatter extends NumericFormatter
    --- Adds a new breakpoint to the formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_AbbreviatedNumberFormatter_AddBreakpoint)
    function AddBreakpoint(breakpoint: NumberAbbreviationBreakpoint)
    --- Removes all configured breakpoints from the formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_AbbreviatedNumberFormatter_ClearBreakpoints)
    function ClearBreakpoints()
    --- Returns a new copy of this formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_AbbreviatedNumberFormatter_Copy)
    function Copy(): AbbreviatedNumberFormatter
    --- Returns a list of all configured breakpoints on this formatter.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_AbbreviatedNumberFormatter_GetBreakpoints)
    function GetBreakpoints(): NumberAbbreviationBreakpoint[]
    --- Removes all configured breakpoints from the formatter and replaces them with appropriate defaults for the client locale.
