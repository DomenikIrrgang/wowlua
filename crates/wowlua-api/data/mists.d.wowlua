declare namespace C_FriendList
    --- Adds a friend to your friend list.
    ---
    --- **Parameters**
    --- - `name`: The name of the player you would like to add.
    --- - `notes`: The note that will show in your friend list.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.AddFriend)
    function AddFriend(name: string, notes: string?)
    --- Adds a player to your ignore list.
    ---
    --- **Parameters**
    --- - `name`: the name of the player you would like to ignore.
    ---
    --- **Returns**
    --- - `added`: whether the player was succesfully added to your ignore list. This seems to *only* return false when trying to ignore someone who is already being ignored, otherwise true.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.AddIgnore)
    function AddIgnore(name: string): boolean
    --- Adds or removes a player to/from the ignore list.
    ---
    --- **Parameters**
    --- - `name`: the name of the player to add or remove.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.AddOrDelIgnore)
    function AddOrDelIgnore(name: string)
    --- Adds or removes a player to or from the friends list.
    ---
    --- **Parameters**
    --- - `name`: The name of the player to add or remove.
    --- - `notes`: (Required) The note in the friends frame.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.AddOrRemoveFriend)
    function AddOrRemoveFriend(name: string, notes: string)
    --- Removes a player from your ignore list.
    ---
    --- **Parameters**
    --- - `name`: the name of the player you would like to remove from your ignore list.
    ---
    --- **Returns**
    --- - `removed`: whether the player was succesfully removed from your ignore list.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.DelIgnore)
    function DelIgnore(name: string): boolean
    --- Removes a player from your ignore list.
    ---
    --- **Parameters**
    --- - `index`: index of the player you would like to remove.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.DelIgnoreByIndex)
    function DelIgnoreByIndex(index: number)
    --- Retrieves information about a person on your friends list.
    ---
    --- **Parameters**
    --- - `name`: name of friend in the friend list.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetFriendInfo)
    function GetFriendInfo(name: string): FriendInfo?
    --- Retrieves information about a person on your friends list.
    ---
    --- **Parameters**
    --- - `index`: index of the friend, up to `C_FriendList.GetNumFriends`() limited to max 100.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetFriendInfoByIndex)
    function GetFriendInfoByIndex(index: number): FriendInfo?
    --- Returns the name of a currently ignored player.
    ---
    --- **Parameters**
    --- - `index`: index of the ignored player, up to `C_FriendList.GetNumIgnores` (max 50).
    ---
    --- **Returns**
    --- - `name`: name of the ignored player.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetIgnoreName)
    function GetIgnoreName(index: number): string?
    --- Returns how many friends you have.
    ---
    --- **Returns**
    --- - `numFriends`: the number of friends you have (max 100).
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetNumFriends)
    function GetNumFriends(): number
    --- Returns the number of entries on your ignore list.
    ---
    --- **Returns**
    --- - `numIgnores`: the number of players on your ignore list (max 50).
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetNumIgnores)
    function GetNumIgnores(): number
    --- Returns the number of online friends.
    ---
    --- **Returns**
    --- - `numOnline`: the number of online friends.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetNumOnlineFriends)
    function GetNumOnlineFriends(): number
    --- Get the number of entries resulting from your most recent /who query.
    ---
    --- **Returns**
    --- - `numWhos`: Number of results returned
    --- - `totalNumWhos`: Number of results to display
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetNumWhoResults)
    function GetNumWhoResults(): (number, number)
    --- Returns the index of the currently selected friend.
    ---
    --- **Returns**
    --- - `index`: The index of the friend which is currently selected on the friend list. Returns `nil` if you have no friends.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetSelectedFriend)
    function GetSelectedFriend(): number?
    --- Returns the currently selected index in the ignore listing.
    ---
    --- **Returns**
    --- - `index`: the index of the ignored player which is currently selected on the friend list. Returns `nil` if you have nobody ignored.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetSelectedIgnore)
    function GetSelectedIgnore(): number?
    --- Retrieves info about a character on your current /who list.
    ---
    --- **Parameters**
    --- - `index`: Ranging from 1 up to `C_FriendList.GetNumWhoResults`
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.GetWhoInfo)
    function GetWhoInfo(index: number): WhoInfo?
    --- Returns whether a character is your friend.
    ---
    --- **Parameters**
    --- - `guid`: : GUID
    ---
    --- **Returns**
    --- - `isFriend`: whether the character is your friend.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.IsFriend)
    function IsFriend(guid: string): boolean
    --- Returns whether a character is being ignored by you.
    ---
    --- **Parameters**
    --- - `token`: The UnitId or name of the character.
    ---
    --- **Returns**
    --- - `isIgnored`: whether the character is ignored.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.IsIgnored)
    function IsIgnored(token: string): boolean
    --- Returns whether a character is being ignored by you.
    ---
    --- **Parameters**
    --- - `guid`: GUID of the character.
    ---
    --- **Returns**
    --- - `isIgnored`: whether the character is ignored.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.IsIgnoredByGuid)
    function IsIgnoredByGuid(guid: string): boolean
    --- Whether the player is on the ignore list.
    ---
    --- **Parameters**
    --- - `token`: The name of the player.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.IsOnIgnoredList)
    function IsOnIgnoredList(token: string): boolean
    --- Removes a friend from the friends list.
    ---
    --- **Parameters**
    --- - `name`: the name of the friend to remove.
    ---
    --- **Returns**
    --- - `removed`: whether the friend was successfully removed.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.RemoveFriend)
    function RemoveFriend(name: string): boolean
    --- Removes a friend from the friends list.
    ---
    --- **Parameters**
    --- - `index`: the index of the friend in the friends list to remove.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.RemoveFriendByIndex)
    function RemoveFriendByIndex(index: number)
    --- Requests a list of other online players.
    ---
    --- **Parameters**
    --- - `filter`: The criteria for which you want to perform a Who query. This can be anything for which you could normally search in a Who query:
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.SendWho)
    function SendWho(filter: string, origin: number?)
    --- Sets the note text for a friend.
    ---
    --- **Parameters**
    --- - `name`: name of friend in the friend list.
    --- - `notes`: the text that the friends note will be set to, up to 48 characters, anything longer will be truncated.
    ---
    --- **Returns**
    --- - `found`: Whether the friend's note was successfully set.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.SetFriendNotes)
    function SetFriendNotes(name: string, notes: string): boolean
    --- Sets the note text for a friend.
    ---
    --- **Parameters**
    --- - `index`: index of the friend, up to `C_FriendList.GetNumFriends` (max 100). Note that status changes can re-order the friend list, indices are not guaranteed to remain stable across events.
    --- - `notes`: the text that the friends note will be set to, up to 48 characters, anything longer will be truncated.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.SetFriendNotesByIndex)
    function SetFriendNotesByIndex(index: number, notes: string)
    --- Updates the current selected friend.
    ---
    --- **Parameters**
    --- - `index`: the index of the friend to be selected.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.SetSelectedFriend)
    function SetSelectedFriend(index: number)
    --- Sets the currently selected ignore entry.
    ---
    --- **Parameters**
    --- - `index`: the index of the ignored player to be selected.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.SetSelectedIgnore)
    function SetSelectedIgnore(index: number)
    --- Sets how the result of a /who request will be delivered.
    ---
    --- **Parameters**
    --- - `whoToUi`: If `true` the results will always be delivered as a `WHO_LIST_UPDATE` event and displayed in the **FriendsFrame**. If `false` the results may be returned as a sequence of `CHAT_MSG_SYSTEM` events (up to 3 results) *or* a WHO_LIST_UPDATE event (4+ results).
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.SetWhoToUi)
    function SetWhoToUi(whoToUi: boolean)
    --- Requests updated friends information from server.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.ShowFriends)
    function ShowFriends()
    --- Sorts the last /who reply received by the client.
    ---
    --- **Parameters**
    --- - `sorting`: The column by which you wish to sort the who list:
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_FriendList.SortWho)
    function SortWho(sorting: string)
end

