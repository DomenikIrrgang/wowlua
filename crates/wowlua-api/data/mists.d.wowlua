@widget("OffScreenFrame")
declare class OffScreenFrame extends Frame
    --- Applies the snapshot associated with the given ID to the given texture.
    ---
    --- **Parameters**
    --- - `texture`: Object - A texture object.
    --- - `ID`: Number - Unique identifier for a snapshot, as provided by OffScreenFrame:TakeSnapshot().
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_OffScreenFrame_ApplySnapshot)
    function ApplySnapshot(texture: Texture, snapshotID: number): boolean
    --- Discards the snapshots the frame holds.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_OffScreenFrame_Flush)
    function Flush()
    --- Returns how many snapshots the frame can hold.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_OffScreenFrame_GetMaxSnapshots)
    function GetMaxSnapshots(): number
    --- Whether the snapshot with the given ID still exists.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_OffScreenFrame_IsSnapshotValid)
    function IsSnapshotValid(snapshotID: number): boolean
    --- Sets how many snapshots the frame can hold.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_OffScreenFrame_SetMaxSnapshots)
    function SetMaxSnapshots(maxSnapshots: number)
    --- Takes a snapshot of all visible child frames, then returns a unique ID.
    ---
    --- **Returns**
    --- - `ID`: Number - Unique identifier for the snapshot.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_OffScreenFrame_TakeSnapshot)
    function TakeSnapshot(): number?
    --- Unavailable in public builds
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_OffScreenFrame_TestPrintToFile)
    function TestPrintToFile(snapshotID: number, filename: string): boolean
    --- Whether the frame uses textures whose sizes are not powers of two.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_OffScreenFrame_UsesNPOT)
    function UsesNPOT(): boolean?
end

