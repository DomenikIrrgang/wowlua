    function IsSpellKnown(spellID: number, spellBank: SpellBookSpellBank?): boolean
    --- Returns true if a spell is considered to be known or present in the spellbook
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_SpellBook.IsSpellKnownOrInSpellBook)
    function IsSpellKnownOrInSpellBook(spellID: number, spellBank: SpellBookSpellBank?, includeOverrides: boolean?): boolean
end

declare namespace C_SpellDiminish
    --- Returns information about all diminishing returns categories.
