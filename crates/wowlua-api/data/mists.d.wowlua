declare namespace C_AccountInfo
    --- Converts a battle.net account GUID to battle.net ID.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountInfo.GetIDFromBattleNetAccountGUID)
    function GetIDFromBattleNetAccountGUID(battleNetAccountGUID: string): number
    --- Returns whether a GUID is a batle.net account type.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountInfo.IsGUIDBattleNetAccountType)
    function IsGUIDBattleNetAccountType(guid: string): boolean
    --- Returns whether a GUID is related to the local (self) account.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountInfo.IsGUIDRelatedToLocalAccount)
    function IsGUIDRelatedToLocalAccount(guid: string): boolean
end

declare namespace C_AccountStore
    --- Starts buying the item from the account store.
    ---
    --- **Parameters**
    --- - `itemID`: The account store item's ID.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_AccountStore.BeginPurchase)
