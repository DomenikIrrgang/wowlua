    ---
    --- **Returns**
    --- - `equipmentSetID`: set ID of an equipment set with the specified name, or nil if no sets with the specified name are currently saved.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.GetEquipmentSetID)
    function GetEquipmentSetID(equipmentSetName: string): number?
    --- Returns an array containing all currently saved equipment set IDs.
    ---
    --- **Returns**
    --- - `equipmentSetIDs`: An array of equipment set IDs of the currently available equipment sets.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.GetEquipmentSetIDs)
    function GetEquipmentSetIDs(): number[]
    --- Returns information about a saved equipment set.
    ---
    --- **Parameters**
    --- - `equipmentSetID`: equipment set ID to query information about.
    ---
    --- **Returns**
    --- - `name`: name of the equipment set.
    --- - `iconFileID`: icon texture selected for the equipment set.
    --- - `setID`: equipment set ID.
    --- - `isEquipped`: true if all non-ignored slots in the set are currently equipped.
    --- - `numItems`: number of items included in the set.
    --- - `numEquipped`: number of items in the set currently equipped.
    --- - `numInInventory`: number of items in the set currently in the player's bags/bank, if bank is available.
    --- - `numLost`: number of items in the set that are not currently available to the player.
    --- - `numIgnored`: number of inventory slots ignored by the set.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.GetEquipmentSetInfo)
    function GetEquipmentSetInfo(equipmentSetID: number): (string?, number?, number?, boolean?, number?, number?, number?, number?, number?)
    --- Returns ignored slots of an equipment set.
    ---
    --- **Returns**
    --- - `slotIgnored`: indexed by InventorySlotId
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.GetIgnoredSlots)
    function GetIgnoredSlots(equipmentSetID: number): boolean[]?
    --- Returns the item IDs of an equipment set.
    ---
    --- **Parameters**
    --- - `equipmentSetID`: Appears to return valid info for indices `[0, 2, 4, ...]`
    ---
    --- **Returns**
    --- - `itemIDs`: a table of numbers indexed by InventorySlotId
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.GetItemIDs)
    function GetItemIDs(equipmentSetID: number): number[]?
    --- Returns the location of all items in an equipment set.
    ---
    --- **Returns**
    --- - `locations`: indexed by InventorySlotId
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.GetItemLocations)
    function GetItemLocations(equipmentSetID: number): number[]?
    --- Returns the number of saved equipment sets.
    ---
    --- **Returns**
    --- - `numEquipmentSets`: number of saved sets for the current character.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.GetNumEquipmentSets)
    function GetNumEquipmentSets(): number
    --- Ignores an equipment slot for saving.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.IgnoreSlotForSave)
    function IgnoreSlotForSave(slot: number)
    --- Returns whether a slot is ignored for saving.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.IsSlotIgnoredForSave)
    function IsSlotIgnoredForSave(slot: number): boolean
    --- Modifies an equipment set.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.ModifyEquipmentSet)
    function ModifyEquipmentSet(equipmentSetID: number, newName: string, newIcon: string?)
    --- Picks up an equipment set, placing it on the cursor.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.PickupEquipmentSet)
    function PickupEquipmentSet(equipmentSetID: number)
    --- Saves your currently equipped items into an equipment set.
    ---
    --- **Parameters**
    --- - `equipmentSetID`: can be retrieved from an existing equipment set by name with `C_EquipmentSet.GetEquipmentSetID`.
    --- - `icon`: icon to use for the equipment set. If ommited, the existing icon will be used.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.SaveEquipmentSet)
    function SaveEquipmentSet(equipmentSetID: number, icon: string?)
    --- Unassigns an equipment set from a specialization.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.UnassignEquipmentSetSpec)
    function UnassignEquipmentSetSpec(equipmentSetID: number)
    --- Unignores a slot for saving.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.UnignoreSlotForSave)
    function UnignoreSlotForSave(slot: number)
    --- Equips items from a specified equipment set.
    ---
    --- **Returns**
    --- - `setWasEquipped`: true if the set was equipped, nil otherwise. Failure conditions include invalid arguments, and engaging in combat.
    ---
    --- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_C_EquipmentSet.UseEquipmentSet)
    function UseEquipmentSet(equipmentSetID: number): boolean
end

declare namespace C_EventUtils
