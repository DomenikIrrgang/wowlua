declare class EventFrameMixin extends CallbackRegistryMixin
    --- Built-in load handler of the event frame, run when it is created.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function OnLoad_Intrinsic()
    --- Built-in hide handler of the event frame, run when it is hidden.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function OnHide_Intrinsic()
    --- Built-in show handler of the event frame, run when it is shown.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function OnShow_Intrinsic()
    --- Built-in size handler of the event frame, run when its size changes.
    ---
    --- *Description by wowlua: the API's documentation has none.*
    function OnSizeChanged_Intrinsic(width: number, height: number)
end

