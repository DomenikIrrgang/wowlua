--- **Parameters**
--- - `index1`: ID of first raid member (1 to `MAX_RAID_MEMBERS`)
--- - `index2`: ID of second raid member (1 to `MAX_RAID_MEMBERS`)
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SwapRaidSubgroup)
declare function SwapRaidSubgroup(index1: number, index2: number)
--- Switches the running file to the global environment. Blizzard's secure addons call it at the top of files that must run outside the secure environment.
---
--- *Description by wowlua: the API's documentation has none.*
declare function SwapToGlobalEnvironment(): (...unknown)
--- Switches the achievement search to a tab, given its index.
---
--- *Description by wowlua: the API's documentation has none.*
declare function SwitchAchievementSearchTab(arg1: number): (...unknown)
--- Takes the attached item from the mailbox message.
---
--- **Parameters**
--- - `messageIndex`: the index of the mailbox message you want to take the item attachment from.
--- - `attachIndex`: The index of the item to take (1-ATTACHMENTS_MAX_RECEIVE(16))
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TakeInboxItem)
declare function TakeInboxItem(messageIndex: number, attachIndex: number)
--- Take the attached money from the mailbox message at index.
---
--- **Parameters**
--- - `index`: a number representing a message in the inbox
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TakeInboxMoney)
declare function TakeInboxMoney(index: number)
--- Takes a copy of a mail's text as a letter item, given the mail's index.
---
--- *Description by wowlua: the API's documentation has none.*
declare function TakeInboxTextItem(index: unknown?, ...: unknown): (...unknown)
--- Travels to the specified flight path node.
---
--- **Parameters**
--- - `index`: Taxi node index to begin travelling to, ascending from 1 to `NumTaxiNodes`().
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TakeTaxiNode)
declare function TakeTaxiNode(index: number)
--- Returns the horizontal position of the destination node of a given route to the destination.
---
--- **Parameters**
--- - `destinationIndex`: The final destination taxi node.
--- - `routeIndex`: The index of the route to get the source from.
---
--- **Returns**
--- - `dX`: The horizontal position of the destination node for the route.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TaxiGetDestX)
declare function TaxiGetDestX(destinationIndex: number?, routeIndex: number?): number
--- Returns the vertical position of the destination node of a given route to the destination.
---
--- **Parameters**
--- - `destinationIndex`: The final destination taxi node.
--- - `routeIndex`: The index of the route to get the source from.
---
--- **Returns**
--- - `dY`: The vertical position of the destination node for the route.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TaxiGetDestY)
declare function TaxiGetDestY(destinationIndex: number?, routeIndex: number?): number
--- Returns the taxi node at one end of a flight route, given the node's index, the route's index and true for the source or false for the destination. Blizzard draws the route lines from it.
---
--- *Description by wowlua: the API's documentation has none.*
declare function TaxiGetNodeSlot(arg1: unknown, arg2: unknown, arg3: boolean): (number, ...unknown)
--- Returns the horizontal position of the source node of a given route to the destination.
---
--- **Parameters**
--- - `destinationIndex`: The final destination taxi node.
--- - `routeIndex`: The index of the route to get the source from.
---
--- **Returns**
--- - `sX`: The horizontal position of the source node.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TaxiGetSrcX)
declare function TaxiGetSrcX(destinationIndex: number?, routeIndex: number?): number
--- Returns the vertical position of the source node of a given route to the destination.
---
--- **Parameters**
--- - `destinationIndex`: The final destination taxi node.
--- - `routeIndex`: The index of the route to get the source from.
---
--- **Returns**
--- - `sY`: The vertical position of the source node.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TaxiGetSrcY)
declare function TaxiGetSrcY(destinationIndex: number?, routeIndex: number?): number
--- Returns whether a taxi node can be reached in one hop.
---
--- *Description by wowlua: the API's documentation has none.*
declare function TaxiIsDirectFlight(arg1: unknown): (...unknown)
--- Returns the cost of the flight path in copper.
---
--- **Parameters**
--- - `slot`: 1 ascending to `NumTaxiNodes`(), out of bound numbers triggers lua error.
---
--- **Returns**
--- - `cost`: returns the cost in copper, 0 if destination is undiscovered, free or current node.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TaxiNodeCost)
declare function TaxiNodeCost(slot: number): number
--- Returns the type of a flight path node.
---
--- **Parameters**
--- - `index`: Taxi map node index, ascending from 1 to `NumTaxiNodes`().
---
--- **Returns**
--- - `type`: "CURRENT" for the player's current position, "REACHABLE" for nodes that can be travelled to, "DISTANT" for nodes that can't be travelled to, and "NONE" if the index is out of bounds.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TaxiNodeGetType)
declare function TaxiNodeGetType(index: number): string
--- Returns the name of a flight path node.
---
--- **Parameters**
--- - `index`: Index of the taxi map node, ascending from 1 to `NumTaxiNodes`()
---
--- **Returns**
--- - `name`: name of the specified flight point, or "INVALID" if the index is out of bounds.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TaxiNodeName)
declare function TaxiNodeName(index: number): string
--- Returns the position of a flight point on the taxi map.
---
--- **Parameters**
--- - `index`: index of a flight point between 1 and `NumTaxiNodes`()
---
--- **Returns**
--- - `x`: Horizontal coordinate of the taxi note (as a proportion of the taxi map's width; 0 = left edge, 1 = right edge)
--- - `y`: Vertical coordinate of the taxi note (as a proportion of the taxi map's width; 0 = bottom edge, 1 = top edge)
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TaxiNodePosition)
declare function TaxiNodePosition(index: number): (number, number)
--- Asks to land early from a flight path.
---
--- *Description by wowlua: the API's documentation has none.*
declare function TaxiRequestEarlyLanding(): (...unknown)
