--- *Description by wowlua: the API's documentation has none.*
declare function TurnInGuildCharter(...: unknown): (...unknown)
--- Turns the player left at the specified time.
---
--- **Parameters**
--- - `startTime`: Begin turning left at this time, per `GetTime` * 1000.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TurnLeftStart)
declare function TurnLeftStart(startTime: number)
--- The player stops turning left at the specified time.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TurnLeftStop)
declare function TurnLeftStop()
--- Starts a "right click" in the 3D game world.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TurnOrActionStart)
declare function TurnOrActionStart()
--- Stops a "right click" in the 3D game world.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TurnOrActionStop)
declare function TurnOrActionStop()
--- Turns the player right at the specified time.
---
--- **Parameters**
--- - `startTime`: Begin turning right at this time, per `GetTime` * 1000
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TurnRightStart)
declare function TurnRightStart(startTime: number)
--- The player stops turning right at the specified time.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_TurnRightStop)
declare function TurnRightStop()
--- Removes a player from the group if you're the leader, or initiates a vote to kick.
---
--- **Parameters**
--- - `name`: Name of the player to remove from group. When removing cross-server players, it is important to include the server name: "Ygramul-Emerald Dream".
--- - `reason`: Used when initiating a kick vote against the player.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_UninviteUnit)
declare function UninviteUnit(name: string, reason: string?)
--- Returns true if the unit is currently being resurrected.
---
--- **Parameters**
--- - `unit`: either the unitID ("player", "target", "party3", etc) or unit's name ("Bob" or "Bob-Llane")
---
--- **Returns**
--- - `isBeingResurrected`: Returns true if the unit is being resurrected by any means, be it spell, item, or some other method. Returns nil/false otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_UnitHasIncomingResurrection)
declare function UnitHasIncomingResurrection(unit: UnitToken): boolean?
--- Returns whether the unit is currently unable to use the dungeon finder due to leaving a group prematurely.
---
--- **Parameters**
--- - `unit`: UnitId - the unit that would assist (e.g., "player" or "target")
---
--- **Returns**
--- - `isDeserter`: true if the unit is currently an LFG deserter (and hence unable to use the dungeon finder), false otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_UnitHasLFGDeserter)
declare function UnitHasLFGDeserter(unit: UnitToken): boolean
--- Returns whether the unit is currently under the effects of the random dungeon cooldown.
---
--- **Parameters**
--- - `unit`: UnitId - the unit that would assist (e.g., "player" or "target")
---
--- **Returns**
--- - `hasRandomCooldown`: true if the unit is currently unable to queue for random dungeons due to the random cooldown, false otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_UnitHasLFGRandomCooldown)
declare function UnitHasLFGRandomCooldown(unit: UnitToken): boolean
