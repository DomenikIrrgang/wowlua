--- Sets a key binding to an action.
---
--- **Parameters**
--- - `key`: Any binding string accepted by World of Warcraft. For example: "ALT-CTRL-F", "SHIFT-T", "W", "BUTTON4".
--- - `command`: Any name attribute value of a Bindings.xml-defined binding, or an action command string, or nil to unbind all bindings from key. For example:
--- - `mode`: 1 if the binding should be saved to the currently loaded binding set (default), or 2 if to the alternative.
---
--- **Returns**
--- - `ok`: 1 if the binding has been changed successfully, nil otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SetBinding)
declare function SetBinding(key: string, command: string?, mode: number?): boolean?
--- Sets a binding to click the specified Button widget.
---
--- **Parameters**
--- - `key`: Any binding string accepted by World of Warcraft. For example: "ALT-CTRL-F", "SHIFT-T", "W", "BUTTON4".
--- - `buttonName`: Name of the button you wish to click.
--- - `button`: Value of the button argument you wish to pass to the OnClick handler with the click; "LeftButton" by default.
---
--- **Returns**
--- - `ok`: 1 if the binding has been changed successfully, nil otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SetBindingClick)
declare function SetBindingClick(key: string, buttonName: string, button: string): boolean?
--- Sets a binding to use a specified item.
---
--- **Parameters**
--- - `key`: Any binding string accepted by World of Warcraft. For example: "ALT-CTRL-F", "SHIFT-T", "W", "BUTTON4".
--- - `item`: Item name (or item string) you want the binding to use. For example: "Hearthstone", "item:6948"
---
--- **Returns**
--- - `ok`: 1 if the binding has been changed successfully, nil otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SetBindingItem)
declare function SetBindingItem(key: string, item: string): boolean?
--- Sets a binding to click the specified button object.
---
--- **Parameters**
--- - `key`: Any binding string accepted by World of Warcraft. For example: "ALT-CTRL-F", "SHIFT-T", "W", "BUTTON4".
--- - `name`: Id or name of the macro you wish to execute.
---
--- **Returns**
--- - `success`: true if the binding has been changed successfully, false otherwise.
---
--- [warcraft.wiki.gg](https://warcraft.wiki.gg/wiki/API_SetBindingMacro)
declare function SetBindingMacro(key: string, name: unknown): boolean
