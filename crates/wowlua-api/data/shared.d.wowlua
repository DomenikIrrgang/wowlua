    displayScale: number
    followerID: string | number
    followerTypeID: number
    garrFollowerID?: number
    height: number
    iLevel: number
    isAutoTroop?: boolean
    isCollected?: boolean
    isFavorite: boolean
    isMaxLevel: boolean
    isSoulbind?: boolean
    isTroop?: boolean
