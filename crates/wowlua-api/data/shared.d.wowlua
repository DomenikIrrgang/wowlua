    levelXP?: number
    name: string
    portraitIconID: number
    quality: number
    scale: number
    slotSoundKitID?: number
    status?: string
    xp?: number
end

declare interface DisplayInfo
    followerPageScale: number
    id: number
    showWeapon?: boolean
end

declare interface TradeSkillCategoryInfo
