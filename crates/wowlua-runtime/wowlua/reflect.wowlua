-- wowlua runtime: reflection metadata (spec §7.8). A WEAK_KEYS-keyed registry,
-- so class tables contain only their members.
const WEAK_KEYS = { __mode = "k" }
local registry = {
	classes = setmetatable({}, WEAK_KEYS) :: { [table]: table },
	byName = {} :: { [string]: table },
	functions = setmetatable({}, WEAK_KEYS) :: { [function]: table },
	enums = setmetatable({}, WEAK_KEYS) :: { [table]: any[] },
}
wl.reflect = registry
function wl.reflectClass(cls: table, meta: { name: string })
	registry.classes[cls] = meta
	registry.byName[meta.name] = cls
end
function wl.reflectFn(fn: any, meta: table)
	if type(fn) == "function" then
		registry.functions[fn] = meta
	end
end
function wl.reflectEnum(e: table, order: any[])
	registry.enums[e] = order
end
