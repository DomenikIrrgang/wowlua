-- wowlua runtime: runtime type checks (spec §7.5).
local check: any = {}
wl.check = check
local function got(value: any): string
	if issecretvalue and issecretvalue(value) then
		return "secret"
	end
	return type(value)
end
-- A parameter failed its check.
function check.fail(index: number, name: string, fname: string, location: string, expected: string, value: any)
	error(
		addonName .. ": " .. location .. ": bad argument #" .. index .. " '" .. name .. "' to '" .. fname .. "' ("
			.. expected .. " expected, got " .. got(value) .. ")",
		0
	)
end
-- A `::` assertion failed.
function check.castFail(expected: string, value: any, location: string)
	error(addonName .. ": " .. location .. ": bad value for '::' (" .. expected .. " expected, got " .. got(value) .. ")", 0)
end
