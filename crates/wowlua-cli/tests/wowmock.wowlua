-- Minimap, cursor, textures, Addon Compartment ---------------------------------

Minimap = CreateFrame("Frame", "Minimap") :: any
function Minimap:GetWidth(): number
    return 140
end
function Minimap:GetHeight(): number
    return 140
end
function Minimap:GetCenter(): (number, number)
    return 500, 500
end
function Minimap:GetEffectiveScale(): number
    return 1
end
Mock.cursor = { 0, 0 }
function GetCursorPosition(): (number, number)
    return Mock.cursor[1], Mock.cursor[2]
end
AddonCompartmentFrame = { registeredAddons = {} } :: any
function AddonCompartmentFrame:RegisterAddon(data: any)
    self.registeredAddons[#self.registeredAddons + 1] = data
end
-- Milliseconds of simulated work (`Mock.spend`), on top of the clock.
Mock.worked = 0

--- Simulates `ms` milliseconds of work (job budgets measure it).
function Mock.spend(ms: number)
    Mock.worked += ms
    __engine.spend(ms)
end

--- `n` frames of `ms` milliseconds each (default 16): timers, then every
--- shown frame's OnUpdate.
function Mock.advanceFrames(n: number, ms: number?)
    __engine.advanceFrames(n, ms ?? 16)
end

-- Addon messages: a server that checks, records and echoes ---------------------

Mock.sent = {}
Mock.sendResults = {}      -- results to return next (else 0, success)
Mock.lockdown = false
Mock.group = nil           -- "party", "raid", "instance"
Mock.echoAs = nil          -- deliver sent messages as from this player
const PARTY_INSTANCE = 2
_G.LE_PARTY_CATEGORY_HOME = 1
_G.LE_PARTY_CATEGORY_INSTANCE = PARTY_INSTANCE

--- An addon message arrives (CHAT_MSG_ADDON, the rest of its payload empty).
function Mock.addonMessage(prefix: string, msg: string, chatType: string, sender: string)
    Mock.fire("CHAT_MSG_ADDON", prefix, msg, chatType, sender, "", 0, 0, "", 0)
end

local function addonMessage(prefix: string, msg: string, chatType: string?, target: string?): any
    if #msg > 255 or msg:find("%z") then
        return 2
    end
    local result = table.remove(Mock.sendResults, 1) ?? 0
    if result ~= 0 then
        return result
    end
    Mock.sent[#Mock.sent + 1] = { prefix = prefix, msg = msg, chatType = chatType, target = target }
    local echoAs = Mock.echoAs
    if echoAs then
        local sender = `{echoAs}-MockRealm`
        C_Timer.After(0.05, function()
            Mock.addonMessage(prefix, msg, chatType ?? "", sender)
        end)
    end
    return 0
end

C_ChatInfo = {} :: any
function C_ChatInfo.RegisterAddonMessagePrefix(_prefix: string): RegisterAddonMessagePrefixResult
    return 0
end
function C_ChatInfo.SendAddonMessage(prefix: string, message: string, chatType: string?, target: string?): SendAddonMessageResult
    return addonMessage(prefix, message, chatType, target)
end
function C_ChatInfo.SendAddonMessageLogged(prefix: string, message: string, chatType: string?, target: string?): SendAddonMessageResult?
    return addonMessage(prefix, message, chatType, target)
end
function C_ChatInfo.InChatMessagingLockdown(): boolean
    return Mock.lockdown
end
Ambiguate = (function(name: string): string
    return (name:gsub("%-MockRealm$", ""))
end) :: any
function IsInRaid(): boolean
    return Mock.group == "raid"
end
IsInGroup = (function(category: number?): boolean
    if category == PARTY_INSTANCE then
        return Mock.group == "instance"
    end
    return Mock.group ~= nil
end) :: any
function IsInGuild(): boolean
    return Mock.guild == true
end

