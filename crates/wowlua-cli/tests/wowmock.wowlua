-- A small model of the WoW client for the standard library's tests: frames
-- and events (with unit filters), scripts and hooks, error handlers,
-- C_Timer on a controlled clock, combat state, addon loading and slash
-- commands. Test scripts drive it through `Mock`.

type Handler = (...any) -> ...any

-- Completed below.
Mock = {
    now = 0,
    frames = {},
    timers = {},
    errors = {},
    out = {},
    loaded = {},
    combat = false,
    loggedIn = false,
} :: MockClient

-- The client's events (anything else is unknown, like an addon's messages).
const CLIENT_EVENTS = {
    "ADDON_LOADED", "PLAYER_LOGIN", "PLAYER_LOGOUT", "PLAYER_ENTERING_WORLD",
    "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED", "PLAYER_STARTED_MOVING", "BAG_UPDATE",
    "BAG_UPDATE_DELAYED", "UNIT_HEALTH", "UNIT_POWER_UPDATE", "PLAYER_TARGET_CHANGED", "UNIT_TARGET",
    "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN", "TIME_PLAYED_MSG", "CHAT_MSG_ADDON",
    "UNIT_AURA", "PLAYER_FOCUS_CHANGED", "GROUP_ROSTER_UPDATE", "INSTANCE_ENCOUNTER_ENGAGE_UNIT",
    "ITEM_DATA_LOAD_RESULT", "GET_ITEM_INFO_RECEIVED", "SPELL_DATA_LOAD_RESULT",
}
Mock.events = {}
for _, e in ipairs(CLIENT_EVENTS) do
    Mock.events[e] = true
end

function print(...: any)
    local parts: string[] = {}
    for i = 1, select("#", ...) do
        parts[i] = tostring((select(i, ...)))
    end
    Mock.out[#Mock.out + 1] = table.concat(parts, " ")
end

-- Error handling ------------------------------------------------------------

local handler: (msg: any, ...any) -> any = function(msg: any)
    Mock.errors[#Mock.errors + 1] = tostring(msg)
    print(`ERROR: {msg}`)
end
function geterrorhandler(): (err: any, ...any) -> any
    return handler
end
function seterrorhandler(fn: (err: any, ...any) -> any)
    handler = fn
end

function securecallfunction(fn: Handler, ...: any): ...any
    local n, args = select("#", ...), { ... }
    local results = { xpcall(function(): ...any
        return fn(unpack(args, 1, n))
    end, function(e: any): any
        geterrorhandler()(e)
        return e
    end) }
    if results[1] then
        return unpack(results, 2)
    end
end

function debugstack(): string
    return ""
end
date = os.date
function GetTime(): number
    return Mock.now
end
-- The client's language (`Mock.locale`).
function GetLocale(): string
    return Mock.locale ?? "enUS"
end
function InCombatLockdown(): boolean
    return Mock.combat
end
function IsLoggedIn(): boolean
    return Mock.loggedIn
end
-- Values marked secret (the modern client hides them from addons).
Mock.secrets = setmetatable({}, { __mode = "k" })
issecretvalue = (function(v: any): boolean
    return type(v) == "table" and Mock.secrets[v] == true
end) :: any
function Mock.secret(): table
    local v = {}
    Mock.secrets[v] = true
    return v
end

-- An assertion inside a test script.
function Mock.check(cond: any, label: string)
    if not cond then
        print(`FAIL: {label}`)
    end
end

-- Frames --------------------------------------------------------------------

type MockRect = { left: number, bottom: number, width: number, height: number }

-- Where an anchor point sits along a frame's width and height (0 to 1).
local function anchorX(point: string): number
    if point:find("LEFT") then return 0 end
    if point:find("RIGHT") then return 1 end
    return 0.5
end

local function anchorY(point: string): number
    if point:find("BOTTOM") then return 0 end
    if point:find("TOP") then return 1 end
    return 0.5
end

--- A frame, texture or font string. Layout and drawing calls are recorded
--- where tests read them back, and otherwise do nothing.
class MockFrame
    readonly kind: string
    readonly name?: string
    parent?: any
    events: { [string]: boolean } = {}
    units: { [string]: { [string]: boolean } } = {}
    scripts: { [string]: Handler } = {}
    hooks: { [string]: Handler[] } = {}
    shown: boolean = true
    points: any[][] = {}
    attributes: { [string]: any } = {}
    text?: string
    texture?: any
    -- Geometry (screen units are UIParent's: 1024 x 768 at scale 1).
    width: number = 0
    height: number = 0
    scale: number = 1
    moving: boolean = false
    sizing: boolean = false
    protected: boolean = false
    resizeBounds?: number[]
    enabled: boolean = true
    vertex?: number[]

    constructor(kind: string, name: string?, parent: any)
        self.kind = kind
        self.name = name
        self.parent = parent
    end

    private function checkEvent(event: string)
        if not Mock.events[event] then
            error(`Attempt to register unknown event "{event}"`, 3)
        end
    end

    function RegisterEvent(event: string)
        self:checkEvent(event)
        self.events[event] = true
        self.units[event] = nil
    end

    function RegisterUnitEvent(event: string, u1: string, u2: string?)
        self:checkEvent(event)
        self.events[event] = true
        local units = { [u1] = true }
        if u2 then
            units[u2] = true
        end
        self.units[event] = units
    end

    function UnregisterEvent(event: string)
        self.events[event] = nil
        self.units[event] = nil
    end

    function UnregisterAllEvents()
        self.events = {}
        self.units = {}
    end

    function IsEventRegistered(event: string): boolean
        return self.events[event] == true
    end

    function SetScript(name: string, fn: Handler?)
        self.scripts[name] = fn
        self.hooks[name] = nil
    end

    function GetScript(name: string): Handler?
        return self.scripts[name]
    end

    function HookScript(name: string, fn: Handler)
        local list = self.hooks[name] ?? {}
        list[#list + 1] = fn
        self.hooks[name] = list
    end

    function Show()
        self.shown = true
        Mock.script(self, "OnShow")
    end

    function Hide()
        self.shown = false
        Mock.script(self, "OnHide")
    end

    function SetShown(shown: boolean)
        if shown then
            self:Show()
        else
            self:Hide()
        end
    end

    function IsShown(): boolean
        return self.shown
    end

    function GetName(): string?
        return self.name
    end

    function GetParent(): any
        return self.parent
    end

    function SetParent(parent: any)
        self.parent = parent
    end

    function GetObjectType(): string
        return self.kind
    end

    function SetPoint(...: any)
        self.points[#self.points + 1] = { ... }
    end

    function ClearAllPoints()
        self.points = {}
    end

    function GetNumPoints(): number
        return #self.points
    end

    function GetPoint(i: number?): ...any
        return unpack(self.points[i ?? 1] ?? {})
    end

    function SetSize(width: number, height: number)
        self.width = width
        self.height = height
    end

    function SetWidth(width: number)
        self.width = width
    end

    function SetHeight(height: number)
        self.height = height
    end

    function GetSize(): (number, number)
        return self.width, self.height
    end

    function GetWidth(): number
        return self.width
    end

    function GetHeight(): number
        return self.height
    end

    function SetScale(scale: number)
        self.scale = scale
    end

    function GetScale(): number
        return self.scale
    end

    function GetEffectiveScale(): number
        const parent = self.parent
        if parent and parent ~= self and parent.GetEffectiveScale then
            return self.scale * parent:GetEffectiveScale()
        end
        return self.scale
    end

    --- The frame's rectangle in screen units, from its first anchor.
    function bounds(): MockRect?
        if self.name == "UIParent" then
            return { left = 0, bottom = 0, width = 1024, height = 768 }
        end
        const p = self.points[1]
        if not p then
            return nil
        end
        local rel: any, relPoint: string, x: number, y: number
        if type(p[2]) == "number" then
            rel, relPoint, x, y = self.parent, p[1], p[2], p[3] ?? 0
        else
            rel, relPoint, x, y = p[2] ?? self.parent, p[3] ?? p[1], p[4] ?? 0, p[5] ?? 0
        end
        if type(rel) == "string" then
            rel = _G[rel]
        end
        const r: MockRect = rel?.bounds and rel:bounds() or { left = 0, bottom = 0, width = 1024, height = 768 }
        const s = self:GetEffectiveScale()
        const ax = r.left + anchorX(relPoint) * r.width + x * s
        const ay = r.bottom + anchorY(relPoint) * r.height + y * s
        const w = self.width * s
        const h = self.height * s
        return { left = ax - anchorX(p[1]) * w, bottom = ay - anchorY(p[1]) * h, width = w, height = h }
    end

    function GetLeft(): number?
        const b = self:bounds()
        return b and b.left / self:GetEffectiveScale()
    end

    function GetRight(): number?
        const b = self:bounds()
        return b and (b.left + b.width) / self:GetEffectiveScale()
    end

    function GetBottom(): number?
        const b = self:bounds()
        return b and b.bottom / self:GetEffectiveScale()
    end

    function GetTop(): number?
        const b = self:bounds()
        return b and (b.bottom + b.height) / self:GetEffectiveScale()
    end

    function StartMoving()
        self.moving = true
    end

    function StartSizing(_: string?)
        self.sizing = true
    end

    function StopMovingOrSizing()
        self.moving = false
        self.sizing = false
    end

    function SetResizeBounds(minW: number, minH: number, maxW: number?, maxH: number?)
        self.resizeBounds = { minW, minH, maxW ?? 100000, maxH ?? 100000 }
    end

    function IsProtected(): (boolean, boolean)
        return self.protected, false
    end

    function SetAttribute(key: string, value: any)
        self.attributes[key] = value
    end

    function GetAttribute(key: string): any
        return self.attributes[key]
    end

    function CreateFontString(): MockFrame
        return MockFrame.new("FontString", nil, self)
    end

    function CreateTexture(): MockFrame
        return MockFrame.new("Texture", nil, self)
    end

    function SetText(text: string?)
        self.text = text
    end

    function GetText(): string?
        return self.text
    end

    function SetTexture(texture: any)
        self.texture = texture
    end

    -- Calls whose effect no test reads.
    function SetAllPoints(...: any) end
    function SetFrameStrata(...: any) end
    function SetFrameLevel(...: any) end
    function SetMovable(...: any) end
    function SetResizable(...: any) end
    function SetVertexColor(r: number, g: number, b: number, a: number?)
        self.vertex = { r, g, b, a ?? 1 }
    end
    function CreateMaskTexture(): MockFrame
        return MockFrame.new("MaskTexture", nil, self)
    end
    function AddMaskTexture(...: any) end
    function Click(button: string?)
        Mock.script(self, "OnClick", button ?? "LeftButton")
    end
    function SetEnabled(enabled: boolean)
        self.enabled = enabled
    end
    function IsEnabled(): boolean
        return self.enabled
    end
    function SetToplevel(...: any) end
    function SetAutoFocus(...: any) end
    function SetMultiLine(...: any) end
    function SetMaxLetters(...: any) end
    function HighlightText(...: any) end
    function SetFocus(...: any) end
    function ClearFocus(...: any) end
    function SetScrollChild(...: any) end
    function SetFontString(...: any) end
    function GetFont(): (string?, number?, string?)
        return "Fonts\\FRIZQT__.TTF", 12, ""
    end
    function SetMinMaxValues(...: any) end
    function SetValue(...: any) end
    function SetBackdrop(...: any) end
    function SetBackdropColor(...: any) end
    function SetBackdropBorderColor(...: any) end
    function SetClampedToScreen(...: any) end
    function SetUserPlaced(...: any) end
    function EnableMouseWheel(...: any) end
    function SetNormalTexture(...: any) end
    function SetPushedTexture(...: any) end
    function EnableMouse(...: any) end
    function RegisterForClicks(...: any) end
    function RegisterForDrag(...: any) end
    function SetHighlightTexture(...: any) end
    function SetTexCoord(...: any) end
    function SetColorTexture(...: any) end
    function SetTextColor(...: any) end
    function SetJustifyH(...: any) end
    function SetJustifyV(...: any) end
    function SetWordWrap(...: any) end
    function SetFont(...: any): boolean return true end
    function SetFontObject(...: any) end
    function SetAlpha(...: any) end
    function SetOwner(...: any) end
    function AddLine(...: any) end
    function AddDoubleLine(...: any) end
    function ClearLines(...: any) end
end

-- (The client's CreateFrame has an overload per frame type.)
--- Frame types with their own mock class (`kind` → constructor).
Mock.frameTypes = {}

--- Templates with their own mock class (`template` → constructor).
Mock.templates = {}

CreateFrame = (function(kind: string, name: string?, parent: any, template: string?): MockFrame
    const make = Mock.templates[template ?? ""] ?? Mock.frameTypes[kind]
    local f: MockFrame
    if make then
        f = make(name, parent)
    else
        f = MockFrame.new(kind, name, parent)
    end
    Mock.frames[#Mock.frames + 1] = f :: any
    if name then
        _G[name] = f
    end
    return f
end) :: any

function Mock.script(frame: any, name: string, ...: any)
    local fn = frame.scripts[name]
    if fn then
        fn(frame, ...)
    end
    for _, h in ipairs(frame.hooks[name] ?? {}) do
        h(frame, ...)
    end
end

-- The mouse and modifier keys -------------------------------------------------

Mock.modifiers = {}
function IsShiftKeyDown(): boolean
    return Mock.modifiers.SHIFT == true
end
function IsControlKeyDown(): boolean
    return Mock.modifiers.CTRL == true
end
function IsAltKeyDown(): boolean
    return Mock.modifiers.ALT == true
end

--- Drags a frame by (dx, dy) screen units, if it starts moving.
function Mock.drag(frame: any, dx: number, dy: number)
    Mock.script(frame, "OnDragStart", "LeftButton")
    if frame.moving then
        const b = frame:bounds()
        const s = frame:GetEffectiveScale()
        frame.points = { { "BOTTOMLEFT", UIParent, "BOTTOMLEFT", (b.left + dx) / s, (b.bottom + dy) / s } }
    end
    Mock.script(frame, "OnDragStop")
end

--- Drags a resize grip by (dw, dh) screen units: the frame's top left stays.
function Mock.sizeBy(grip: any, dw: number, dh: number)
    Mock.script(grip, "OnMouseDown", "LeftButton")
    const frame = grip.parent
    if frame.sizing then
        const b = frame:bounds()
        const s = frame:GetEffectiveScale()
        const limits = frame.resizeBounds ?? { 0, 0, 100000, 100000 }
        frame.width = math.max(limits[1], math.min(limits[3], frame.width + dw / s))
        frame.height = math.max(limits[2], math.min(limits[4], frame.height + dh / s))
        frame.points = { { "TOPLEFT", UIParent, "BOTTOMLEFT", b.left / s, (b.bottom + b.height) / s } }
    end
    Mock.script(grip, "OnMouseUp", "LeftButton")
end

--- Turns the mouse wheel over a frame.
function Mock.wheel(frame: any, delta: number)
    Mock.script(frame, "OnMouseWheel", delta)
end

-- Fires a WoW event at every frame registered for it, in creation order.
function Mock.fire(event: string, ...: any)
    if event == "PLAYER_REGEN_DISABLED" then
        Mock.combat = true
    elseif event == "PLAYER_REGEN_ENABLED" then
        Mock.combat = false
    elseif event == "PLAYER_LOGIN" then
        Mock.loggedIn = true
    end
    local unit = ...
    for _, f in ipairs({ unpack(Mock.frames) }) do
        local units = f.units[event]
        if f.events[event] and (not units or units[unit]) then
            Mock.script(f, "OnEvent", event, ...)
        end
    end
end

-- Loads an addon (fires ADDON_LOADED for it).
function Mock.loadAddon(name: string | number)
    Mock.loaded[name] = true
    Mock.fire("ADDON_LOADED", name, false)
end

-- Load-on-demand addons: name → a function defining their globals.
Mock.onDemand = {}
Mock.metadata = {}
C_AddOns = {} :: any
function C_AddOns.IsAddOnLoaded(name: string | number): (boolean, boolean)
    local loaded = Mock.loaded[name] == true
    return loaded, loaded
end
function C_AddOns.IsAddOnLoadOnDemand(name: string | number): boolean
    return Mock.onDemand[name] ~= nil
end
function C_AddOns.LoadAddOn(name: string | number): (boolean?, string?)
    local define = Mock.onDemand[name]
    if not define or Mock.loaded[name] then
        return false, "LOADED"
    end
    define()
    Mock.loadAddon(name)
    return true, nil
end
function C_AddOns.GetAddOnMetadata(name: string | number, field: string): string
    return Mock.metadata[name]?.[field] :: any
end
-- (The pre-C_AddOns name, which older clients have.)
_G.GetAddOnMetadata = C_AddOns.GetAddOnMetadata
Mock.interface = 11508
function GetBuildInfo(): (string, string, string, number)
    return "1.0.0", "1", "Jan 1 2026", Mock.interface
end

-- Units -------------------------------------------------------------------------

--- What the client knows about a unit; any value may be a `Mock.secret()`.
type MockUnit = {
    name: any,
    realm?: string,
    guid: any,
    class: string,
    classFile: string,
    level: number,
    health: any,
    healthMax: any,
    power: any,
    powerMax: any,
    isPlayer: any,
    connected: any,
    faction?: string,
    race?: string,
    role?: string,
}

Mock.units = {
    player = {
        name = "Tester", guid = "Player-1-00000001", class = "Mage", classFile = "MAGE", level = 70,
        health = 800, healthMax = 1000, power = 50, powerMax = 100, isPlayer = true, connected = true,
        faction = "Alliance", race = "Human", role = "NONE",
    },
}

local function mockUnit(unit: string): MockUnit?
    return Mock.units[unit] :: MockUnit?
end

function UnitExists(unit: string): boolean
    return mockUnit(unit) ~= nil
end
UnitName = (function(unit: string): (any, string?)
    const u = mockUnit(unit)
    if u then
        return u.name, u.realm
    end
    return nil, nil
end) :: any
GetUnitName = (function(unit: string, showServer: boolean?): any
    const u = mockUnit(unit)
    if not u then
        return nil
    end
    if showServer and u.realm then
        return `{u.name}-{u.realm}`
    end
    return u.name
end) :: any
function GetRealmName(): string
    return "MockRealm"
end
function GetNormalizedRealmName(): string
    return "MockRealm"
end
UnitClass = (function(unit: string): (string?, string?, number?)
    const u = mockUnit(unit)
    if u then
        return u.class, u.classFile, 8
    end
    return nil, nil, nil
end) :: any
UnitLevel = (function(unit: string): number
    return mockUnit(unit)?.level ?? 0
end) :: any
UnitHealth = (function(unit: string): any
    return mockUnit(unit)?.health ?? 0
end) :: any
UnitHealthMax = (function(unit: string): any
    return mockUnit(unit)?.healthMax ?? 0
end) :: any
UnitPower = (function(unit: string): any
    return mockUnit(unit)?.power ?? 0
end) :: any
UnitPowerMax = (function(unit: string): any
    return mockUnit(unit)?.powerMax ?? 0
end) :: any
UnitIsPlayer = (function(unit: string): any
    return mockUnit(unit)?.isPlayer ?? false
end) :: any
UnitIsConnected = (function(unit: string): any
    return mockUnit(unit)?.connected ?? false
end) :: any
UnitIsUnit = (function(a: string, b: string): any
    const x = mockUnit(a)
    return x ~= nil and x == mockUnit(b)
end) :: any
UnitFactionGroup = (function(unit: string): (string?, string?)
    const f = mockUnit(unit)?.faction
    return f, f
end) :: any
UnitRace = (function(unit: string): (string?, string?)
    const r = mockUnit(unit)?.race
    return r, r
end) :: any
function GetNumGroupMembers(_: number?): number
    local n = 0
    if Mock.group == "raid" then
        for i = 1, 40 do
            if mockUnit(`raid{i}`) then n += 1 end
        end
    elseif Mock.group then
        n = 1
        for i = 1, 4 do
            if mockUnit(`party{i}`) then n += 1 end
        end
    end
    return n
end
UnitGroupRolesAssigned = (function(unit: string): string
    return mockUnit(unit)?.role ?? "NONE"
end) :: any
function GetFramesRegisteredForEvent(event: string): ...any
    local out: any[] = {}
    for _, f in ipairs(Mock.frames) do
        if f.events[event] then
            out[#out + 1] = f
        end
    end
    return unpack(out)
end
-- Server answers arrive a moment later.
function RequestTimePlayed()
    C_Timer.After(0.2, function()
        Mock.fire("TIME_PLAYED_MSG", 3600, 60)
    end)
end
C_EventUtils = {} :: any
function C_EventUtils.IsEventValid(event: string): boolean
    return Mock.events[event] == true
end

-- Hooks ---------------------------------------------------------------------

hooksecurefunc = (function(target: any, name: any, fn: any)
    if type(target) == "string" then
        target, name, fn = _G, target, name
    end
    local original = target[name]
    assert(type(original) == "function", `hooksecurefunc: {name} is not a function`)
    target[name] = function(...: any): ...any
        local r = { original(...) }
        fn(...)
        return unpack(r)
    end
end) :: any

-- Timers --------------------------------------------------------------------

--- A scheduled callback: `left` more runs, every `every` seconds.
class MockTimer
    due: number
    readonly every: number
    readonly fn: Handler
    left: number
    cancelled: boolean = false

    constructor(sec: number, fn: Handler, iterations: number)
        self.due = Mock.now + sec
        self.every = sec
        self.fn = fn
        self.left = iterations
    end

    function Cancel()
        self.cancelled = true
    end

    function IsCancelled(): boolean
        return self.cancelled
    end
end

local function schedule(sec: number, fn: Handler, iterations: number): MockTimer
    local t = MockTimer.new(sec, fn, iterations)
    Mock.timers[#Mock.timers + 1] = t :: any
    return t
end

C_Timer = {} :: any
function C_Timer.After(seconds: number, callback: () -> ())
    schedule(seconds, callback, 1)
end
function C_Timer.NewTimer(seconds: number, callback: (handle: TimerHandle) -> ()): TimerHandle
    return schedule(seconds, callback, 1) :: any
end
function C_Timer.NewTicker(seconds: number, callback: (handle: TickerHandle) -> (), iterations: number?): TickerHandle
    return schedule(seconds, callback, iterations ?? math.huge) :: any
end

-- Advances the clock, running due timers in order (a frame is 0 seconds).
function Mock.advance(sec: number?)
    local target = Mock.now + (sec ?? 0)
    while true do
        local next: MockTimer? = nil
        for _, entry in ipairs(Mock.timers) do
            local t = entry :: MockTimer
            if t.cancelled or t.left <= 0 or t.due > target then
                continue
            end
            if not next or t.due < next.due then
                next = t
            end
        end
        if not next then
            break
        end
        Mock.now = math.max(Mock.now, next.due)
        next.left -= 1
        next.due += next.every
        next.fn(next)
    end
    Mock.now = target
end

-- Slash commands ------------------------------------------------------------

SlashCmdList = {}

-- Runs "/cmd args" like the chat box.
function Mock.slash(line: string)
    local cmd, msg = line:match("^(%S+)%s*(.-)$")
    if not (cmd and msg) then
        return
    end
    for key, fn in pairs(SlashCmdList) do
        local i = 1
        while _G[`SLASH_{key}{i}`] do
            if _G[`SLASH_{key}{i}`]:lower() == cmd:lower() then
                -- (A stand-in for the chat edit box.)
                return fn(msg, {} :: any)
            end
            i += 1
        end
    end
    print(`unknown command {cmd}`)
end

-- A few of Blizzard's globals for hooks.
UIParent = CreateFrame("Frame", "UIParent") :: any
UIParent:SetSize(1024, 768)
function ToggleGameMenu()
    print("menu")
end

-- Tooltips -------------------------------------------------------------------

--- What a mock tooltip shows, for its getters.
type Shown = { kind: string, id?: number, guid?: string, unit?: string, link?: string, name?: string }

--- A tooltip: the lines added to it and what it shows.
class MockTooltip extends MockFrame
    lines: string[] = {}
    showing?: Shown

    constructor(name: string)
        super("GameTooltip", name, nil)
        Mock.frames[#Mock.frames + 1] = self :: any
        _G[name] = self
    end

    override function AddLine(text: string)
        self.lines[#self.lines + 1] = text
        -- The client's font strings for each line.
        _G[`{self.name}TextLeft{#self.lines}`] = { GetText = function() return text end }
    end

    function NumLines(): number
        return #self.lines
    end

    function SetItemByID(id: number)
        Mock.showTooltip("Item", { kind = "Item", id = id, name = `item {id}`, link = `|Hitem:{id}::|h[item {id}]|h` }, self)
    end

    function SetSpellByID(id: number)
        Mock.showTooltip("Spell", { kind = "Spell", id = id, name = `spell {id}` }, self)
    end

    function SetUnit(unit: string)
        print(`SetUnit {unit}`)
        Mock.showTooltip("Unit", { kind = "Unit", unit = unit, name = unit, guid = `GUID-{unit}` }, self)
    end

    function IsForbidden(): boolean
        return false
    end

    function GetItem(): (string?, string?)
        if self.showing?.kind == "Item" then
            return self.showing.name, self.showing.link
        end
        return nil, nil
    end

    function GetSpell(): (string?, number?)
        if self.showing?.kind == "Spell" then
            return self.showing.name, self.showing.id
        end
        return nil, nil
    end

    function GetUnit(): (string?, string?)
        if self.showing?.kind == "Unit" then
            return self.showing.name, self.showing.unit
        end
        return nil, nil
    end
end

for _, name in ipairs({ "ItemRefTooltip", "ShoppingTooltip1", "ShoppingTooltip2" }) do
    MockTooltip.new(name)
end

--- Another tooltip frame (an addon's own).
function Mock.tooltip(name: string): any
    return MockTooltip.new(name)
end

UnitGUID = (function(unit: string): any
    return mockUnit(unit)?.guid ?? `GUID-{unit}`
end) :: any

-- The tooltip data system (setups without it set TooltipDataProcessor to nil).
_G.Enum = {
    TooltipDataType = { Item = 0, Spell = 1, Unit = 2, Currency = 5, Mount = 10 },
    SpellBookSpellBank = { Player = 0, Pet = 1 },
}
Mock.tooltipCalls = {}
_G.TooltipDataProcessor = {
    AddTooltipPostCall = function(kind: number, fn: (tip: any, data: table) -> ())
        const list = Mock.tooltipCalls[kind] ?? {}
        list[#list + 1] = fn
        Mock.tooltipCalls[kind] = list
    end,
}

const TOOLTIP_SCRIPTS: { [string]: string } = {
    Item = "OnTooltipSetItem",
    Spell = "OnTooltipSetSpell",
    Unit = "OnTooltipSetUnit",
}

--- Shows `data` as a tooltip of `kind` (GameTooltip by default): runs the
--- post-hooks as the client would and returns the lines they added.
function Mock.showTooltip(kind: string, data: Shown?, tip: any): string[]
    const t = (tip ?? GameTooltip) :: MockTooltip
    const shown: Shown = data ?? { kind = kind }
    shown.kind = kind
    t.lines = {}
    t.showing = shown
    if _G.TooltipDataProcessor then
        const dataType = _G.Enum.TooltipDataType[kind]
        const raw = { type = dataType, id = shown.id, guid = shown.guid, hyperlink = shown.link }
        for _, fn in ipairs(Mock.tooltipCalls[dataType] ?? {}) do
            fn(t, raw)
        end
    else
        Mock.script(t, TOOLTIP_SCRIPTS[kind])
    end
    return t.lines
end

GameTooltip = MockTooltip.new("GameTooltip") :: any
CreateFrame("Frame", "PlayerFrame")

-- Settings (Blizzard's Settings API: categories, rows, proxy settings) -------

type Row = { kind: string, [string]: any }

class MockLayout
    items: Row[] = {}

    function AddInitializer(init: Row)
        self.items[#self.items + 1] = init
    end
end

class MockCategory
    readonly id: number
    readonly name: string
    readonly parent?: MockCategory
    readonly layout: MockLayout = MockLayout.new()
    registered: boolean = false

    constructor(name: string, parent: MockCategory?)
        self.id = #Mock.settings.categories + 1
        self.name = name
        self.parent = parent
    end

    function GetID(): number
        return self.id
    end
end

class MockSetting
    readonly variable: string
    readonly varType: string
    readonly name: string
    readonly default: any
    private readonly get: () -> any
    private readonly set: (value: any) -> ()
    updates: number = 0

    constructor(variable: string, varType: string, name: string, default: any, get: () -> any, set: (value: any) -> ())
        self.variable = variable
        self.varType = varType
        self.name = name
        self.default = default
        self.get = get
        self.set = set
    end

    function GetValue(): any
        return self.get()
    end

    function SetValue(value: any)
        self.set(value)
    end

    function NotifyUpdate()
        self.updates += 1
    end
end

Mock.settings = { categories = {}, opened = {}, variables = {} }

local function newCategory(name: string, parent: MockCategory?): (MockCategory, MockLayout)
    local c = MockCategory.new(name, parent)
    Mock.settings.categories[#Mock.settings.categories + 1] = c
    return c, c.layout
end

local function row(kind: string): (category: MockCategory, setting: MockSetting, a: any, b: any) -> Row
    return function(category: MockCategory, setting: MockSetting, a: any, b: any): Row
        local item: Row = { kind = kind, setting = setting, a = a, b = b }
        category.layout:AddInitializer(item)
        return item
    end
end

-- (A fake of the Settings API: what wowlua:settings uses.)
Settings = ({
    VarType = { Boolean = "boolean", Number = "number", String = "string" },
    RegisterVerticalLayoutCategory = function(name: string): (MockCategory, MockLayout)
        return newCategory(name)
    end,
    RegisterVerticalLayoutSubcategory = function(parent: MockCategory, name: string): (MockCategory, MockLayout)
        return newCategory(name, parent)
    end,
    RegisterAddOnCategory = function(c: MockCategory)
        c.registered = true
    end,
    RegisterProxySetting = function(_: any, variable: string, varType: string, name: string, default: any, get: () -> any, set: (value: any) -> ()): MockSetting
        if Mock.settings.variables[variable] then
            error(`Setting variable '{variable}' was previously registered.`)
        end
        local s = MockSetting.new(variable, varType, name, default, get, set)
        Mock.settings.variables[variable] = s
        return s
    end,
    CreateCheckbox = row("checkbox"),
    CreateSlider = row("slider"),
    CreateDropdown = row("dropdown"),
    CreateColorSwatch = row("color"),
    CreateSliderOptions = function(min: number, max: number, step: number): table
        return {
            min = min,
            max = max,
            step = step,
            SetLabelFormatter = function(self: table, _: any, f: any)
                self.format = f
            end,
        }
    end,
    CreateControlTextContainer = function(): table
        local data: { value: any, label: string }[] = {}
        return {
            Add = function(_: table, value: any, label: string)
                data[#data + 1] = { value = value, label = label }
            end,
            GetData = function(): table
                return data
            end,
        }
    end,
    CreateElementInitializer = function(template: string, data: table?): Row
        local init: Row = { kind = "element", template = template, data = data, Resetter = function() end }
        init.InitFrame = function()
            -- The client's element template needs set-up an element row lacks.
            if template == "SettingsListElementTemplate" then
                error("attempt to index field 'cbrHandles' (a nil value)")
            end
        end
        return init
    end,
    OpenToCategory = function(id: number)
        Mock.settings.opened[#Mock.settings.opened + 1] = id
        SettingsPanel:Show()
        -- The list shows the category's rows.
        for _, item in ipairs(Mock.settings.categories[id].layout.items) do
            if item.InitFrame then
                item:InitFrame(CreateFrame("Frame"))
            end
        end
    end,
    GetSetting = function(variable: string): MockSetting?
        return Mock.settings.variables[variable]
    end,
}) :: any
SettingsPanel = CreateFrame("Frame", "SettingsPanel") :: any
SettingsPanel:Hide()
HideUIPanel = (function(frame: any)
    frame:Hide()
end) :: any
MinimalSliderWithSteppersMixin = { Label = { Right = "right" } } :: any
CreateSettingsListSectionHeaderInitializer = (function(name: string): Row
    return { kind = "header", name = name }
end) :: any
CreateSettingsButtonInitializer = (function(_: string, text: string, click: () -> ()): Row
    return { kind = "button", text = text, click = click }
end) :: any
CreateKeybindingEntryInitializer = (function(index: number): Row
    return { kind = "keybinding", index = index }
end) :: any
Mock.bindings = {}
Mock.bindingActions = {}

--- Bindings.xml as the client reads it: one action per binding.
function Mock.addBinding(name: string, action: (keystate: string) -> ())
    Mock.bindings[#Mock.bindings + 1] = name
    Mock.bindingActions[name] = action
end

--- Presses (or, with `"up"`, releases) a binding's key.
function Mock.pressBinding(name: string, keystate: string?)
    const action = Mock.bindingActions[name]
    if not action then
        error(`no binding {name}`, 2)
    end
    action(keystate ?? "down")
end

Mock.keys = {}

--- Presses and releases a key, running the binding it is bound to.
function Mock.pressKey(key: string)
    const command = Mock.keys[key]
    if command then
        Mock.pressBinding(command, "down")
        Mock.pressBinding(command, "up")
    end
end

function SetBinding(key: string, command: string?, _: number?): boolean
    Mock.keys[key] = command
    return true
end

function GetBindingAction(key: string, _: boolean?): string
    return Mock.keys[key] ?? ""
end

function GetNumBindings(): number
    return #Mock.bindings
end
GetBinding = (function(i: number): any
    return Mock.bindings[i]
end) :: any

--- A color (Blizzard's ColorMixin, what the tests use).
class MockColor
    readonly r: number
    readonly g: number
    readonly b: number
    readonly a: number

    constructor(r: number, g: number, b: number, a: number?)
        self.r, self.g, self.b, self.a = r, g, b, a ?? 1
    end

    function GetRGB(): (number, number, number)
        return self.r, self.g, self.b
    end

    function GetRGBA(): (number, number, number, number)
        return self.r, self.g, self.b, self.a
    end

    function GenerateHexColor(): string
        local function byte(v: number): number
            return math.floor(v * 255 + 0.5)
        end
        return string.format("%02x%02x%02x%02x", byte(self.a), byte(self.r), byte(self.g), byte(self.b))
    end
end

function CreateColor(r: number, g: number, b: number, a: number?): colorRGBA
    return MockColor.new(r, g, b, a) :: any
end
CreateColorFromHexString = (function(hex: string): colorRGBA
    local function part(i: number): number
        return (tonumber(hex:sub(i, i + 1), 16) ?? 0) / 255
    end
    return CreateColor(part(3), part(5), part(7), part(1))
end) :: any

-- Auras (C_UnitAuras) and the engine's aura containers ----------------------------

--- Each unit's auras, as AuraData tables (any field may be a secret).
Mock.auras = {}
--- Reads refuse, as on clients with secret auras in combat.
Mock.aurasRestricted = false

local function auraMatches(a: table, filter: string?): boolean
    for word in (filter ?? ""):gmatch("[^|]+") do
        if word == "HELPFUL" and not a.isHelpful then return false end
        if word == "HARMFUL" and not a.isHarmful then return false end
        if word == "PLAYER" and not a.isFromPlayerOrPlayerPet then return false end
        if word == "!PLAYER" and a.isFromPlayerOrPlayerPet then return false end
    end
    return true
end

local function aurasOf(unit: string, filter: string?): table[]
    if Mock.aurasRestricted then
        error("Auras cannot be accessed when secret while tainted")
    end
    const out: table[] = {}
    for _, a in ipairs(Mock.auras[unit] ?? {}) do
        if auraMatches(a, filter) then
            out[#out + 1] = a
        end
    end
    return out
end

C_UnitAuras = {} :: any
function C_UnitAuras.GetAuraDataByIndex(unit: string, index: number, filter: string?): any
    return aurasOf(unit, filter)[index]
end
function C_UnitAuras.GetAuraDataByAuraInstanceID(unit: string, id: number): any
    for _, a in ipairs(aurasOf(unit, nil)) do
        if a.auraInstanceID == id then
            return a
        end
    end
    return nil
end

--- An engine aura button: what was registered with it.
class MockAuraButton extends MockFrame
    icon?: any
    count?: any
    durationText?: any
    dispel: any[] = {}
    cancel?: string

    constructor(parent: any)
        super("AuraButton", nil, parent)
    end

    function SetIcon(texture: any) self.icon = texture end
    function SetApplicationCount(fs: any, _: table?) self.count = fs end
    function SetDurationText(fs: any, _: table?) self.durationText = fs end
    function AddDispelTypeTexture(texture: any, _: table?) self.dispel[#self.dispel + 1] = texture end
    function SetCancelAuraButtons(buttons: string?) self.cancel = buttons end
end

--- The engine's container: groups filled from `Mock.auras` on UpdateAllAuras.
class MockAuraContainer extends MockFrame
    unit?: string
    groups: table[] = {}
    --- What each group shows: spell IDs, by group key.
    showing: { [string]: number[] } = {}

    constructor(name: string?, parent: any)
        super("AuraContainer", name, parent)
    end

    function SetUnit(unit: string) self.unit = unit end
    function SetFlowLayoutAnchorPoint(_: string) end
    function SetFlowLayoutGrowthDirection(_: any, _: any) end
    function SetFlowLayoutMaximumLineSize(_: number?) end

    function AddAuraGroup(key: string, filter: string, options: table)
        if key == "" then
            error("groupKey must be a non-empty string.")
        end
        self.groups[#self.groups + 1] = { key = key, filter = filter, options = options, buttons = {} }
    end

    private function group(key: string): table
        for _, g in ipairs(self.groups) do
            if g.key == key then return g end
        end
        error(`aura group '{key}' was not found with this key.`)
    end

    function SetAuraGroupMaxFrameCount(key: string, max: number) self:group(key).options.maxFrameCount = max end
    function SetAuraGroupCandidateFilters(key: string, filters: table) self:group(key).options.candidateFilters = filters end

    -- The engine reads auras itself: restricted reads do not stop it.
    function UpdateAllAuras()
        for _, g in ipairs(self.groups) do
            const ids: number[] = {}
            const filters = g.options.candidateFilters ?? {}
            for _, a in ipairs(Mock.auras[self.unit ?? ""] ?? {}) do
                const spells = filters.includeSpellIDs
                const types = filters.includeDispelTypes
                if auraMatches(a, g.filter) and #ids < (g.options.maxFrameCount ?? 16)
                    and (not spells or spells[a.spellId]) and (not types or types[a.dispelName ?? ""]) then
                    ids[#ids + 1] = a.spellId
                    if not g.buttons[#ids] then
                        const button = MockAuraButton.new(self)
                        g.buttons[#ids] = button
                        g.options.initializeFrame?.(button)
                    end
                end
            end
            self.showing[g.key] = ids
        end
    end
end

Mock.auraContainers = {}
Mock.frameTypes.AuraContainer = function(name: string?, parent: any): any
    const c = MockAuraContainer.new(name, parent)
    Mock.auraContainers[#Mock.auraContainers + 1] = c
    return c
end

--- The unit's auras changed: the engine updates its containers for it.
function Mock.auraChanged(unit: string)
    for _, c in ipairs(Mock.auraContainers) do
        if c.unit == unit then
            c:UpdateAllAuras()
        end
    end
end

-- Spells (C_Spell, C_SpellBook) ----------------------------------------------------

--- Spells by ID: `name`, `iconID`, `description`, `known`, `cooldown`
--- (a SpellCooldownInfo, any time a secret), `charges`.
Mock.spells = {
    [133] = { name = "Fireball", iconID = 135812, description = "Hurls a fiery ball.", known = true },
    [6603] = {
        name = "Auto Attack", iconID = 135641, known = true,
        cooldown = { startTime = 0, duration = 0, modRate = 1, isEnabled = true, isActive = false },
    },
}

local function mockSpell(spell: any): table?
    if type(spell) == "string" then
        for id, s in pairs(Mock.spells) do
            if s.name == spell then
                s.id = id
                return s
            end
        end
        return nil
    end
    const s = Mock.spells[spell]
    if s then
        s.id = spell
    end
    return s
end

C_Spell = {} :: any
function C_Spell.GetSpellInfo(spell: any): any
    const s = mockSpell(spell)
    if not s then return nil end
    return { name = s.name, iconID = s.iconID, originalIconID = s.iconID, castTime = 0, minRange = 0, maxRange = 40, spellID = s.id }
end
function C_Spell.GetSpellName(spell: any): string?
    return mockSpell(spell)?.name
end
function C_Spell.GetSpellTexture(spell: any): number?
    return mockSpell(spell)?.iconID
end
function C_Spell.GetSpellLink(spell: any): string?
    const s = mockSpell(spell)
    return s and `|cff71d5ff|Hspell:{s.id}|h[{s.name}]|h|r`
end
function C_Spell.GetSpellDescription(spell: any): string?
    return mockSpell(spell)?.description
end
function C_Spell.GetSpellCooldown(spell: any): any
    return mockSpell(spell)?.cooldown
end
function C_Spell.GetSpellCharges(spell: any): any
    return mockSpell(spell)?.charges
end
C_SpellBook = {} :: any
function C_SpellBook.IsSpellKnown(id: number, bank: any): boolean
    const s = mockSpell(id)
    if bank == 1 then
        return s?.petKnown == true
    end
    return s?.known == true
end

-- Items (C_Item) and spell data loading -----------------------------------------

--- Items by ID: `info` (GetItemInfo's values, by name), whether the client
--- has it `cached`, the seconds it takes to arrive (`delay`, default 0.2),
--- and `missing` for items that do not exist.
Mock.items = {
    [6948] = { cached = true, info = { name = "Hearthstone", link = "|cffffffff|Hitem:6948::|h[Hearthstone]|h|r", quality = 1, icon = 134414 } },
    [19019] = { delay = 0.5, info = { name = "Thunderfury", link = "|cffff8000|Hitem:19019::|h[Thunderfury]|h|r", quality = 5, itemLevel = 80 } },
}
--- Items the client was asked to load.
Mock.itemRequests = {}
C_Item = {} :: any

function C_Item.GetItemInfo(item: any): ...any
    const id = C_Item.GetItemInfoInstant(item)
    const it = Mock.items[id ?? 0]
    if not it or not it.cached then
        return nil
    end
    const i = it.info
    return i.name, i.link, i.quality, i.itemLevel, i.minLevel, i.type, i.subType, i.stackCount,
        i.equipLoc, i.icon, i.sellPrice, i.classID, i.subclassID, i.bindType, i.expansionID
end

function C_Item.GetItemInfoInstant(item: any): number?
    if type(item) == "number" then
        return item
    end
    const id = tonumber(tostring(item):match("item:(%d+)"))
    if id then
        return id
    end
    for itemId, it in pairs(Mock.items) do
        if it.cached and it.info.name == item then
            return itemId
        end
    end
    return nil
end

function C_Item.RequestLoadItemDataByID(id: number)
    Mock.itemRequests[#Mock.itemRequests + 1] = id
    const it = Mock.items[id]
    C_Timer.After(it?.delay ?? 0.2, function()
        if it and not it.missing then
            it.cached = true
            Mock.fire("ITEM_DATA_LOAD_RESULT", id, true)
        else
            Mock.fire("ITEM_DATA_LOAD_RESULT", id, false)
        end
    end)
end

function C_Spell.IsSpellDataCached(id: number): boolean
    return Mock.spells[id]?.cached == true
end

function C_Spell.RequestLoadSpellData(id: number)
    C_Timer.After(0.2, function()
        const s = Mock.spells[id]
        if s then
            s.cached = true
        end
        Mock.fire("SPELL_DATA_LOAD_RESULT", id, s ~= nil)
    end)
end

-- Libraries (LibStub) ----------------------------------------------------------

--- Libraries another addon embedded, by major version.
Mock.libraries = {}

--- Makes a library available through LibStub (as if an addon loaded it).
function Mock.provideLibrary(major: string, impl: table)
    Mock.libraries[major] = impl
    _G.LibStub = function(name: string, silent: boolean?): any
        const found = Mock.libraries[name]
        if not found and not silent then
            error(`Cannot find a library instance of "{name}".`, 2)
        end
        return found
    end
end

--- A minimal LibSharedMedia-3.0: media by kind and name, and its
--- registration callbacks.
function Mock.sharedMedia(): table
    const media: { [string]: { [string]: any } } = {}
    const callbacks: ((...any) -> ())[] = {}
    const lsm: table = {}
    function lsm.Register(_: any, kind: string, name: string, path: any): boolean
        media[kind] = media[kind] ?? {}
        media[kind][name] = path
        for _, cb in ipairs(callbacks) do
            cb("LibSharedMedia_Registered", kind, name)
        end
        return true
    end
    function lsm.Fetch(_: any, kind: string, name: string?, noDefault: boolean?): any
        const found = name and (media[kind] ?? {})[name]
        if found or noDefault then
            return found
        end
        return `lsm-default-{kind}`
    end
    function lsm.List(_: any, kind: string): string[]
        const names: string[] = {}
        for n in pairs(media[kind] ?? {}) do
            names[#names + 1] = n
        end
        table.sort(names)
        return names
    end
    function lsm.RegisterCallback(_: any, _event: string, fn: (...any) -> ())
        callbacks[#callbacks + 1] = fn
    end
    return lsm
end

-- Dialogs -------------------------------------------------------------------------

UISpecialFrames = {} :: any

--- The open wowlua:dialog (its `text`, `edit`, `accept`, `cancel`, `error`).
function Mock.dialog(): any
    for _, f in ipairs(Mock.frames) do
        const d = (f :: any).dialog
        if d and f.shown then
            return d
        end
    end
    return nil
end

--- Accepts the open dialog, typing `value` first.
function Mock.dialogAccept(value: string?)
    const d = Mock.dialog()
    if value then
        d.edit:SetText(value)
        Mock.script(d.edit, "OnTextChanged", true)
    end
    Mock.script(d.accept, "OnClick", "LeftButton")
end

function Mock.dialogCancel()
    Mock.script(Mock.dialog().cancel, "OnClick", "LeftButton")
end

--- Escape: hides the shown frames named in UISpecialFrames.
function Mock.escape()
    for _, name in ipairs(UISpecialFrames :: string[]) do
        const f = _G[name]
        if f and f.shown then
            f:Hide()
        end
    end
end

-- Menus (MenuUtil) --------------------------------------------------------------

--- One menu entry as MenuUtil builds it.
class MockMenuEntry
    readonly kind: string
    readonly text: string
    readonly callback?: (...any) -> any
    readonly isSelected?: (...any) -> boolean
    enabled: boolean = true
    children: MockMenuEntry[] = {}

    constructor(kind: string, text: string, callback: ((...any) -> any)?, isSelected: ((...any) -> boolean)?)
        self.kind = kind
        self.text = text
        self.callback = callback
        self.isSelected = isSelected
    end

    private function add(e: MockMenuEntry): MockMenuEntry
        self.children[#self.children + 1] = e
        return e
    end

    function CreateTitle(text: string): MockMenuEntry return self:add(MockMenuEntry.new("title", text, nil, nil)) end
    function CreateButton(text: string, cb: any): MockMenuEntry return self:add(MockMenuEntry.new("button", text, cb, nil)) end
    function CreateCheckbox(text: string, sel: any, cb: any): MockMenuEntry return self:add(MockMenuEntry.new("checkbox", text, cb, sel)) end
    function CreateRadio(text: string, sel: any, cb: any): MockMenuEntry return self:add(MockMenuEntry.new("radio", text, cb, sel)) end
    function CreateDivider(): MockMenuEntry return self:add(MockMenuEntry.new("divider", "", nil, nil)) end
    function CreateSpacer(): MockMenuEntry return self:add(MockMenuEntry.new("spacer", "", nil, nil)) end
    function SetEnabled(enabled: boolean) self.enabled = enabled end

    --- `text` lines, indented by depth: `[x]`/`( )` for checkboxes and radios.
    function lines(out: string[], depth: number)
        for _, e in ipairs(self.children) do
            local mark = ""
            if e.isSelected then
                const on = e.isSelected(nil)
                if e.kind == "checkbox" then
                    mark = on and "[x] " or "[ ] "
                else
                    mark = on and "(o) " or "( ) "
                end
            end
            const label = e.kind == "divider" and "---" or `{mark}{e.text}{e.enabled and "" or " (disabled)"}`
            out[#out + 1] = string.rep("  ", depth) .. label
            e:lines(out, depth + 1)
        end
    end
end

Mock.menu = nil
MenuUtil = {} :: any
function MenuUtil.CreateContextMenu(owner: any, generator: (owner: any, root: any) -> ())
    const root = MockMenuEntry.new("root", "", nil, nil)
    generator(owner, root)
    Mock.menu = root
end

--- The last menu opened, one line per entry.
function Mock.lastMenu(): string
    const out: string[] = {}
    if Mock.menu then
        (Mock.menu :: MockMenuEntry):lines(out, 0)
    end
    return table.concat(out, "\n")
end

--- Clicks the entry at `path` ("Move to/Bags") in the last menu.
function Mock.clickMenu(path: string)
    local e: MockMenuEntry? = Mock.menu
    for part in path:gmatch("[^/]+") do
        local found: MockMenuEntry? = nil
        for _, child in ipairs(e?.children ?? {}) do
            if child.text == part then
                found = child
            end
        end
        e = found
    end
    if e and e.enabled and e.callback then
        e.callback(nil, {}, {})
    end
end

-- Scrolling lists (ScrollBox) ----------------------------------------------------

--- How many rows a mock ScrollBox shows.
Mock.listRows = 5

class MockListView
    extent: number = 0
    initializer?: (holder: any, data: any) -> ()
    resetter?: (holder: any) -> ()

    function SetElementExtent(extent: number) self.extent = extent end
    function SetPadding(...: any) end
    function SetElementInitializer(_: string, fn: (holder: any, data: any) -> ()) self.initializer = fn end
    function SetElementResetter(fn: (holder: any) -> ()) self.resetter = fn end
end

class MockScrollBox extends MockFrame
    view?: MockListView
    items: any[] = {}
    offset: number = 0
    holders: any[] = {}

    constructor(name: string?, parent: any)
        super("Frame", name, parent)
    end

    -- Shows the window starting after `offset`, recycling the holders.
    function layout()
        const view = self.view
        if not view then return end
        for k = 1, Mock.listRows do
            local holder = self.holders[k]
            if holder and view.resetter then
                view.resetter(holder)
            end
            const item = self.items[self.offset + k]
            if item then
                if not holder then
                    holder = CreateFrame("Frame", nil, self)
                    self.holders[k] = holder
                end
                view.initializer?.(holder, item)
            end
        end
    end

    function SetDataProvider(provider: any)
        self.items = provider.items
        self.offset = 0
        self:layout()
    end

    function ScrollToElementDataIndex(index: number)
        self.offset = math.max(0, math.min(index - Mock.listRows, #self.items - Mock.listRows))
        self:layout()
    end
end

Mock.templates.WowScrollBoxList = function(name: string?, parent: any): any
    return MockScrollBox.new(name, parent)
end
_G.CreateScrollBoxListLinearView = function(): any
    return MockListView.new()
end
_G.CreateDataProvider = function(items: any[]?): any
    return { items = items ?? {} }
end
ScrollUtil = {} :: any
function ScrollUtil.InitScrollBoxListWithScrollBar(box: any, _: any, view: any)
    box.view = view
end

--- Scrolls a wowlua:list view so that row `offset + 1` is the first shown.
function Mock.scroll(list: any, offset: number)
    for _, f in ipairs(Mock.frames) do
        if f.parent == list.frame and (f :: any).layout then
            const box = f :: any
            box.offset = offset
            box:layout()
        end
    end
end

-- The client's formatting helpers (English stand-ins) -----------------------------

COPPER_PER_SILVER, SILVER_PER_GOLD = 100, 100
GOLD_AMOUNT, SILVER_AMOUNT, COPPER_AMOUNT = "%d Gold", "%d Silver", "%d Copper"
function SecondsToTime(seconds: number, noSeconds: boolean?, notAbbreviated: boolean?, maxCount: number?): string
    const units = { { 3600, notAbbreviated and "Hours" or "Hr" }, { 60, notAbbreviated and "Minutes" or "Min" }, { 1, notAbbreviated and "Seconds" or "Sec" } }
    const parts: string[] = {}
    local rest = math.floor(seconds)
    for i, u in ipairs(units) do
        const n = math.floor(rest / (u[1] :: number))
        rest = rest % (u[1] :: number)
        if n > 0 and #parts < (maxCount ?? 2) and not (i == 3 and noSeconds) then
            parts[#parts + 1] = `{n} {u[2]}`
        end
    end
    return table.concat(parts, " ")
end
function SecondsToTimeAbbrev(seconds: number): (string, number)
    if seconds >= 3600 then return `{math.floor(seconds / 3600)} h`, 0 end
    if seconds >= 60 then return `{math.floor(seconds / 60)} m`, 0 end
    return `{math.floor(seconds)} s`, 0
end
function SecondsToClock(seconds: number, hours: boolean?): string
    local h, m, sec = math.floor(seconds / 3600), math.floor(seconds / 60) % 60, math.floor(seconds) % 60
    if h > 0 or hours then
        return string.format("%d:%02d:%02d", h, m, sec)
    end
    return string.format("%d:%02d", m, sec)
end
function FormatShortDate(day: number, month: number, year: number): string
    return string.format("%d/%d/%02d", month, day, year % 100)
end
function GetMoneyString(copper: number, _: boolean?): string
    return `{math.floor(copper / 10000)}g {math.floor(copper / 100) % 100}s {copper % 100}c`
end
BreakUpLargeNumbers = (function(n: number): string
    local text = tostring(math.floor(n))
    local k = 0
    repeat
        text, k = text:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
    until k == 0
    return text
end) :: any
AbbreviateNumbers = (function(n: any): string
    if issecretvalue(n) then error("secret") end
    if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
    if n >= 1000 then return string.format("%.1fK", n / 1000) end
    return tostring(n)
end) :: any

