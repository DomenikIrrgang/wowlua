-- A small model of the WoW client for the standard library's tests: frames
-- and events (with unit filters), scripts and hooks, error handlers,
-- C_Timer on a controlled clock, combat state, addon loading and slash
-- commands. Test scripts drive it through `Mock`.

Mock = { now = 0, frames = {}, timers = {}, errors = {}, out = {}, loaded = {},
         combat = false, loggedIn = false }

-- The client's events (anything else is unknown, like an addon's messages).
Mock.events = {}
for _, e in ipairs({ "ADDON_LOADED", "PLAYER_LOGIN", "PLAYER_LOGOUT", "PLAYER_ENTERING_WORLD",
    "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED", "PLAYER_STARTED_MOVING", "BAG_UPDATE",
    "BAG_UPDATE_DELAYED", "UNIT_HEALTH", "UNIT_POWER_UPDATE", "PLAYER_TARGET_CHANGED", "UNIT_TARGET",
    "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN", "TIME_PLAYED_MSG" }) do
    Mock.events[e] = true
end

function print(...)
    local parts = {}
    for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
    Mock.out[#Mock.out + 1] = table.concat(parts, " ")
end

-- Error handling ------------------------------------------------------------

local handler: (msg: any) -> () = function(msg)
    Mock.errors[#Mock.errors + 1] = tostring(msg)
    print("ERROR: " .. tostring(msg))
end
function geterrorhandler() return handler end
function seterrorhandler(fn) handler = fn end

function securecallfunction(fn, ...)
    local n, args = select("#", ...), { ... }
    local results = { xpcall(function() return fn(unpack(args, 1, n)) end, function(e) geterrorhandler()(e) return e end) }
    if results[1] then return unpack(results, 2) end
end

function debugstack() return "" end
date = os.date
function GetTime() return Mock.now end
-- The client's language (`Mock.locale`).
function GetLocale() return Mock.locale or "enUS" end
function InCombatLockdown() return Mock.combat end
function IsLoggedIn() return Mock.loggedIn end
-- Values marked secret (the modern client hides them from addons).
Mock.secrets = setmetatable({}, { __mode = "k" })
function issecretvalue(v) return type(v) == "table" and Mock.secrets[v] == true end
function Mock.secret() local v = {}; Mock.secrets[v] = true; return v end

-- An assertion inside a test script.
function Mock.check(cond, label)
    if not cond then print("FAIL: " .. tostring(label)) end
end

DEFAULT_CHAT_FRAME = { AddMessage = function(_, msg) print(msg) end }

-- Frames --------------------------------------------------------------------

local Frame = {}
Frame.__index = function(self, key)
    local method = Frame[key]
    if method then return method end
    -- Layout and drawing methods do nothing.
    return function() end
end

function Frame:RegisterEvent(event)
    if not Mock.events[event] then error("Attempt to register unknown event \"" .. event .. "\"", 2) end
    self.events[event] = true
    self.units[event] = nil
end
function Frame:RegisterUnitEvent(event, u1, u2)
    if not Mock.events[event] then error("Attempt to register unknown event \"" .. event .. "\"", 2) end
    self.events[event] = true
    self.units[event] = { [u1] = true }
    if u2 then self.units[event][u2] = true end
end
function Frame:UnregisterEvent(event) self.events[event] = nil; self.units[event] = nil end
function Frame:UnregisterAllEvents() self.events = {}; self.units = {} end
function Frame:IsEventRegistered(event) return self.events[event] == true end
function Frame:SetScript(name, fn) self.scripts[name] = fn; self.hooks[name] = nil end
function Frame:GetScript(name) return self.scripts[name] end
function Frame:HookScript(name, fn)
    self.hooks[name] = self.hooks[name] or {}
    table.insert(self.hooks[name], fn)
end
function Frame:Show() self.shown = true; Mock.script(self, "OnShow") end
function Frame:Hide() self.shown = false; Mock.script(self, "OnHide") end
function Frame:IsShown() return self.shown end
function Frame:GetName() return self.name end
function Frame:GetParent() return rawget(self, "parent") end
function Frame:SetParent(p) rawset(self, "parent", p) end
function Frame:GetObjectType() return self.kind end
function Frame:SetPoint(...) local p = rawget(self, "points") or {}; rawset(self, "points", p); p[#p + 1] = { ... } end
function Frame:ClearAllPoints() rawset(self, "points", {}) end
function Frame:GetNumPoints() local p = rawget(self, "points"); return p and #p or 0 end
function Frame:SetAttribute(k, v)
    local a = rawget(self, "attributes") or {}
    rawset(self, "attributes", a)
    a[k] = v
end
function Frame:GetAttribute(k) local a = rawget(self, "attributes"); return a and a[k] end

-- (The client's CreateFrame has an overload per frame type.)
CreateFrame = (function(kind, name, parent, template)
    local f = setmetatable({ kind = kind, name = name, parent = parent, events = {}, units = {}, scripts = {}, hooks = {}, shown = true }, Frame)
    Mock.frames[#Mock.frames + 1] = f
    if name then _G[name] = f end
    return f
end) :: any

function Mock.script(frame, name, ...)
    local fn = frame.scripts[name]
    if fn then fn(frame, ...) end
    for _, h in ipairs(frame.hooks[name] or {}) do h(frame, ...) end
end

-- Fires a WoW event at every frame registered for it, in creation order.
function Mock.fire(event, ...)
    if event == "PLAYER_REGEN_DISABLED" then Mock.combat = true end
    if event == "PLAYER_REGEN_ENABLED" then Mock.combat = false end
    if event == "PLAYER_LOGIN" then Mock.loggedIn = true end
    local unit = ...
    for _, f in ipairs({ unpack(Mock.frames) }) do
        local units = f.units[event]
        if f.events[event] and (not units or units[unit]) then
            Mock.script(f, "OnEvent", event, ...)
        end
    end
end

-- Loads an addon (fires ADDON_LOADED for it).
function Mock.loadAddon(name)
    Mock.loaded[name] = true
    Mock.fire("ADDON_LOADED", name, false)
end

-- Load-on-demand addons: name → a function defining their globals.
Mock.onDemand = {}
Mock.metadata = {}
C_AddOns = {} :: any
function C_AddOns.IsAddOnLoaded(name: string | number): (boolean, boolean)
    return Mock.loaded[name] == true, Mock.loaded[name] == true
end
function C_AddOns.IsAddOnLoadOnDemand(name: string | number): boolean
    return Mock.onDemand[name] ~= nil
end
function C_AddOns.LoadAddOn(name: string | number): (boolean?, string?)
    local define = Mock.onDemand[name]
    if not define or Mock.loaded[name] then
        return false, "LOADED"
    end
    define()
    Mock.loadAddon(name)
    return true, nil
end
function C_AddOns.GetAddOnMetadata(name: string | number, field: string): string
    return Mock.metadata[name] and Mock.metadata[name][field]
end
GetAddOnMetadata = C_AddOns.GetAddOnMetadata
Mock.interface = 11508
function GetBuildInfo() return "1.0.0", "1", "Jan 1 2026", Mock.interface end
function UnitName() return "Tester" end
function GetFramesRegisteredForEvent(event)
    local out = {}
    for _, f in ipairs(Mock.frames) do
        if f.events[event] then out[#out + 1] = f end
    end
    return unpack(out)
end
-- Server answers arrive a moment later.
function RequestTimePlayed()
    C_Timer.After(0.2, function() Mock.fire("TIME_PLAYED_MSG", 3600, 60) end)
end
C_EventUtils = {} :: any
function C_EventUtils.IsEventValid(event: string): boolean
    return Mock.events[event] == true
end

-- Hooks ---------------------------------------------------------------------

function hooksecurefunc(target, name, fn)
    if type(target) == "string" then target, name, fn = _G, target, name end
    local original = target[name]
    assert(type(original) == "function", "hooksecurefunc: " .. tostring(name) .. " is not a function")
    target[name] = function(...)
        local r = { original(...) }
        fn(...)
        return unpack(r)
    end
end

-- Timers --------------------------------------------------------------------

local Timer = {}
Timer.__index = Timer
function Timer:Cancel() self.cancelled = true end
function Timer:IsCancelled() return self.cancelled == true end

local function schedule(sec, fn, iterations)
    local t = setmetatable({ due = Mock.now + sec, every = sec, fn = fn, left = iterations, cancelled = false }, Timer)
    Mock.timers[#Mock.timers + 1] = t
    return t
end

C_Timer = {} :: any
function C_Timer.After(seconds: number, callback: () -> ())
    schedule(seconds, callback, 1)
end
function C_Timer.NewTimer(seconds: number, callback: (handle: TimerHandle) -> ()): TimerHandle
    return schedule(seconds, callback, 1) :: any
end
function C_Timer.NewTicker(seconds: number, callback: (handle: TickerHandle) -> (), iterations: number?): TickerHandle
    return schedule(seconds, callback, iterations or math.huge) :: any
end

-- Advances the clock, running due timers in order (a frame is 0 seconds).
function Mock.advance(sec)
    local target = Mock.now + (sec or 0)
    while true do
        local next
        for _, t in ipairs(Mock.timers) do
            if not t.cancelled and t.left > 0 and t.due <= target and (not next or t.due < next.due) then next = t end
        end
        if not next then break end
        Mock.now = math.max(Mock.now, next.due)
        next.left = next.left - 1
        next.due = next.due + next.every
        next.fn(next)
    end
    Mock.now = target
end

-- Slash commands ------------------------------------------------------------

SlashCmdList = {}

-- Runs "/cmd args" like the chat box.
function Mock.slash(line)
    local cmd, msg = line:match("^(%S+)%s*(.-)$")
    for key, fn in pairs(SlashCmdList) do
        local i = 1
        while _G["SLASH_" .. key .. i] do
            if _G["SLASH_" .. key .. i]:lower() == cmd:lower() then return fn(msg, {}) end
            i = i + 1
        end
    end
    print("unknown command " .. cmd)
end

-- A few of Blizzard's globals for hooks.
UIParent = CreateFrame("Frame", "UIParent") :: any
function ToggleGameMenu() print("menu") end
GameTooltip = CreateFrame("GameTooltip", "GameTooltip") :: any
function GameTooltip:SetUnit(unit) print("SetUnit " .. unit) end
CreateFrame("Frame", "PlayerFrame")

-- Settings (Blizzard's Settings API: categories, rows, proxy settings) -------

Mock.settings = { categories = {}, opened = {}, variables = {} }
local Category = {}
Category.__index = Category
function Category:GetID() return self.id end
local Layout = {}
Layout.__index = Layout
function Layout:AddInitializer(init) table.insert(self.items, init) end
local function newCategory(name, parent)
    local c = setmetatable({ id = #Mock.settings.categories + 1, name = name, parent = parent }, Category)
    c.layout = setmetatable({ items = {} }, Layout)
    table.insert(Mock.settings.categories, c)
    return c, c.layout
end
local Setting = {}
Setting.__index = Setting
function Setting:GetValue() return self.get() end
function Setting:SetValue(v) self.set(v) end
function Setting:NotifyUpdate() self.updates = (self.updates or 0) + 1 end
local function row(kind)
    return function(category, setting, a, b)
        local item = { kind = kind, setting = setting, a = a, b = b }
        table.insert(category.layout.items, item)
        return item
    end
end
Settings = {
    VarType = { Boolean = "boolean", Number = "number", String = "string" },
    RegisterVerticalLayoutCategory = function(name) return newCategory(name) end,
    RegisterVerticalLayoutSubcategory = function(parent, name) return newCategory(name, parent) end,
    RegisterAddOnCategory = function(c) c.registered = true end,
    RegisterProxySetting = function(category, variable, varType, name, default, get, set)
        if Mock.settings.variables[variable] then
            error("Setting variable '" .. variable .. "' was previously registered.")
        end
        local s = setmetatable({ variable = variable, varType = varType, name = name, default = default, get = get, set = set }, Setting)
        Mock.settings.variables[variable] = s
        return s
    end,
    CreateCheckbox = row("checkbox"),
    CreateSlider = row("slider"),
    CreateDropdown = row("dropdown"),
    CreateColorSwatch = row("color"),
    CreateSliderOptions = function(min, max, step)
        return { min = min, max = max, step = step, SetLabelFormatter = function(self, label, f) self.format = f end }
    end,
    CreateControlTextContainer = function()
        local data = {}
        return { Add = function(_, v, l) table.insert(data, { value = v, label = l }) end, GetData = function() return data end }
    end,
    CreateElementInitializer = function(template, data)
        local init = { kind = "element", template = template, data = data, Resetter = function() end }
        init.InitFrame = function()
            -- The client's element template needs set-up an element row lacks.
            if template == "SettingsListElementTemplate" then
                error("attempt to index field 'cbrHandles' (a nil value)")
            end
        end
        return init
    end,
    OpenToCategory = function(id)
        table.insert(Mock.settings.opened, id)
        SettingsPanel:Show()
        -- The list shows the category's rows.
        for _, item in ipairs(Mock.settings.categories[id].layout.items) do
            if item.InitFrame then item:InitFrame(CreateFrame("Frame")) end
        end
    end,
    GetSetting = function(variable) return Mock.settings.variables[variable] end,
}
SettingsPanel = CreateFrame("Frame", "SettingsPanel")
SettingsPanel:Hide()
function HideUIPanel(frame) frame:Hide() end
MinimalSliderWithSteppersMixin = { Label = { Right = "right" } }
function CreateSettingsListSectionHeaderInitializer(name) return { kind = "header", name = name } end
function CreateSettingsButtonInitializer(name, text, click) return { kind = "button", text = text, click = click } end
function CreateKeybindingEntryInitializer(index) return { kind = "keybinding", index = index } end
Mock.bindings = {}
function GetNumBindings() return #Mock.bindings end
function GetBinding(i) return Mock.bindings[i] end
function Frame:CreateFontString() return CreateFrame("FontString") end
function Frame:SetText(t) rawset(self, "text", t) end
function Frame:GetText() return rawget(self, "text") end

local Color = {}
Color.__index = Color
function CreateColor(r: number, g: number, b: number, a: number?): colorRGBA
    return setmetatable({ r = r, g = g, b = b, a = a or 1 }, Color) :: any
end
function Color:GenerateHexColor()
    local function byte(v) return math.floor(v * 255 + 0.5) end
    return string.format("%02x%02x%02x%02x", byte(self.a), byte(self.r), byte(self.g), byte(self.b))
end
function CreateColorFromHexString(hex)
    local function part(i) return tonumber(hex:sub(i, i + 1), 16) / 255 end
    return CreateColor(part(3), part(5), part(7), part(1))
end

-- Minimap, cursor, textures, Addon Compartment ---------------------------------

Minimap = CreateFrame("Frame", "Minimap") :: any
function Minimap:GetWidth() return 140 end
function Minimap:GetHeight() return 140 end
function Minimap:GetCenter() return 500, 500 end
function Minimap:GetEffectiveScale() return 1 end
Mock.cursor = { 0, 0 }
function GetCursorPosition() return Mock.cursor[1], Mock.cursor[2] end
function Frame:SetShown(v) if v then self:Show() else self:Hide() end end
function Frame:CreateTexture() return CreateFrame("Texture") end
function Frame:SetTexture(t) rawset(self, "texture", t) end
function Frame:GetPoint(i) local p = rawget(self, "points"); return unpack(p and p[i or 1] or {}) end
AddonCompartmentFrame = { registeredAddons = {} } :: any
function AddonCompartmentFrame:RegisterAddon(data) table.insert(self.registeredAddons, data) end
function debugprofilestop() return Mock.now * 1000 end

-- Addon messages: a server that checks, records and echoes ---------------------

Mock.sent = {}
Mock.sendResults = {}      -- results to return next (else 0, success)
Mock.lockdown = false
Mock.group = nil           -- "party", "raid", "instance"
Mock.echoAs = nil          -- deliver sent messages as from this player
LE_PARTY_CATEGORY_HOME, LE_PARTY_CATEGORY_INSTANCE = 1, 2
local function addonMessage(prefix, msg, chatType, target)
    if #msg > 255 or msg:find("%z") then return 2 end
    local result = table.remove(Mock.sendResults, 1) or 0
    if result ~= 0 then return result end
    table.insert(Mock.sent, { prefix = prefix, msg = msg, chatType = chatType, target = target })
    if Mock.echoAs then
        local sender = Mock.echoAs .. "-MockRealm"
        C_Timer.After(0.05, function() Mock.fire("CHAT_MSG_ADDON", prefix, msg, chatType, sender) end)
    end
    return 0
end
C_ChatInfo = {} :: any
function C_ChatInfo.RegisterAddonMessagePrefix(prefix: string): RegisterAddonMessagePrefixResult
    return 0
end
function C_ChatInfo.SendAddonMessage(prefix: string, message: string, chatType: string?, target: string?): SendAddonMessageResult
    return addonMessage(prefix, message, chatType, target)
end
function C_ChatInfo.SendAddonMessageLogged(prefix: string, message: string, chatType: string?, target: string?): SendAddonMessageResult?
    return addonMessage(prefix, message, chatType, target)
end
function C_ChatInfo.InChatMessagingLockdown(): boolean
    return Mock.lockdown
end
Mock.events.CHAT_MSG_ADDON = true
function Ambiguate(name) return (name:gsub("%-MockRealm$", "")) end
function IsInRaid() return Mock.group == "raid" end
function IsInGroup(category)
    if category == LE_PARTY_CATEGORY_INSTANCE then return Mock.group == "instance" end
    return Mock.group ~= nil
end
function IsInGuild() return Mock.guild == true end
