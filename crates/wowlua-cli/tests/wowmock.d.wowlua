-- The mock client's control table (wowmock.wowlua), for test scripts.

--- A frame of the mock client (its own fields; the API comes from the
--- frame's class).
type MockFrameFields = {
    scripts: { [string]: (...any) -> ...any },
    hooks: { [string]: ((...any) -> ...any)[] },
    events: { [string]: boolean },
    shown: boolean,
    [string]: any,
}

interface MockClient
    --- The clock (seconds), advanced by `advance`.
    now: number
    --- Every frame created, in order.
    frames: MockFrameFields[]
    timers: table[]
    --- Reported errors and printed lines.
    errors: string[]
    out: string[]
    --- Loaded addons; load-on-demand ones (name → their code) and TOC
    --- metadata.
    loaded: { [string | number]: boolean }
    onDemand: { [string | number]: () -> () }
    metadata: { [string | number]: { [string]: string } }
    combat: boolean
    loggedIn: boolean
    --- The events the client knows.
    events: { [string]: boolean }
    secrets: { [table]: boolean }
    interface: number
    locale?: string
    settings: { categories: table[], opened: any[], variables: { [string]: any } }
    --- Keybindings the client knows, in order, and what each runs (from
    --- the addon's Bindings.xml).
    bindings: string[]
    bindingActions: { [string]: (keystate: string) -> () }
    --- What each key is bound to (`SetBinding`).
    keys: { [string]: string }
    --- Tooltip post-calls by data type (the data system).
    tooltipCalls: { [number]: ((tip: any, data: table) -> ())[] }
    cursor: number[]
    --- Addon messages: sent ones, results to return next, lockdown, the
    --- group and guild, and who sent messages come back as.
    sent: table[]
    sendResults: number[]
    lockdown: boolean
    group?: "party" | "raid" | "instance"
    guild?: boolean
    echoAs?: string

    secret: () -> table
    check: (cond: any, label: string) -> ()
    script: (frame: any, name: string, ...any) -> ()
    fire: (event: string, ...any) -> ()
    updateStateDrivers: () -> ()
    stateDrivers: any[]
    loadAddon: (name: string | number) -> ()
    advance: (sec: number?) -> ()
    slash: (line: string) -> ()
    addBinding: (name: string, action: (keystate: string) -> ()) -> ()
    pressBinding: (name: string, keystate: string?) -> ()
    pressKey: (key: string) -> ()
    --- Shows a tooltip of `kind` (GameTooltip by default); returns the
    --- lines the post-hooks added.
    tooltip: (name: string) -> any
    --- Frame types with their own mock class.
    frameTypes: { [string]: (name: string?, parent: any) -> any }
    --- Each unit's auras (AuraData tables); reads refuse while restricted.
    auras: { [string]: table[] }
    aurasRestricted: boolean
    --- Spells by ID (name, iconID, description, known, cooldown, charges).
    spells: { [number]: table }
    --- Items by ID (`info`, `cached`, `delay`, `missing`) and load requests.
    items: { [number]: table }
    itemRequests: number[]
    libraries: { [string]: table }
    provideLibrary: (major: string, impl: table) -> ()
    sharedMedia: () -> table
    --- Simulated work (ms) and frames driving OnUpdate.
    worked: number
    spend: (ms: number) -> ()
    advanceFrames: (n: number, ms: number?) -> ()
    dialog: () -> any
    dialogAccept: (value: string?) -> ()
    dialogCancel: () -> ()
    escape: () -> ()
    menu: any
    lastMenu: () -> string
    clickMenu: (path: string) -> ()
    templates: { [string]: (name: string?, parent: any) -> any }
    listRows: number
    scroll: (list: any, offset: number) -> ()
    sounds: string[]
    warnings: string[]
    flashes: number
    auraContainers: any[]
    auraChanged: (unit: string) -> ()
    --- Units by token (`player`, `target`, `party1`, …): what the unit
    --- functions return; values may be `secret()`s.
    units: { [string]: table }
    --- Held modifier keys (`SHIFT`, `CTRL`, `ALT`).
    modifiers: { [string]: boolean }
    drag: (frame: any, dx: number, dy: number) -> ()
    sizeBy: (grip: any, dw: number, dh: number) -> ()
    wheel: (frame: any, delta: number) -> ()
    showTooltip: (kind: string, data: { id?: number, guid?: string, unit?: string, link?: string, name?: string }?, tip: any) -> string[]

    -- Set by some tests' setups.
    awaitText?: (text: string) -> ()
    serialize?: (value: any) -> string
    saved?: string
    ldb?: table
    ctl?: string[]
end

declare global Mock: MockClient
