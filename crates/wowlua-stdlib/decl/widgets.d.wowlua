-- Native widget types (spec §3.2): every frame type `CreateFrame` creates.
-- Implicit until the generated wow-api packages (milestone M4) declare them
-- with their members.

@widget("Frame")
declare class Frame
end

@widget("Button")
declare class Button extends Frame
end

@widget("CheckButton")
declare class CheckButton extends Button
end

@widget("ItemButton")
declare class ItemButton extends Button
end

@widget("ColorSelect")
declare class ColorSelect extends Frame
end

@widget("Cooldown")
declare class Cooldown extends Frame
end

@widget("EditBox")
declare class EditBox extends Frame
end

@widget("GameTooltip")
declare class GameTooltip extends Frame
end

@widget("MessageFrame")
declare class MessageFrame extends Frame
end

@widget("ScrollingMessageFrame")
declare class ScrollingMessageFrame extends Frame
end

@widget("Minimap")
declare class Minimap extends Frame
end

@widget("Model")
declare class Model extends Frame
end

@widget("PlayerModel")
declare class PlayerModel extends Model
end

@widget("CinematicModel")
declare class CinematicModel extends PlayerModel
end

@widget("DressUpModel")
declare class DressUpModel extends PlayerModel
end

@widget("TabardModel")
declare class TabardModel extends PlayerModel
end

@widget("ModelScene")
declare class ModelScene extends Frame
end

@widget("MovieFrame")
declare class MovieFrame extends Frame
end

@widget("ScrollFrame")
declare class ScrollFrame extends Frame
end

@widget("SimpleHTML")
declare class SimpleHTML extends Frame
end

@widget("Slider")
declare class Slider extends Frame
end

@widget("StatusBar")
declare class StatusBar extends Frame
end
