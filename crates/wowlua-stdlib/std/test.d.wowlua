-- Compiler behavior of `wowlua:test` (spec Tooling §16.1.3): the test
-- decorators register the final function value.
@intrinsic("test.test")
declare global test: any
@intrinsic("test.skip")
declare global skip: any
@intrinsic("test.only")
declare global only: any
@intrinsic("test.flavors")
declare global flavors: any
@intrinsic("test.cases")
declare global cases: any
@intrinsic("test.beforeEach")
declare global beforeEach: any
@intrinsic("test.afterEach")
declare global afterEach: any
@intrinsic("test.beforeAll")
declare global beforeAll: any
@intrinsic("test.afterAll")
declare global afterAll: any
