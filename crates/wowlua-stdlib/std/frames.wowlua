-- wowlua:frames (spec stdlib "frames"): movable and resizable frames whose
-- position, size and scale live in a wowlua:saved store. Positions are
-- stored relative to UIParent, anchored at the screen third the frame sits
-- in (a frame near the right edge stays there when the screen size
-- changes), and restored once the store is loaded. With `editMode` the
-- frame joins the client's Edit Mode: it shows the selection overlay there,
-- keeps a position per Edit Mode layout and is locked outside it.
import isLoaded from "wowlua:lifecycle"
import callIn from "wowlua:errors"
import defer from "wowlua:combat"
import handle from "wowlua:saved"
import type SavedHandle from "wowlua:saved"

local _, ns = ...
local wl = ns.__wowlua

export type AnchorPoint = FramePoint

--- Where a frame is: always relative to UIParent.
export type FramePosition = {
    point: AnchorPoint,
    relativePoint: AnchorPoint,
    x: number,
    y: number,
    width?: number,
    height?: number,
    scale?: number,
    --- With `editMode`: the position in each Edit Mode layout, by name (the
    --- fields above are the last one saved, used by layouts without one).
    layouts?: { [string]: FramePosition },
}

export type Modifier = "SHIFT" | "CTRL" | "ALT"

export type MovableOptions = {
    --- A wowlua:saved store; `store[key]` is `FramePosition?` (E8340).
    store: table,
    key: string,
    clamp?: boolean,
    --- The mouse button that drags (default "LeftButton").
    button?: mouseButton,
    --- Drag only while this key is held.
    modifier?: Modifier,
    --- `min`/`max` as `{ width, height }`; `grip`: your own resize handle.
    resize?: { min?: number[], max?: number[], grip?: Frame },
    --- This key + mouse wheel changes the scale.
    scaleWheel?: Modifier,
    --- `{ min, max }` (default `{ 0.5, 2 }`).
    scaleRange?: number[],
    --- After a save, or a reset (nil).
    onChange?: (pos: FramePosition?) -> (),
    --- Joins the client's Edit Mode (decision S36): `label` names the frame
    --- there; `lock = false` keeps it movable outside Edit Mode too.
    editMode?: { label: string, lock?: boolean },
}

export interface MovableHandle
    --- A locked frame cannot be moved, resized or scaled with the mouse.
    function lock(locked: boolean)
    function isLocked(): boolean
    --- Back to the frame's original anchor, size and scale (forgets the
    --- saved position).
    function reset()
    --- Applies the saved position again.
    function restore()
    --- Saves the current position.
    function save()
end

const WHEEL_STEP = 0.05
const GRIP_TEXTURES = {
    normal = "Interface\\ChatFrame\\UI-ChatIM-SizeGrabber-Up",
    pushed = "Interface\\ChatFrame\\UI-ChatIM-SizeGrabber-Down",
    highlight = "Interface\\ChatFrame\\UI-ChatIM-SizeGrabber-Highlight",
}

local function held(modifier: Modifier?): boolean
    if modifier == "SHIFT" then
        return IsShiftKeyDown()
    elseif modifier == "CTRL" then
        return IsControlKeyDown()
    elseif modifier == "ALT" then
        return IsAltKeyDown()
    end
    return true
end

-- The frame's position in UIParent units, anchored at its screen third.
local function measure(frame: Frame): FramePosition
    const s = frame:GetEffectiveScale() / UIParent:GetEffectiveScale()
    const left = (frame:GetLeft() ?? 0) * s
    const right = (frame:GetRight() ?? 0) * s
    const bottom = (frame:GetBottom() ?? 0) * s
    const top = (frame:GetTop() ?? 0) * s
    const width = UIParent:GetWidth()
    const height = UIParent:GetHeight()
    const cx = (left + right) / 2
    const cy = (bottom + top) / 2
    local horizontal, x = "", cx - width / 2
    if cx < width / 3 then
        horizontal, x = "LEFT", left
    elseif cx > width * 2 / 3 then
        horizontal, x = "RIGHT", right - width
    end
    local vertical, y = "", cy - height / 2
    if cy < height / 3 then
        vertical, y = "BOTTOM", bottom
    elseif cy > height * 2 / 3 then
        vertical, y = "TOP", top - height
    end
    local point = vertical .. horizontal
    if point == "" then
        point = "CENTER"
    end
    return { point = point :: AnchorPoint, relativePoint = point :: AnchorPoint, x = x, y = y }
end

-- Anchors the frame at `pos` (UIParent units, converted to the frame's).
local function place(frame: Frame, pos: FramePosition)
    const s = frame:GetEffectiveScale() / UIParent:GetEffectiveScale()
    frame:ClearAllPoints()
    frame:SetPoint(pos.point, UIParent, pos.relativePoint, pos.x / s, pos.y / s)
end

-- The client's Edit Mode selection overlay (EditModeSystemSelectionTemplate).
type Selection = Frame & {
    system: { GetSystemName: (self: any) -> string },
    ShowHighlighted: (self: Selection) -> (),
    ShowSelected: (self: Selection) -> (),
    IsSelected: (self: Selection) -> boolean?,
}

-- Edit Mode's manager (nil on clients without Edit Mode).
type EditModeManager = {
    IsEditModeActive: (self: EditModeManager) -> boolean?,
    GetActiveLayoutInfo: (self: EditModeManager) -> { layoutName?: string }?,
    ClearSelectedSystem: (self: EditModeManager) -> (),
}
local function editModeManager(): EditModeManager?
    return _G.EditModeManagerFrame :: EditModeManager?
end

-- This addon's frames in Edit Mode.
local editModeFrames: Movable[] = {}
local editModeHooked = false

class Movable implements MovableHandle
    private readonly frame: Frame
    private readonly opts: MovableOptions
    private locked: boolean = false
    -- A drag or resize the mouse started (only those save).
    private active: boolean = false
    private grip?: Frame
    -- The frame as it was set up: its anchors, size and scale.
    private readonly points: any[][] = {}
    private readonly width: number
    private readonly height: number
    private readonly scale: number
    private selection?: Selection
    private editing: boolean = false

    constructor(frame: Frame, opts: MovableOptions)
        self.frame = frame
        self.opts = opts
        for i = 1, frame:GetNumPoints() do
            self.points[i] = { frame:GetPoint(i) }
        end
        self.width, self.height = frame:GetSize()
        self.scale = frame:GetScale()
        frame:SetMovable(true)
        frame:EnableMouse(true)
        frame:RegisterForDrag(opts.button ?? "LeftButton")
        if opts.clamp then
            frame:SetClampedToScreen(true)
        end
        frame:HookScript("OnDragStart", function() self:dragStart() end)
        frame:HookScript("OnDragStop", function() self:dragStop() end)
        if opts.resize then
            self:resizable(opts.resize)
        end
        if opts.scaleWheel then
            frame:EnableMouseWheel(true)
            frame:HookScript("OnMouseWheel", function(_: Frame, delta: number) self:wheel(delta) end)
        end
        if opts.editMode and editModeManager() then
            self:joinEditMode(opts.editMode.label)
        end
    end

    -- Protected frames stay put in combat; Edit Mode frames outside it
    -- unless `lock = false`.
    private function blocked(): boolean
        if self.editing then
            return false
        end
        if self.selection and self.opts.editMode?.lock ~= false then
            return true
        end
        return self.locked or (self.frame:IsProtected() and InCombatLockdown())
    end

    private function joinEditMode(label: string)
        const sel = CreateFrame("Frame", nil, self.frame, "EditModeSystemSelectionTemplate") :: Selection
        sel:SetAllPoints()
        sel:Hide()
        -- The template asks its system for the label and selects through
        -- the manager, which knows only Blizzard's frames.
        sel.system = { GetSystemName = function() return label end }
        sel:SetScript("OnMouseDown", function() self:select() end)
        sel:SetScript("OnDragStart", function() self:dragStart() end)
        sel:SetScript("OnDragStop", function() self:dragStop() end)
        if self.opts.scaleWheel then
            sel:EnableMouseWheel(true)
            sel:SetScript("OnMouseWheel", function(_: Frame, delta: number) self:wheel(delta) end)
        end
        self.selection = sel
        self.grip?:SetShown(not self:blocked())
        editModeFrames[#editModeFrames + 1] = self
        const manager = editModeManager()
        if manager and not editModeHooked then
            editModeHooked = true
            EventRegistry:RegisterCallback("EditMode.Enter", function()
                for _, m in ipairs(editModeFrames) do
                    m:editMode(true)
                end
            end, editModeFrames)
            EventRegistry:RegisterCallback("EditMode.Exit", function()
                for _, m in ipairs(editModeFrames) do
                    m:editMode(false)
                end
            end, editModeFrames)
            -- A layout switch or a revert re-reads the layouts.
            hooksecurefunc(manager :: any, "UpdateLayoutInfo", function()
                for _, m in ipairs(editModeFrames) do
                    m:restore()
                end
            end)
            -- Selecting one of Blizzard's frames deselects ours.
            hooksecurefunc(manager :: any, "SelectSystem", function()
                for _, m in ipairs(editModeFrames) do
                    if m.editing then
                        m.selection?:ShowHighlighted()
                    end
                end
            end)
        end
        if manager?:IsEditModeActive() then
            self:editMode(true)
        end
    end

    private function editMode(active: boolean)
        self.editing = active
        if active then
            self.selection?:ShowHighlighted()
        else
            self.selection?:Hide()
        end
        const grip = self.grip
        if grip then
            grip:SetShown(not self:blocked())
            -- Above the overlay.
            grip:SetFrameLevel(self.frame:GetFrameLevel() + 1000)
        end
    end

    private function select()
        editModeManager()?:ClearSelectedSystem()
        for _, m in ipairs(editModeFrames) do
            if m ~= self and m.editing then
                m.selection?:ShowHighlighted()
            end
        end
        self.selection?:ShowSelected()
    end

    -- The active Edit Mode layout's name (nil without Edit Mode).
    private function layout(): string?
        if not self.selection then
            return nil
        end
        return editModeManager()?:GetActiveLayoutInfo()?.layoutName
    end

    private function dragStart()
        if not self:blocked() and held(self.opts.modifier) then
            self.active = true
            self.frame:StartMoving()
        end
    end

    private function dragStop()
        if not self.active then
            return
        end
        self.active = false
        self.frame:StopMovingOrSizing()
        self.frame:SetUserPlaced(false)
        self:save()
    end

    private function resizable(resize: { min?: number[], max?: number[], grip?: Frame })
        const frame = self.frame
        frame:SetResizable(true)
        const min = resize.min ?? { 0, 0 }
        const max = resize.max
        frame:SetResizeBounds(min[1], min[2], max?.[1], max?.[2])
        local grip = resize.grip
        if not grip then
            const button = CreateFrame("Button", nil, frame)
            button:SetSize(16, 16)
            button:SetPoint("BOTTOMRIGHT", frame, "BOTTOMRIGHT", -2, 2)
            button:SetNormalTexture(GRIP_TEXTURES.normal)
            button:SetPushedTexture(GRIP_TEXTURES.pushed)
            button:SetHighlightTexture(GRIP_TEXTURES.highlight)
            grip = button
        end
        self.grip = grip
        grip:EnableMouse(true)
        grip:HookScript("OnMouseDown", function()
            if not self:blocked() then
                self.active = true
                frame:StartSizing("BOTTOMRIGHT")
            end
        end)
        grip:HookScript("OnMouseUp", function() self:dragStop() end)
    end

    -- Scales around the frame's anchor, which stays where it is.
    private function wheel(delta: number)
        if self:blocked() or not held(self.opts.scaleWheel) then
            return
        end
        const range = self.opts.scaleRange ?? { 0.5, 2 }
        const scale = math.max(range[1], math.min(range[2], self.frame:GetScale() + delta * WHEEL_STEP))
        const pos = measure(self.frame)
        self.frame:SetScale(scale)
        place(self.frame, pos)
        self:save()
    end

    function lock(locked: boolean)
        self.locked = locked
        self.grip?:SetShown(not self:blocked())
    end

    function isLocked(): boolean
        return self.locked
    end

    function save()
        const pos = measure(self.frame)
        pos.scale = self.frame:GetScale()
        if self.opts.resize then
            pos.width, pos.height = self.frame:GetSize()
        end
        const name = self:layout()
        if name then
            -- Kept: the other layouts' positions.
            const layouts = (self.opts.store[self.opts.key] :: FramePosition?)?.layouts ?? {}
            layouts[name] = pos
            self.opts.store[self.opts.key] = {
                point = pos.point,
                relativePoint = pos.relativePoint,
                x = pos.x,
                y = pos.y,
                width = pos.width,
                height = pos.height,
                scale = pos.scale,
                layouts = layouts,
            }
        else
            local layouts = (self.opts.store[self.opts.key] :: FramePosition?)?.layouts
            pos.layouts = layouts
            self.opts.store[self.opts.key] = pos
        end
        self:changed(pos)
    end

    function restore()
        local pos = self.opts.store[self.opts.key] :: FramePosition?
        if not pos then
            return
        end
        const name = self:layout()
        if name and pos.layouts?.[name] then
            pos = pos.layouts[name]
        end
        defer(function()
            const frame = self.frame
            frame:SetScale(pos.scale ?? self.scale)
            if self.opts.resize and pos.width and pos.height then
                frame:SetSize(pos.width, pos.height)
            end
            place(frame, pos)
        end)
    end

    function reset()
        self.opts.store[self.opts.key] = nil
        defer(function()
            const frame = self.frame
            frame:SetScale(self.scale)
            frame:SetSize(self.width, self.height)
            frame:ClearAllPoints()
            for _, p in ipairs(self.points) do
                frame:SetPoint(unpack(p))
            end
        end)
        self:changed(nil)
    end

    private function changed(pos: FramePosition?)
        const onChange = self.opts.onChange
        if onChange then
            callIn({ component = `frames: {self.opts.key}` }, onChange, pos)
        end
    end
end

--- Makes `frame` movable (and resizable), keeping its position in
--- `opts.store[opts.key]`; restored once the store is loaded.
export function movable(frame: Frame, opts: MovableOptions): MovableHandle
    const m = Movable.new(frame, opts)
    local function start()
        m:restore()
        -- A profile switch brings that profile's position.
        local ok, h = pcall(handle, opts.store)
        if ok then
            (h :: SavedHandle).profiles?:onChange(function() m:restore() end)
        end
    end
    if isLoaded() then
        start()
    else
        const tasks = assert(wl.lifecycleTasks)
        tasks.afterLoad[#tasks.afterLoad + 1] = start
    end
    return m
end

-- Widget themes ------------------------------------------------------------------

--- A color: `{ r, g, b, a? }`, components 0 to 1.
export type ThemeColor = number[]

--- How the standard library's own widgets look (dialogs, the built-in
--- minimap button). Every slot is optional; unset slots keep the client's
--- look (decisions S17, S18).
export type WidgetTheme = {
    font?: { title?: string, body?: string, size?: number },
    colors?: {
        background?: ThemeColor,
        border?: ThemeColor,
        title?: ThemeColor,
        text?: ThemeColor,
        muted?: ThemeColor,
        accent?: ThemeColor,
        onAccent?: ThemeColor,
        error?: ThemeColor,
    },
    borderSize?: number,
    padding?: number,
    button?: "template" | "flat",
}

--- What a piece of text is, for its font and color.
export type TextRole = "title" | "body" | "muted" | "error"

const WHITE = "Interface\\Buttons\\WHITE8X8"
const FONT_OBJECTS: { [string]: string } = {
    title = "GameFontNormal",
    body = "GameFontHighlight",
    muted = "GameFontDisable",
    error = "GameFontRed",
}

--- The client's dialog backdrop, or with a theme's colors and border a
--- flat one.
export function applyBackdrop(frame: Frame, theme: WidgetTheme?)
    const colors = theme?.colors
    if colors?.background or colors?.border or theme?.borderSize then
        const edge = theme?.borderSize ?? 1
        frame:SetBackdrop({ bgFile = WHITE, edgeFile = WHITE, edgeSize = edge, insets = { left = edge, right = edge, top = edge, bottom = edge } })
        const bg = colors?.background ?? { 0, 0, 0, 0.9 }
        frame:SetBackdropColor(bg[1], bg[2], bg[3], bg[4] ?? 1)
        const border = colors?.border ?? { 0.5, 0.5, 0.5, 1 }
        frame:SetBackdropBorderColor(border[1], border[2], border[3], border[4] ?? 1)
    else
        frame:SetBackdrop(BACKDROP_DIALOG_32_32)
        frame:SetBackdropColor(1, 1, 1, 1)
        frame:SetBackdropBorderColor(1, 1, 1, 1)
    end
end

--- Text in its role's font object, with a theme's font and color.
export function styleText(text: FontString, role: TextRole, theme: WidgetTheme?)
    text:SetFontObject(FONT_OBJECTS[role])
    local file = theme?.font?.body
    if role == "title" then
        file = theme?.font?.title ?? file
    end
    if file or theme?.font?.size then
        local path, size, flags = text:GetFont()
        text:SetFont(file ?? path ?? "Fonts\\FRIZQT__.TTF", theme?.font?.size ?? size ?? 12, (flags ?? "") :: any)
    end
    const colors = theme?.colors
    local color: ThemeColor? = nil
    if role == "title" then
        color = colors?.title
    elseif role == "body" then
        color = colors?.text
    elseif role == "muted" then
        color = colors?.muted
    else
        color = colors?.error
    end
    if color then
        text:SetTextColor(color[1], color[2], color[3], color[4] ?? 1)
    end
end

--- A button: the client's panel button, or a flat one with a theme's
--- `button = "flat"`.
export function button(parent: Frame, label: string, theme: WidgetTheme?): Button
    if theme?.button ~= "flat" then
        const b = CreateFrame("Button", nil, parent, "UIPanelButtonTemplate")
        b:SetSize(128, 21)
        b:SetText(label)
        return b
    end
    const b = CreateFrame("Button", nil, parent, "BackdropTemplate")
    b:SetSize(128, 21)
    const edge = theme?.borderSize ?? 1
    b:SetBackdrop({ bgFile = WHITE, edgeFile = WHITE, edgeSize = edge })
    const accent = theme?.colors?.accent ?? { 0.3, 0.3, 0.3, 1 }
    b:SetBackdropColor(accent[1], accent[2], accent[3], accent[4] ?? 1)
    const border = theme?.colors?.border ?? accent
    b:SetBackdropBorderColor(border[1], border[2], border[3], border[4] ?? 1)
    const text = b:CreateFontString(nil, "OVERLAY")
    text:SetPoint("CENTER")
    styleText(text, "body", theme)
    const on = theme?.colors?.onAccent
    if on then
        text:SetTextColor(on[1], on[2], on[3], on[4] ?? 1)
    end
    b:SetFontString(text)
    b:SetText(label)
    return b
end
