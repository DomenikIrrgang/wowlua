-- wowlua:frames (spec stdlib "frames"): movable and resizable frames whose
-- position, size and scale live in a wowlua:saved store. Positions are
-- stored relative to UIParent, anchored at the screen third the frame sits
-- in (a frame near the right edge stays there when the screen size
-- changes), and restored once the store is loaded. With `editMode` the
-- frame joins the client's Edit Mode: it shows the selection overlay there,
-- keeps a position per Edit Mode layout and is locked outside it. A
-- position, size or scale that reads as secret (anchored to a restricted
-- frame) is neither saved nor applied.
import isLoaded from "wowlua:lifecycle"
import callIn from "wowlua:errors"
import defer from "wowlua:combat"
import handle from "wowlua:saved"
import type SavedHandle from "wowlua:saved"
import * as secret from "wowlua:secret"
import after from "wowlua:timer"

local _, ns = ...
local wl = ns.__wowlua

--- A frame's anchor point (`"TOPLEFT"`, `"CENTER"`, …): the game's `FramePoint`.
export type AnchorPoint = FramePoint

--- Where a frame is: always relative to UIParent.
export type FramePosition = {
    point: AnchorPoint,
    relativePoint: AnchorPoint,
    x: number,
    y: number,
    width?: number,
    height?: number,
    scale?: number,
    --- With `editMode`: the position in each Edit Mode layout, by name (the
    --- fields above are the last one saved, used by layouts without one).
    layouts?: { [string]: FramePosition },
}

--- A modifier key.
export type Modifier = "SHIFT" | "CTRL" | "ALT"

--- Options of `movable`: where the position is saved, and how the frame
--- is dragged, resized and scaled.
export type MovableOptions = {
    --- A wowlua:saved store; `store[key]` is `FramePosition?` (E8340).
    store: table,
    key: string,
    clamp?: boolean,
    --- The mouse button that drags (default "LeftButton").
    button?: mouseButton,
    --- Drag only while this key is held.
    modifier?: Modifier,
    --- `min`/`max` as `{ width, height }`; `grip`: your own resize handle.
    resize?: { min?: number[], max?: number[], grip?: Frame },
    --- This key + mouse wheel changes the scale.
    scaleWheel?: Modifier,
    --- `{ min, max }` (default `{ 0.5, 2 }`).
    scaleRange?: number[],
    --- After a save, or a reset (nil).
    onChange?: (pos: FramePosition?) -> (),
    --- Joins the client's Edit Mode (decision S36): `label` names the frame
    --- there; `lock = false` keeps it movable outside Edit Mode too.
    editMode?: { label: string, lock?: boolean },
}

--- What `movable` returns: locks the frame, and saves, restores or
--- resets its position.
export interface MovableHandle
    --- A locked frame cannot be moved, resized or scaled with the mouse.
    function lock(locked: boolean)
    --- Whether the frame is locked (see `lock`).
    function isLocked(): boolean
    --- Back to the frame's original anchor, size and scale (forgets the
    --- saved position).
    function reset()
    --- Applies the saved position again.
    function restore()
    --- Saves the current position.
    function save()
end

const WHEEL_STEP = 0.05
const GRIP_TEXTURES = {
    normal = "Interface\\ChatFrame\\UI-ChatIM-SizeGrabber-Up",
    pushed = "Interface\\ChatFrame\\UI-ChatIM-SizeGrabber-Down",
    highlight = "Interface\\ChatFrame\\UI-ChatIM-SizeGrabber-Highlight",
}

local function held(modifier: Modifier?): boolean
    if modifier == "SHIFT" then
        return IsShiftKeyDown()
    elseif modifier == "CTRL" then
        return IsControlKeyDown()
    elseif modifier == "ALT" then
        return IsAltKeyDown()
    end
    return true
end

-- `v` when it is a number that can be read.
local function number(v: unknown): number?
    if secret.isSecret(v) or type(v) ~= "number" then
        return nil
    end
    return v :: number
end

-- The frame's position in UIParent units, anchored at its screen third;
-- nil while it reads as secret.
local function measure(frame: Frame): FramePosition?
    const scale = number(frame:GetEffectiveScale())
    const uiScale = number(UIParent:GetEffectiveScale())
    const width = number(UIParent:GetWidth())
    const height = number(UIParent:GetHeight())
    local l, r, b, t = frame:GetLeft(), frame:GetRight(), frame:GetBottom(), frame:GetTop()
    if scale == nil or uiScale == nil or width == nil or height == nil then
        return nil
    end
    if secret.isSecret(l) or secret.isSecret(r) or secret.isSecret(b) or secret.isSecret(t) then
        return nil
    end
    const s = scale / uiScale
    const left = (l ?? 0) * s
    const right = (r ?? 0) * s
    const bottom = (b ?? 0) * s
    const top = (t ?? 0) * s
    const cx = (left + right) / 2
    const cy = (bottom + top) / 2
    local horizontal, x = "", cx - width / 2
    if cx < width / 3 then
        horizontal, x = "LEFT", left
    elseif cx > width * 2 / 3 then
        horizontal, x = "RIGHT", right - width
    end
    local vertical, y = "", cy - height / 2
    if cy < height / 3 then
        vertical, y = "BOTTOM", bottom
    elseif cy > height * 2 / 3 then
        vertical, y = "TOP", top - height
    end
    local point = vertical .. horizontal
    if point == "" then
        point = "CENTER"
    end
    return { point = point :: AnchorPoint, relativePoint = point :: AnchorPoint, x = x, y = y }
end

-- Anchors the frame at `pos` (UIParent units, converted to the frame's).
local function place(frame: Frame, pos: FramePosition)
    local scale, x, y = number(frame:GetEffectiveScale()), number(pos.x), number(pos.y)
    const uiScale = number(UIParent:GetEffectiveScale())
    if scale == nil or uiScale == nil or x == nil or y == nil or secret.isSecret(pos.point) or secret.isSecret(pos.relativePoint) then
        return
    end
    const s = scale / uiScale
    frame:ClearAllPoints()
    frame:SetPoint(pos.point, UIParent, pos.relativePoint, x / s, y / s)
end

-- The client's Edit Mode selection overlay (EditModeSystemSelectionTemplate).
type Selection = Frame & {
    system: { GetSystemName: (self: any) -> string },
    ShowHighlighted: (self: Selection) -> (),
    ShowSelected: (self: Selection) -> (),
    IsSelected: (self: Selection) -> boolean?,
}

-- Edit Mode's manager (nil on clients without Edit Mode).
type EditModeManager = {
    IsEditModeActive: (self: EditModeManager) -> boolean?,
    GetActiveLayoutInfo: (self: EditModeManager) -> { layoutName?: string }?,
    ClearSelectedSystem: (self: EditModeManager) -> (),
}
-- What Edit Mode is used through: the manager's methods called and hooked
-- here. A client without Edit Mode lacks the manager, or has a stub of it
-- (cata's answers only `IsEditModeActive`).
const EDIT_MODE_METHODS = { "IsEditModeActive", "GetActiveLayoutInfo", "ClearSelectedSystem", "SelectSystem", "UpdateLayoutInfo" }
local function editModeManager(): EditModeManager?
    const manager = _G.EditModeManagerFrame :: unknown
    if type(manager) ~= "table" or _G.EventRegistry == nil then
        return nil
    end
    for _, name in ipairs(EDIT_MODE_METHODS) do
        if type((manager :: { [string]: unknown })[name]) ~= "function" then
            return nil
        end
    end
    return manager :: EditModeManager
end

-- This addon's frames in Edit Mode.
local editModeFrames: Movable[] = {}
local editModeHooked = false

class Movable implements MovableHandle
    private readonly frame: Frame
    private readonly opts: MovableOptions
    private locked: boolean = false
    -- A drag or resize the mouse started (only those save).
    private active: boolean = false
    private grip?: Frame
    -- The frame as it was set up: its anchors, size and scale (those that
    -- read as secret are left out).
    private readonly points: any[][] = {}
    private readonly width?: number
    private readonly height?: number
    private readonly scale?: number
    private selection?: Selection
    private editing: boolean = false

    constructor(frame: Frame, opts: MovableOptions)
        self.frame = frame
        self.opts = opts
        for i = 1, frame:GetNumPoints() do
            const p: any[] = { frame:GetPoint(i) }
            if not (secret.isSecret(p[1]) or secret.isSecret(p[2]) or secret.isSecret(p[3])
                or secret.isSecret(p[4]) or secret.isSecret(p[5])) then
                self.points[#self.points + 1] = p
            end
        end
        local width, height = frame:GetSize()
        self.width, self.height = number(width), number(height)
        self.scale = number(frame:GetScale())
        frame:SetMovable(true)
        frame:EnableMouse(true)
        frame:RegisterForDrag(opts.button ?? "LeftButton")
        if opts.clamp then
            frame:SetClampedToScreen(true)
        end
        frame:HookScript("OnDragStart", function() self:dragStart() end)
        frame:HookScript("OnDragStop", function() self:dragStop() end)
        if opts.resize then
            self:resizable(opts.resize)
        end
        if opts.scaleWheel then
            frame:EnableMouseWheel(true)
            frame:HookScript("OnMouseWheel", function(_: Frame, delta: number) self:wheel(delta) end)
        end
        if opts.editMode and editModeManager() then
            self:joinEditMode(opts.editMode.label)
        end
    end

    -- Protected frames stay put in combat; Edit Mode frames outside it
    -- unless `lock = false`.
    private function blocked(): boolean
        if self.editing then
            return false
        end
        if self.selection and self.opts.editMode?.lock ~= false then
            return true
        end
        return self.locked or (self.frame:IsProtected() and InCombatLockdown())
    end

    private function joinEditMode(label: string)
        const sel = CreateFrame("Frame", nil, self.frame, "EditModeSystemSelectionTemplate") :: Selection
        sel:SetAllPoints()
        sel:Hide()
        -- The template asks its system for the label and selects through
        -- the manager, which knows only Blizzard's frames.
        sel.system = { GetSystemName = function() return label end }
        sel:SetScript("OnMouseDown", function() self:select() end)
        sel:SetScript("OnDragStart", function() self:dragStart() end)
        sel:SetScript("OnDragStop", function() self:dragStop() end)
        if self.opts.scaleWheel then
            sel:EnableMouseWheel(true)
            sel:SetScript("OnMouseWheel", function(_: Frame, delta: number) self:wheel(delta) end)
        end
        self.selection = sel
        self.grip?:SetShown(not self:blocked())
        editModeFrames[#editModeFrames + 1] = self
        const manager = editModeManager()
        if manager and not editModeHooked then
            editModeHooked = true
            EventRegistry:RegisterCallback("EditMode.Enter", function()
                for _, m in ipairs(editModeFrames) do
                    m:editMode(true)
                end
            end, editModeFrames)
            EventRegistry:RegisterCallback("EditMode.Exit", function()
                for _, m in ipairs(editModeFrames) do
                    m:editMode(false)
                end
            end, editModeFrames)
            -- A layout switch or a revert re-reads the layouts.
            hooksecurefunc(manager :: any, "UpdateLayoutInfo", function()
                for _, m in ipairs(editModeFrames) do
                    m:restore()
                end
            end)
            -- Selecting one of Blizzard's frames deselects ours.
            hooksecurefunc(manager :: any, "SelectSystem", function()
                for _, m in ipairs(editModeFrames) do
                    if m.editing then
                        m.selection?:ShowHighlighted()
                    end
                end
            end)
        end
        if manager?:IsEditModeActive() then
            self:editMode(true)
        end
    end

    private function editMode(active: boolean)
        self.editing = active
        if active then
            self.selection?:ShowHighlighted()
        else
            self.selection?:Hide()
        end
        const grip = self.grip
        if grip then
            grip:SetShown(not self:blocked())
            -- Above the overlay.
            grip:SetFrameLevel(secret.known(self.frame:GetFrameLevel(), 0) + 1000)
        end
    end

    private function select()
        editModeManager()?:ClearSelectedSystem()
        for _, m in ipairs(editModeFrames) do
            if m ~= self and m.editing then
                m.selection?:ShowHighlighted()
            end
        end
        self.selection?:ShowSelected()
    end

    -- The active Edit Mode layout's name (nil without Edit Mode).
    private function layout(): string?
        if not self.selection then
            return nil
        end
        return editModeManager()?:GetActiveLayoutInfo()?.layoutName
    end

    private function dragStart()
        if not self:blocked() and held(self.opts.modifier) then
            self.active = true
            self.frame:StartMoving()
        end
    end

    private function dragStop()
        if not self.active then
            return
        end
        self.active = false
        self.frame:StopMovingOrSizing()
        self.frame:SetUserPlaced(false)
        self:save()
    end

    private function resizable(resize: { min?: number[], max?: number[], grip?: Frame })
        const frame = self.frame
        frame:SetResizable(true)
        const min = resize.min ?? { 0, 0 }
        const max = resize.max
        frame:SetResizeBounds(min[1], min[2], max?.[1], max?.[2])
        local grip = resize.grip
        if not grip then
            const button = CreateFrame("Button", nil, frame)
            button:SetSize(16, 16)
            button:SetPoint("BOTTOMRIGHT", frame, "BOTTOMRIGHT", -2, 2)
            button:SetNormalTexture(GRIP_TEXTURES.normal)
            button:SetPushedTexture(GRIP_TEXTURES.pushed)
            button:SetHighlightTexture(GRIP_TEXTURES.highlight)
            grip = button
        end
        self.grip = grip
        grip:EnableMouse(true)
        grip:HookScript("OnMouseDown", function()
            if not self:blocked() then
                self.active = true
                frame:StartSizing("BOTTOMRIGHT")
            end
        end)
        grip:HookScript("OnMouseUp", function() self:dragStop() end)
    end

    -- Scales around the frame's anchor, which stays where it is.
    private function wheel(delta: number)
        if self:blocked() or not held(self.opts.scaleWheel) then
            return
        end
        const current = number(self.frame:GetScale())
        const pos = measure(self.frame)
        if current == nil or pos == nil then
            return
        end
        const range = self.opts.scaleRange ?? { 0.5, 2 }
        const scale = math.max(range[1], math.min(range[2], current + delta * WHEEL_STEP))
        self.frame:SetScale(scale)
        place(self.frame, pos)
        self:save()
    end

    function lock(locked: boolean)
        if secret.isSecret(locked) then
            return
        end
        self.locked = locked
        self.grip?:SetShown(not self:blocked())
    end

    function isLocked(): boolean
        return self.locked
    end

    -- The saved position, unless it cannot be read.
    private function stored(): FramePosition?
        const pos = self.opts.store[self.opts.key] :: FramePosition?
        if pos == nil or type(pos) ~= "table" or not secret.readable(pos) then
            return nil
        end
        return pos
    end

    -- The saved positions per layout, unless they cannot be read.
    private function layouts(): { [string]: FramePosition }?
        const layouts = self:stored()?.layouts
        if layouts == nil or type(layouts) ~= "table" or not secret.readable(layouts) then
            return nil
        end
        return layouts
    end

    function save()
        const pos = measure(self.frame)
        const scale = number(self.frame:GetScale())
        if pos == nil or scale == nil then
            return
        end
        pos.scale = scale
        if self.opts.resize then
            local width, height = self.frame:GetSize()
            pos.width, pos.height = number(width), number(height)
            if pos.width == nil or pos.height == nil then
                return
            end
        end
        const name = self:layout()
        if name then
            -- Kept: the other layouts' positions.
            const layouts = self:layouts() ?? {}
            layouts[name] = pos
            self.opts.store[self.opts.key] = {
                point = pos.point,
                relativePoint = pos.relativePoint,
                x = pos.x,
                y = pos.y,
                width = pos.width,
                height = pos.height,
                scale = pos.scale,
                layouts = layouts,
            }
        else
            pos.layouts = self:layouts()
            self.opts.store[self.opts.key] = pos
        end
        self:changed(pos)
    end

    function restore()
        const stored = self:stored()
        if not stored then
            return
        end
        local pos: FramePosition = stored
        const name = self:layout()
        if name then
            const own = self:layouts()?.[name]
            if own and type(own) == "table" and secret.readable(own) then
                pos = own
            end
        end
        defer(function()
            const frame = self.frame
            const scale = number(pos.scale) ?? self.scale
            if scale then
                frame:SetScale(scale)
            end
            local width, height = number(pos.width), number(pos.height)
            if self.opts.resize and width and height then
                frame:SetSize(width, height)
            end
            place(frame, pos)
        end)
    end

    function reset()
        self.opts.store[self.opts.key] = nil
        defer(function()
            const frame = self.frame
            if self.scale then
                frame:SetScale(self.scale)
            end
            if self.width and self.height then
                frame:SetSize(self.width, self.height)
            end
            frame:ClearAllPoints()
            for _, p in ipairs(self.points) do
                frame:SetPoint(unpack(p))
            end
        end)
        self:changed(nil)
    end

    private function changed(pos: FramePosition?)
        const onChange = self.opts.onChange
        if onChange then
            callIn({ component = `frames: {self.opts.key}` }, onChange, pos)
        end
    end
end

--- Makes `frame` movable (and resizable), keeping its position in
--- `opts.store[opts.key]`; restored once the store is loaded.
export function movable(frame: Frame, opts: MovableOptions): MovableHandle
    const m = Movable.new(frame, opts)
    local function start()
        m:restore()
        -- A profile switch brings that profile's position.
        local ok, h = pcall(handle, opts.store)
        if ok then
            (h :: SavedHandle).profiles?:onChange(function() m:restore() end)
        end
    end
    if isLoaded() then
        start()
    else
        const tasks = assert(wl.lifecycleTasks)
        tasks.afterLoad[#tasks.afterLoad + 1] = start
    end
    return m
end

-- Widget themes ------------------------------------------------------------------

--- A color: `{ r, g, b, a? }`, components 0 to 1.
export type ThemeColor = number[]

--- How the standard library's own widgets look (dialogs, the built-in
--- minimap button). Every slot is optional; unset slots keep the client's
--- look (decisions S17, S18).
export type WidgetTheme = {
    font?: { title?: string, body?: string, size?: number },
    colors?: {
        background?: ThemeColor,
        border?: ThemeColor,
        title?: ThemeColor,
        text?: ThemeColor,
        muted?: ThemeColor,
        accent?: ThemeColor,
        onAccent?: ThemeColor,
        error?: ThemeColor,
    },
    borderSize?: number,
    padding?: number,
    button?: "template" | "flat",
}

--- What a piece of text is, for its font and color.
export type TextRole = "title" | "body" | "muted" | "error"

const WHITE = "Interface\\Buttons\\WHITE8X8"
const FONT_OBJECTS: { [string]: string } = {
    title = "GameFontNormal",
    body = "GameFontHighlight",
    muted = "GameFontDisable",
    error = "GameFontRed",
}

--- The client's dialog backdrop, or with a theme's colors and border a
--- flat one.
export function applyBackdrop(frame: Frame, theme: WidgetTheme?)
    const colors = theme?.colors
    if colors?.background or colors?.border or theme?.borderSize then
        const edge = theme?.borderSize ?? 1
        frame:SetBackdrop({ bgFile = WHITE, edgeFile = WHITE, edgeSize = edge, insets = { left = edge, right = edge, top = edge, bottom = edge } })
        const bg = colors?.background ?? { 0, 0, 0, 0.9 }
        frame:SetBackdropColor(bg[1], bg[2], bg[3], bg[4] ?? 1)
        const border = colors?.border ?? { 0.5, 0.5, 0.5, 1 }
        frame:SetBackdropBorderColor(border[1], border[2], border[3], border[4] ?? 1)
    else
        frame:SetBackdrop(BACKDROP_DIALOG_32_32)
        frame:SetBackdropColor(1, 1, 1, 1)
        frame:SetBackdropBorderColor(1, 1, 1, 1)
    end
end

--- Text in its role's font object, with a theme's font and color.
export function styleText(text: FontString, role: TextRole, theme: WidgetTheme?)
    text:SetFontObject(FONT_OBJECTS[role])
    local file = theme?.font?.body
    if role == "title" then
        file = theme?.font?.title ?? file
    end
    if file or theme?.font?.size then
        local path, size, flags = text:GetFont()
        text:SetFont(file ?? secret.known(path, "Fonts\\FRIZQT__.TTF"), theme?.font?.size ?? secret.known(size, 12), secret.known(flags, "") :: any)
    end
    const colors = theme?.colors
    local color: ThemeColor? = nil
    if role == "title" then
        color = colors?.title
    elseif role == "body" then
        color = colors?.text
    elseif role == "muted" then
        color = colors?.muted
    else
        color = colors?.error
    end
    if color then
        text:SetTextColor(color[1], color[2], color[3], color[4] ?? 1)
    end
end

--- A button: the client's panel button, or a flat one with a theme's
--- `button = "flat"`.
export function button(parent: Frame, label: string, theme: WidgetTheme?): Button
    if theme?.button ~= "flat" then
        const b = CreateFrame("Button", nil, parent, "UIPanelButtonTemplate")
        b:SetSize(128, 21)
        b:SetText(label)
        return b
    end
    const b = CreateFrame("Button", nil, parent, "BackdropTemplate")
    b:SetSize(128, 21)
    const edge = theme?.borderSize ?? 1
    b:SetBackdrop({ bgFile = WHITE, edgeFile = WHITE, edgeSize = edge })
    const accent = theme?.colors?.accent ?? { 0.3, 0.3, 0.3, 1 }
    b:SetBackdropColor(accent[1], accent[2], accent[3], accent[4] ?? 1)
    const border = theme?.colors?.border ?? accent
    b:SetBackdropBorderColor(border[1], border[2], border[3], border[4] ?? 1)
    const text = b:CreateFontString(nil, "OVERLAY")
    text:SetPoint("CENTER")
    styleText(text, "body", theme)
    const on = theme?.colors?.onAccent
    if on then
        text:SetTextColor(on[1], on[2], on[3], on[4] ?? 1)
    end
    b:SetFontString(text)
    b:SetText(label)
    return b
end

-- ------------------------------------------------- the game's frames --

-- Whether `v` is a widget of this kind (by its IsObjectType, protected:
-- a table that is no widget, or one the addon may not read, is not one).
local function isA(v: unknown, kind: string): boolean
    if type(v) ~= "table" or not secret.readable(v) then
        return false
    end
    const is = (v :: { [string]: unknown }).IsObjectType
    if type(is) ~= "function" then
        return false
    end
    local ok, yes = pcall(is :: (unknown, string) -> unknown, v, kind)
    return ok and yes == true
end

--- `v` as a widget of that kind, else nil: for the game's frames read by a
--- name or a key (`asButton(frame.CloseButton)`), whose types the
--- declarations may not know.
export function asRegion(v: unknown): Region? if isA(v, "Region") then return v :: Region end return nil end
--- `v` as a `Frame`, else nil.
export function asFrame(v: unknown): Frame? if isA(v, "Frame") then return v :: Frame end return nil end
--- `v` as a `Button`, else nil.
export function asButton(v: unknown): Button? if isA(v, "Button") then return v :: Button end return nil end
--- `v` as a `CheckButton`, else nil.
export function asCheckButton(v: unknown): CheckButton? if isA(v, "CheckButton") then return v :: CheckButton end return nil end
--- `v` as an `EditBox`, else nil.
export function asEditBox(v: unknown): EditBox? if isA(v, "EditBox") then return v :: EditBox end return nil end
--- `v` as a `ScrollFrame`, else nil.
export function asScrollFrame(v: unknown): ScrollFrame? if isA(v, "ScrollFrame") then return v :: ScrollFrame end return nil end
--- `v` as a `Slider`, else nil.
export function asSlider(v: unknown): Slider? if isA(v, "Slider") then return v :: Slider end return nil end
--- `v` as a `StatusBar`, else nil.
export function asStatusBar(v: unknown): StatusBar? if isA(v, "StatusBar") then return v :: StatusBar end return nil end
--- `v` as a `Cooldown`, else nil.
export function asCooldown(v: unknown): Cooldown? if isA(v, "Cooldown") then return v :: Cooldown end return nil end
--- `v` as a `FontString`, else nil.
export function asFontString(v: unknown): FontString? if isA(v, "FontString") then return v :: FontString end return nil end
--- `v` as a `Texture`, else nil.
export function asTexture(v: unknown): Texture? if isA(v, "Texture") then return v :: Texture end return nil end
--- `v` as a `Browser`, else nil.
export function asBrowser(v: unknown): Browser? if isA(v, "Browser") then return v :: Browser end return nil end

--- A global frame by its name (`"CharacterFrame"`), nil when there is
--- none: a load-on-demand window before its addon loads, a client without it.
export function find(name: string): Frame?
    return asFrame(_G[name])
end

--- What `keepAway` gives back.
export type AwayHandle = {
    --- Puts the frame away now (when `when` allows).
    apply: () -> (),
    --- Stops keeping it away (where the game puts it next, it stays).
    release: () -> (),
}

-- A frame's own regions or children, protected (none for a forbidden one).
local function own(frame: Frame, get: string): unknown[]
    if not secret.readable(frame) or frame:IsForbidden() then
        return {}
    end
    const fn = (frame :: { [string]: unknown })[get]
    if type(fn) ~= "function" then
        return {}
    end
    -- (gathered inside the protected call: pcall handing back a hundred or
    -- more values crashes the game, as UIParent's children would)
    local ok, all = pcall(function(): unknown[]
        return { (fn :: (unknown) -> ...unknown)(frame) }
    end)
    if not ok then
        return {}
    end
    return all
end

--- The textures among a frame's own regions (its art): for restyling the
--- game's frames (`for _, t in ipairs(frames.textures(f)) do t:SetAlpha(0) end`).
export function textures(frame: Frame): Texture[]
    const out: Texture[] = {}
    for _, r in ipairs(own(frame, "GetRegions")) do
        const t = asTexture(r)
        if t then
            out[#out + 1] = t
        end
    end
    return out
end

--- The font strings among a frame's own regions.
export function fontStrings(frame: Frame): FontString[]
    const out: FontString[] = {}
    for _, r in ipairs(own(frame, "GetRegions")) do
        const fs = asFontString(r)
        if fs then
            out[#out + 1] = fs
        end
    end
    return out
end

--- The widgets a frame holds in its own fields, by key
--- (`frame.ScrollBox`, `frame.CloseButton`): the parts the game's templates
--- and code give it, named or not, for restyling or reading them. None for
--- a value that is no table the addon may read; forbidden widgets are left
--- out.
export function keyed(frame: unknown): { [string]: Region }
    const out: { [string]: Region } = {}
    if type(frame) ~= "table" or not secret.readable(frame) then
        return out
    end
    pcall(function()
        for k, v in pairs(frame) do
            if type(k) == "string" then
                const r = asRegion(v)
                if r and not r:IsForbidden() then
                    out[k] = r
                end
            end
        end
    end)
    return out
end

--- A frame's children (frames the addon may read).
export function children(frame: Frame): Frame[]
    const out: Frame[] = {}
    for _, c in ipairs(own(frame, "GetChildren")) do
        const f = asFrame(c)
        if f then
            out[#out + 1] = f
        end
    end
    return out
end

--- A button's state textures it has: normal, pushed, highlight, disabled,
--- and a check button's checked and disabled-checked ones.
export function stateTextures(button: Button): Texture[]
    const out: Texture[] = {}
    for _, get in ipairs({ "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture", "GetDisabledTexture",
                           "GetCheckedTexture", "GetDisabledCheckedTexture" }) do
        for _, t in ipairs(own(button, get)) do
            const tex = asTexture(t)
            if tex then
                out[#out + 1] = tex
            end
        end
    end
    return out
end

-- The frames an enumerator of the game's gives (`pairs`-like: each frame
-- the first value), started by calling `enumerate(...)`, protected.
local function enumerated(enumerate: unknown, ...: unknown): Frame[]
    const out: Frame[] = {}
    if type(enumerate) ~= "function" then
        return out
    end
    local ok, iter, state, key = pcall(enumerate :: (...unknown) -> (unknown, unknown, unknown), ...)
    if ok and type(iter) == "function" then
        const step = iter :: (unknown, unknown) -> unknown
        while true do
            key = step(state, key)
            if key == nil then
                break
            end
            const f = asFrame(key)
            if f then
                out[#out + 1] = f
            end
        end
    end
    return out
end

--- The frames one of the game's lists shows: an object pool's active ones
--- (`EnumerateActive`), or a scroll box's (`ForEachFrame`); none for
--- anything else. In the list's own order.
export function rows(list: unknown): Frame[]
    if type(list) ~= "table" or not secret.readable(list) then
        return {}
    end
    const methods = list :: { [string]: unknown }
    const enumerate = methods.EnumerateActive
    if type(enumerate) == "function" then
        return enumerated(enumerate, list)
    end
    const out: Frame[] = {}
    const each = methods.ForEachFrame
    if type(each) == "function" then
        pcall(each :: (unknown, (unknown) -> ()) -> (), list, function(row: unknown)
            const f = asFrame(row)
            if f then
                out[#out + 1] = f
            end
        end)
    end
    return out
end

--- The pins a map of the game's (the world map, the flight map: Blizzard's
--- map canvas) shows of one pin template (`"QuestPinTemplate"`), through
--- its `EnumeratePinsByTemplate`; none for anything else.
export function mapPins(map: unknown, template: string): Frame[]
    if type(map) ~= "table" or not secret.readable(map) then
        return {}
    end
    return enumerated((map :: { [string]: unknown }).EnumeratePinsByTemplate, map, template)
end

--- Keeps one of the game's frames out of sight while it stays shown, so its
--- scripts and children keep working (a list the addon draws its own of, a
--- part the game must see shown): moved off screen and, with `fade`,
--- see-through; again a frame after the game places it (or with `fade` sets
--- its alpha) and when it shows. Only while `when` says so (default:
--- always). A protected frame moves only out of combat: in combat it waits
--- for the end (wowlua:combat).
export function keepAway(frame: Frame, opts: { fade?: boolean, when?: () -> boolean }?): AwayHandle
    const fade = secret.flag(opts?.fade)
    const when = opts?.when
    local active, placing = true, false
    local function away()
        if not active or (when and not when()) then
            return
        end
        if InCombatLockdown() and frame:IsProtected() then
            defer(away, frame)
            return
        end
        placing = true
        if fade then
            frame:SetAlpha(0)
        end
        frame:ClearAllPoints()
        frame:SetPoint("TOPLEFT", UIParent, "TOPRIGHT", 5000, 0)
        placing = false
    end
    local function later()
        if not placing and active then
            after(0, away)
        end
    end
    hooksecurefunc(frame, "SetPoint", later)
    if fade then
        hooksecurefunc(frame, "SetAlpha", later)
    end
    frame:HookScript("OnShow", function() away() end)
    away()
    return {
        apply = away,
        release = function() active = false end,
    }
end
