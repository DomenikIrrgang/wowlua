-- wowlua:unit (spec stdlib "unit"): unit information across flavors.
-- Values the client may return as secrets (names, classes, health, yes/no
-- answers in combat) are typed `T | Secret<T>` and passed through: nothing
-- here compares or tests them (decision S26).
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as color from "wowlua:color"
import type Color from "wowlua:color"
import on from "wowlua:events"
import type Subscription from "wowlua:events"
import after from "wowlua:timer"
import callIn, try from "wowlua:errors"

export type UnitInfo = {
    --- Without the realm (WoW: Forever's names include the surname).
    name: string | Secret<string>,
    --- Only for players of another realm.
    realm?: string,
    --- `"Name-Realm"`, the own realm filled in; nil when the name is secret.
    fullName?: string,
    guid?: string | Secret<string>,
    class?: string | Secret<string>,
    classFile?: string | Secret<string>,
    level: number,
    isPlayer: boolean | Secret<boolean>,
    isConnected: boolean | Secret<boolean>,
    faction?: string,
    race?: string | Secret<string>,
    role?: string | Secret<string>,
}

export type GroupOptions = { includePlayer?: boolean, includePets?: boolean }

-- `GetUnitName(unit, true)`: the name with `-Realm` for other realms.
const getUnitName = _G.GetUnitName :: ((unit: string, showServer: boolean) -> (string | Secret<string>)?)?

local function ownRealm(): string
    const normalized = GetNormalizedRealmName()
    if normalized then
        return normalized
    end
    const realm = GetRealmName():gsub("[%s%-]", "")
    return realm
end

-- The name and (for another realm) the realm.
local function nameAndRealm(unit: UnitToken): (string | Secret<string>, string?)
    local full: (string | Secret<string>)? = nil
    if getUnitName then
        full = getUnitName(unit, true)
    else
        full = (UnitName(unit))
    end
    if secret.isSecret(full) then
        return full, nil
    end
    if full == nil then
        return "", nil
    end
    local name, realm = full:match("^(.-)%-(.+)$")
    if name and realm then
        return name, realm
    end
    return full, nil
end

--- Whether the unit exists.
export function exists(unit: UnitToken): boolean
    return secret.flag(UnitExists(unit))
end

--- `"Name-Realm"`, the own realm filled in; nil when the name is secret
--- or the unit does not exist.
export function fullName(unit: UnitToken): string?
    if not exists(unit) then
        return nil
    end
    local name, realm = nameAndRealm(unit)
    if secret.isSecret(name) then
        return nil
    end
    return `{name}-{realm ?? ownRealm()}`
end

--- What the client says about a unit; nil when it does not exist.
export function info(unit: UnitToken): UnitInfo?
    if not exists(unit) then
        return nil
    end
    local name, realm = nameAndRealm(unit)
    local className, classFile = UnitClass(unit)
    local faction = UnitFactionGroup(unit)
    local race = UnitRace(unit)
    local fullText: string? = nil
    if not secret.isSecret(name) then
        fullText = `{name}-{realm ?? ownRealm()}`
    end
    return {
        name = name,
        realm = realm,
        fullName = fullText,
        guid = UnitGUID(unit),
        class = className,
        classFile = classFile,
        level = UnitLevel(unit),
        isPlayer = UnitIsPlayer(unit),
        isConnected = UnitIsConnected(unit),
        faction = faction,
        race = race,
        role = UnitGroupRolesAssigned(unit),
    }
end

--- `UnitIsUnit`: may be a secret boolean in combat (`secret.flag` reads
--- it as false).
export function isSame(a: UnitToken, b: UnitToken): boolean | Secret<boolean>
    return UnitIsUnit(a, b)
end

--- Current and maximum health (secret on restricted clients).
export function health(unit: UnitToken): (number | Secret<number>, number | Secret<number>)
    return UnitHealth(unit), UnitHealthMax(unit)
end

const unitHealthPercent = _G.UnitHealthPercent :: ((unit: string, usePredicted: boolean?, curve: any) -> number | Secret<number>)?

--- Health in percent (0 to 100): the client's own (possibly secret) where
--- it has one, else computed when both values can be read, else nil.
export function healthPercent(unit: UnitToken): (number | Secret<number>)?
    if unitHealthPercent then
        const scale = (_G.CurveConstants :: { ScaleTo100?: any }?)?.ScaleTo100
        return unitHealthPercent(unit, false, scale)
    end
    local hp, max = UnitHealth(unit), UnitHealthMax(unit)
    if secret.isSecret(hp) or secret.isSecret(max) or max == 0 then
        return nil
    end
    return hp / max * 100
end

--- Current and maximum power (of `powerType`, else the unit's own).
export function power(unit: UnitToken, powerType: number?): (number | Secret<number>, number | Secret<number>)
    return UnitPower(unit, powerType), UnitPowerMax(unit, powerType)
end

--- The unit's class color (wowlua:color); nil when the class is secret.
export function classColor(unit: UnitToken): Color?
    local _, classFile = UnitClass(unit)
    if secret.isSecret(classFile) or classFile == nil then
        return nil
    end
    return color.class(classFile)
end

--- The group's unit tokens: `raid1..raidN` in a raid, `party1..party4` in a
--- party, and `player` (with `includePlayer`, or alone when solo). Secret
--- options and answers count as no.
export function group(opts: GroupOptions?): () -> UnitToken?
    const tokens: UnitToken[] = {}
    const pets = secret.flag(opts?.includePets)
    local function add(token: UnitToken, pet: UnitToken)
        if exists(token) then
            tokens[#tokens + 1] = token
            if pets and exists(pet) then
                tokens[#tokens + 1] = pet
            end
        end
    end
    const withPlayer = secret.flag(opts?.includePlayer)
    if secret.flag(IsInRaid()) then
        for i = 1, 40 do
            const token = `raid{i}`
            -- The player is one of the raid's tokens.
            if withPlayer or not secret.flag(UnitIsUnit(token, "player")) then
                add(token, `raidpet{i}`)
            end
        end
    else
        if withPlayer or not secret.flag(IsInGroup()) then
            add("player", "pet")
        end
        if secret.flag(IsInGroup()) then
            for i = 1, 4 do
                add(`party{i}`, `partypet{i}`)
            end
        end
    end
    local i = 0
    return function(): UnitToken?
        i += 1
        return tokens[i]
    end
end

--- The group's size: 1 when solo.
--- Invites `name` (a player's name, with the realm for another realm's) to
--- your group: `C_PartyInfo.InviteUnit`, or the older `InviteUnit`; the
--- game says in chat how it went.
export function invite(name: string)
    try(tbl.field(_G, "C_PartyInfo", "InviteUnit") or tbl.field(_G, "InviteUnit"), name)
end

export function groupSize(): number
    return math.max(1, GetNumGroupMembers())
end

-- The roster ------------------------------------------------------------------

--- A group member (the player included).
export type RosterMember = {
    guid: string,
    --- The current unit token (`raid3`, `party1`, `player`).
    unit: UnitToken,
    name: string | Secret<string>,
    --- nil while the name is secret.
    fullName?: string,
    classFile?: string | Secret<string>,
}

class RosterListener implements Subscription
    active: boolean = true
    readonly fn: (joined: RosterMember[], left: RosterMember[]) -> ()

    constructor(fn: (joined: RosterMember[], left: RosterMember[]) -> ())
        self.fn = fn
    end

    function cancel()
        self.active = false
    end
end

-- By GUID; built on first use and kept current from then on.
local byGuidMap: { [string]: RosterMember } = {}
local byUnitMap: { [string]: RosterMember } = {}
local started = false
local dirty = true
local rebuildQueued = false
local rosterListeners: RosterListener[] = {}

local function member(token: UnitToken, guid: string): RosterMember
    local name, realm = nameAndRealm(token)
    local _, classFile = UnitClass(token)
    local full: string? = nil
    if not secret.isSecret(name) then
        full = `{name}-{realm ?? ownRealm()}`
    end
    return { guid = guid, unit = token, name = name, fullName = full, classFile = classFile }
end

-- The player first, then by group index.
local function tokenOrder(token: UnitToken): number
    if token == "player" then
        return 0
    end
    return tonumber(token:match("%d+$")) ?? 99
end

-- Re-reads the group; tells the listeners who joined and left.
local function rebuild()
    dirty = false
    const nextGuid: { [string]: RosterMember } = {}
    const nextUnit: { [string]: RosterMember } = {}
    local function add(token: UnitToken)
        const guid = UnitGUID(token)
        if secret.isSecret(guid) then
            -- Unreadable now: keep who was there.
            const known = byUnitMap[token]
            if known then
                nextGuid[known.guid] = known
                nextUnit[token] = known
            end
            return
        end
        if guid == nil or nextGuid[guid] then
            return
        end
        const m = member(token, guid)
        nextGuid[guid] = m
        nextUnit[token] = m
    end
    add("player")
    for token in group() do
        add(token)
    end
    const joined: RosterMember[] = {}
    const left: RosterMember[] = {}
    for guid, m in pairs(nextGuid) do
        if not byGuidMap[guid] then
            joined[#joined + 1] = m
        end
    end
    for guid, m in pairs(byGuidMap) do
        if not nextGuid[guid] then
            left[#left + 1] = m
        end
    end
    byGuidMap = nextGuid
    byUnitMap = nextUnit
    if #joined == 0 and #left == 0 then
        return
    end
    for _, l in ipairs(rosterListeners) do
        if l.active then
            callIn({ component = "unit.roster: onChange" }, l.fn, joined, left)
        end
    end
end

-- Bursts of roster events rebuild once.
local function changed()
    dirty = true
    if rebuildQueued then
        return
    end
    rebuildQueued = true
    after(0.2, function()
        rebuildQueued = false
        if dirty then
            rebuild()
        end
    end)
end

local function current()
    if not started then
        started = true
        on("GROUP_ROSTER_UPDATE", changed)
        on("PLAYER_ENTERING_WORLD", changed)
        on("UNIT_NAME_UPDATE", changed)
        -- The roster as it is now counts as the start, not as joins.
        rebuild()
    elseif dirty then
        rebuild()
    end
end

--- The group's members (the player included) by GUID, kept current, and
--- who joins and leaves. Starts on first use; members whose GUID is secret
--- keep their last known entry.
export const roster = {
    --- The member with this GUID; nil when not in the group or the GUID
    --- is secret (combat log GUIDs can be).
    byGuid = function(guid: string | Secret<string>): RosterMember?
        current()
        if secret.isSecret(guid) then
            return nil
        end
        return byGuidMap[guid]
    end,
    --- The member behind a unit token of the group.
    byUnit = function(token: UnitToken): RosterMember?
        current()
        return byUnitMap[token]
    end,
    --- Every member, in unit token order.
    members = function(): RosterMember[]
        current()
        const out: RosterMember[] = {}
        for _, m in pairs(byGuidMap) do
            out[#out + 1] = m
        end
        table.sort(out, function(a: RosterMember, b: RosterMember): boolean
            return tokenOrder(a.unit) < tokenOrder(b.unit)
        end)
        return out
    end,
    --- `fn(joined, left)` after each change (bursts of roster events
    --- coalesced); the group at the first call counts as already there.
    onChange = function(fn: (joined: RosterMember[], left: RosterMember[]) -> ()): Subscription
        current()
        const l = RosterListener.new(fn)
        rosterListeners[#rosterListeners + 1] = l
        return l
    end,
}
