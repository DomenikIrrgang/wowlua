-- Compiler behavior of `wowlua:lifecycle` (spec stdlib "lifecycle"): the
-- hooks register the final function value.
@intrinsic("lifecycle.onLoad")
declare function onLoad(fn: () -> (), ctx: any)
@intrinsic("lifecycle.onLogin")
declare function onLogin(fn: () -> (), ctx: any)
@intrinsic("lifecycle.onEnterWorld")
declare function onEnterWorld(fn: (isInitialLogin: boolean, isReloadingUi: boolean) -> (), ctx: any)
@intrinsic("lifecycle.onLogout")
declare function onLogout(fn: () -> (), ctx: any)
