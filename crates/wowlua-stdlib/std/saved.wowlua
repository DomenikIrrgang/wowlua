-- wowlua:saved (spec stdlib "saved"): typed SavedVariables with lazy deep
-- defaults, migrations, default stripping at logout and profiles. `bind`
-- returns the data table itself (locked until the addon's SavedVariables
-- load); housekeeping lives on `handle(db)`.
import isLoaded from "wowlua:lifecycle"
import Subscription from "wowlua:events"
import report, callIn from "wowlua:errors"
import * as secret from "wowlua:secret"

local addonName, ns = ...
local wl = ns.__wowlua

const DEFAULT_PROFILE = "Default"

--- The profiles of a binding with `profiles = true`.
export interface Profiles
    --- Switches to the profile `name` (made empty when new) and calls the
    --- `onChange` handlers. An error before the data is loaded.
    function use(name: string)
    --- The active profile's name (`"Default"` at first).
    function current(): string
    --- The profiles' names, sorted.
    function list(): string[]
    --- Replaces the active profile's data with a copy of the profile `from`'s;
    --- an error when there is no such profile.
    function copy(from: string)
    --- Deletes the profile `name`; deleting the active one is an error.
    function delete(name: string)
    --- Calls `fn` with the new profile's name after each `use`.
    function onChange(fn: (name: string) -> ()): Subscription
end

--- The housekeeping of a bound table: `saved.handle(db)`.
export interface SavedHandle
    profiles?: Profiles
    --- The current profile (or the whole data) back to its defaults.
    function reset()
    --- Whether the SavedVariable is loaded (the data can be read).
    function isLoaded(): boolean
    --- For wowlua:settings: a key's default (the panel's Defaults button).
    __default?: (self: SavedHandle, key: string) -> any
end

--- Options of `bind`: the data's `version` and `defaults`; `migrate[v]`
--- upgrades data saved at version `v - 1` to `v`; `profiles` keeps the data
--- per profile; `stripDefaults = false` keeps values equal to their
--- defaults at logout.
export type BindOptions<T> = {
    version: number,
    defaults: T,
    migrate?: { [number]: (data: any) -> () },
    profiles?: boolean,
    stripDefaults?: boolean,
}

type Binding = {
    name: string,
    opts: BindOptions<any>,
    --- The table `bind` returned.
    db: table,
    --- The SavedVariable's table and the active data (the profile's, or
    --- `db` itself), once loaded.
    root?: table,
    data?: table,
    loaded: boolean,
    failed?: string,
    strip: boolean,
    profile?: string,
    listeners: ((name: string) -> ())[],
    handle?: SavedHandle,
}

local bindings: Binding[] = {}
local handles: { [table]: SavedHandle } = setmetatable({}, { __mode = "k" })

-- (A secret or a table addons may not index is carried as it is.)
local function copy(value: any): any
    if type(value) ~= "table" or not secret.readable(value) then
        return value
    end
    local out = {}
    for k, v in pairs(value) do
        out[k] = copy(v)
    end
    return out
end

-- Lazy deep defaults: a missing key reads its default; a table default is
-- created in the data on first read, so writes never reach the defaults.
local function attach(data: table, defaults: any): table
    if type(defaults) ~= "table" then
        return data
    end
    for k, d in pairs(defaults) do
        local v = rawget(data, k)
        if type(d) == "table" and type(v) == "table" and secret.readable(v) then
            attach(v, d)
        end
    end
    return setmetatable(data, {
        __index = function(t: table, k: any): any
            local d = defaults[k]
            if type(d) == "table" then
                local child = attach({}, d)
                rawset(t, k, child)
                return child
            end
            return d
        end,
    })
end

-- Removes values equal to their defaults, recursively, and secret values
-- (they cannot be saved) anywhere; returns whether a secret was dropped.
-- Empty tables go only where their default is a table; a table addons may
-- not index is kept as it is.
local function strip(data: table, defaults: any, seen: { [table]: boolean }?): boolean
    seen = seen or {}
    if not secret.readable(data) or seen[data] then
        return false
    end
    seen[data] = true
    local secrets = false
    for k, v in pairs(data) do
        local d: any = nil
        if type(defaults) == "table" then
            d = defaults[k]
        end
        if secret.isSecret(v) then
            data[k] = nil
            secrets = true
        elseif type(v) == "table" then
            local nested = type(d) == "table" and d or nil
            if strip(v, nested, seen) then
                secrets = true
            end
            if nested and secret.readable(v) and next(v) == nil then
                data[k] = nil
            end
        elseif d ~= nil and v == d then
            data[k] = nil
        end
    end
    return secrets
end

local function locked(b: Binding): table
    local message = function(): string
        return b.failed or (addonName .. ": " .. b.name .. " accessed before it was loaded; use @onLoad")
    end
    return {
        __index = function() error(message(), 2) end,
        __newindex = function() error(message(), 2) end,
    }
end

local function perChar(b: Binding): { profile?: string }
    local key = b.name .. "PerChar"
    local store = _G[key]
    if type(store) ~= "table" then
        store = {}
        _G[key] = store
    end
    return store :: { profile?: string }
end

-- Points the returned table at the active profile's data.
local function useProfile(b: Binding, name: string)
    local profiles = assert(b.root).profiles
    if type(profiles[name]) ~= "table" then
        profiles[name] = {}
    end
    b.profile = name
    perChar(b).profile = name
    b.data = attach(profiles[name], b.opts.defaults)
end

local function load(b: Binding)
    local opts = b.opts
    local stored = _G[b.name]
    local version = opts.version
    if type(stored) ~= "table" then
        stored = { __version = version }
    else
        local from = stored.__version or 0
        if from > version then
            -- A newer version wrote this: keep it as it is (decision S14).
            b.strip = false
            report(b.name .. " was saved by a newer version (" .. from .. " > " .. version .. "); not migrating, defaults are kept")
        elseif from < version and opts.migrate then
            -- Migrations run on a copy, so a failure leaves the data as loaded.
            local work = copy(stored)
            for v = from + 1, version do
                local step = opts.migrate[v]
                if step then
                    local ok = callIn({ component = "saved: " .. b.name .. " migration " .. v }, step, work)
                    if not ok then
                        b.failed = addonName .. ": " .. b.name .. " failed to migrate to version " .. v .. "; data preserved"
                        b.strip = false
                        return
                    end
                end
            end
            work.__version = version
            stored = work
        else
            stored.__version = math.max(from, version)
        end
    end
    if opts.profiles then
        stored.profiles = type(stored.profiles) == "table" and stored.profiles or {}
        b.root = stored
        _G[b.name] = stored
        useProfile(b, perChar(b).profile or DEFAULT_PROFILE)
        setmetatable(b.db, {
            -- Set by `useProfile` above.
            __index = function(_: table, k: any): any return (b.data :: table)[k] end,
            __newindex = function(_: table, k: any, v: any) (b.data :: table)[k] = v end,
        })
    else
        -- The returned table becomes the data (its identity never changes).
        setmetatable(b.db, nil)
        for k, v in pairs(stored) do
            rawset(b.db, k, v)
        end
        b.root = b.db
        b.data = b.db
        _G[b.name] = b.db
        attach(b.db, opts.defaults)
    end
    b.loaded = true
end

local function stripAll(b: Binding)
    if not b.loaded or not b.strip or b.opts.stripDefaults == false then
        return
    end
    local secrets = false
    if b.opts.profiles then
        for _, data in pairs(assert(b.root).profiles) do
            if strip(data, b.opts.defaults) then
                secrets = true
            end
        end
    else
        local version = rawget(b.db, "__version")
        secrets = strip(b.db, b.opts.defaults)
        rawset(b.db, "__version", version)
    end
    if secrets and wl.debug then
        report(b.name .. ": secret values were not saved")
    end
end

-- Loading before the addon's `@onLoad` hooks, stripping after `@onLogout`
-- (the phase order of wowlua:lifecycle).
local tasks = assert(wl.lifecycleTasks)
tasks.beforeLoad[#tasks.beforeLoad + 1] = function()
    for _, b in ipairs(bindings) do
        if not b.loaded and not b.failed then
            load(b)
        end
    end
end
tasks.afterLogout[#tasks.afterLogout + 1] = function()
    for _, b in ipairs(bindings) do
        stripAll(b)
    end
end

local function makeHandle(b: Binding): SavedHandle
    -- The loaded binding's root and data.
    local function need(what: string): (table, table)
        local root, data = b.root, b.data
        if not (b.loaded and root and data) then
            error(what .. ": " .. b.name .. " is not loaded", 3)
        end
        return root, data
    end
    local h: SavedHandle = {
        profiles = nil,
        reset = function(_: SavedHandle)
            local _, data = need("reset")
            local version = rawget(data, "__version")
            for k in pairs(data) do
                rawset(data, k, nil)
            end
            if not b.opts.profiles then
                rawset(data, "__version", version)
            end
        end,
        isLoaded = function(_: SavedHandle): boolean return b.loaded end,
        __default = function(_: SavedHandle, key: string): any
            local d = b.opts.defaults
            return type(d) == "table" and d[key] or nil
        end,
    }
    if b.opts.profiles then
        h.profiles = {
            use = function(_: Profiles, name: string)
                need("profiles:use")
                if type(name) ~= "string" then
                    error("profiles:use: the profile name must be a string, not " .. type(name), 2)
                end
                useProfile(b, name)
                for _, fn in ipairs(b.listeners) do
                    callIn({ component = "saved: profile change" }, fn, name)
                end
            end,
            current = function(_: Profiles): string return b.profile or DEFAULT_PROFILE end,
            list = function(_: Profiles): string[]
                local root = need("profiles:list")
                local names: string[] = {}
                for name in pairs(root.profiles) do
                    names[#names + 1] = name
                end
                table.sort(names)
                return names
            end,
            copy = function(_: Profiles, from: string)
                local root, data = need("profiles:copy")
                local source = root.profiles[from]
                if type(source) ~= "table" then
                    error("no profile `" .. tostring(from) .. "`", 2)
                end
                -- Copied first: `from` may be the active profile itself.
                local values = copy(source)
                for k in pairs(data) do
                    rawset(data, k, nil)
                end
                for k, v in pairs(values) do
                    rawset(data, k, v)
                end
                attach(data, b.opts.defaults)
            end,
            delete = function(_: Profiles, name: string)
                local root = need("profiles:delete")
                if name == b.profile then
                    error("cannot delete the active profile `" .. name .. "`", 2)
                end
                root.profiles[name] = nil
            end,
            onChange = function(_: Profiles, fn: (name: string) -> ()): Subscription
                local list = b.listeners
                list[#list + 1] = fn
                return {
                    active = true,
                    cancel = function(self: Subscription)
                        self.active = false
                        for i, f in ipairs(list) do
                            if f == fn then
                                table.remove(list, i)
                                break
                            end
                        end
                    end,
                }
            end,
        }
    end
    return h
end

--- Binds the SavedVariable `name`; returns its data table (locked until
--- the addon's SavedVariables load).
export function bind<T>(name: string, opts: BindOptions<T>): T
    for _, b in ipairs(bindings) do
        if b.name == name then
            error("bind: " .. name .. " is bound already", 2)
        end
    end
    -- The proxy the caller sees as `T` (its fields are the saved data's).
    local db: any = {}
    local b: Binding = {
        name = name,
        opts = opts,
        db = db,
        loaded = false,
        strip = true,
        listeners = {},
    }
    setmetatable(db, locked(b))
    local h = makeHandle(b)
    b.handle = h
    handles[db] = h
    bindings[#bindings + 1] = b
    -- Bound after the addon loaded, or the SavedVariables load first
    -- (`addon.load-saved-variables-first`).
    if isLoaded() or wl.savedFirst then
        load(b)
    end
    return db
end

--- The housekeeping handle of a bound table.
export function handle(db: table): SavedHandle
    local h = handles[db]
    if not h then
        error("handle: not a table from saved.bind", 2)
    end
    return h
end
