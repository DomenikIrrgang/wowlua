-- -------------------------------------------------------- communication

--- Another player's addon message.
export function receiveAddonMessage(prefix: string, message: string, chatType: string, sender: string)
    engine().receiveAddonMessage(prefix, message, chatType, sender)
end

--- The addon messages sent so far.
