--- minPrice, totalQuantity, containsOwnerItem } }, infoReceived = { itemID,
--- … }, commodities = { [itemID] = { { auctionID, quantity, unitPrice,
--- timeLeftSeconds, owners, … } } }, items = { [itemID] = { … } }, deposit,
--- nextAuctionID, mailSender }`; `player:interact(auctioneer)` opens it.
export function defineAuctionHouse(auctioneer: MockUnit, data: table)
    engine().defineAuctionHouse(auctioneer, data)
