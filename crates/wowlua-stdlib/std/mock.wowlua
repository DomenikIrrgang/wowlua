--- A level: `{ xpMax, health, power, talents, pvpTalentSlots, strength,
--- agility, stamina, intellect, spirit }`. Experience past the current
--- level's end gains it (`PLAYER_LEVEL_UP`, a round trip later
--- `PLAYER_LEVEL_CHANGED`).
export function defineLevel(level: number, data: table)
    engine().defineLevel(level, data)
end

--- Shows a tooltip as the player hovering something would (Blizzard's UI
--- code: `test.blizzard-ui`): an item (`{ id }`, `{ link }`, `{ bag,
--- slot }`, `{ slot }` equipped), a spell (`{ id }`), a unit (`{ unit }`);
--- the tooltip's data comes from the tests' game data, and the addons'
--- tooltip hooks run. Returns the lines' left texts.
export function showTooltip(kind: "item" | "spell" | "unit", data: { id?: number, link?: string, unit?: string, bag?: number, slot?: number }, tip: any?): string[]
    local t: any = tip ?? _G.GameTooltip
    if t == nil or t.SetItemByID == nil then
        error("mock.showTooltip needs Blizzard's UI code (test.blizzard-ui)", 2)
    end
    t:SetOwner(_G.UIParent, "ANCHOR_NONE")
    if kind == "unit" then
        t:SetUnit(data.unit ?? "player")
    elseif kind == "spell" then
        t:SetSpellByID(data.id)
    elseif data.link then
        t:SetHyperlink(data.link)
    elseif data.bag and data.slot then
        t:SetBagItem(data.bag, data.slot)
    elseif data.slot then
        t:SetInventoryItem("player", data.slot)
    else
        t:SetItemByID(data.id)
    end
    local lines: string[] = {}
    local name = t:GetName()
    for i = 1, t:NumLines() do
        local fs = _G[`{name}TextLeft{i}`]
        lines[i] = fs and fs:GetText() or ""
    end
    return lines
end

--- A stand-in for a Blizzard template: `CreateFrame` with it calls `fn`.
export function defineTemplate(name: string, fn: (frame: any) -> ())
    engine().defineTemplate(name, fn)
