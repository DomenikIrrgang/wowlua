    return engine().refusals()
end

-- ---------------------------------------------------------------- output

--- The lines `print` printed.
export function printed(): string[]
    return engine().printed()
end

--- The errors that reached the error handler. Reading them marks them as
--- expected: errors no test reads fail the test.
export function errors(): string[]
