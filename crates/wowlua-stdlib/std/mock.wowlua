-- ------------------------------------------------------------- the client

--- An addon the client knows (`C_AddOns`).
export function defineAddon(name: string, opts: table?)
    engine().defineAddon(name, opts)
end

--- Loads an addon the client knows (`mock.defineAddon`), as
--- `C_AddOns.LoadAddOn` does.
export function loadAddon(name: string): (boolean?, string?)
    return C_AddOns.LoadAddOn(name)
end

--- A library for `LibStub(major)` (a stand-in LibStub when there is none).
export function provideLibrary(major: string, impl: table, minor: number?)
    local stub: any = _G.LibStub
    if stub == nil then
        local libs: { [string]: table } = {}
        local minors: { [string]: number } = {}
        stub = setmetatable({ libs = libs, minors = minors }, {
            __call = function(self: any, name: string, silent: boolean?): (table?, number?)
                local lib = self.libs[name]
                if lib == nil and not silent then
                    error(`Cannot find a library instance of "{name}".`, 2)
                end
                return lib, self.minors[name]
            end,
        })
        function stub:NewLibrary(name: string, version: number): table?
            if self.minors[name] and self.minors[name] >= version then
                return nil
            end
            self.minors[name] = version
            self.libs[name] = self.libs[name] or {}
            return self.libs[name]
        end
        function stub:GetLibrary(name: string, silent: boolean?): (table?, number?)
            return self(name, silent)
        end
        _G.LibStub = stub
    end
    stub.libs[major] = impl
    stub.minors[major] = minor ?? 1
end

--- A spell's data (decision T203). `cooldown` (seconds): pressing it
--- again sooner is refused ("Spell is not ready yet."); `category`: its
--- cooldown category (`SPELL_UPDATE_COOLDOWN`'s third value);
--- `outOfCombat`: unusable in combat; `onCast`: a function run as the
--- cast lands (its damage, kill, auras), before its cooldowns;
--- `cooldowns = { { spell, a?, b? } }`: the spells its landing tells
--- (else itself); `slotChanges = { seconds }`: its slots told changed
--- (`ACTIONBAR_SLOT_CHANGED`) that long after it is sent. Presses waiting
--- for the server fail if the target dies.
export function defineSpell(id: number, data: table)
    engine().defineSpell(id, data)
end

--- An item's data; `opts.cached = false` makes it load (`delay`). A
--- consumable's use: `spell`, `castSpells`, `cooldownCategory`; its
--- `aura` (an `applyAura` table: food's eating, run out after its
--- duration); food's `wellFed = { aura, maxHealth?, cooldowns?, after? }`
--- (eaten `after` seconds, 10 by default: the buff).
export function defineItem(id: number, data: table, opts: table?)
    engine().defineItem(id, data, opts)
end

--- A quest: `{ title, text, objective, progress, completion, giver, xp,
--- money, choices, rewards, objectives = { { item, required, text } },
--- header, level, reputation }` (`$N` in the texts: the player's name).
--- Its giver offers it (`unit:interact`); `AcceptQuest()` takes it into
--- the log; looting the items its objectives ask for advances it.
