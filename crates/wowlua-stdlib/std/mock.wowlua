end

-- --------------------------------------------------- spies, stubs, fakes

--- A function that records its calls (`toHaveBeenCalled…`) and runs `fn`.
export function spy<A..., R...>(fn: ((A...) -> R...)?): (A...) -> R...
    local calls: any[] = {}
    local function s(...: any): ...any
        calls[#calls + 1] = { n = select("#", ...), ... }
        if fn then
            return fn(...)
        end
    end
    spies[s] = calls
    return s :: any
end

--- Forgets the calls every spy recorded.
export function resetSpies()
    for _, calls in pairs(spies) do
        for i = #calls, 1, -1 do
            calls[i] = nil
        end
    end
end

--- Replaces `t[key]` with `fn` (a spy) until the test ends; returns the spy.
export function stub(t: table, key: string, fn: Fn?): Fn
    local original = rawget(t, key)
    local s = spy(fn)
    t[key] = s
    restores[#restores + 1] = function()
        t[key] = original
    end
    return s
end

--- Replaces exports of a module for the rest of the test file (decision
--- T224): `target` is the module's namespace (`import * as tracker from
--- "/tracker"`), `replacement` the exports to replace, checked against the
--- module's (a missing or mistyped one is an error). The addon's files
--- read imports at each use in tests, so every importer sees the
--- replacement.
export function module<M>(target: M, replacement: table)
    local exports = target :: any
    for name, value in pairs(replacement) do
        exports[name] = value
    end
end

--- Replaces an engine function (`"UnitName"`, `"C_Spell.GetSpellInfo"`)
--- with `impl` until the test ends; returns its spy.
export function fake(name: string, impl: Fn): Fn
    local t: table = _G
    local key = name
    local dot = name:find(".", 1, true)
    if dot then
        local ns2 = _G[name:sub(1, dot - 1)]
        if type(ns2) ~= "table" then
            error(`mock.fake: there is no {name:sub(1, dot - 1)}`, 2)
        end
        t = ns2
        key = name:sub(dot + 1)
    end
    return stub(t, key, impl)
end
