-- wowlua:mock (spec Tooling §16.1.4): drives the emulated client in tests.
-- The test runner (`wowlua test`) gives the runtime the engine's controls
-- (`ns.__wowlua.mockEngine`); this module types them and adds spies, stubs,
-- fakes and waiting. Spies keep the values they are handed, secrets too,
-- and nothing here compares them (tests run tainted, like the addon).
import isSecret from "wowlua:secret"

local addonName, ns = ...
local wl = ns.__wowlua

type Fn = (...any) -> ...any

--- A unit of the simulated world (`mock.player`, `mock.spawnUnit`).
export interface MockUnit
    --- Targets, focuses or mouses over `unit` (`PLAYER_TARGET_CHANGED`, …);
    --- the player's target told back by the server (`UNIT_TARGET`) a round
    --- trip later, or `echo` seconds (`false`: not).
    function target(unit: MockUnit?, opts: { echo?: number | boolean }?)
    --- Focuses `unit` (nil: none): `PLAYER_FOCUS_CHANGED`.
    function focus(unit: MockUnit?)
    --- Mouses over `unit` (nil: none): `UPDATE_MOUSEOVER_UNIT`.
    function mouseover(unit: MockUnit?)
    --- The player's soft target of `kind` (by default the enemy for a
    --- hostile or neutral unit, else the friend; `nil` clears it):
    --- `PLAYER_SOFT_ENEMY_CHANGED`, `…_FRIEND_CHANGED`, `…_INTERACT_CHANGED`;
    --- a soft friend's actions' usability `usableAfter` seconds later (a
    --- recording's; else at once).
    function softTarget(unit: MockUnit?, kind: ("enemy" | "friend" | "interact")?, opts: { usableAfter?: number }?)
    --- Its health down; its absorb shields (`setAbsorb`) take what they
    --- can first. `statesAfter`: its aura states' change told that many
    --- seconds later (the server's next update), else at once.
    function damage(amount: number, opts: { statesAfter?: number | boolean }?)
    --- Its health up by `amount`: `UNIT_HEALTH`; its heal absorbs
    --- (`setHealAbsorb`) take what they can first (`statesAfter` as for
    --- `damage`).
    function heal(amount: number, opts: { statesAfter?: number | boolean }?)
    --- Its damage absorb shields, in all: `UNIT_ABSORB_AMOUNT_CHANGED`.
    function setAbsorb(amount: number)
    --- Its heal absorbs, in all: `UNIT_HEAL_ABSORB_AMOUNT_CHANGED`.
    function setHealAbsorb(amount: number)
    --- The heal `healer` (the player by default) is casting on it (0:
    --- none): `UNIT_HEAL_PREDICTION`.
    function setIncomingHeal(amount: number, healer: MockUnit?)
    --- Dies (`UNIT_DIED`); `by` the player or the group: `PARTY_KILL` and
    --- the killing blow's `UNIT_COMBAT` (`amount`, else the health left;
    --- `school`, 1 physical by default); `lootable`: `UNIT_LOOT`. Its
    --- auras go with it; `flagsAfter`: the player's flags told these
    --- seconds after (the server's, still in combat).
    function kill(opts: { by?: MockUnit, lootable?: boolean, amount?: number, school?: number, flagsAfter?: number }?)
    --- Its power now (`UNIT_POWER_UPDATE` with the power's token): the one
    --- it shows, or `powerType`'s (a token, `"COMBO_POINTS"`, or an
    --- `Enum.PowerType` value; one of its powers); `frequent`: a
    --- regeneration tick's, `UNIT_POWER_FREQUENT` alone.
    function setPower(amount: number, opts: { frequent?: boolean, powerType?: number | string }?)
    --- Puts it in combat; the player's: `PLAYER_REGEN_DISABLED`, the combat
    --- lockdown, `PLAYER_IN_COMBAT_CHANGED`, `UNIT_FLAGS`.
    function enterCombat()
    --- Takes it out of combat; the player's: the lockdown ends,
    --- `PLAYER_REGEN_ENABLED`, `UNIT_FLAGS`.
    function leaveCombat()
    --- The player's auto attack on (`PLAYER_ENTER_COMBAT`) and off
    --- (`PLAYER_LEAVE_COMBAT`).
    function startAttack()
    --- The player's auto attack off (`PLAYER_LEAVE_COMBAT`).
    function stopAttack()
    --- A melee swing landing on `victim`: `PLAYER_SWING` for the player's,
    --- both in combat, the attacker's then the victim's power (`power`,
    --- `victimPower`: rage), the victim's health, and the combat text
    --- (`UNIT_COMBAT`) a moment later (`textAfter` seconds, 0.4 by
    --- default); `combat = false`: no one put in combat. `kind`: `WOUND` (default), `PARRY`, `DODGE`, `MISS`, `BLOCK`;
    --- `indicator`: the text's (`"CRITICAL"`, `"GLANCING"`). The victim's
    --- health's aura states (below 20, 25, 35, 50 percent, above 75, 80:
    --- `PET_BAR_UPDATE_USABLE`) told with the blow (the target's at the
    --- frame's end), or `statesAfter` seconds later (`true`: when
    --- `mock.tellAuraStates` tells it); the player's dodge, parry or block with a
    --- `procOnAvoid` spell known turns its defensive state on (told the
    --- same way) for `stateFor` seconds (5 by default).
    --- The player's skill `name` up to `rank` ("Your skill in … has
    --- increased", the stats' events); more `name2, rank2` pairs: skills up
    --- in the same packet (their messages, then the stats' events once).
    function raiseSkill(name: string, rank: number, ...: string | number)
    --- `kill`: the swing kills (`PARTY_KILL`, the death, the experience's
    --- message, its update a round trip later; `loot`: the corpse's items;
    --- `echo`: the target's clearing told back after these seconds;
    --- `xpAfter`: the experience's update after these seconds;
    --- `diesAfter`: with a queued spell's swing, the death, the
    --- experience's message and the corpse's loot after these seconds;
    --- `flagsAfter`: the player's `UNIT_FLAGS` these seconds after, as
    --- for `kill`).
    function swing(victim: MockUnit, amount: number, opts: { kind?: string, power?: number, victimPower?: number, speed?: number, textAfter?: number, combat?: boolean, indicator?: string, statesAfter?: number | boolean, stateFor?: number, kill?: { xp?: number, loot?: table, echo?: number | boolean, xpAfter?: number, diesAfter?: number, flagsAfter?: number } }?)
    --- The player talks to an NPC: a round trip later its quest dialog
    --- opens (`QUEST_DETAIL` for a quest it offers, `QUEST_PROGRESS` for
    --- one in the log); too far (`setDistance` above 5 yards): the
    --- client's error.
    function interact(npc: MockUnit)
    --- The player dies (the server's death: "You died.", `PLAYER_DEAD`,
    --- the worn items' `durability` left by slot); Blizzard's popup
    --- releases the spirit (`RepopMe`), `mock.nearCorpse` and its popup
    --- take the corpse back (`RetrieveCorpse`).
    function die(opts: { durability?: table, ghostAura?: number }?)
    --- Its resurrection spell lands on dead `target` (`health`: what it
    --- comes back with, half its maximum by default). The player is
    --- offered it (`RESURRECT_REQUEST`, Blizzard's popup; accepted, alive
    --- a round trip later: `PLAYER_ALIVE`); another unit lives at once
    --- (`UNIT_HEALTH`, `UNIT_FLAGS`).
    function resurrect(target: MockUnit, opts: { health?: number }?)
    --- Its nameplate appears in the first free `nameplateN` slot
    --- (`NAME_PLATE_UNIT_ADDED`); nothing if it is shown. `entering =
    --- true` (a world profile's): before the login, it appears when the
    --- player enters the world.
    function showNameplate(opts: { entering?: boolean }?)
    --- Its nameplate goes (`NAME_PLATE_UNIT_REMOVED`).
    function hideNameplate()
    --- It leaves the world: its nameplate and auras go, and it stops being
    --- the target (`PLAYER_TARGET_CHANGED`), focus or mouseover.
    function despawn()
    --- The unit's first token (`"player"`, `"nameplate1"` before
    --- `"target"`, …), nil when none names it.
    function token(): string?
    --- Its first and last name: `UNIT_NAME_UPDATE` for each of its tokens
    --- when they change (`quiet = true`: its name all along, untold).
    function setName(name: string, lastName: string?, opts: { quiet?: boolean }?)
    --- The group role it chose (`UnitGroupRolesAssigned`, the raid
    --- roster's combat role); nil none.
    function setRole(role: ("TANK" | "HEALER" | "DAMAGER")?)
    --- A group member logging in or out (`UnitIsConnected`,
    --- `UNIT_CONNECTION(unit, isConnected)`, the roster).
    function setOnline(online: boolean)
    --- The fields of its data that `data` names, changed in place (its
    --- GUID kept), each told as the client tells it: `UNIT_LEVEL`,
    --- `UNIT_NAME_UPDATE`, the health's and power's events,
    --- `UNIT_DISPLAYPOWER`, `UNIT_FACTION` (reaction, faction, PvP),
    --- `UNIT_CLASSIFICATION_CHANGED`, `UNIT_PORTRAIT_UPDATE` and
    --- `UNIT_MODEL_CHANGED` (class, race, sex); `distance`, `role` and
    --- `online` as `setDistance`, `setRole` and `setOnline` tell them;
    --- `dead` as a death without a killer, or alive again (the player dies
    --- with `die`).
    function update(data: UnitData)
    --- An aura on it (`UNIT_AURA`), its instance ID; `quiet = true`: there
    --- already (a snapshot's), untold.
    function applyAura(data: table): number
    --- Removes the aura with that instance ID (`UNIT_AURA`).
    function removeAura(auraInstanceID: number)
    --- The aura changed in place (a periodic effect's tick:
    --- `updatedAuraInstanceIDs`); `cooldowns`: the spells it triggered, as
    --- for `hit`.
    function updateAura(auraInstanceID: number, opts: { cooldowns?: table }?)
    --- A spell's or periodic effect's hit, its combat text at once: `school`
    --- (1 physical, 2 holy, …), `indicator` ("CRITICAL"), `kind` ("WOUND",
    --- "HEAL"); `aura`: the victim's aura it updates; `cooldowns = { {
    --- spell, a?, b? } }`: the triggered spells' `SPELL_UPDATE_COOLDOWN`s;
    --- `spell`: the spell the damage meter counts it under; `statesAfter`:
    --- as for `swing`.
    function hit(victim: MockUnit, amount: number, opts: { school?: number, indicator?: string, kind?: string, aura?: number, cooldowns?: table, spell?: number, statesAfter?: number | boolean }?)
    --- Starts casting (`UNIT_SPELLCAST_START`, or `CHANNEL_START`); it ends
    --- `castTime` seconds later (the spell data's, else 1.5).
    function castSpell(spellID: number, opts: { castTime?: number, channel?: boolean, notInterruptible?: boolean }?)
    --- The player gathers a world object (a vein, a herb): `spell` cast on
    --- it, at its success its `loot` in the window (`auto`: autoloot). A
    --- recording's timing: `succeedsAfter` (the success, seconds after the
    --- cast's start; else at its end), `slotsAfter` (each slot's item,
    --- seconds after the window opened), `bagsAfter` (the bags' packets,
    --- each seconds after the item that set it off, in order),
    --- `flagsAfter` (the looting flags, seconds after the last item; else
    --- a round trip).
    function gather(object: MockUnit, opts: { spell: number, castTime?: number, loot?: { id: number, count?: number }[], auto?: boolean, succeedsAfter?: number, slotsAfter?: number[], bagsAfter?: number[], flagsAfter?: number })
    --- The player clicks a profession's spell: its window open, as the
    --- client recorded `profession`'s (`"Blacksmithing"`, `"Mining"`).
    function openTradeSkill(spell: number, profession: string)
    --- Interrupts the cast (`UNIT_SPELLCAST_INTERRUPTED`); the player's is
    --- answered by the server 0.4 s later. The player's with no cast yet:
    --- a craft's next cast, asked of the server, given up.
    function interruptCast()
    --- A spell the server cast for the player (a proc) failing quietly
    --- (`UNIT_SPELLCAST_FAILED_QUIET`, `CURRENT_SPELL_CAST_CHANGED(true)`);
    --- `client`: a press of the player's, by its client cast GUID.
    function spellFailedQuiet(spell: number, opts: { client?: boolean }?)
    --- The player's cast of `spell` refused, `error` told
    --- (`UNIT_SPELLCAST_FAILED`, `UI_ERROR_MESSAGE`): a client error's
    --- name (`"SPELL_COOLDOWN"`) or a spell failure's (`"TARGETS_DEAD"`);
    --- by the server, or the client (`client`).
    function castFailed(spell: number, opts: { error: string, client?: boolean })
    --- The player starts or stops moving (`PLAYER_STARTED_MOVING`,
    --- `PLAYER_STOPPED_MOVING`); meanwhile a spell with a cast time is
    --- refused ("Can't do that while moving").
    function setMoving(moving: boolean)
    --- Which crafts of `recipe` to come raise the profession's skill, in
    --- order (the server's chance).
    function craftSkillUps(recipe: number, ups: boolean[])
    --- A recording's timings of the crafts' casts to come, in order (the
    --- server's answers, seconds): each cast's `start` after its request
    --- or the last cast's success, its `success` after its start, its
    --- `item` after its success (0: with it), the bags' packet (`bags`)
    --- after its item, a new slot's item data (`data`, its own packet;
    --- else with the bags') after its item; the bags' packet split (its
    --- first `split` bag changes, the item's first, the rest and the
    --- reagents' taking `rest` seconds after), a
    --- used-up reagent's removal after its item (`spent`; else with it),
    --- a new slot's bag told before the item's push (`slotFirst`); what
    --- one leaves out is the engine's.
    function craftTimings(timings: { start?: number, success?: number, item?: number, bags?: number, data?: number, split?: number, rest?: number, spent?: number, slotFirst?: boolean }[])
    --- The spell focuses near the player (`{ "Forge" }`): a recipe needing
    --- one can be made.
    function setSpellFocus(names: string[])
    --- How far from the player, in yards (`nil`: unknown); where the
    --- player has a place, the unit moves that far along its bearing
    --- (decision T515).
    function setDistance(yards: number?)
    --- It walks its waypoints in order (2.5 yards a second unless `speed`
    --- says), from the first again after the last unless `loop` is false
    --- (decision T517).
    function patrol(path: { y: number, x: number, z?: number }[], opts: { speed?: number, loop?: boolean }?)
    --- It follows the player, keeping `keep` yards (2), running (7 a
    --- second) unless `speed` says.
    function follow(opts: { keep?: number, speed?: number }?)
    --- It comes to the player, stopping `keep` yards away (2: melee
    --- reach).
    function approach(opts: { keep?: number, speed?: number }?)
    --- It runs from the player.
    function flee(opts: { speed?: number }?)
    --- It goes to a place, then stands.
    function moveTo(place: { y: number, x: number, z?: number }, opts: { speed?: number }?)
    --- It stands where it is.
    function stop()
    --- A worn item's durability (the player; `GetInventoryItemDurability`,
    --- a repair restores it).
    function setDurability(slot: number, current: number, max: number)
    --- The server's durability update (`UPDATE_INVENTORY_DURABILITY`): the
    --- item in `slot` a point lower, or nothing visible.
    function wear(slot: number?)
    --- The player's money, in copper (`PLAYER_MONEY`).
    function setMoney(copper: number)
    --- Spells the player has trained (an ID or a list), known from then on
    --- (`IsSpellKnown`, `IsPlayerSpell`); unless `quiet`, each told as a
    --- trainer's (`LEARNED_SPELL_IN_SKILL_LINE`, then `SPELLS_CHANGED`).
    function learn(spells: number | number[], opts: { quiet?: boolean }?)
    --- Spells the player no longer knows (`SPELLS_CHANGED`).
    function unlearn(spells: number | number[])
    --- The player's stats given (the others stay), each change told by its
    --- event (`UNIT_STATS`, `PLAYER_XP_UPDATE`, …):
    --- `setStats({ xp = 0, stat = { [1] = { 67, 67, 22, 0 } } })`. The
    --- player's pet's (`mock.setPet`) too: the unit's own stats
    --- (`UnitDamage("pet")`, …).
    function setStats(stats: PlayerStats)
    --- The player's item in an inventory slot (`nil`: none):
    --- `PLAYER_EQUIPMENT_CHANGED`, `UNIT_INVENTORY_CHANGED`.
    function equip(slot: number, item: number | HeldItem | nil)
    --- The invited player joins the party (the player leading it; invite
    --- first, and let the invitation arrive).
    function joinGroup()
    --- The player loots `corpse`; the window opens a round trip later
    --- (`opts`: a recording's timings: `auto`, `opensAfter`, `slotsAfter`,
    --- `bagsAfter`, `dataAfter`, `logAfter`, `bagsAlone`, `pushAfter`,
    --- `flagsAfter`).
    function loot(corpse: MockUnit, opts: table?)
    --- The other side accepted the trade: the trade window.
    function openTrade()
    --- What the server knows of another player for an inspect
    --- (`NotifyInspect`): its specialization, item level, gear (links; the
    --- `cached` ones at once, the others' infos after), the items' infos
    --- received in order, its talent config.
    function setInspect(data: { spec?: number, itemLevel?: number, items?: { [number]: { link: string, cached?: boolean } },
                                received?: number[], config?: table, traitCharacter?: number })
    --- The player's threat on this creature, as the server tells it
    --- (`nil`: off its list); with `who` (a group member, a pet), that
    --- unit's. Each unit's status follows: the one the creature targets
    --- (else the highest) holds it, 3 while no one is above, 2 once
    --- someone is; anyone else 1 above the holder, else 0.
    function setThreat(value: number?, who: MockUnit?)
    --- The player pressing a spell (as recorded: the power check, the
    --- global cooldown, the cast a round trip later).
    function useSpell(spellID: number)
end

--- A stat's answer: the client function's results in order, or its one
--- result.
export type StatAnswer = number | boolean | string | (number | boolean | string)[]

--- The player's stats (`unit:setStats`): each the answer of the client
--- function that reports it.
export type PlayerStats = {
    --- `UnitStat` by index.
    stat?: { [number]: StatAnswer },
    --- `UnitResistance` by index.
    resistance?: { [number]: StatAnswer },
    --- `UnitArmor`.
    armor?: StatAnswer,
    --- `UnitDamage`.
    damage?: StatAnswer,
    --- `UnitRangedDamage`.
    rangedDamage?: StatAnswer,
    --- `UnitAttackSpeed`.
    attackSpeed?: StatAnswer,
    --- `UnitAttackPower`.
    attackPower?: StatAnswer,
    --- `UnitRangedAttackPower`.
    rangedAttackPower?: StatAnswer,
    --- `UnitDefenseSkill`.
    defense?: StatAnswer,
    --- `UnitHPPerStamina`.
    hpPerStamina?: StatAnswer,
    --- `UnitSpellHaste`.
    spellHaste?: StatAnswer,
    --- `GetUnitSpeed`.
    movement?: StatAnswer,
    --- `UnitXP`.
    xp?: StatAnswer,
    --- `UnitXPMax`.
    xpMax?: StatAnswer,
    --- `UnitHonor`.
    honor?: StatAnswer,
    --- `UnitHonorMax`.
    honorMax?: StatAnswer,
    --- `UnitHonorLevel`.
    honorLevel?: StatAnswer,
    --- `GetXPExhaustion`.
    restedXP?: StatAnswer,
    --- `GetRestState`.
    restState?: StatAnswer,
    --- `IsXPUserDisabled`.
    xpDisabled?: StatAnswer,
    --- `GetExpertise`.
    expertise?: StatAnswer,
    --- `GetSpellBonusHealing`.
    spellHealing?: StatAnswer,
    --- `GetSpellPenetration`.
    spellPenetration?: StatAnswer,
    --- `GetSpellHitModifier`.
    spellHit?: StatAnswer,
    --- `GetSpellCritChance`.
    spellCrit?: StatAnswer,
    --- `GetShieldBlock`.
    shieldBlock?: StatAnswer,
    --- `GetRangedHaste`.
    rangedHaste?: StatAnswer,
    --- `GetRangedCritChance`.
    rangedCrit?: StatAnswer,
    --- `GetRangedHitModifier`.
    rangedHit?: StatAnswer,
    --- `GetCritChance`.
    crit?: StatAnswer,
    --- `GetHitModifier`.
    hit?: StatAnswer,
    --- `GetOffhandHitModifier`.
    offhandHit?: StatAnswer,
    --- `GetMeleeHaste`.
    meleeHaste?: StatAnswer,
    --- `GetMasteryEffect`.
    mastery?: StatAnswer,
    --- `GetPowerRegen`.
    powerRegen?: StatAnswer,
    --- `GetManaRegen`.
    manaRegen?: StatAnswer,
    --- `GetManaRegenFromSpirit`.
    manaRegenFromSpirit?: StatAnswer,
    --- `GetHealthRegen`.
    healthRegen?: StatAnswer,
    --- `GetHealthRegenFromSpirit`.
    healthRegenFromSpirit?: StatAnswer,
    --- `GetBlockChance`.
    block?: StatAnswer,
    --- `GetDodgeChance`.
    dodge?: StatAnswer,
    --- `GetDodgeChanceFromAttribute`.
    dodgeFromAttribute?: StatAnswer,
    --- `GetParryChance`.
    parry?: StatAnswer,
    --- `GetModResilienceDamageReduction`.
    resilience?: StatAnswer,
    --- `GetLifesteal`.
    lifesteal?: StatAnswer,
    --- `GetAvoidance`.
    avoidance?: StatAnswer,
    --- `GetSpeed`.
    speed?: StatAnswer,
    --- `GetAverageItemLevel`.
    itemLevel?: StatAnswer,
    --- `GetArmorPenetration`.
    armorPenetration?: StatAnswer,
    --- `GetOverrideSpellPowerByAP`.
    spellPowerByAttackPower?: StatAnswer,
    --- `GetOverrideAPBySpellPower`.
    attackPowerBySpellPower?: StatAnswer,
    --- `GetCombatRating` by index.
    combatRating?: { [number]: StatAnswer },
    --- `GetCombatRatingBonus` by index.
    combatRatingBonus?: { [number]: StatAnswer },
    --- `GetSpellBonusDamage` by index.
    spellDamage?: { [number]: StatAnswer },
    --- `GetVersatilityBonus` by index.
    versatility?: { [number]: StatAnswer },
    --- `GetAttackPowerForStat` by attribute, at its effective value.
    attackPowerForStat?: { [number]: StatAnswer },
    --- `GetRangedAttackPowerForStat` by attribute, at its effective value.
    rangedAttackPowerForStat?: { [number]: StatAnswer },
    --- `GetCritChanceFromStat` by attribute, at its effective value.
    critFromStat?: { [number]: StatAnswer },
    --- `GetSpellCritChanceFromStat` by attribute, at its effective value.
    spellCritFromStat?: { [number]: StatAnswer },
}

--- An item as the player holds it.
export type HeldItem = {
    id: number,
    count?: number,
    link?: string,
    bound?: boolean,
    locked?: boolean,
    --- A quest item; the quest it starts; whether that quest is active.
    questItem?: boolean,
    questID?: number,
    questActive?: boolean,
    --- Its running cooldown (a snapshot's): seconds left, its length.
    cooldown?: { remaining: number, duration: number },
    --- Worn gear's durability, both or neither (`GetInventoryItemDurability`).
    durability?: number,
    maxDurability?: number,
}

--- One of a unit's powers: how much it has (`UnitPower(unit, type)`) and
--- the most it can have (`UnitPowerMax(unit, type)`).
export type UnitPowerAmount = {
    current?: number,
    max?: number,
}

--- What `spawnUnit` takes.
export type UnitData = {
    name?: string,
    guid?: string,
    level?: number,
    class?: string,
    race?: string,
    sex?: number,
    reaction?: "hostile" | "neutral" | "friendly",
    --- The player's reaction toward it, when not the unit's own (a faction
    --- NPC's by the player's standing).
    playerReaction?: "hostile" | "neutral" | "friendly",
    player?: boolean,
    health?: number,
    healthMax?: number,
    --- The shown power's amount and maximum (`UnitPower(unit)`).
    power?: number,
    powerMax?: number,
    --- The power it shows (`Enum.PowerType`), by default its class's (a
    --- druid's mana).
    powerType?: number,
    --- Any of its powers by token (`MANA`, `RAGE`, `ENERGY`,
    --- `COMBO_POINTS`, …). It has every power its class has, each at the
    --- flavor's default unless named here.
    powers?: { [string]: UnitPowerAmount },
    dead?: boolean,
    --- How far from the player, in yards.
    distance?: number,
    realm?: string,
    lastName?: string,
    classID?: number,
    npcID?: number,
    --- The group role it chose.
    role?: "TANK" | "HEALER" | "DAMAGER",
    --- Where it is when not where the player is (a group member's roster
    --- zone; out of sight: `UnitIsVisible` false).
    zone?: string,
    --- Where it is in the world: `UnitPosition`'s north `y`, west `x` and
    --- height `z` (a group member's blip on the minimap). Its distance from
    --- the player follows it (decision T515); a unit with only a
    --- `distance` stands that far in front of the player.
    world?: { y: number, x: number, z?: number },
    --- Radians counter-clockwise from north; it faces the player when not
    --- given.
    facing?: number,
    --- How it moves on its own (decision T517): `kind` "stand", "patrol"
    --- (along `path`), "follow" (the player, `keep` yards away), "approach"
    --- (to the player, stopping `keep` yards away) or "flee".
    movement?: { kind: string, path?: { y: number, x: number, z?: number }[], loop?: boolean, speed?: number, keep?: number },
    --- What it does on its own (decision T518): each action `at` seconds
    --- after it appears, `every` so many seconds or `within` so many yards
    --- of the player, `do` "attack" (swings of `damage` every `speed`
    --- seconds while within 5 yards), "cast" (`spell`, `castTime`) or
    --- "face" (it turns to the player).
    actions?: { at?: number, every?: number, within?: number, ["do"]: string, damage?: number, speed?: number, spell?: number, castTime?: number }[],
    --- The creature display the 3D world shows it as (decision T526).
    displayID?: number,
    --- false: an offline player character (`UnitIsConnected` false; the
    --- roster's level 0, zone "Offline").
    online?: boolean,
    --- `UnitFactionGroup` ("Horde", "Alliance"); `faction` the same.
    factionGroup?: string,
    faction?: string,
    --- `UnitIsPVP`.
    pvp?: boolean,
    --- `UnitClassification`: "normal" by default, "elite", "rare",
    --- "rareelite", "worldboss", "trivial", "minus".
    classification?: string,
    --- `UnitCreatureType` and `UnitCreatureFamily`, with their IDs.
    creatureType?: string,
    creatureTypeID?: number,
    creatureFamily?: string,
    creatureFamilyID?: number,
    --- The older names of `healthMax` and `powerMax` (decision T232).
    maxHealth?: number,
    maxPower?: number,
}

local function engine(): any
    local e = wl.mockEngine
    if e == nil then
        error("wowlua:mock runs in `wowlua test` only", 3)
    end
    return e
end

-- Spies' calls, by spy (wowlua:test's matchers read them).
local spies: { [any]: any[] } = setmetatable({}, { __mode = "k" })
wl.spies = spies
-- What stubs and fakes replaced: restored after every test.
local restores: (() -> ())[] = {}
wl.afterTest = {
    function()
        for i = #restores, 1, -1 do
            restores[i]()
        end
        restores = {}
    end,
}
-- What waits yield, so wowlua:test's jobs tell them from other yields.
const waitToken = {}
wl.waitToken = waitToken

-- ------------------------------------------------------------- the world

--- The player.
export const player: MockUnit = (wl.mockEngine and wl.mockEngine.player) :: MockUnit

--- A unit near the player.
export function spawnUnit(data: UnitData): MockUnit
    return engine().spawnUnit(data)
end

--- The unit a token names now (`"target"`: a world profile's, say); nil
--- when none.
export function unitOf(token: string): MockUnit?
    return engine().unitOf(token)
end

--- The unit at a place of the world's list (0 the player, then in the
--- order they came): a debugger's units panel names units so.
export function unitAt(index: number): MockUnit?
    return engine().unitAt(index)
end

--- The player's data (a world profile's character). No events, unless
--- `{ events = true }`: then what changed is told as the client tells it
--- (the level: `PLAYER_LEVEL_CHANGED(old, new, true)` and `UNIT_LEVEL`; the
--- name: `UNIT_NAME_UPDATE`; health and powers: `UNIT_MAXHEALTH`,
--- `UNIT_HEALTH`, each power's `UNIT_MAXPOWER` and `UNIT_POWER_UPDATE`, and
--- `UNIT_DISPLAYPOWER` for another power shown).
export function setPlayer(data: UnitData, options: { events?: boolean }?)
    engine().setPlayer(data, options)
end

--- An item's cooldown: `duration` seconds, `remaining` of them to run
--- (all by default; 0: none). `BAG_UPDATE_COOLDOWN`.
export function setItemCooldown(itemID: number, duration: number, remaining: number?)
    engine().setItemCooldown(itemID, duration, remaining)
end

--- A bag's contents (`nil`: no bag): `BAG_UPDATE`, `BAG_UPDATE_DELAYED`.
export function setBag(bag: number, contents: { slots?: number, items?: { [number]: number | HeldItem } }?)
    engine().setBag(bag, contents)
end

--- An item a vendor sells: `price` for `stack` of it (`available`: -1
--- unlimited).
--- `itemAfter`: a bought one's data (a new slot's) that many seconds after
--- the purchase's answer, the server's (the money told before the item
--- then; by default its data at once).
export type MerchantItem = { id: number, price?: number, stack?: number, available?: number, maxStack?: number, usable?: boolean, itemAfter?: number }

--- Opens a vendor's window (`MERCHANT_SHOW`, then `MERCHANT_UPDATE`): the
--- vendor is the `npc` unit. Buying, selling, buying back and repairing go
--- through the client's API, answered by the server a round trip later.
--- `cached`: the goods' data known (a visit before: no filter updates);
--- `repairMoneyAfter`: a repair's money told after that many items'
--- durability (the server's packets; by default after all);
--- `repairCosts`: what mending each worn slot's item costs (`{ [slot] =
--- copper }`: `GetRepairAllCost` sums the damaged ones', the repair
--- cursor's click on one mends it alone).
export function openMerchant(data: { name?: string, items?: MerchantItem[], canRepair?: boolean, repairCost?: number, damaged?: number, cached?: boolean, repairMoneyAfter?: number, repairCosts?: { [number]: number } })
    engine().openMerchant(data)
end

--- An action on the action bars (`GetActionInfo`'s type, ID and subtype;
--- `usable`: `IsUsableAction`'s answers, by default usable).
export type ActionData = {
    type: string,
    id?: number | string,
    subType?: string,
    texture?: number | string,
    count?: string,
    text?: string,
    usable?: boolean | { [number]: boolean },
}

--- The action in an action bar slot (`nil`: none):
--- `ACTIONBAR_SLOT_CHANGED`.
export function setAction(slot: number, action: ActionData?)
    engine().setAction(slot, action)
end

--- A chat channel the player is in.
export type ChannelData = {
    name: string,
    --- With its zone (`General - Thunder Bluff`); by default the name.
    fullName?: string,
    --- `CHANNEL_CATEGORY_WORLD`, `…_CUSTOM` (the default) or `…_GROUP`.
    category?: string,
    disabled?: boolean,
    --- `C_ChatInfo.GetChannelInfoFromIdentifier`'s (the shortcut by
    --- default the name; IDs 0) and `C_ChatInfo.IsChannelRegional`.
    shortcut?: string,
    instanceID?: number,
    zoneChannelID?: number,
    channelType?: number,
    regional?: boolean,
    --- Its number when higher than the one after the channel before (a
    --- channel left keeps its number free).
    number?: number,
}

--- The chat channels the player is in, numbered in order
--- (`CHANNEL_UI_UPDATE`).
export function setChannels(channels: { joined: ChannelData[], groupChannels?: number, regionalService?: boolean })
    engine().setChannels(channels)
end

--- A macro: its name, icon (a file ID or texture path) and body.
export type MacroData = { name: string, icon?: number | string, body?: string }

--- The macros, the account's then the character's, in the client's order
--- (`UPDATE_MACROS`).
export function setMacros(macros: { account?: MacroData[], character?: MacroData[] })
    engine().setMacros(macros)
end

--- A mount of the journal: its spell (its name and icon the spell's
--- unless given), `sourceType` (the journal's source index, 0 by
--- default), the journal's `source` and `description` texts, its creature
--- `display`, `mountType` (230 by default), `modelScene` (4), `animID`
--- (91), `visualKit` (0), `selfMount`, `noPreview` (the player's preview
--- off), `faction` (0 the Horde's, 1 the Alliance's; none for both),
--- `hidden` (not shown for this character), `collected` and `usable` (both
--- true by default), `favorite`, `steadyFlight` and the `item` that teaches
--- it (`GetMountFromItem`).
export type MountData = {
    spellID: number,
    name?: string,
    icon?: number | string,
    sourceType?: number,
    source?: string,
    description?: string,
    display?: number,
    mountType?: number,
    modelScene?: number,
    animID?: number,
    visualKit?: number,
    selfMount?: boolean,
    noPreview?: boolean,
    faction?: number,
    hidden?: boolean,
    collected?: boolean,
    usable?: boolean,
    favorite?: boolean,
    steadyFlight?: boolean,
    item?: number,
}

--- The mount journal's mounts by mount ID, the whole journal
--- (`MOUNT_JOURNAL_SEARCH_UPDATED`): `C_MountJournal`'s lists, info,
--- favourites and usability answer from them; the displayed list follows
--- the journal's filters and search.
export function setMounts(mounts: { [number]: MountData })
    engine().setMounts(mounts)
end

--- A toy of the toy box: `collected` and `usable` (both true by default),
--- `favorite`, `fanfare` (new, not yet shown). Its name, icon and quality
--- are its item's (`mock.defineItem`).
export type ToyData = { collected?: boolean, usable?: boolean, favorite?: boolean, fanfare?: boolean }

--- The toy box's toys by item ID, the whole box (`TOYS_UPDATED`):
--- `C_ToyBox`, `PlayerHasToy` and the box's list (through its filters and
--- search) answer from them.
export function setToys(toys: { [number]: ToyData })
    engine().setToys(toys)
end

--- The wardrobe's collected sources and favourite appearances, over the
--- flavor's recorded catalogue (`TRANSMOG_COLLECTION_UPDATED`); a part left
--- out stays as it was.
export function setAppearances(appearances: { collected?: number[], favorites?: number[] })
    engine().setAppearances(appearances)
end

--- A player of another group's group finder listing: its class by file
--- (`WARRIOR`; `className` the class's name by default), its level (1 by
--- default), its zone (`area`), its assigned role (`NONE` by default) and
--- the roles it would take (its assigned one's by default).
export type LFGMember = {
    name: string,
    class: string,
    className?: string,
    level?: number,
    area?: string,
    role?: "TANK" | "HEALER" | "DAMAGER" | "NONE",
    roles?: { tank?: boolean, healer?: boolean, dps?: boolean },
}

--- Another group's or player's listing in the group finder: its activities
--- (`C_LFGList`'s activity IDs), its title (`name`) and description
--- (`comment`), seconds listed (`age`), the playstyle
--- (`Enum.LFGEntryGeneralPlaystyle`), the voice chat (`voiceMode`), whether
--- it takes new players and accepts at once; its members, the leader first.
export type LFGListingData = {
    activities: number[],
    comment?: string,
    name?: string,
    age?: number,
    playstyle?: number,
    newPlayerFriendly?: boolean,
    voiceMode?: number,
    autoAccept?: boolean,
    members: LFGMember[],
}

--- A listing's changes (`updateLFGListing`): the fields given replace its
--- own (`members` the whole list).
export type LFGListingChanges = {
    activities?: number[],
    comment?: string,
    name?: string,
    age?: number,
    playstyle?: number,
    newPlayerFriendly?: boolean,
    voiceMode?: number,
    autoAccept?: boolean,
    members?: LFGMember[],
}

--- Another group's or player's listing on the group finder's server: the
--- searches (`C_LFGList.Search`) of its category and activities find it,
--- each numbering its results anew (`lfgSearchResultID`). Its handle.
export function defineLFGListing(data: LFGListingData): number
    return engine().defineLFGListing(data)
end

--- The listing changed: later searches find it so; when the last search
--- found it, its result changes and the server tells it
--- (`LFG_LIST_SEARCH_RESULT_UPDATED(searchResultID)`). Whether it was told.
export function updateLFGListing(handle: number, changes: LFGListingChanges): boolean
    return engine().updateLFGListing(handle, changes)
end

--- The listing delisted: later searches do not find it; when the last
--- search found it, its result is told delisted (`isDelisted`,
--- `LFG_LIST_SEARCH_RESULT_UPDATED`). Whether it was told.
export function removeLFGListing(handle: number): boolean
    return engine().removeLFGListing(handle)
end

--- The listing's `searchResultID` among the last search's results; nil
--- when that search did not find it.
export function lfgSearchResultID(handle: number): number?
    return engine().lfgSearchResultID(handle)
end

--- The next search fails: `LFG_LIST_SEARCH_FAILED(reason)` for its answer,
--- no results.
export function failLFGSearch(reason: string?)
    engine().failLFGSearch(reason)
end

--- The player lists themselves, as from the game's own listing panel
--- (`createData` as `C_LFGList.CreateListing` takes it: `activityIDs`,
--- `generalPlaystyle`, `isAutoAccept`, `questID`, …): the listing a round
--- trip later, `LFG_LIST_ACTIVE_ENTRY_UPDATE` from the server. An addon's
--- own `CreateListing` is blocked.
export function postLFGListing(createData: { [string]: unknown })
    engine().postLFGListing(createData)
end

--- The player's own listing withdrawn, as from the game's Delist: a round
--- trip later, `LFG_LIST_ACTIVE_ENTRY_UPDATE(nil)`. Whether there was one.
export function delistLFG(): boolean
    return engine().delistLFG()
end

--- The API calls Blizzard's code made that the engine had no answer for
--- (they returned empty values), as `name(args)`, sorted: what the engine
--- does not know of the client yet.
export function unanswered(): string[]
    return engine().defaultedCalls()
end

--- Closes the vendor's window (`MERCHANT_CLOSED`).
export function closeMerchant()
    engine().closeMerchant()
end

--- The user's right-click on a bag item at the vendor: sold (locked at
--- once, `PLAYER_MONEY` when the server answers).
export function sell(bag: number, slot: number)
    engine().sell(bag, slot)
end

--- Where the player is: `ZONE_CHANGED_NEW_AREA` for a new zone,
--- `ZONE_CHANGED` for a new subzone or map (`ZONE_CHANGED_INDOORS` for a
--- subzone inside a world map object, a city's: `wmo`), then the map's
--- updates. `instance`/`instanceID`: the continent (`GetInstanceInfo`);
--- `pvp`: the zone's `C_PvP.GetZonePVPInfo` (kind, free for all, faction).
export function moveTo(place: {
    mapID?: number,
    zone?: string,
    subZone?: string,
    x?: number,
    y?: number,
    world?: { y: number, x: number, z?: number, instanceID?: number },
    instance?: string,
    instanceID?: number,
    pvp?: any[],
    wmo?: boolean,
    indoors?: boolean,
    --- Where the player faces: radians counter-clockwise from north
    --- (`GetPlayerFacing`; no event).
    facing?: number,
})
    engine().moveTo(place)
end

--- The player in another part of a world map object (a city's walls):
--- `NEW_WMO_CHUNK` and the map's updates.
export function newWmoChunk()
    engine().newWmoChunk()
end

--- Units' controls for a party (`unit:joinGroup()`: an invited player
--- joins; `unit:openTrade()`: the other side of a trade accepts) are the
--- unit's methods.

--- The player enters or leaves a resting place (`IsResting`,
--- `PLAYER_UPDATE_RESTING`).
export function setResting(resting: boolean)
    engine().setResting(resting)
end

--- The realm has the hardcore rules (permanent death) or not:
--- `C_GameRules.IsHardcoreActive`. On `vanilla` only (Classic Era's
--- hardcore realms); off by default.
export function setHardcore(active: boolean)
    engine().setHardcore(active)
end

--- The area's updates without a zone's event (the mount journal's
--- usability, the map's points of interest and fog).
export function areaChanged()
    engine().areaChanged()
end

--- What the client knows of the character's spells: those off the global
--- cooldown, the tracking ones, the professions', those usable on the
--- player or a group member in reach only (`partyOrSelf`: Blessing of
--- Protection; re-told as the target or the soft friend changes).
export function setSpellTraits(traits: {
    offGlobalCooldown?: number[],
    tracking?: number[],
    profession?: number[],
    partyOrSelf?: number[],
})
    engine().setSpellTraits(traits)
end

--- A trait config's ranks as the session begins (class talents, the
--- legacy trees: `C_Traits`), by node: the recorded character's otherwise.
export function setTraitRanks(configID: number, ranks: { [number]: number })
    engine().setTraitRanks(configID, ranks)
end

--- The recorded character (named by its class config's ID) whose trait
--- data is the player's: a class may have several recorded.
export function setTraitCharacter(configID: number)
    engine().setTraitCharacter(configID)
end

--- A major faction's renown (`C_MajorFactions.GetCurrentRenownLevel`: the
--- legacy system opens at 1 or more). No events, unless `{ events = true }`:
--- then a change fires `MAJOR_FACTION_RENOWN_LEVEL_CHANGED(factionID, level,
--- oldLevel)`.
export function setRenown(factionID: number, level: number, options: { events?: boolean }?)
    engine().setRenown(factionID, level, options)
end

--- The player's group: `mock.group:add(unit, raid?)` (`partyN`; with
--- `raid`, the group a raid: `raidN`), or `mock.group:add(unit, { raid?,
--- subgroup?, quiet? })` (its raid subgroup, else five to one in joining
--- order; `quiet`: in the group already, no `GROUP_ROSTER_UPDATE`).
--- A group the player makes this way the player leads;
--- `C_PartyInfo.ConvertToRaid()` / `ConvertToParty()` change it.
--- `mock.group:remove(unit, { quiet? })`: the unit leaves
--- (`GROUP_ROSTER_UPDATE`; the last one gone, the group is disbanded:
--- `GROUP_LEFT`). `mock.group:leave()`: the player leaves now, as
--- `C_PartyInfo.LeaveParty()` does a round trip later ("You leave the
--- group.", `GROUP_LEFT`, `GROUP_ROSTER_UPDATE`).
export const group = {
    add = function(_: any, unit: MockUnit, opts: (boolean | { raid?: boolean, subgroup?: number, quiet?: boolean })?)
        engine().addToGroup(unit, opts)
    end,
    remove = function(_: any, unit: MockUnit, opts: { quiet?: boolean }?)
        engine().removeFromGroup(unit, opts)
    end,
    leave = function(_: any)
        engine().leaveGroup()
    end,
}

--- Enters a restricted instance of `kind` (`"raid"`, `"party"`, `"pvp"`, …):
--- `IsInInstance`, `GetInstanceInfo` (`opts`: its `name`, `instanceID`,
--- `difficultyID`, `difficultyName`, `maxPlayers`; a normal dungeon's or
--- raid's by default), `UPDATE_INSTANCE_INFO`, `PLAYER_DIFFICULTY_CHANGED`.
export function enterInstance(kind: string?, opts: { name?: string, instanceID?: number, difficultyID?: number, difficultyName?: string, maxPlayers?: number }?)
    engine().enterInstance(kind, opts)
end

--- Leaves the instance (an encounter under way ends, not won).
export function leaveInstance()
    engine().leaveInstance()
end

--- A boss encounter begins: `ENCOUNTER_START(id, name, difficultyID,
--- groupSize)` (the instance's by default), then the `bosses` on the
--- `boss1`.. tokens (Blizzard's boss frames) and
--- `INSTANCE_ENCOUNTER_ENGAGE_UNIT`;
--- `C_InstanceEncounter.IsEncounterInProgress()` true.
export function startEncounter(data: { id: number, name: string, difficultyID?: number, groupSize?: number, bosses?: MockUnit[] })
    engine().startEncounter(data)
end

--- The encounter ends: won (`success`), `BOSS_KILL(id, name)`; then
--- `ENCOUNTER_END(id, name, difficultyID, groupSize, success, status)`
--- (each boss's creature ID, name and health left in percent), the boss
--- tokens cleared, `INSTANCE_ENCOUNTER_ENGAGE_UNIT`.
export function endEncounter(success: boolean)
    engine().endEncounter(success)
end

--- A slot of the pet's bar (`mock.setPet`'s `actions`): a spell
--- (`spell`, `name`, `icon`, `autocast`, `autocastAllowed`) or a command
--- (`token`: `"PET_ACTION_ATTACK"`, …, `texture`: its texture's global).
export type PetAction = {
    spell?: number,
    name?: string,
    icon?: number | string,
    autocast?: boolean,
    autocastAllowed?: boolean,
    token?: string,
    texture?: string,
    active?: boolean,
}

--- The player's pet (`nil`: dismissed): `UNIT_PET("player")`,
--- `PET_BAR_UPDATE`, `UNIT_HAPPINESS("pet")`; Blizzard's pet frame and
--- pet bar. A hunter's (`hunter`, by default) has its `happiness` (1 to
--- 3, happy by default), `loyalty` and experience (`xp` of `xpMax`); its
--- bar is a hunter's (attack, follow, stay, four spells, the three modes)
--- with `actions` in their slots. Called again for the same pet, it
--- changes what `opts` gives (`UNIT_HAPPINESS`, `UNIT_PET_EXPERIENCE`,
--- `PET_BAR_UPDATE`).
export function setPet(pet: MockUnit?, opts: { hunter?: boolean, happiness?: number, loyalty?: string, xp?: number, xpMax?: number, actions?: { [number]: PetAction } }?)
    engine().setPet(pet, opts)
end

--- Turns one of the client's addon restrictions on or off.
export function setRestriction(kind: unknown, active: boolean)
    engine().setRestriction(kind, active)
end

--- A secret value with `v` inside (spec emulator §17.5).
export function secret<T>(v: T): Secret<T>
    return engine().secret(v)
end

-- ----------------------------------------------------------------- events

--- Fires an event of the flavor, its payload checked against the
--- documentation.
export function fireEvent(name: string, ...: unknown)
    engine().fireEvent(name, ...)
end

--- Fires a unit event for `unit`.
export function fireUnitEvent(name: string, unit: string, ...: unknown)
    engine().fireUnitEvent(name, unit, ...)
end

--- `ADDON_LOADED` (the addon), `PLAYER_LOGIN` and `PLAYER_ENTERING_WORLD`
--- (for `config({ lifecycle = "manual" })`).
export function login()
    engine().login()
end

-- Raised in the test's pass after `reloadUI`: the pass ends there.
const reloadSignal = {}
wl.reloadSignal = reloadSignal

--- `/reload`: the test's pass ends here. The runner keeps the TOC's
--- SavedVariables (as the client writes them), loads everything again in a
--- fresh VM, logs in and runs the test again from the top, with
--- `reloads()` one higher. The file's other tests go on as before. Code
--- that calls `ReloadUI()` itself ends the session there (`PLAYER_LOGOUT`
--- and the rest; nothing of it runs after) and the pass at the test's
--- next wait, as here.
export function reloadUI()
    if coroutine.running() == nil then
        error("mock.reloadUI runs inside a test", 2)
    end
    coroutine.yield(waitToken, "reload", 0)
    error(reloadSignal, 0)
end

--- How many times the running test reloaded the UI: 0 on its first pass.
export function reloads(): number
    return wl.reloads ?? 0
end

-- ------------------------------------------------------------------ time

--- Moves the virtual clock by `sec`, running the timers that come due.
--- The server's round trip from now on (the player's ping; 0.4 s by
--- default): its answers to requests (targeting, buying, interrupts) come
--- that much later.
export function setLatency(seconds: number)
    engine().setLatency(seconds)
end

--- The profile's snapshot was taken now: the cooldowns it recorded end
--- their recorded time left from here.
export function snapshotTaken()
    engine().snapshotTaken()
end

--- Moves the virtual clock (`GetTime`, `C_Timer`) on by `sec` seconds,
--- running the timers that come due on the way, in order.
export function advanceTime(sec: number)
    engine().advanceTime(sec)
end

--- One frame (`OnUpdate` with `ms` milliseconds, 1000/60 by default).
export function nextFrame(ms: number?)
    engine().advanceFrames(1, ms)
end

--- `n` frames of `ms` milliseconds.
export function advanceFrames(n: number, ms: number?)
    engine().advanceFrames(n, ms)
end

--- The client's batching of a frame's events (off by default: each event
--- as the control causing it fires it). On: `ACTIONBAR_UPDATE_*`,
--- `SPELL_UPDATE_COOLDOWN`, `UNIT_HEALTH`, the threat updates and the like
--- wait for the frame's end (the clock's next move), each once, in their
--- names' order; off: those owed fired now.
export function setFrameBatching(on: boolean)
    engine().setFrameBatching(on)
end

--- The ID the damage meter's next combat session gets (1 by default; the
--- client numbers them on from its earlier ones). The sessions
--- (`C_DamageMeter`) count the blows and heals of the player's fights.
export function setDamageMeterSession(id: number)
    engine().setDamageMeterSession(id)
end

--- Simulated work of `ms` milliseconds (`debugprofilestop` moves).
export function spend(ms: number)
    engine().spend(ms)
end

-- ------------------------------------------------------------ waiting

-- The session ended (`ReloadUI` in an addon's or Blizzard's code): as at
-- `reloadUI`, the test's pass ends.
local function reloaded()
    if engine().loggedOut() then
        coroutine.yield(waitToken, "reload", 0)
        error(reloadSignal, 0)
    end
end

local function wait(kind: string, amount: number)
    if coroutine.running() == nil then
        error("mock.wait… runs inside a test", 3)
    end
    reloaded()
    coroutine.yield(waitToken, kind, amount)
    reloaded()
end

--- Lets `n` frames pass (decision T216).
export function waitFrames(n: number)
    wait("frames", n)
end

--- Lets `sec` virtual seconds of frames pass.
export function waitSeconds(sec: number)
    wait("seconds", sec)
end

local function timeout(): number
    local tests = wl.tests
    return tests and tests.timeout() or 10
end

-- A wait's condition: a secret boolean cannot be tested (other secrets are
-- truthy).
local function truthy(v: any, what: string): boolean
    if isSecret(v) and type(v) == "boolean" then
        error(`{what} is a secret boolean, which tests cannot test (they run tainted, like the addon)`, 3)
    end
    return not not v
end

--- Lets frames pass until `fn` returns a truthy value, and returns it; the
--- test fails after its timeout, or when `fn` returns a secret boolean.
export function waitUntil<T>(fn: () -> T?, what: string?): T
    local deadline = GetTime() + timeout()
    local v = fn()
    while not truthy(v, "mock.waitUntil: the condition") do
        if GetTime() >= deadline then
            error(`timed out after {timeout()} s waiting for {what ?? "the condition"}`, 2)
        end
        wait("frames", 1)
        v = fn()
    end
    return v :: T
end

--- Lets frames pass until `event` fires (with a payload `predicate`
--- accepts), and returns its payload (secrets as they are); the test fails
--- after its timeout, or when `predicate` returns a secret boolean.
export function waitFor(event: string, predicate: ((...any) -> boolean)?): ...any
    local got: any = nil
    local refused: string? = nil
    local listener = CreateFrame("Frame")
    listener:RegisterEvent(event)
    listener:SetScript("OnEvent", function(_: Frame, _: string, ...: any)
        if got ~= nil or refused ~= nil then
            return
        end
        local accepted = predicate == nil or predicate(...)
        if isSecret(accepted) and type(accepted) == "boolean" then
            refused = `mock.waitFor: the predicate for {event} returned a secret boolean, which tests cannot test (they run tainted, like the addon)`
        elseif accepted then
            got = { n = select("#", ...), ... }
        end
    end)
    -- Waits yield, so no pcall (Lua 5.1 cannot yield across it).
    local deadline = GetTime() + timeout()
    while got == nil and refused == nil and GetTime() < deadline do
        wait("frames", 1)
    end
    listener:UnregisterAllEvents()
    listener:SetScript("OnEvent", nil)
    if refused ~= nil then
        error(refused, 2)
    end
    if got == nil then
        error(`timed out after {timeout()} s waiting for {event}`, 2)
    end
    return unpack(got, 1, got.n)
end

-- -------------------------------------------------------------- the user

--- Runs a slash command line as the player typed it (a hardware event, as
--- a click or a key press): with Blizzard's chat, typed into its edit box
--- and sent with Enter (the client's own commands, emotes and help line);
--- without it, the handler `SlashCmdList` names (decision T233).
export function slash(line: string)
    engine().slash(line)
end

-- A user action on a frame the test found: nil fails the test where it
-- was passed, saying so.
local function present(frame: unknown, fn: string)
    if frame == nil then
        error(`mock.{fn}: no frame (nil)`, 3)
    end
end

--- Runs a frame's script handler as a user action would (`OnClick`, …).
export function script(frame: ScriptRegion?, name: string, ...: unknown)
    present(frame, "script")
    engine().script(frame, name, ...)
end

--- The whole screen, for `expect(mock.screen).toMatchScreenshot()`.
export const screen: any = { __wowluaScreen = true }

--- Draws the screen (or `frame` and what it holds) as the client would
--- and writes it as a PNG under the build's `screenshots` folder; its
--- path (spec debugger §18.12.4).
export function screenshot(name: string?, frame: any?): string
    return engine().screenshot(name ?? "screenshot", frame)
end

--- The user's click on a visible frame (`"LeftButton"` by default):
--- `OnMouseDown`, `OnMouseUp`, then an enabled button's `PreClick`,
--- `OnClick` and `PostClick`.
export function click(frame: ScriptRegion?, button: string?)
    present(frame, "click")
    engine().click(frame, button ?? "LeftButton")
end

--- Moves the mouse over a frame (`nil`: away, off every frame): onto its
--- middle unless it is over it already (`GetCursorPosition`), then
--- `OnLeave` of the last one, `OnEnter` of this one; `GetMouseFoci`
--- follows, and `IsMouseOver` measures the mouse against each frame.
export function hover(frame: ScriptRegion?)
    engine().hover(frame)
end

--- Types into a visible edit box: it gets the keyboard focus
--- (`OnEditFocusGained`), then each character goes in place of the
--- selected text (`HighlightText`), else at the cursor, and runs `OnChar`
--- and `OnTextChanged(true)`. `mock.pressKey("ENTER")` then goes to it.
export function typeText(editBox: EditBox?, text: string)
    present(editBox, "typeText")
    engine().type(editBox, text)
end

--- Drags a frame (or an overlay's moving parent) by `dx`, `dy` screen
--- units, as `GetCursorPosition` counts them (a distance in the frame's
--- units times its `GetEffectiveScale()`). The mouse starts on the frame
--- and moves with the drag; with `frames`, in that many steps, a frame
--- running after each (`OnUpdate` code following the drag sees it move).
export function drag(frame: ScriptRegion?, dx: number, dy: number, frames: number?)
    present(frame, "drag")
    engine().drag(frame, dx, dy, frames)
end

--- Drags a slider's thumb to `value` as the user does: `OnValueChanged(
--- value, true)` for where it is and where it goes (clamped; snapped to its
--- step only if it obeys its step on drag), `OnMouseDown`, `OnMouseUp`.
export function slide(slider: Slider?, value: number)
    present(slider, "slide")
    engine().slide(slider, value)
end

--- Drags `source` onto `target` as the user would: the source's
--- `OnDragStart` (it picks something up), then its `OnDragStop` and, with
--- something on the cursor, the target's `OnReceiveDrag`.
export function dragTo(source: ScriptRegion?, target: ScriptRegion?)
    present(source, "dragTo")
    present(target, "dragTo")
    engine().dragTo(source, target)
end

--- Drags a resize grip by `dw`, `dh` screen units (as `drag`).
export function sizeBy(grip: ScriptRegion?, dw: number, dh: number)
    present(grip, "sizeBy")
    engine().sizeBy(grip, dw, dh)
end

--- Turns the mouse wheel over a frame.
export function wheel(frame: ScriptRegion?, delta: number)
    present(frame, "wheel")
    engine().wheel(frame, delta)
end

--- The order this session's server tells the bags' updates in (a move's,
--- a sort's): `{ bag, … }` first, the default's after.
export function setBagOrder(bags: number[])
    engine().setBagOrder(bags)
end

--- A split stack's data this long after the server's answer (seconds; nil:
--- at once): its slot reads empty till then.
export function setItemDataDelay(seconds: number?)
    engine().setItemDataDelay(seconds)
end

--- Where the next `C_Container.SortBags` puts the bags' items (the
--- server's sort): `{ [bag] = { [slot] = { id, count, shownFirst, after } } }`
--- (a merged stack shown first with `shownFirst`, its `count` `after`
--- seconds later).
export function setSortResult(bags: table)
    engine().setSortResult(bags)
end

--- The modifier keys held (the left ones): `MODIFIER_STATE_CHANGED`;
--- `IsShiftKeyDown` and the others follow.
export function setModifiers(keys: { shift?: boolean, ctrl?: boolean, alt?: boolean })
    engine().setModifiers(keys)
end

--- Moves the mouse to (`x`, `y`) on the screen (`GetCursorPosition`'s
--- units: a frame's point times its effective scale); `IsMouseOver`
--- follows, no events (what is under it is `hover`'s).
export function setCursorPosition(x: number, y: number)
    engine().setCursorPosition(x, y)
end

--- A key binding the client knows (from `Bindings.xml`).
export function defineBinding(name: string, action: (keystate: string) -> (), opts: { header?: string, runOnUp?: boolean }?)
    engine().defineBinding(name, action, opts)
end

--- Presses the key binding `name` (one from `defineBinding`): its action
--- runs with `keystate` (default `"down"`); `"up"` only reaches a binding
--- with `runOnUp`.
export function pressBinding(name: string, keystate: string?)
    engine().pressBinding(name, keystate)
end

--- Presses a key: its binding (`SetBinding`) runs.
export function pressKey(key: string)
    engine().pressKey(key)
end

-- -------------------------------------------------------- communication

--- Another player's addon message.
export function receiveAddonMessage(prefix: string, message: string, chatType: string, sender: string)
    engine().receiveAddonMessage(prefix, message, chatType, sender)
end

--- An addon message the addon sent: its prefix, text, chat type and
--- target (a whisper's).
export type SentAddonMessage = { prefix: string, message: string, chatType: string, target?: string }

--- The addon messages sent so far.
export function sentAddonMessages(): SentAddonMessage[]
    return engine().sentAddonMessages()
end

--- A message of the server's own (`CHAT_MSG_SYSTEM`): a friend coming
--- online, going offline.
export function systemMessage(text: string)
    engine().systemMessage(text)
end

-- -------------------------------------------------------------- the guild

--- Another member of the player's guild: its name (and WoW Forever's last
--- name), GUID (the engine's own by default), class by file (`WARRIOR`
--- by default) and race, level (1), rank index (0 the leader; the lowest
--- rank by default), zone, public and officer notes, whether online
--- (offline by default) and away (`status` 1) or busy (2), and an offline
--- member's time away (`lastOnline`: years, months, days, hours).
export type GuildMemberData = {
    name: string,
    lastName?: string,
    guid?: string,
    class?: string,
    race?: string,
    level?: number,
    rank?: number,
    zone?: string,
    note?: string,
    officerNote?: string,
    online?: boolean,
    status?: number,
    lastOnline?: number[],
    achievementPoints?: number,
    achievementRank?: number,
}

--- A member's changes (`updateGuildMember`): the fields given replace its
--- own.
export type GuildMemberChanges = {
    name?: string,
    lastName?: string,
    guid?: string,
    class?: string,
    race?: string,
    level?: number,
    rank?: number,
    zone?: string,
    note?: string,
    officerNote?: string,
    online?: boolean,
    status?: number,
    lastOnline?: number[],
    achievementPoints?: number,
    achievementRank?: number,
}

--- A guild rank: its name and rights (`flags[n]` the right
--- `GuildControlGetRankFlags` numbers n: 1 hear guild chat, 2 speak, 3
--- and 4 officer chat, 5 promote, 6 demote, 7 invite, 8 remove, 9 set the
--- message of the day, 10 edit public notes, 11 and 12 view and edit
--- officer notes, 13 modify the guild's info, 15 bank repairs, 16
--- withdraw gold, 19 modify bank tabs, 22 officer). Without `flags` the
--- first rank has the leader's rights, the others guild chat alone.
export type GuildRankData = { name: string, flags?: { [number]: boolean } }

--- A guild for `joinGuild`: its name ("Guild"), the player's rank index
--- (0, its leader), its ranks (the leader's first; by default Guild
--- Master, Officer, Veteran, Member, Initiate), its other members (none),
--- message of the day, info text, bank money (copper) and bank tabs.
export type GuildData = {
    name?: string,
    rank?: number,
    ranks?: GuildRankData[],
    members?: GuildMemberData[],
    motd?: string,
    info?: string,
    bankMoney?: number,
    bankTabs?: number,
}

--- The player in a guild (`PLAYER_GUILD_UPDATE`). With nothing given, the
--- recorded character's, the camelot character's from the start: its
--- leader among 26 other members, all offline. With a table, that guild.
export function joinGuild(guild: GuildData?)
    engine().joinGuild(guild)
end

--- The player in no guild (`PLAYER_GUILD_UPDATE`).
export function leaveGuild()
    engine().leaveGuild()
end

--- Another member of the player's guild (`GUILD_ROSTER_UPDATE` a round
--- trip later); its handle.
export function defineGuildMember(member: GuildMemberData): number
    return engine().defineGuildMember(member)
end

--- The member changed: online, a level, a rank, notes
--- (`GUILD_ROSTER_UPDATE`).
export function updateGuildMember(handle: number, changes: GuildMemberChanges)
    engine().updateGuildMember(handle, changes)
end

--- The member left the guild (`GUILD_ROSTER_UPDATE`).
export function removeGuildMember(handle: number)
    engine().removeGuildMember(handle)
end

-- ------------------------------------------------------------- the client

--- An addon the client knows (`C_AddOns`).
export function defineAddon(name: string, opts: table?)
    engine().defineAddon(name, opts)
end

--- Loads an addon the client knows (`mock.defineAddon`), as
--- `C_AddOns.LoadAddOn` does.
export function loadAddon(name: string): (boolean?, string?)
    return C_AddOns.LoadAddOn(name)
end

--- A library for `LibStub(major)` (a stand-in LibStub when there is none).
export function provideLibrary(major: string, impl: table, minor: number?)
    local stub: any = _G.LibStub
    if stub == nil then
        local libs: { [string]: table } = {}
        local minors: { [string]: number } = {}
        stub = setmetatable({ libs = libs, minors = minors }, {
            __call = function(self: any, name: string, silent: boolean?): (table?, number?)
                local lib = self.libs[name]
                if lib == nil and not silent then
                    error(`Cannot find a library instance of "{name}".`, 2)
                end
                return lib, self.minors[name]
            end,
        })
        function stub:NewLibrary(name: string, version: number): table?
            if self.minors[name] and self.minors[name] >= version then
                return nil
            end
            self.minors[name] = version
            self.libs[name] = self.libs[name] or {}
            return self.libs[name]
        end
        function stub:GetLibrary(name: string, silent: boolean?): (table?, number?)
            return self(name, silent)
        end
        _G.LibStub = stub
    end
    stub.libs[major] = impl
    stub.minors[major] = minor ?? 1
end

--- A spell's data (decision T203). `cooldown` (seconds): pressing it
--- again sooner is refused ("Spell is not ready yet."); `category`: its
--- cooldown category (`SPELL_UPDATE_COOLDOWN`'s third value);
--- `outOfCombat`: unusable in combat; `onCast`: a function run as the
--- cast lands (its damage, kill, auras), before its cooldowns;
--- `cooldowns = { { spell, a?, b? } }`: the spells its landing tells
--- (else itself); `slotChanges = { seconds }`: its slots told changed
--- (`ACTIONBAR_SLOT_CHANGED`) that long after it is sent. Presses waiting
--- for the server fail if the target dies.
export function defineSpell(id: number, data: table)
    engine().defineSpell(id, data)
end

--- An item's data; `opts.cached = false` makes it load (`delay`). A
--- consumable's use: `spell`, `castSpells`, `cooldownCategory`; its
--- `aura` (an `applyAura` table: food's eating, run out after its
--- duration); food's `wellFed = { aura, maxHealth?, cooldowns?, after? }`
--- (eaten `after` seconds, 10 by default: the buff). Gear's `worn = {
--- maxHealth?, maxMana?, stats?, attackPower? }`: what wearing it adds (the
--- player's maximums, how many stats change, whether the attack power
--- does), told as it goes on and off; `bindType` 1 or 2: bound once worn.
export function defineItem(id: number, data: table, opts: table?)
    engine().defineItem(id, data, opts)
end

--- A quest: `{ title, text, objective, progress, completion, giver, xp,
--- money, choices, rewards, objectives = { { item, required, text } },
--- header, level, reputation }` (`$N` in the texts: the player's name).
--- Its giver offers it (`unit:interact`); `AcceptQuest()` takes it into
--- the log; looting the items its objectives ask for advances it.
export function defineQuest(id: number, data: table)
    engine().defineQuest(id, data)
end

--- The quest log as the client shows it while the map for quest POIs is
--- `mapID` (the server's data): `{ first = headerTitle(s), top = {
--- headerTitle, … }, expanded = { headerTitle, … }, onMap = { questID, …
--- }, localPOI = { questID, … }, quests = { questID, … } }`; `first`'s
--- headers move to the top, shown expanded, `top`'s after them (their own
--- state), `expanded`'s show expanded in their place; `quests`: the logged
--- quests whose map (`GetQuestUiMapID`) it is. `nil`: the map shows the
--- log as the snapshot's map does. A view defined or dropped for the map
--- shown applies at once.
export function defineQuestMap(mapID: number, data: table?)
    engine().defineQuestMap(mapID, data)
end

--- An NPC's gossip: `{ text, options = { { name, icon, gossipOptionID,
--- opens, merchant? } }, textAfter?, availableQuests? }` (`opens =
--- "trainer"`: its trainer; `"taxi"`; `"merchant"`: its vendor window,
--- `merchant` as `openMerchant` takes it; `availableQuests = { {
--- questID, title } }`: the quests it offers).
--- `unit:interact` opens it (its text with the interaction by default;
--- `textAfter` seconds later, as a class trainer's came); choosing an
--- option closes it and opens what the option does; the NPC moved out of
--- reach (`setDistance`) closes it.
export function defineGossip(npc: MockUnit, data: table)
    engine().defineGossip(npc, data)
end

--- An NPC's trainer: `{ greeting, services = { { spell, name, icon, level,
--- rank, cost, skillLine, skillLineIndex, rankData } } }`, or `{ class =
--- "WARRIOR" }`: the class's services as the client listed them (the
--- NPC's own list if recorded), each one's state the character's. Buying a
--- service teaches the spell (onto the action bar's first empty slot).
export function defineTrainer(npc: MockUnit, data: table)
    engine().defineTrainer(npc, data)
end

--- A flight master's taxi map: `{ mapID, nodes = { { name, nodeID, x, y,
--- state, cost, routes } }, mapNodes = { { name, nodeID, x, y, atlasName,
--- faction, isUndiscovered } } }`, opened by its gossip (`opens = "taxi"`).
export function defineTaxi(npc: MockUnit, data: table)
    engine().defineTaxi(npc, data)
end

--- A mailbox and its inbox: `{ letters = { { packageIcon, stationeryIcon,
--- sender, subject, money, cod, daysLeft, wasRead, wasReturned,
--- textCreated, canReply, isGM, text, items = { { id, count, itemAfter } },
--- invoice = { type, itemName, playerName, … }, auction, retrieving,
--- readAfter } }, newMail, senders, fetched, received, namesAfter,
--- dataAfter, bagAfter, goneAfter }`; `player:interact(mailbox)` opens it.
--- `fetched = false`: the inbox not fetched yet this session (empty till
--- the server's); `retrieving`: a letter's items' data not with the client
--- ("Retrieving data") till `dataAfter` seconds after the inbox, the
--- `received` items' `GET_ITEM_INFO_RECEIVED` then; the server's delays:
--- the invoices' names (`namesAfter`), a taken item's bag packet
--- (`bagAfter`), an emptied letter's going (`goneAfter`), a letter's read
--- (`readAfter`), a taken item's data after its bag packet (`itemAfter`).
export function defineMailbox(mailbox: MockUnit, data: table)
    engine().defineMailbox(mailbox, data)
end

--- Unread mail waiting (`HasNewMail`), sent by `senders`
--- (`GetLatestThreeSenders`, the latest first); nil or `{}`: none. A
--- world's state: no event.
export function setNewMail(senders: string[]?)
    engine().setNewMail(senders)
end

--- The character's saved equipment sets: `{ { name, icon, items = {
--- [slot] = itemID }, ignored = { slot, … }, spec, id }, … }`, their IDs
--- from 0 in order unless given (`C_EquipmentSet`; worn, in the bags or
--- lost by the character's gear and bags). A world's state: no event.
export function setEquipmentSets(sets: { name: string, icon?: number, items?: { [number]: number }, ignored?: number[], spec?: number, id?: number }[])
    engine().setEquipmentSets(sets)
end

--- A banker and the character's bank tabs: `{ tabs = { { name, icon,
--- depositFlags, slots, items } }, nextTabCost, tabSlots }` (the tabs'
--- bags 6 on); `player:interact(banker)` opens the bank.
export function defineBank(banker: MockUnit, data: table)
    engine().defineBank(banker, data)
end

--- An auction house and what its searches find: `{ browse = { { itemKey,
--- minPrice, totalQuantity, containsOwnerItem } }, infoReceived = { itemID,
--- … }, commodities = { [itemID] = { { auctionID, quantity, unitPrice,
--- timeLeftSeconds, owners, … } } }, items = { [itemID] = { … } }, deposit,
--- nextAuctionID, mailSender }`; `player:interact(auctioneer)` opens it.
--- A browse query with a `searchString` finds the `browse` rows whose
--- item's name holds it, all of them at once; without one, every row and
--- more on the server (`RequestMoreBrowseResults` adds none). The
--- player's posted auctions are told once asked (`QueryOwnedAuctions`:
--- `OWNED_AUCTIONS_UPDATED`); `CancelAuction` sends one back by mail.
export function defineAuctionHouse(auctioneer: MockUnit, data: table)
    engine().defineAuctionHouse(auctioneer, data)
end

--- The user clicks the world: an item on the cursor is to be deleted
--- (`DELETE_ITEM_CONFIRM`, Blizzard's popup; `DeleteCursorItem` deletes it).
export function clickWorld()
    engine().clickWorld()
end

--- The server's blocks of a loading screen's inventory, in its order: one
--- per block, the bag the block's item updates last (`"0"`: the backpack,
--- then `BAG_UPDATE(-1)`; `"-"`: none), after what the block tells before
--- the item (`"1"`, `"5"`, ...: a bag's `BAG_UPDATE`; `"containers"`:
--- `BAG_CONTAINER_UPDATE`; `"bank"`: `PLAYERBANKSLOTS_CHANGED(1)`), e.g.
--- `{ "-", "0", "1 5 containers 0" }`. Without it, a block per item.
export function setInventoryLoad(blocks: string[])
    engine().setInventoryLoad(blocks)
end

--- The class's hidden group buffs (`HIDDEN_GROUP_BUFFS_CHANGED`' list).
export function setHiddenGroupBuffs(spellIDs: number[])
    engine().setHiddenGroupBuffs(spellIDs)
end

--- The ghost reaches its corpse (`CORPSE_IN_RANGE`) or leaves it.
export function nearCorpse(near: boolean)
    engine().nearCorpse(near)
end

--- The client's error message by its name (`"BADATTACKFACING"`:
--- `UI_ERROR_MESSAGE` with the client's code and text).
export function gameError(name: string)
    engine().gameError(name)
end

--- `fn` runs once just before the engine next fires event `name`: a
--- world event among a server packet's events.
export function beforeEvent(name: string, fn: () -> ())
    engine().beforeEvent(name, fn)
end

--- The server's update owing an aura state change (a blow's
--- `statesAfter`) comes now, after the moment's other packets.
export function tellAuraStates()
    engine().tellAuraStates()
end

--- The creatures' turns on the player owed to the moment's end (their
--- `UNIT_TARGET`, their flags) told now: their packet came before the
--- moment's other updates.
export function tellTurns()
    engine().tellTurns()
end

--- A CVar the client changed without telling (the camera's pitch as it
--- turned): no `CVAR_UPDATE`.
export function setCVar(name: string, value: string)
    engine().setCVar(name, value)
end

--- A level: `{ xpMax, health, power, talents, pvpTalentSlots, strength,
--- agility, stamina, intellect, spirit }`. Experience past the current
--- level's end gains it (`PLAYER_LEVEL_UP`, a round trip later
--- `PLAYER_LEVEL_CHANGED`).
export function defineLevel(level: number, data: table)
    engine().defineLevel(level, data)
end

--- Shows a tooltip as the player hovering something would (Blizzard's UI
--- code: `test.blizzard-ui`): an item (`{ id }`, `{ link }`, `{ bag,
--- slot }`, `{ slot }` equipped), a spell (`{ id }`), a unit (`{ unit }`);
--- the tooltip's data comes from the tests' game data, and the addons'
--- tooltip hooks run. It is placed where the default UI places a tooltip
--- of something in the world (`GameTooltip_SetDefaultAnchor`), so a
--- screenshot shows it. Returns the lines' left texts.
export function showTooltip(kind: "item" | "spell" | "unit", data: { id?: number, link?: string, unit?: string, bag?: number, slot?: number }, tip: GameTooltip?): string[]
    local t: any = tip ?? _G.GameTooltip
    if t == nil or t.SetItemByID == nil then
        error("mock.showTooltip needs Blizzard's UI code (test.blizzard-ui)", 2)
    end
    -- Where the default UI puts a tooltip of something hovered in the
    -- world (`GameTooltip_SetDefaultAnchor`: bottom right, over the bars);
    -- `ANCHOR_NONE` alone leaves it nowhere, so it is not drawn.
    if _G.GameTooltip_SetDefaultAnchor then
        _G.GameTooltip_SetDefaultAnchor(t, _G.UIParent)
    else
        t:SetOwner(_G.UIParent, "ANCHOR_NONE")
    end
    if kind == "unit" then
        t:SetUnit(data.unit ?? "player")
    elseif kind == "spell" then
        t:SetSpellByID(data.id)
    elseif data.link then
        t:SetHyperlink(data.link)
    elseif data.bag and data.slot then
        t:SetBagItem(data.bag, data.slot)
    elseif data.slot then
        t:SetInventoryItem("player", data.slot)
    else
        t:SetItemByID(data.id)
    end
    local lines: string[] = {}
    local name = t:GetName()
    for i = 1, t:NumLines() do
        local fs = _G[`{name}TextLeft{i}`]
        lines[i] = fs and fs:GetText() or ""
    end
    return lines
end

--- A tooltip's lines as it shows them now (`GameTooltip`'s, or `tip`'s):
--- the left texts, or with `right` the right ones; "" for an empty side.
export function tooltipLines(tip: GameTooltip?, right: boolean?): string[]
    local t: any = tip ?? _G.GameTooltip
    local side = right and "Right" or "Left"
    local lines: string[] = {}
    local name = t:GetName()
    for i = 1, t:NumLines() do
        local fs = _G[`{name}Text{side}{i}`]
        lines[i] = fs and fs:GetText() or ""
    end
    return lines
end

--- The text a font string, button or edit box shows: `""` when it has
--- none (a fresh font string's `GetText()` is nil); a secret one as it is
--- (typed so with `check.secret-widget-results`).
export function textOf(region: FontString | Button | EditBox | nil): AspectSecret<string, string | Secret<string>>
    if region == nil then
        error("mock.textOf: no region (nil)", 2)
    end
    return region:GetText() ?? ""
end

--- A stand-in for a Blizzard template: `CreateFrame` with it calls `fn`.
export function defineTemplate(name: string, fn: (frame: Frame) -> ())
    engine().defineTemplate(name, fn)
end

--- An intrinsic frame type built on `base`.
export function defineFrameType(name: string, base: string, fn: (frame: Frame) -> ())
    engine().defineFrameType(name, base, fn)
end

--- Makes a frame protected (or not).
export function protect(frame: ScriptRegion, on: boolean?)
    engine().protect(frame, on)
end

--- Every frame, in creation order.
export function frames(): ScriptRegion[]
    return engine().frames()
end

--- Protected actions the client refused, with their taint.
export function refusals(): table[]
    return engine().refusals()
end

-- ---------------------------------------------------------------- output

--- The lines `print` printed.
export function printed(): string[]
    return engine().printed()
end

--- The errors that reached the error handler since the test began (its
--- `@beforeEach` hooks included; the file's earlier tests' are theirs).
--- Reading them marks them as
--- expected: errors no test reads fail the test. (Errors the client drops
--- without a report, a `secureexecuterange` callback's, are not here: they
--- always fail the test.)
export function errors(): string[]
    return engine().errors()
end

--- What the engine warned about (undefined templates, …).
export function warnings(): string[]
    return engine().warnings()
end

-- --------------------------------------------------- spies, stubs, fakes

--- A function that records its calls (`toHaveBeenCalled…`) and runs `fn`.
export function spy<A..., R...>(fn: ((A...) -> R...)?): (A...) -> R...
    local calls: any[] = {}
    local function s(...: any): ...any
        calls[#calls + 1] = { n = select("#", ...), ... }
        if fn then
            return fn(...)
        end
    end
    spies[s] = calls
    return s :: any
end

--- Forgets the calls every spy recorded.
export function resetSpies()
    for _, calls in pairs(spies) do
        for i = #calls, 1, -1 do
            calls[i] = nil
        end
    end
end

--- Replaces `t[key]` with `fn` (a spy) until the test ends; returns the spy.
--- `t` is any table: a module's, a widget (its method), an object. The
--- field is put back as it was, its taint included: a global the client
--- set stays secure for Blizzard's code after the test.
export function stub<T>(t: T, key: string, fn: Fn?): Fn
    local target: any = t
    if type(target) ~= "table" then
        error(`mock.stub: a table expected, got {type(target)}`, 2)
    end
    local restore: () -> ()
    if wl.mockEngine then
        restore = wl.mockEngine.keepField(target, key)
    else
        local original = rawget(target, key)
        restore = function()
            target[key] = original
        end
    end
    local s = spy(fn)
    target[key] = s
    restores[#restores + 1] = restore
    return s
end

--- Sets `t[key]` to `value` (any value, `nil` too) until the test ends:
--- a frame or a game API taken away, a field changed. The field is put
--- back as it was, its taint included, as `stub` does it: an assignment
--- from the test would leave Blizzard's field tainted for the rest of the
--- file (decision T230).
export function setField(t: table, key: unknown, value: unknown)
    local target: any = t
    if type(target) ~= "table" then
        error(`mock.setField: a table expected, got {type(target)}`, 2)
    end
    local restore: () -> ()
    if wl.mockEngine then
        restore = wl.mockEngine.keepField(target, key)
    else
        local original = rawget(target, key)
        restore = function()
            target[key] = original
        end
    end
    target[key] = value
    restores[#restores + 1] = restore
end

--- Replaces exports of a module for the rest of the test file (decision
--- T224): `target` is the module's namespace (`import * as tracker from
--- "/tracker"`), `replacement` the exports to replace, checked against the
--- module's (a missing or mistyped one is an error). The addon's files
--- read imports at each use in tests, so every importer sees the
--- replacement.
export function module<M>(target: M, replacement: table)
    local exports = target :: any
    for name, value in pairs(replacement) do
        exports[name] = value
    end
end

-- What marks a `mock.partial` fake for the runtime checks
-- (`__wl.check.partial`).
const PARTIAL = { __wowluaPartial = true }

--- A fake of a record the game gives, with only the fields a test needs,
--- typed as where it goes (`local info: BNetAccountInfo = mock.partial({
--- bnetAccountID = 1 })`), so a stub can return it. The fields are not
--- checked against the type, also not by runtime checks.
export function partial<T>(fields: { [string]: unknown }): T
    if getmetatable(fields) == nil then
        setmetatable(fields, PARTIAL)
    end
    return fields :: unknown :: T
end

--- Replaces an engine function (`"UnitName"`, `"C_Spell.GetSpellInfo"`)
--- with `impl` until the test ends; returns its spy.
export function fake(name: string, impl: Fn): Fn
    local t: table = _G
    local key = name
    local dot = name:find(".", 1, true)
    if dot then
        local ns2 = _G[name:sub(1, dot - 1)]
        if type(ns2) ~= "table" then
            error(`mock.fake: there is no {name:sub(1, dot - 1)}`, 2)
        end
        t = ns2
        key = name:sub(dot + 1)
    end
    return stub(t, key, impl)
end
