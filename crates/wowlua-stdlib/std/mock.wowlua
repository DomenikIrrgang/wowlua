--- The client's error message by its name (`"BADATTACKFACING"`:
--- `UI_ERROR_MESSAGE` with the client's code and text).
export function gameError(name: string)
    engine().gameError(name)
end

--- A CVar the client changed without telling (the camera's pitch as it
--- turned): no `CVAR_UPDATE`.
export function setCVar(name: string, value: string)
    engine().setCVar(name, value)
