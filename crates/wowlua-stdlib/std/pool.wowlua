-- wowlua:pool (spec stdlib "pool"): object pools that reuse frames and
-- tables instead of creating garbage. A released frame is hidden, loses its
-- points and gets `onRelease()` if it has one; a protected frame released
-- in combat stays active until combat ends (wowlua:combat).
import defer from "wowlua:combat"

local _, ns = ...
local wl = ns.__wowlua

--- A pool of `T`s.
export interface Pool<T>
    --- An object, and whether it was newly created.
    function acquire(): (T, boolean)
    function release(obj: T)
    function releaseAll()
    --- An iterator over the acquired objects.
    function active(): () -> T?
    --- How many objects are acquired, and how many wait for reuse.
    function count(): (number, number)
end

local function wipeTable(t: any)
    if wipe then
        wipe(t)
        return
    end
    for k in pairs(t) do
        t[k] = nil
    end
end

local function blocked(obj: any): boolean
    return type(obj) == "table"
        and type(obj.IsProtected) == "function"
        and obj:IsProtected()
        and InCombatLockdown()
        and true
        or false
end

-- A pool that makes objects with `create` and resets them with `reset`;
-- at most `max` wait for reuse.
local function makePool(create: () -> any, reset: (any) -> (), max: number?): any
    local acquired: { [any]: boolean } = {}
    local waiting: any[] = {}
    -- Releases waiting for the end of combat.
    local pending: { [any]: boolean } = {}
    local pool: any = {}

    local function misuse(what: string)
        if wl.debug then
            error("pool: " .. what, 3)
        end
    end

    local function finish(obj: any)
        pending[obj] = nil
        acquired[obj] = nil
        reset(obj)
        if max == nil or #waiting < max then
            waiting[#waiting + 1] = obj
        end
    end

    function pool.acquire(_): (any, boolean)
        local obj = table.remove(waiting)
        local created = false
        if obj == nil then
            obj = create()
            created = true
        end
        acquired[obj] = true
        return obj, created
    end

    function pool.release(_, obj: any)
        if not acquired[obj] then
            misuse("released an object that is not acquired from this pool (released twice?)")
            return
        end
        if pending[obj] then
            misuse("released an object twice")
            return
        end
        if blocked(obj) then
            -- Hiding a protected frame in combat is blocked: later.
            pending[obj] = true
            defer(function()
                if pending[obj] then
                    finish(obj)
                end
            end)
            return
        end
        finish(obj)
    end

    function pool.releaseAll(self: any)
        local list = {}
        for obj in pairs(acquired) do
            if not pending[obj] then
                list[#list + 1] = obj
            end
        end
        for _, obj in ipairs(list) do
            self:release(obj)
        end
    end

    function pool.active(_): () -> any
        local list = {}
        for obj in pairs(acquired) do
            list[#list + 1] = obj
        end
        local i = 0
        return function(): any
            i += 1
            return list[i]
        end
    end

    function pool.count(_): (number, number)
        local n = 0
        for _ in pairs(acquired) do
            n += 1
        end
        return n, #waiting
    end

    return pool
end

local function resetFrame(frame: any)
    frame:Hide()
    frame:ClearAllPoints()
    if type(frame.onRelease) == "function" then
        frame:onRelease()
    end
end

--- A pool of instances of `cls`, made with `cls.new(...)`.
local function framePool(cls: any, ...: any): Pool<any>
    local n = select("#", ...)
    local args = { ... }
    return makePool(function(): any
        return cls.new(unpack(args, 1, n))
    end, resetFrame)
end

--- A pool of plain frames of `frameType` (with `template`, under `parent`).
local function templatePool(frameType: string, parent: any?, template: string?): Pool<Frame>
    return makePool(function(): any
        return CreateFrame(frameType, nil, parent, template)
    end, resetFrame)
end

--- A pool of tables, wiped when released; `opts.max` caps the tables kept.
local function tablePool(opts: { max: number? }?): Pool<table>
    return makePool(function(): any
        return {}
    end, wipeTable, opts and opts.max)
end

export local FramePool = { new = framePool, fromTemplate = templatePool }
export local TablePool = { new = tablePool }
