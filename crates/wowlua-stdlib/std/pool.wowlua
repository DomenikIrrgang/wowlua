-- wowlua:pool (spec stdlib "pool"): object pools that reuse frames and
-- tables instead of creating garbage. A released frame is hidden, loses its
-- points and gets `onRelease()` if it has one; a protected frame released
-- in combat stays active until combat ends (wowlua:combat).
import defer from "wowlua:combat"

local _, ns = ...
local wl = ns.__wowlua

--- A pool of `T`s.
export interface Pool<T>
    --- An object, and whether it was newly created.
    function acquire(): (T, boolean)
    function release(obj: T)
    function releaseAll()
    --- An iterator over the acquired objects.
    function active(): () -> T?
    --- How many objects are acquired, and how many wait for reuse.
    function count(): (number, number)
end

local function wipeTable(t: any)
    if wipe then
        wipe(t)
        return
    end
    for k in pairs(t) do
        t[k] = nil
    end
end

local function blocked(obj: any): boolean
    return type(obj) == "table"
        and type(obj.IsProtected) == "function"
        and obj:IsProtected()
        and InCombatLockdown()
        and true
        or false
end

--- A pool that makes objects with `create` and resets them with `reset`;
--- at most `max` wait for reuse.
class ObjectPool<T> implements Pool<T>
    private readonly make: () -> T
    private readonly clean: (obj: T) -> ()
    private readonly max?: number
    private acquired: { [T]: boolean } = {}
    private waiting: T[] = {}
    -- Releases waiting for the end of combat.
    private pending: { [T]: boolean } = {}

    constructor(make: () -> T, clean: (obj: T) -> (), max: number?)
        self.make = make
        self.clean = clean
        self.max = max
    end

    private function misuse(what: string)
        if wl.debug then
            error("pool: " .. what, 3)
        end
    end

    private function finish(obj: T)
        self.pending[obj] = nil
        self.acquired[obj] = nil
        self.clean(obj)
        if self.max == nil or #self.waiting < self.max then
            self.waiting[#self.waiting + 1] = obj
        end
    end

    function acquire(): (T, boolean)
        local obj = table.remove(self.waiting)
        local created = false
        if obj == nil then
            obj = self.make()
            created = true
        end
        self.acquired[obj] = true
        return obj, created
    end

    function release(obj: T)
        if not self.acquired[obj] then
            self:misuse("released an object that is not acquired from this pool (released twice?)")
            return
        end
        if self.pending[obj] then
            self:misuse("released an object twice")
            return
        end
        if blocked(obj) then
            -- Hiding a protected frame in combat is blocked: later.
            self.pending[obj] = true
            defer(function()
                if self.pending[obj] then
                    self:finish(obj)
                end
            end)
            return
        end
        self:finish(obj)
    end

    function releaseAll()
        local list: T[] = {}
        for obj in pairs(self.acquired) do
            if not self.pending[obj] then
                list[#list + 1] = obj
            end
        end
        for _, obj in ipairs(list) do
            self:release(obj)
        end
    end

    function active(): () -> T?
        local list: T[] = {}
        for obj in pairs(self.acquired) do
            list[#list + 1] = obj
        end
        local i = 0
        return function(): T?
            i += 1
            return list[i]
        end
    end

    function count(): (number, number)
        local n = 0
        for _ in pairs(self.acquired) do
            n += 1
        end
        return n, #self.waiting
    end
end

local function resetFrame(frame: any)
    frame:Hide()
    frame:ClearAllPoints()
    if type(frame.onRelease) == "function" then
        frame:onRelease()
    end
end

--- A pool of instances of `cls`, made with `cls.new(...)`.
local function framePool(cls: any, ...: any): Pool<any>
    local n = select("#", ...)
    local args = { ... }
    return ObjectPool.new(function(): any
        return cls.new(unpack(args, 1, n))
    end, resetFrame)
end

--- A pool of plain frames of `frameType` (with `template`, under `parent`).
local function templatePool(frameType: FrameType, parent: Frame?, template: string?): Pool<Frame>
    return ObjectPool.new(function(): Frame
        return CreateFrame(frameType, nil, parent, template)
    end, resetFrame)
end

--- A pool of tables, wiped when released; `opts.max` caps the tables kept.
local function tablePool(opts: { max?: number }?): Pool<table>
    return ObjectPool.new(function(): table
        return {}
    end, wipeTable, opts?.max)
end

export local FramePool = { new = framePool, fromTemplate = templatePool }
export local TablePool = { new = tablePool }
