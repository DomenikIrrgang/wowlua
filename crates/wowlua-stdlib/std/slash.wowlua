-- wowlua:slash (spec stdlib "slash"): slash commands, and a router for
-- subcommands with typed arguments and flags. Each `@slash` gets the key
-- WOWLUA_<ADDON>_<N> in WoW's SlashCmdList, unique across addons.
import callIn from "wowlua:errors"
import print as say from "wowlua:log"
import * as secret from "wowlua:secret"

local addonName, ns = ...

--- How a positional argument converts: a type (`?` when optional),
--- `"rest"`, or a list of choices.
export type ArgSpec = string | string[]

--- A router command.
export type Command = {
    args?: ArgSpec[],
    flags?: string[],
    aliases?: string[],
    help?: string,
    run: (...any) -> (),
}

--- A command as `commands()` lists it: `usage` is its name and arguments.
export type CommandInfo = {
    name: string,
    usage: string,
    help?: string,
    aliases: string[],
    owner?: any,
}

--- `order`: how `help` and `commands()` list the commands, by name
--- (default) or in the order they were added (the definitions first).
export type RouterOptions = { order?: "name" | "added" }

--- What `router` returns: runs the commands of a slash line, and lists
--- them.
export interface Router
    --- Runs the command `msg` names with its arguments (true). An empty
    --- `msg` or `help` prints the help (true); an unknown command prints it
    --- too (false). A secret `msg` runs nothing (false).
    function dispatch(msg: string): boolean
    --- Every command's usage and help text, one per line, each after the
    --- slash command (`/<cmd> <command> <args> - <help>`): the one whose
    --- handler runs, else the addon's first.
    function help(): string
    --- Adds a command (checked like the definitions; a name or alias that is
    --- taken is an error), owned by `owner` for `removeAll`.
    function add(name: string, command: Command, owner: any?)
    --- Removes a command and its aliases (nothing when there is none).
    function remove(name: string)
    --- Removes every command `owner` added.
    function removeAll(owner: any)
    --- The commands, in help order.
    function commands(): CommandInfo[]
end

type Handler = (msg: string, editBox: EditBox?) -> ()

local prefix = "WOWLUA_" .. addonName:upper():gsub("[^A-Z0-9]", "_") .. "_"
local registered = 0
local commands: { [string]: boolean } = {}
-- The command whose handler runs (its first name), and the addon's first
-- command: the router's help and usage lines start with it.
local running: string? = nil
local first: string? = nil

local function register(names: string[], fn: Handler)
    registered += 1
    local key = prefix .. registered
    for i, name in ipairs(names) do
        if type(name) ~= "string" or not name:match("^/%S+$") then
            error("@slash: `" .. tostring(name) .. "` is no slash command (\"/name\")", 3)
        end
        local lower = name:lower()
        if commands[lower] then
            error("@slash: " .. name .. " is registered twice", 3)
        end
        commands[lower] = true
        _G["SLASH_" .. key .. i] = name
    end
    first = first ?? names[1]
    SlashCmdList[key] = function(msg: string, editBox: EditBox?)
        const outer = running
        running = names[1]
        callIn({ component = "slash: " .. names[1] }, fn, msg, editBox)
        running = outer
    end
end

--- `@slash("/cmd", ...)`: the handler gets the message and the edit box.
export function slash(...: string)
    local names = { ... }
    return function(fn: Handler, _: DecoratorContext?)
        register(names, fn)
    end
end

-- Router ---------------------------------------------------------------------

-- Splits on whitespace; "two words" and 'two words' are one token, \"
-- escapes. Also returns where each token starts in `msg`.
local function tokenize(msg: string): (string[], number[])
    local tokens: string[], starts: number[] = {}, {}
    local i, n = 1, #msg
    while i <= n do
        local c = msg:sub(i, i)
        if c:match("%s") then
            i += 1
        elseif c == "\"" or c == "'" then
            local buf: string[] = {}
            starts[#starts + 1] = i
            i += 1
            while i <= n and msg:sub(i, i) ~= c do
                if msg:sub(i, i) == "\\" and i < n then
                    i += 1
                end
                buf[#buf + 1] = msg:sub(i, i)
                i += 1
            end
            tokens[#tokens + 1] = table.concat(buf)
            i += 1
        else
            local j = i
            while j <= n and not msg:sub(j, j):match("%s") do
                j += 1
            end
            tokens[#tokens + 1] = msg:sub(i, j - 1)
            starts[#starts + 1] = i
            i = j
        end
    end
    return tokens, starts
end

const BOOLEANS = { ["true"] = true, on = true, yes = true, ["1"] = true,
                   ["false"] = false, off = false, no = false, ["0"] = false }

-- Converts one argument by its spec; returns ok and the value.
local function convert(spec: ArgSpec, token: string?): (boolean, any)
    if type(spec) == "table" then
        if token == nil then
            return false, nil
        end
        for _, choice in ipairs(spec) do
            if choice:lower() == token:lower() then
                return true, choice
            end
        end
        return false, nil
    end
    local optional = spec:sub(-1) == "?"
    local kind = optional and spec:sub(1, -2) or spec
    if token == nil then
        return optional, nil
    end
    if kind == "string" then
        return true, token
    elseif kind == "number" then
        local v = tonumber(token)
        return v ~= nil, v
    elseif kind == "boolean" then
        local v = BOOLEANS[token:lower()]
        return v ~= nil, v
    end
    return false, nil
end

local function describe(spec: ArgSpec): string
    if type(spec) == "table" then
        return "<" .. table.concat(spec, "|") .. ">"
    end
    if spec == "rest" then
        return "<text...>"
    end
    local optional = spec:sub(-1) == "?"
    local kind = optional and spec:sub(1, -2) or spec
    return optional and "[" .. kind .. "]" or "<" .. kind .. ">"
end

-- `/<cmd> ` for help and usage lines: the command whose handler runs, else
-- the addon's first one (nothing when it has none).
local function slashPrefix(): string
    const cmd = running ?? first
    return cmd and cmd .. " " or ""
end

local function usage(name: string, command: Command): string
    local parts = { name }
    for _, spec in ipairs(command.args ?? {}) do
        parts[#parts + 1] = describe(spec)
    end
    for _, flag in ipairs(command.flags ?? {}) do
        parts[#parts + 1] = "[--" .. flag .. "]"
    end
    return table.concat(parts, " ")
end

class SlashRouter implements Router
    private defs: { [string]: Command } = {}
    -- Command names and aliases, lowercase, to command names.
    private byName: { [string]: string } = {}
    -- Command names in the order they came (the definitions' first, by
    -- name: a table has no order), and their owners.
    private names: string[] = {}
    private owners: { [string]: any } = {}
    private readonly order: "name" | "added"

    constructor(defs: { [string]: Command }, opts: RouterOptions?)
        self.order = opts?.order ?? "name"
        const initial: string[] = {}
        for name in pairs(defs) do
            initial[#initial + 1] = name
        end
        table.sort(initial)
        for _, name in ipairs(initial) do
            self:insert(name, assert(defs[name]), nil)
        end
    end

    private function insert(name: string, command: Command, owner: any)
        self.defs[name] = command
        self.owners[name] = owner
        self.names[#self.names + 1] = name
        self.byName[name:lower()] = name
        for _, alias in ipairs(command.aliases ?? {}) do
            self.byName[alias:lower()] = name
        end
    end

    function add(name: string, command: Command, owner: any?)
        for _, key in ipairs({ name, unpack(command.aliases ?? {}) }) do
            const taken = self.byName[key:lower()]
            if taken then
                error(`router: "{key}" is taken by the command "{taken}"`, 2)
            end
        end
        self:insert(name, command, owner)
    end

    function remove(name: string)
        if not self.defs[name] then
            return
        end
        self.defs[name] = nil
        self.owners[name] = nil
        for i, n in ipairs(self.names) do
            if n == name then
                table.remove(self.names, i)
                break
            end
        end
        for key, n in pairs(self.byName) do
            if n == name then
                self.byName[key] = nil
            end
        end
    end

    function removeAll(owner: any)
        if owner == nil then
            error("removeAll: the owner is nil", 2)
        end
        const owned: string[] = {}
        for _, name in ipairs(self.names) do
            if self.owners[name] == owner then
                owned[#owned + 1] = name
            end
        end
        for _, name in ipairs(owned) do
            self:remove(name)
        end
    end

    function commands(): CommandInfo[]
        const names = { unpack(self.names) }
        if self.order == "name" then
            table.sort(names)
        end
        const out: CommandInfo[] = {}
        for i, name in ipairs(names) do
            const command = assert(self.defs[name])
            out[i] = {
                name = name,
                usage = usage(name, command),
                help = command.help,
                aliases = command.aliases ?? {},
                owner = self.owners[name],
            }
        end
        return out
    end

    function help(): string
        local lines: string[] = {}
        for i, c in ipairs(self:commands()) do
            lines[i] = slashPrefix() .. c.usage .. (c.help and " - " .. c.help or "")
        end
        return table.concat(lines, "\n")
    end

    private function printHelp()
        for line in self:help():gmatch("[^\n]+") do
            say(line)
        end
    end

    function dispatch(msg: string): boolean
        -- Slash input is never secret, forwarded chat text may be: it
        -- cannot be read, so nothing runs.
        if secret.isSecret(msg) then
            return false
        end
        local tokens, starts = tokenize(msg)
        if #tokens == 0 or tokens[1]:lower() == "help" then
            self:printHelp()
            return true
        end
        local name = self.byName[tokens[1]:lower()]
        if not name then
            self:printHelp()
            return false
        end
        local command = assert(self.defs[name])
        local args = command.args ?? {}
        -- A `rest` argument takes the text as typed from the first token
        -- after the arguments before it (flags must come before it).
        local restAt: number? = nil
        for i, spec in ipairs(args) do
            if spec == "rest" then
                restAt = i
                break
            end
        end
        -- Flags anywhere after the command; the rest are positional.
        local flags: { [string]: boolean } = {}
        local known: { [string]: boolean } = {}
        for _, f in ipairs(command.flags ?? {}) do
            known[f] = true
            flags[f] = false
        end
        local positional: string[] = {}
        local rest = ""
        for i = 2, #tokens do
            if restAt and #positional == restAt - 1 then
                rest = msg:sub(starts[i]):match("^(.-)%s*$")
                break
            end
            local flag = tokens[i]:match("^%-%-(.+)$")
            if flag then
                if not known[flag] then
                    say("Usage: " .. slashPrefix() .. usage(name, command))
                    return true
                end
                flags[flag] = true
            else
                positional[#positional + 1] = tokens[i]
            end
        end
        local values: any[] = {}
        for i, spec in ipairs(args) do
            if i == restAt then
                values[i] = rest
                break
            end
            local ok, v = convert(spec, positional[i])
            if not ok then
                say("Usage: " .. slashPrefix() .. usage(name, command))
                return true
            end
            values[i] = v
        end
        if not restAt and #positional > #args then
            say("Usage: " .. slashPrefix() .. usage(name, command))
            return true
        end
        local n = #args
        if command.flags then
            n += 1
            values[n] = flags
        end
        callIn({ component = "slash: " .. name }, command.run, unpack(values, 1, n))
        return true
    end
end

--- A router: `router:dispatch(msg)` runs the matching command; more come
--- and go with `add` and `remove`.
export function router(defs: { [string]: Command }, opts: RouterOptions?): Router
    return SlashRouter.new(defs, opts)
end
