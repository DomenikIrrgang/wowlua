-- wowlua:table (spec stdlib "table"): the table helpers addons keep
-- rewriting: deep copies, merging defaults, deep equality, keys and values,
-- list helpers, and a stable sort with sorted-list helpers. Values the
-- addon may not read (secrets, tables whose security keeps addons out) are
-- copied as they are, never equal anything, and sort after everything
-- else: nothing here compares, indexes or walks them (that would error).
import * as secret from "wowlua:secret"

-- A deep copy of the values (keys are kept as they are) that keeps shared
-- and cyclic references shared.
local function deep(v: any, seen: { [table]: table }): any
    if type(v) ~= "table" or not secret.readable(v) then
        return v
    end
    const known = seen[v]
    if known then
        return known
    end
    const out: table = {}
    seen[v] = out
    for k, x in pairs(v) do
        out[k] = deep(x, seen)
    end
    return out
end

-- A table the addon may walk.
local function walkable(v: unknown): boolean
    return type(v) == "table" and secret.readable(v)
end

-- A deep copy of the values where every occurrence of a table becomes a
-- table of its own; `path` holds the tables being copied. A cycle gives
-- false (no copy).
local function separate(v: any, path: { [table]: boolean }): (boolean, any)
    if type(v) ~= "table" or not secret.readable(v) then
        return true, v
    end
    if path[v] then
        return false, nil
    end
    path[v] = true
    const out: table = {}
    for k, x in pairs(v) do
        local ok, copied = separate(x, path)
        if not ok then
            return false, nil
        end
        out[k] = copied
    end
    path[v] = nil
    return true, out
end

export type CopyOptions = {
    --- `false`: every occurrence of a nested table gets a table of its own
    --- (no two places of the copy share one; a cycle is an error).
    shared?: boolean,
}

--- A deep copy: nested values copied, keys kept as they are, metatables
--- dropped. Shared and cyclic references stay shared unless
--- `opts.shared` is false.
export function copy<T>(t: T, opts: CopyOptions?): T
    if opts?.shared == false then
        local ok, copied = separate(t, {})
        if not ok then
            error("copy: the table contains itself, which `shared = false` cannot copy", 2)
        end
        return copied
    end
    return deep(t, {})
end

--- A copy of the top level only.
export function shallowCopy<T extends table>(t: T): T
    if not secret.readable(t) then
        return t
    end
    const out: table = {}
    for k, v in pairs(t) do
        out[k] = v
    end
    return out :: any
end

--- Copies `source` into `target` (nested tables merged, other values
--- replaced); returns `target`.
export function merge<T extends table>(target: T, source: table): T
    if not walkable(target) or not walkable(source) then
        return target
    end
    const into: table = target
    for k, v in pairs(source) do
        if walkable(v) and walkable(into[k]) then
            merge(into[k], v)
        elseif walkable(v) then
            into[k] = copy(v)
        else
            into[k] = v
        end
    end
    return target
end

--- Fills in what `target` lacks from `defaults` (nested too); returns
--- `target`.
export function defaults<T extends table>(target: T, from: table): T
    if not walkable(target) or not walkable(from) then
        return target
    end
    const into: table = target
    for k, v in pairs(from) do
        if into[k] == nil then
            into[k] = copy(v)
        elseif walkable(v) and walkable(into[k]) then
            defaults(into[k], v)
        end
    end
    return target
end

--- Deep equality: the same keys with equal values (secrets never equal).
export function equal(a: any, b: any): boolean
    if secret.isSecret(a) or secret.isSecret(b) then
        return false
    end
    if a == b then
        return true
    end
    if not walkable(a) or not walkable(b) then
        return false
    end
    for k, v in pairs(a) do
        if not equal(v, b[k]) then
            return false
        end
    end
    for k in pairs(b) do
        if a[k] == nil then
            return false
        end
    end
    return true
end

--- The keys, sorted by `less` when given, else when they are all numbers
--- or all strings.
export function keys<K, V>(t: { [K]: V }, less: ((a: K, b: K) -> boolean)?): K[]
    const out: K[] = {}
    if not secret.readable(t) then
        return out
    end
    for k in pairs(t) do
        out[#out + 1] = k
    end
    if less then
        table.sort(out, less)
        return out
    end
    local sortable = true
    const first = type(out[1])
    for _, k in ipairs(out) do
        if type(k) ~= first or (first ~= "number" and first ~= "string") then
            sortable = false
        end
    end
    if sortable then
        table.sort(out :: any[])
    end
    return out
end

export function values<K, V>(t: { [K]: V }): V[]
    const out: V[] = {}
    if not secret.readable(t) then
        return out
    end
    for _, v in pairs(t) do
        out[#out + 1] = v
    end
    return out
end

--- How many entries (pairs, not just the array part).
export function count(t: table): number
    if not secret.readable(t) then
        return 0
    end
    local n = 0
    for _ in pairs(t) do
        n += 1
    end
    return n
end

export function isEmpty(t: table): boolean
    return not secret.readable(t) or next(t) == nil
end

export function filter<T>(list: T[], keep: (v: T, i: number) -> boolean): T[]
    const out: T[] = {}
    if not secret.readable(list) then
        return out
    end
    for i, v in ipairs(list) do
        if keep(v, i) then
            out[#out + 1] = v
        end
    end
    return out
end

export function map<T, U>(list: T[], fn: (v: T, i: number) -> U): U[]
    const out: U[] = {}
    if not secret.readable(list) then
        return out
    end
    for i, v in ipairs(list) do
        out[i] = fn(v, i)
    end
    return out
end

--- The first element `pred` accepts, and its index.
export function find<T>(list: T[], pred: (v: T, i: number) -> boolean): (T?, number?)
    if not secret.readable(list) then
        return nil, nil
    end
    for i, v in ipairs(list) do
        if pred(v, i) then
            return v, i
        end
    end
    return nil, nil
end

--- Whether `list` holds `value` (secrets are never found).
export function contains<T>(list: T[], value: T): boolean
    if secret.isSecret(value) or not secret.readable(list) then
        return false
    end
    for _, v in ipairs(list) do
        if not secret.isSecret(v) and v == value then
            return true
        end
    end
    return false
end

-- Ordering ------------------------------------------------------------------

export type Less<T> = (a: T, b: T) -> boolean

-- The default order: numbers and strings by `<`, values of different types
-- by their type's name, anything else as equal (kept in its order).
local function natural(a: any, b: any): boolean
    local ta, tb = type(a), type(b)
    if ta ~= tb then
        return ta < tb
    end
    if ta == "number" or ta == "string" then
        return a < b
    end
    return false
end

--- `less` (default: numbers and strings ascending, other values in their
--- order) behind a guard: a value the addon may not read never reaches it
--- and comes after every other value. The order `sort`, `insertSorted`,
--- `searchSorted` and `wowlua:collections`' `Heap` use.
export function order<T>(less: Less<T>?): Less<T>
    const cmp: Less<T> = less ?? natural
    return function(a: T, b: T): boolean
        if not secret.readable(a) then
            return false
        end
        if not secret.readable(b) then
            return true
        end
        return cmp(a, b)
    end
end

--- An order by `key(v)`, for `sort` and the other ordered helpers: numbers
--- and strings ascending (`descending` reverses), and values whose key is
--- nil or secret after all others, in their order.
export function by<T>(key: (v: T) -> unknown, descending: boolean?): Less<T>
    return function(a: T, b: T): boolean
        local ka, kb = key(a), key(b)
        if ka == nil or secret.isSecret(ka) then
            return false
        end
        if kb == nil or secret.isSecret(kb) then
            return true
        end
        if descending then
            return natural(kb, ka)
        end
        return natural(ka, kb)
    end
end

-- Sorts list[lo..hi] by insertion: stable, no garbage.
local function insertion<T>(list: T[], lo: number, hi: number, less: Less<T>)
    for i = lo + 1, hi do
        const v = list[i]
        local j = i - 1
        while j >= lo and less(v, list[j]) do
            list[j + 1] = list[j]
            j -= 1
        end
        list[j + 1] = v
    end
end

-- Sorts list[lo..hi] by merging (stable), short runs by insertion.
local function mergeSort<T>(list: T[], tmp: T[], lo: number, hi: number, less: Less<T>)
    if hi - lo < 12 then
        insertion(list, lo, hi, less)
        return
    end
    const mid = floor((lo + hi) / 2)
    mergeSort(list, tmp, lo, mid, less)
    mergeSort(list, tmp, mid + 1, hi, less)
    if not less(list[mid + 1], list[mid]) then
        return
    end
    for i = lo, mid do
        tmp[i] = list[i]
    end
    local i, j, k = lo, mid + 1, lo
    while i <= mid and j <= hi do
        if less(list[j], tmp[i]) then
            list[k] = list[j]
            j += 1
        else
            list[k] = tmp[i]
            i += 1
        end
        k += 1
    end
    while i <= mid do
        list[k] = tmp[i]
        i += 1
        k += 1
    end
end

--- Sorts `list` in place by `less` (default: numbers and strings
--- ascending) and returns it. Stable: equal elements keep their order. An
--- inconsistent `less` gives some order, never an error. Secret elements
--- never reach `less`; they go last, in their order (by `by`, secret keys
--- too).
export function sort<T>(list: T[], less: Less<T>?): T[]
    if not secret.readable(list) then
        return list
    end
    const n = #list
    if n > 12 then
        mergeSort(list, {}, 1, n, order(less))
    elseif n > 1 then
        insertion(list, 1, n, order(less))
    end
    return list
end

-- Where `value` belongs in `list` (sorted by `less`): before the elements
-- equal to it, or with `after`, behind them.
local function bound<T>(list: T[], value: T, less: Less<T>, after: boolean): number
    local lo, hi = 1, #list + 1
    while lo < hi do
        const mid = floor((lo + hi) / 2)
        local before: boolean
        if after then
            before = not less(value, list[mid])
        else
            before = less(list[mid], value)
        end
        if before then
            lo = mid + 1
        else
            hi = mid
        end
    end
    return lo
end

--- Inserts `value` into `list`, sorted by `less`, after the elements equal
--- to it; returns its position (0 when the addon may not read `list`). A
--- secret goes last.
export function insertSorted<T>(list: T[], value: T, less: Less<T>?): number
    if not secret.readable(list) then
        return 0
    end
    const at = bound(list, value, order(less), true)
    table.insert(list, at, value)
    return at
end

--- The position of the first element of `list` (sorted by `less`) equal to
--- `value` (neither before nor after it), or nil. Secrets are never found.
export function searchSorted<T>(list: T[], value: T, less: Less<T>?): number?
    if not secret.readable(value) or not secret.readable(list) then
        return nil
    end
    const order = order(less)
    const at = bound(list, value, order, false)
    if at <= #list and not order(value, list[at]) then
        return at
    end
    return nil
end

--- `t[k1][k2]…` through values that may not be tables: nil at the first
--- one that is not a table the addon may read (`field(frame, "ScrollBox",
--- "ScrollTarget")` for parts of the game's frames that some clients lack).
export function field(t: unknown, ...: string): unknown
    local v = t
    for i = 1, select("#", ...) do
        if not walkable(v) then
            return nil
        end
        v = (v :: { [string]: unknown })[(select(i, ...))]
    end
    return v
end

--- `v` as a list when it is a table the addon may read, else an empty one:
--- for walking a list the game gives as `unknown` (`for _, x in
--- ipairs(table.list(v))`), its elements read with `secret.asString` and
--- the like.
export function list(v: unknown): unknown[]
    if walkable(v) then
        return v :: unknown[]
    end
    return {}
end

--- The list at `t[key]`, made and stored there when `t[key]` is not a
--- table the addon may read: for adding to a list kept in a record read
--- as `unknown`, such as saved variables
--- (`table.insert(tbl.listAt(saved, "errors"), text)`).
export function listAt<K>(t: { [K]: unknown }, key: K): unknown[]
    const v = t[key]
    if walkable(v) then
        return v :: unknown[]
    end
    const made: unknown[] = {}
    t[key] = made
    return made
end

--- The record at `t[key]` (its fields `unknown`), made and stored there
--- when `t[key]` is not a table the addon may read: for filling in a
--- record kept in another (`tbl.recordAt(saved, "probe").at = date()`).
export function recordAt<K>(t: { [K]: unknown }, key: K): { [string]: unknown }
    const v = t[key]
    if walkable(v) then
        return v :: { [string]: unknown }
    end
    const made: { [string]: unknown } = {}
    t[key] = made
    return made
end

--- A table whose keys don't keep their values (`__mode = "k"`): for what
--- you note about objects you don't own, such as the game's frames, without
--- writing fields onto them. Typed by where it goes:
--- `local seen: { [Frame]: boolean } = tbl.weakKeys()`.
export function weakKeys<K, V>(): { [K]: V }
    const t: { [K]: V } = {}
    setmetatable(t, { __mode = "k" })
    return t
end

--- A table whose values may go when nothing else holds them (`__mode = "v"`).
export function weakValues<K, V>(): { [K]: V }
    const t: { [K]: V } = {}
    setmetatable(t, { __mode = "v" })
    return t
end
