-- wowlua:secret (spec stdlib "secret"): helpers for secret values (patch
-- 12.0 and WoW: Forever). A secret may be stored, passed on, concatenated,
-- formatted and handed to widgets that accept it; comparing it, doing
-- arithmetic on it or testing a secret boolean raises an error. These
-- helpers test for secrecy first, so they never do that. On clients without
-- secret values nothing is secret.

const isSecretValue = _G.issecretvalue :: ((v: unknown) -> boolean)?
const canAccessTable = _G.canaccesstable :: ((t: unknown) -> boolean)?

--- Whether `v` is a secret (narrows: `v` is then `Secret<…>`).
export function isSecret(v: unknown): v is Secret<unknown>
    return isSecretValue ~= nil and isSecretValue(v)
end

--- Whether `v` may be looked into: not a secret, and a table only when
--- addons may index it (a table's security can keep tainted code out,
--- `canaccesstable`). Code that walks tables it was handed checks this
--- before `pairs` or an index.
export function readable(v: unknown): boolean
    if isSecret(v) then
        return false
    end
    if type(v) == "table" and canAccessTable ~= nil then
        return canAccessTable(v)
    end
    return true
end

--- `v`, or `fallback` when `v` is secret or nil.
export function known<T>(v: T | Secret<T> | nil, fallback: T): T
    if isSecret(v) or v == nil then
        return fallback
    end
    return v
end

--- A yes/no answer for conditions: a secret boolean reads as `false`.
export function flag(b: boolean | Secret<boolean> | nil): boolean
    if isSecret(b) then
        return false
    end
    return b == true
end

--- An amount for widgets that accept secrets (`StatusBar:SetValue`): a
--- secret passes through, nil becomes 0.
export function amount(v: number | Secret<number> | nil): number | Secret<number>
    if isSecret(v) then
        return v
    end
    return v ?? 0
end
