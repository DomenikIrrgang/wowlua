-- wowlua:secret (spec stdlib "secret"): helpers for secret values (patch
-- 12.0 and WoW: Forever). A secret may be stored, passed on, concatenated,
-- formatted and handed to widgets that accept it; comparing it, doing
-- arithmetic on it or testing a secret boolean raises an error. These
-- helpers test for secrecy first, so they never do that. On clients without
-- secret values nothing is secret.

const isSecretValue = _G.issecretvalue :: ((v: unknown) -> boolean)?

--- Whether `v` is a secret (narrows: `v` is then `Secret<…>`).
export function isSecret(v: unknown): v is Secret<unknown>
    return isSecretValue ~= nil and isSecretValue(v)
end

--- `v`, or `fallback` when `v` is secret or nil. The fallback may be of
--- another type (`known(name, nil)` is a `string?`).
export function known<T, F>(v: T | Secret<T> | nil, fallback: F): T | F
    if isSecret(v) or v == nil then
        return fallback
    end
    return v
end

--- A yes/no answer for conditions, by truthiness (legacy 1/nil answers
--- too): a secret reads as `false`.
export function flag(v: unknown): boolean
    if isSecret(v) or not v then
        return false
    end
    return true
end

--- What `readable` narrows to: any value that is not nil or secret.
export type Plain = string | number | boolean | table | (...any) -> ...any

--- Whether `v` is present and not secret (narrows: `v` is then `Plain`).
export function readable(v: unknown): v is Plain
    return v ~= nil and not isSecret(v)
end

--- An amount for widgets that accept secrets (`StatusBar:SetValue`): a
--- secret passes through, nil becomes 0.
export function amount(v: number | Secret<number> | nil): number | Secret<number>
    if isSecret(v) then
        return v
    end
    return v ?? 0
end
