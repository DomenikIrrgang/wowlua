-- wowlua:reflect (spec §7.8): class identity (always available) and the
-- full metadata of `@reflect` classes and functions. A secret (or a table
-- addons may not index) has no class, metadata or enum member: the answers
-- are nil, false or empty.
import * as secret from "wowlua:secret"

local _, ns = ...
local wl = ns.__wowlua

--- A decorator as written: its name and its compile-time constant
--- arguments (others appear as `"<expr>"`).
export type DecoratorInfo = { name: string, args: any[] }
export type ParamInfo = { name: string, type: string, optional: boolean }
export type FieldInfo = {
    name: string,
    type: string,
    visibility: string,
    optional: boolean,
    static: boolean,
    readonly: boolean,
    hasDefault: boolean,
    decorators: DecoratorInfo[],
}
export type MethodInfo = {
    name: string,
    params: ParamInfo[],
    returns: string,
    visibility: string,
    static: boolean,
    abstract: boolean,
    overloads: string[],
    decorators: DecoratorInfo[],
}
export type PropertyInfo = {
    name: string,
    type: string,
    visibility: string,
    static: boolean,
    hasGetter: boolean,
    hasSetter: boolean,
    decorators: DecoratorInfo[],
}
export type FunctionInfo = { name: string, location: string, params: ParamInfo[], returns: string }
type ClassMeta = {
    name: string,
    decorators: DecoratorInfo[],
    fields: FieldInfo[],
    methods: MethodInfo[],
    properties: PropertyInfo[],
    interfaces: string[],
}

local function registry()
    return wl.reflect
end

local function super(cls: any): any
    return type(cls) == "table" and secret.readable(cls) and rawget(cls, "__super") or nil
end

-- `value is T`: true narrows `value` to the class.
export function isInstance<T>(value: unknown, cls: ClassOf<T>): value is T
    local check = wl.isInstance
    return check ~= nil and secret.readable(value) and secret.readable(cls) and check(value, cls)
end

export function classOf<T>(value: T): ClassOf<T>?
    local get = wl.classOf
    return get and secret.readable(value) and get(value) or nil
end

-- The class name of an instance or a class.
export function className(value: unknown): string?
    local cls = classOf(value)
    if cls == nil and type(value) == "table" and secret.readable(value) and rawget(value, "__name") then
        cls = value
    end
    return cls and rawget(cls, "__name") or nil
end

export function superclass(cls: unknown): unknown
    return super(cls)
end

export function isSubclass(cls: unknown, base: unknown): boolean
    if not (secret.readable(cls) and secret.readable(base)) then
        return false
    end
    local c = cls
    while c do
        if c == base then
            return true
        end
        c = super(c)
    end
    return false
end

-- Member names in declaration order (registered), else sorted by value.
local function order(e: any): string[]
    local reg = registry()
    local known = reg?.enums[e]
    if known then
        return known
    end
    local names: string[] = {}
    for name in pairs(e) do
        names[#names + 1] = name
    end
    table.sort(names, function(a: any, b: any): boolean
        local x, y = rawget(e, a), rawget(e, b)
        if type(x) == type(y) then
            return x < y
        end
        return tostring(x) < tostring(y)
    end)
    return names
end

export function enumName(e: unknown, value: unknown): string?
    if type(e) ~= "table" or not (secret.readable(e) and secret.readable(value)) then
        return nil
    end
    for _, name in ipairs(order(e)) do
        if rawget(e, name) == value then
            return name
        end
    end
    return nil
end

export function enumEntries<E>(e: ClassOf<E>): { name: string, value: E }[]
    local out = {}
    if not secret.readable(e) then
        return out
    end
    for _, name in ipairs(order(e)) do
        out[#out + 1] = { name = name, value = rawget(e, name) }
    end
    return out
end

-- `raw` as a member of `e`, or nil.
export function enumFrom<E>(e: ClassOf<E>, raw: unknown): E?
    if enumName(e, raw) then
        return raw :: E
    end
    return nil
end

local function meta(cls: any): ClassMeta?
    if not secret.readable(cls) then
        return nil
    end
    local reg = registry()
    -- The registry holds what the compiler generated for `@reflect` classes.
    local m = reg?.classes[cls]
    return m and m :: ClassMeta or nil
end

export function fields(cls: unknown): FieldInfo[]?
    local m = meta(cls)
    return m?.fields
end

export function methods(cls: unknown): MethodInfo[]?
    local m = meta(cls)
    return m?.methods
end

export function properties(cls: unknown): PropertyInfo[]?
    local m = meta(cls)
    return m?.properties
end

export function interfaces(cls: unknown): string[]?
    local m = meta(cls)
    return m?.interfaces
end

-- The class's decorators, or a member's.
export function decorators(cls: unknown, member: string?): DecoratorInfo[]?
    local m = meta(cls)
    if not m then
        return nil
    end
    if member == nil then
        return m.decorators
    end
    for _, entry in ipairs(m.fields) do
        if entry.name == member then
            return entry.decorators
        end
    end
    for _, entry in ipairs(m.methods) do
        if entry.name == member then
            return entry.decorators
        end
    end
    for _, entry in ipairs(m.properties) do
        if entry.name == member then
            return entry.decorators
        end
    end
    return nil
end

export function functionInfo(fn: unknown): FunctionInfo?
    if secret.isSecret(fn) then
        return nil
    end
    local reg = registry()
    local info = reg?.functions[fn]
    return info and info :: FunctionInfo or nil
end

export function getClass(name: string): unknown
    local reg = registry()
    return reg?.byName[name]
end

export function classes(): unknown[]
    local out: any[] = {}
    local reg = registry()
    if reg then
        for _, cls in pairs(reg.byName) do
            out[#out + 1] = cls
        end
    end
    return out
end
