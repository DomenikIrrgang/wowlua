-- Compiler behavior of `wowlua:events` (spec stdlib "events"): `@event`,
-- `@unitEvent` and `@bucket` register the final function value.
@intrinsic("events.event")
declare global event: any
@intrinsic("events.unitEvent")
declare global unitEvent: any
@intrinsic("events.on")
declare global on: any
@intrinsic("events.once")
declare global once: any
@intrinsic("events.onUnit")
declare global onUnit: any
@intrinsic("events.watchUnit")
declare global watchUnit: any
@intrinsic("events.offAll")
declare global offAll: any
@intrinsic("events.send")
declare global send: any
@intrinsic("events.bucket")
declare global bucket: any
@intrinsic("events.onBucket")
declare global onBucket: any
