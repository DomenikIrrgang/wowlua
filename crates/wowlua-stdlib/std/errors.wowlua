-- wowlua:errors (spec stdlib "errors"): the standard library's error policy.
-- Every function the standard library calls for user code runs isolated: an
-- error goes to `geterrorhandler()` (so BugSack and the error frame see it,
-- with the stack of the error), prefixed with the addon's name, at most once
-- per `rateLimit` seconds per message, and the caller carries on.
local addonName, ns = ...
local wl = ns.__wowlua

local rateLimit = 10
local reported = 0
local recent: { [string]: { time: number, more: number } } = {}
local listeners: { { fn: (string) -> (), active: boolean } } = {}
local notifying = false

local function now(): number
    return GetTime and GetTime() or 0
end

local function deliver(message: string)
    local handler = geterrorhandler and geterrorhandler()
    if handler then
        handler(message)
    else
        print(message)
    end
end

local function text(err: any): string
    if issecretvalue and issecretvalue(err) then
        return "<secret>"
    end
    return tostring(err)
end

--- Reports an error through the policy.
export function report(err: any, context: { [string]: any }?)
    local message = text(err)
    if message:sub(1, #addonName + 2) ~= addonName .. ": " then
        message = addonName .. ": " .. message
    end
    if wl.debug and context and context.component then
        message = message .. " [" .. tostring(context.component) .. "]"
    end
    local seen = recent[message]
    local t = now()
    if seen and t - seen.time < rateLimit then
        seen.more += 1
        return
    end
    local more = seen?.more ?? 0
    recent[message] = { time = t, more = 0 }
    reported += 1
    deliver(more > 0 and message .. " (" .. more .. " more)" or message)
    -- Listeners' own errors go straight to the handler, never back here.
    if notifying then
        return
    end
    notifying = true
    for _, l in ipairs(listeners) do
        if not l.active then
            continue
        end
        local ok, e = pcall(l.fn, message)
        if not ok then
            deliver(text(e))
        end
    end
    notifying = false
end

-- The context of the innermost isolated call, for the one error handler:
-- nothing is allocated per call. Calls nest strictly, as nothing yields
-- across `xpcall`.
local current: { [string]: any }? = nil

local function handler(e: any): any
    report(e, current)
    return e
end

-- The client's `xpcall` passes the arguments on (a recorded answer:
-- `xpcall(function(a, b) return a + b end, h, 1, 2)` is `true, 3`); plain
-- Lua 5.1's passes none, and then a closure carries them.
local passesArgs = select(2, xpcall(function(a: any) return a end, handler, true)) == true

-- The outer call's context back, and the results passed on.
local function finish(outer: { [string]: any }?, ...: any): (boolean, ...any)
    current = outer
    return ...
end

-- `fn` with its arguments, for a Lua whose `xpcall` passes none.
local function packed(fn: (...any) -> ...any, ...: any): () -> ...any
    local n = select("#", ...)
    local args = { ... }
    return function() return fn(unpack(args, 1, n)) end
end

--- Calls `fn` isolated: on error, reports it and returns `false`.
export function call(fn: (...any) -> ...any, ...: any): (boolean, ...any)
    local outer = current
    current = nil
    if passesArgs then
        return finish(outer, xpcall(fn, handler, ...))
    end
    return finish(outer, xpcall(packed(fn, ...), handler))
end

--- Calls `fn` isolated, reporting with `context` (the stdlib's handlers).
export function callIn(context: { [string]: any }, fn: (...any) -> ...any, ...: any): (boolean, ...any)
    local outer = current
    current = context
    if passesArgs then
        return finish(outer, xpcall(fn, handler, ...))
    end
    return finish(outer, xpcall(packed(fn, ...), handler))
end

--- An isolated version of `fn` (its results are dropped).
export function wrap(fn: (...any) -> ...any): (...any) -> ()
    return function(...)
        call(fn, ...)
    end
end

--- An `onError` listener (a wowlua:events `Subscription`).
export interface ErrorListener
    active: boolean
    function cancel()
end

--- Calls `fn` with every error this addon reports.
export function onError(fn: (msg: string) -> ()): ErrorListener
    local entry = { fn = fn, active = true }
    listeners[#listeners + 1] = entry
    return {
        active = true,
        cancel = function(self: ErrorListener)
            self.active = false
            entry.active = false
        end,
    }
end

export function configure(opts: { rateLimit?: number })
    if opts.rateLimit then
        rateLimit = opts.rateLimit
    end
end

--- Errors reported by this addon since it loaded.
export function count(): number
    return reported
end
