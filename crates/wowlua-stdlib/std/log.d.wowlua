-- Compiler behavior of `wowlua:log` (spec stdlib "log"): level calls below
-- the profile's log level are removed with their arguments.
@intrinsic("log.trace")
declare function trace(...: unknown)
@intrinsic("log.debug")
declare function debug(...: unknown)
@intrinsic("log.info")
declare function info(...: unknown)
@intrinsic("log.warn")
declare function warn(...: unknown)
@intrinsic("log.error")
declare function error(...: unknown)
@intrinsic("log.object")
declare global log: { trace: (...unknown) -> (), debug: (...unknown) -> (), info: (...unknown) -> (), warn: (...unknown) -> (), error: (...unknown) -> () }
