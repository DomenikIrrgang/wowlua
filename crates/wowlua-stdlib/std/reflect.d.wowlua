-- Compiler behavior of `wowlua:reflect` (spec §7.8.2): full-metadata
-- functions warn (W7010) in profiles without reflection.
@intrinsic("reflect.fields")
declare global fields: any
@intrinsic("reflect.methods")
declare global methods: any
@intrinsic("reflect.properties")
declare global properties: any
@intrinsic("reflect.decorators")
declare global decorators: any
@intrinsic("reflect.interfaces")
declare global interfaces: any
@intrinsic("reflect.functionInfo")
declare global functionInfo: any
@intrinsic("reflect.getClass")
declare global getClass: any
@intrinsic("reflect.classes")
declare global classes: any
