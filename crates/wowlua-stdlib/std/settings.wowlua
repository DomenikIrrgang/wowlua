-- wowlua:settings (spec stdlib "settings"): declarative options pages on
-- Blizzard's Settings API, bound to a wowlua:saved store. Each control is a
-- proxy setting whose getter and setter read and write the store, so
-- defaults apply and profile switches show. The category is created once
-- the store has loaded; the compiler checks the controls' keys against the
-- store's type (E8113, E8070, E8107).
import isLoaded from "wowlua:lifecycle"
import handle from "wowlua:saved"
import defer from "wowlua:combat"
import callIn from "wowlua:errors"
import print as say from "wowlua:log"

local addonName, ns = ...
local wl = ns.__wowlua

--- The registered options page.
export interface SettingsCategory
    --- The category's id (set once the page exists).
    id: any
    function open()
    --- Re-reads every control from the store.
    function refresh()
end

type Labeled = { label: string, tooltip?: string }

--- A control of an options page (made by the functions below).
export type Control =
    { kind: "header", text: string }
    | { kind: "text", text: string }
    | { kind: "checkbox", key: string, opts: Labeled }
    | {
        kind: "slider",
        key: string,
        opts: { label: string, tooltip?: string, min: number, max: number, step: number, format?: ((v: number) -> string) },
    }
    | { kind: "dropdown", key: string, opts: { label: string, tooltip?: string, options: { value: any, label: string }[] } }
    | { kind: "color", key: string, opts: { label: string, tooltip?: string, alpha?: boolean } }
    | { kind: "keybinding", key: string, opts: { label: string } }
    | { kind: "button", text: string, fn: () -> () }
    | { kind: "custom", fn: (parent: Frame) -> Frame, opts: { height?: number } }

-- Variable names of the proxy settings, unique across addons.
local prefix = "WOWLUA_" .. addonName:upper():gsub("[^A-Z0-9]", "_") .. "_"

--- A section header.
export function header(text: string): Control
    return { kind = "header", text = text }
end

--- A line of text.
export function text(content: string): Control
    return { kind = "text", text = content }
end

--- A checkbox for a `boolean` field.
export function checkbox(key: string, opts: { label: string, tooltip?: string }): Control
    return { kind = "checkbox", key = key, opts = opts }
end

--- A slider for a `number` field.
export function slider(
    key: string,
    opts: { label: string, tooltip?: string, min: number, max: number, step: number, format?: ((v: number) -> string) }
): Control
    return { kind = "slider", key = key, opts = opts }
end

--- A dropdown; its options are shown in their order.
export function dropdown(key: string, opts: { label: string, tooltip?: string, options: { value: any, label: string }[] }): Control
    return { kind = "dropdown", key = key, opts = opts }
end

--- A color swatch for a `{ r, g, b, a? }` field.
export function color(key: string, opts: { label: string, tooltip?: string, alpha?: boolean }): Control
    return { kind = "color", key = key, opts = opts }
end

--- A key binding row for the binding `name`.
export function keybinding(name: string, opts: { label: string }): Control
    return { kind = "keybinding", key = name, opts = opts }
end

--- A button.
export function button(label: string, onClick: () -> ()): Control
    return { kind = "button", text = label, fn = onClick }
end

--- An area of arbitrary UI: `factory` builds it once into the parent frame.
export function custom(factory: (parent: Frame) -> Frame, opts: { height?: number }?): Control
    return { kind = "custom", fn = factory, opts = opts or {} }
end

local registered = false
local proxies: any[] = {}
-- Variables in use: the Settings API takes each name once, and a field may
-- have several controls (on a page and its subcategory).
local variables: { [string]: boolean } = {}

local function variableFor(key: string): string
    local name = prefix .. key
    local n = 1
    while variables[name] do
        n += 1
        name = prefix .. key .. "_" .. n
    end
    variables[name] = true
    return name
end
local pendingOpen = false

-- A row of arbitrary content: `build(holder)` once, shown in its row. The
-- row is a plain frame (Blizzard's element templates need set-up of their
-- own controls), so the list's initializer does nothing to it.
local function element(layout: any, height: number, build: (holder: Frame) -> ())
    local init: any = Settings.CreateElementInitializer("Frame", { name = "" })
    local holder: Frame? = nil
    local baseInit = init.InitFrame
    local baseReset = init.Resetter
    init.GetExtent = function(): number
        return height
    end
    init.InitFrame = function(self: any, frame: any)
        baseInit(self, frame)
        if not holder then
            local created = CreateFrame("Frame")
            holder = created
            callIn({ component = "settings: custom control" }, build, created)
        end
        holder:SetParent(frame)
        holder:ClearAllPoints()
        holder:SetPoint("TOPLEFT", frame, "TOPLEFT", 0, 0)
        holder:SetPoint("BOTTOMRIGHT", frame, "BOTTOMRIGHT", 0, 0)
        holder:Show()
    end
    init.Resetter = function(self: any, frame: any)
        if holder then
            holder:Hide()
            holder:SetParent(nil)
        end
        baseReset(self, frame)
    end
    layout:AddInitializer(init)
end

type Color = { r: number, g: number, b: number, a?: number }

local function colorHex(c: Color?): string
    local value = c or { r = 1, g = 1, b = 1 }
    return CreateColor(value.r or 1, value.g or 1, value.b or 1, value.a or 1):GenerateHexColor()
end

type PageDef = {
    title: string,
    store: table,
    controls: Control[],
    subcategories?: { title: string, controls: Control[] }[],
    onChange?: ((key: string, value: any) -> ()),
}

local function addControls(def: PageDef, store: table, category: any, layout: any, controls: Control[])
    local h = handle(store)
    local function default(key: string): any
        return h.__default and h:__default(key)
    end
    local function changed(key: string, value: any)
        if def.onChange then
            callIn({ component = "settings: onChange" }, def.onChange, key, value)
        end
    end
    -- A proxy setting reading and writing `store[key]`.
    local function proxy(key: string, varType: any, label: string, default: any, get: () -> any, set: (any) -> ()): any
        local setting = Settings.RegisterProxySetting(category, variableFor(key), varType, label, default, get, set)
        proxies[#proxies + 1] = setting
        return setting
    end
    local function plain(key: string, label: string, varType: any): any
        local value = default(key)
        if value == nil then
            value = store[key]
        end
        return proxy(key, varType, label, value, function(): any
            return store[key]
        end, function(value: any)
            store[key] = value
            changed(key, value)
        end)
    end
    for _, c in ipairs(controls) do
        if c.kind == "header" then
            layout:AddInitializer(CreateSettingsListSectionHeaderInitializer(c.text))
        elseif c.kind == "text" then
            local content = c.text
            element(layout, 20, function(holder: Frame)
                local line = holder:CreateFontString(nil, "ARTWORK", "GameFontHighlightSmall")
                line:SetPoint("LEFT", holder, "LEFT", 0, 0)
                line:SetPoint("RIGHT", holder, "RIGHT", -20, 0)
                line:SetJustifyH("LEFT")
                line:SetText(content)
            end)
        elseif c.kind == "checkbox" then
            Settings.CreateCheckbox(category, plain(c.key, c.opts.label, Settings.VarType.Boolean), c.opts.tooltip)
        elseif c.kind == "slider" then
            local o = c.opts
            local options = Settings.CreateSliderOptions(o.min, o.max, o.step)
            if o.format then
                options:SetLabelFormatter(MinimalSliderWithSteppersMixin.Label.Right, o.format)
            end
            Settings.CreateSlider(category, plain(c.key, o.label, Settings.VarType.Number), options, o.tooltip)
        elseif c.kind == "dropdown" then
            local first = c.opts.options[1]
            local valueType = first and type(first.value)
            local varType = valueType == "number" and Settings.VarType.Number
                or valueType == "boolean" and Settings.VarType.Boolean
                or Settings.VarType.String
            local choices = c.opts.options
            local function options(): any
                local container = Settings.CreateControlTextContainer()
                for _, option in ipairs(choices) do
                    container:Add(option.value, option.label)
                end
                return container:GetData()
            end
            Settings.CreateDropdown(category, plain(c.key, c.opts.label, varType), options, c.opts.tooltip)
        elseif c.kind == "color" then
            local key = c.key
            local alpha = c.opts.alpha == true
            local setting = proxy(key, Settings.VarType.String, c.opts.label, colorHex(default(key)), function(): any
                return colorHex(store[key])
            end, function(hex: any)
                local picked = CreateColorFromHexString(hex)
                local value = store[key]
                value.r, value.g, value.b = picked.r, picked.g, picked.b
                if alpha then
                    value.a = picked.a
                end
                changed(key, value)
            end)
            Settings.CreateColorSwatch(category, setting, c.opts.tooltip)
        elseif c.kind == "keybinding" then
            local index: number? = nil
            local binding = c.key
            for i = 1, GetNumBindings() do
                if GetBinding(i) == binding then
                    index = i
                    break
                end
            end
            if index then
                layout:AddInitializer(CreateKeybindingEntryInitializer(index, true))
            else
                error("settings.keybinding: no binding `" .. binding .. "`", 0)
            end
        elseif c.kind == "button" then
            local onClick = c.fn
            layout:AddInitializer(CreateSettingsButtonInitializer("", c.text, function()
                callIn({ component = "settings: button" }, onClick)
            end, nil, true))
        elseif c.kind == "custom" then
            local factory = c.fn
            element(layout, c.opts.height or 100, function(holder: Frame)
                factory(holder)
            end)
        end
    end
end

local categoryId: any = nil

local function show()
    if InCombatLockdown() then
        if not pendingOpen then
            pendingOpen = true
            say("The options open once combat ends.")
            defer(function()
                pendingOpen = false
                show()
            end)
        end
        return
    end
    if categoryId ~= nil then
        Settings.OpenToCategory(categoryId)
    end
end

local page: SettingsCategory = {
    id = nil,
    open = function(_: SettingsCategory)
        show()
    end,
    refresh = function(_: SettingsCategory)
        for _, setting in ipairs(proxies) do
            setting:NotifyUpdate()
        end
    end,
}

--- Registers the addon's options page (once): created when the store has
--- loaded.
export function register(def: PageDef): SettingsCategory
    if registered then
        error("settings.register: called more than once (use subcategories)", 2)
    end
    registered = true
    local function build()
        local category, layout = Settings.RegisterVerticalLayoutCategory(def.title)
        addControls(def, def.store, category, layout, def.controls)
        for _, sub in ipairs(def.subcategories or {}) do
            local subcategory, subLayout = Settings.RegisterVerticalLayoutSubcategory(category, sub.title)
            addControls(def, def.store, subcategory, subLayout, sub.controls)
        end
        Settings.RegisterAddOnCategory(category)
        categoryId = category:GetID()
        page.id = categoryId
        -- Profile switches re-read every control.
        local profiles = handle(def.store).profiles
        if profiles then
            profiles:onChange(function() page:refresh() end)
        end
    end
    if isLoaded() then
        callIn({ component = "settings: register" }, build)
    else
        local tasks = assert(wl.lifecycleTasks)
        tasks.afterLoad[#tasks.afterLoad + 1] = build
    end
    return page
end

--- Opens the options page (once combat ends, if in combat).
export function open()
    show()
end
