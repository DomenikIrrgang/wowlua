-- wowlua:timer (spec stdlib "timer"): C_Timer's timers, plus the wrapping
-- decorators `@throttle`, `@debounce` and `@nextFrame`. Decorated methods
-- keep their state per instance (weak keys on `self`).
import callIn from "wowlua:errors"
import * as secret from "wowlua:secret"

-- The error contexts of the callbacks, made once.
local contexts = {
    after = { component = "timer: after" },
    every = { component = "timer: every" },
    nextFrame = { component = "timer: nextFrame" },
    throttle = { component = "timer: @throttle" },
    debounce = { component = "timer: @debounce" },
    repeating = { component = "timer: repeating" },
}

--- A one-shot timer; the handle has `Cancel()` and `IsCancelled()`.
export function after(sec: number, fn: () -> ()): TimerHandle
    return C_Timer.NewTimer(sec, function()
        callIn(contexts.after, fn)
    end)
end

--- A repeating timer; `fn` receives the ticker.
export function every(sec: number, fn: (ticker: TickerHandle) -> (), iterations: number?): TickerHandle
    return C_Timer.NewTicker(sec, function(ticker: TickerHandle)
        callIn(contexts.every, fn, ticker)
    end, iterations)
end

--- A repeating timer that stops and starts again (`repeating`).
export interface Repeating
    --- Starts ticking (the first tick one interval later); nothing if running.
    function start()
    function stop()
    --- `start()` when `running`, else `stop()` (a secret reads as false).
    function setRunning(running: boolean | Secret<boolean>)
    function isRunning(): boolean
end

class RepeatingTimer implements Repeating
    private readonly interval: number
    private readonly tick: () -> ()
    private ticker: TickerHandle? = nil

    constructor(sec: number, fn: () -> ())
        self.interval = sec
        self.tick = function()
            callIn(contexts.repeating, fn)
        end
    end

    function start()
        if not self.ticker then
            self.ticker = C_Timer.NewTicker(self.interval, self.tick)
        end
    end

    function stop()
        local ticker = self.ticker
        if ticker then
            self.ticker = nil
            ticker:Cancel()
        end
    end

    function setRunning(running: boolean | Secret<boolean>)
        if secret.flag(running) then
            self:start()
        else
            self:stop()
        end
    end

    function isRunning(): boolean
        return self.ticker ~= nil
    end
end

--- A repeating timer, stopped until `start` or `setRunning(true)`: a
--- `C_Timer` ticker while it runs.
export function repeating(sec: number, fn: () -> ()): Repeating
    return RepeatingTimer.new(sec, fn)
end

type Args = { [number]: any, n: number }
--- A decorated function's state (per instance for methods).
type State = { args?: Args, pending?: boolean, last?: number, scheduled?: boolean, timer?: TimerHandle }
type Fn = (...any) -> ...any

-- Per-instance state of a decorated method, or one state for a function.
local function states(ctx: DecoratorContext?): (self: any) -> State
    if ctx and ctx.kind == "method" and not ctx.static then
        local byInstance: { [any]: State } = setmetatable({}, { __mode = "k" })
        return function(self: any): State
            local s = byInstance[self]
            if not s then
                s = {}
                byInstance[self] = s
            end
            return s
        end
    end
    local single: State = {}
    return function(): State return single end
end

local function now(): number
    return GetTime and GetTime() or 0
end

local function pack(...: any): Args
    return { n = select("#", ...), ... }
end

--- Runs `fn` on the next frame.
local function defer(fn: () -> ())
    C_Timer.After(0, function()
        callIn(contexts.nextFrame, fn)
    end)
end

--- `nextFrame(fn)` runs `fn` on the next frame; as `@nextFrame`, calls in
--- one frame coalesce into one, with the last call's arguments.
export function nextFrame(fn: Fn, ctx: DecoratorContext?): Fn?
    if ctx == nil then
        defer(fn)
        return nil
    end
    local state = states(ctx)
    return function(...: any)
        local s = state((...))
        s.args = pack(...)
        if s.pending then
            return
        end
        s.pending = true
        defer(function()
            s.pending = false
            local args = assert(s.args)
            fn(unpack(args, 1, args.n))
        end)
    end
end

--- `@throttle(sec)`: the first call runs at once; later calls within `sec`
--- become one trailing call with the latest arguments.
export function throttle(sec: number)
    return function(fn: Fn, ctx: DecoratorContext?): Fn
        local state = states(ctx)
        return function(...: any)
            local s = state((...))
            local t = now()
            if not s.scheduled and (s.last == nil or t - s.last >= sec) then
                s.last = t
                fn(...)
                return
            end
            s.args = pack(...)
            if s.scheduled then
                return
            end
            s.scheduled = true
            C_Timer.After(math.max(0, (s.last ?? t) + sec - t), function()
                s.scheduled = false
                s.last = now()
                local args = assert(s.args)
                callIn(contexts.throttle, fn, unpack(args, 1, args.n))
            end)
        end
    end
end

--- `@debounce(sec)`: runs `sec` seconds after the last call, with its
--- arguments.
export function debounce(sec: number)
    return function(fn: Fn, ctx: DecoratorContext?): Fn
        local state = states(ctx)
        return function(...: any)
            local s = state((...))
            s.args = pack(...)
            if s.timer then
                s.timer:Cancel()
            end
            s.timer = C_Timer.NewTimer(sec, function()
                s.timer = nil
                local args = assert(s.args)
                callIn(contexts.debounce, fn, unpack(args, 1, args.n))
            end)
        end
    end
end
