-- wowlua:test (spec Tooling §16.1.3): tests, hooks and matchers. A test
-- file registers its tests while it loads; the test runner (`wowlua test`)
-- runs them through `ns.__wowlua.tests`, each in a coroutine so that a test
-- can wait for the game (wowlua:mock's `wait…`). Tests run tainted, like
-- the addon: nothing here compares, indexes or walks a value tests may not
-- read (a secret, a table whose security keeps addons out); a matcher that
-- needs one fails instead (spec Tooling §16.1.3).
import * as secret from "wowlua:secret"

local addonName, ns = ...
local wl = ns.__wowlua

type Fn = (...any) -> ...any

type Entry = {
    name: string,
    fn: Fn,
    file: string,
    line: number,
    test: boolean,
    skip?: string,
    only: boolean,
    flavors?: string[],
    cases?: any[],
    timeout?: number,
    --- A compile-time test (`@expectError`): checked by the compiler, never run.
    compileTime?: boolean,
}

type Job = {
    phases: Fn[],
    teardown: boolean[],
    i: number,
    co?: thread,
    failure?: { message: string, stack: string },
}

-- A failed expectation: thrown as a table, so it is told apart from errors.
type Failure = { __wowluaFailure: boolean, message: string, stack: string }

local tests: Entry[] = {}
local byFn: { [Fn]: Entry } = {}
local hooks = {
    beforeEach = {} :: Fn[],
    afterEach = {} :: Fn[],
    beforeAll = {} :: Fn[],
    afterAll = {} :: Fn[],
}
local groups: string[] = {}
local settings = { lifecycle = "auto", timeout = 10 }
local current: Entry? = nil
-- The running test's name (its case's, for a parametrized one) and how many
-- snapshots it matched.
local currentName = ""
local snapshotCount = 0

-- The wildcards an expected value may hold (`anything`, `ofType`): each
-- with its test of the actual value and its name in messages.
local wildcards: { [any]: { test: (v: any) -> boolean, name: string } } = setmetatable({}, { __mode = "k" })

local function wildcard(name: string, test: (v: any) -> boolean): any
    local w = setmetatable({}, { __tostring = function() return name end })
    wildcards[w] = { test = test, name = name }
    return w
end

--- An expected value that matches any value but `nil` (decision T261):
--- `expect(spy).toHaveBeenCalledWith(1, anything)`, `toEqual({ frame =
--- anything })`.
export const anything: any = wildcard("anything", function(v: any): boolean return v ~= nil end)

--- An expected value that matches any value of a Lua type (`"table"`,
--- `"string"`, `"function"`, …; decision T261): `ofType("table")`.
export function ofType(kind: string): any
    return wildcard(`ofType("{kind}")`, function(v: any): boolean return type(v) == kind end)
end

-- A value as messages show it: strings quoted, tables one level deep,
-- secrets as `<secret>`.
local function show(v: any, depth: number?): string
    if secret.isSecret(v) then
        return "<secret>"
    end
    local w = type(v) == "table" and wildcards[v] or nil
    if w then
        return w.name
    end
    local t = type(v)
    if t == "string" then
        return string.format("%q", v)
    elseif t ~= "table" then
        return tostring(v)
    end
    if not secret.readable(v) then
        return "<inaccessible table>"
    end
    if (depth ?? 0) >= 2 then
        return "{…}"
    end
    local parts: string[] = {}
    local n = #v
    for i = 1, n do
        parts[#parts + 1] = show(v[i], (depth ?? 0) + 1)
    end
    local keys: string[] = {}
    local named: { [string]: any } = {}
    for k, value in pairs(v) do
        if not (type(k) == "number" and k >= 1 and k <= n and k % 1 == 0) then
            local key = type(k) == "string" and k or `[{show(k, 2)}]`
            keys[#keys + 1] = key
            named[key] = value
        end
    end
    table.sort(keys)
    for _, key in ipairs(keys) do
        parts[#parts + 1] = `{key} = {show(named[key], (depth ?? 0) + 1)}`
    end
    if #parts == 0 then
        return "{}"
    end
    return "{ " .. table.concat(parts, ", ") .. " }"
end

-- A name or reason given to the runner: a secret one reads as `<secret>`.
local function label(v: any): any
    return secret.isSecret(v) and "<secret>" or v
end

local function entry(fn: Fn, ctx: DecoratorContext?): Entry
    local e = byFn[fn]
    if e == nil then
        local prefix = #groups > 0 and table.concat(groups, " › ") .. " › " or ""
        e = {
            name = prefix .. (ctx and ctx.name or "test"),
            fn = fn,
            file = ctx and ctx.file or "?",
            line = ctx and ctx.line or 0,
            test = false,
            only = false,
        }
        byFn[fn] = e
        tests[#tests + 1] = e
    end
    return e
end

-- A decorator that is used bare (`@skip`) or called (`@skip("why")`).
local function decorator(apply: (e: Entry, arg: any) -> ()): any
    return function(a: any, ctx: any): any
        if type(a) == "function" then
            apply(entry(a, ctx), nil)
            return nil
        end
        return function(fn: Fn, c: DecoratorContext?)
            apply(entry(fn, c), a)
        end
    end
end

--- `@test(name?, opts?)`: marks a test function; the name defaults to the
--- function's. `opts.timeout`: how long its waits may take (virtual
--- seconds).
export function test(name: any?, opts: any?): any
    local function mark(fn: Fn, ctx: DecoratorContext?)
        local e = entry(fn, ctx)
        e.test = true
        if type(name) == "string" then
            local prefix = #groups > 0 and table.concat(groups, " › ") .. " › " or ""
            e.name = prefix .. label(name)
        end
        if type(opts) == "table" and type(opts.timeout) == "number" then
            e.timeout = opts.timeout
        end
    end
    if type(name) == "function" then
        mark(name, opts)
        return nil
    end
    return mark
end

--- `@skip(reason?)`: the test is reported as skipped.
export const skip: any = decorator(function(e: Entry, reason: any)
    e.skip = type(reason) == "string" and label(reason) or ""
end)

--- `@only`: in a file with `@only` tests, only they run.
export const only: any = decorator(function(e: Entry, _: any)
    e.only = true
end)

--- `@flavors("standard", …)`: the test runs only for these flavors.
export function flavors(...: string): any
    local list = { ... }
    return function(fn: Fn, ctx: DecoratorContext?)
        entry(fn, ctx).flavors = list
    end
end

--- `@cases(list)`: the test runs once per case, the case's values as its
--- arguments (decision T215). A case may be or hold secrets (passed on as
--- they are); the list itself may not.
export function cases(list: any[]): any
    if not secret.readable(list) then
        error("@cases: the list of cases is a secret value", 2)
    end
    return function(fn: Fn, ctx: DecoratorContext?)
        entry(fn, ctx).cases = list
    end
end

--- `@expectError("E2001", …)`: a compile-time test (decision T219). The
--- function must not compile, with exactly these diagnostics; the compiler
--- checks it (E8122 otherwise), and it is never run.
export function expectError(...: string): any
    return function(fn: Fn, ctx: DecoratorContext?)
        local e = entry(fn, ctx)
        e.test = true
        e.compileTime = true
    end
end

local function hook(kind: string): any
    return function(fn: Fn, _: DecoratorContext?)
        local list = (hooks :: any)[kind] :: Fn[]
        list[#list + 1] = fn
    end
end

--- `@beforeEach`, `@afterEach`: run around every test of the file.
export const beforeEach: any = hook("beforeEach")
export const afterEach: any = hook("afterEach")
--- `@beforeAll`, `@afterAll`: run once, before the first and after the
--- last test of the file.
export const beforeAll: any = hook("beforeAll")
export const afterAll: any = hook("afterAll")

--- Per-file runner settings: `lifecycle = "manual"` leaves logging in to
--- the file (`mock.login()`); `timeout`: how long waits may take (virtual
--- seconds, 10 by default); `profile`: the world profile the file starts
--- in (`tests/profiles/<name>.json`); `platform`: the machine the client
--- runs on, `"mac"` (the default) or `"windows"`; `screen`: the screen it
--- draws on, its pixels, DPI scale and the UI scale with "Use UI Scale"
--- on (the recorded Mac's 1920 x 1080 by default; all three read before
--- anything loads, as literals).
export function config(opts: {
    lifecycle?: "auto" | "manual",
    timeout?: number,
    profile?: string,
    platform?: "mac" | "windows",
    screen?: { width: number, height: number, dpiScale?: number, uiScale?: number },
})
    if opts.lifecycle then
        settings.lifecycle = opts.lifecycle
    end
    if opts.timeout then
        settings.timeout = opts.timeout
    end
end

--- Groups the tests `fn` defines at run time (`test(name)(fn)` inside it).
export function describe(name: string, fn: () -> ())
    groups[#groups + 1] = label(name)
    local ok, err = pcall(fn)
    table.remove(groups)
    if not ok then
        error(err, 0)
    end
end

-- -------------------------------------------------------------- matchers

local function fail(message: string, level: number?)
    -- A message made from a secret is secret: the runner could not show it.
    if secret.isSecret(message) then
        message = "the expectation failed; its message is a secret value"
    end
    local failure: Failure = {
        __wowluaFailure = true,
        message = message,
        stack = debugstack and debugstack((level ?? 1) + 2, 1, 0) or "",
    }
    error(failure, 0)
end

-- `a == b` where a secret may be involved: as tainted code may tell, values
-- of different types differ and two nils are equal; two secrets are the
-- same when the values inside them are (the test runner looks, as the
-- addon cannot: `mock.secret(true)` matches the secret handed on);
-- otherwise nil (unknown).
local function same(a: any, b: any): boolean?
    if secret.isSecret(a) or secret.isSecret(b) then
        local t = type(a)
        if t ~= type(b) then
            return false
        end
        if t == "nil" then
            return true
        end
        local engine = wl.mockEngine
        if engine and secret.isSecret(a) and secret.isSecret(b) then
            return engine.sameSecret(a, b)
        end
        return nil
    end
    return a == b
end

-- Both checks passed: false when one failed, else nil when one is unknown.
local function both(a: boolean?, b: boolean?): boolean?
    if a == false or b == false then
        return false
    end
    return a and b
end

-- Deep equality; nil (unknown) when it turns on a value tests may not read
-- (a secret of the other's type, a table addons may not index). `b` is the
-- expected value: a wildcard in it tests `a` instead.
local function deepEqual(a: any, b: any, seen: { [any]: any }): boolean?
    local w = type(b) == "table" and not secret.isSecret(b) and wildcards[b] or nil
    if w then
        return w.test(a)
    end
    if secret.isSecret(a) or secret.isSecret(b) then
        return same(a, b)
    end
    if a == b then
        return true
    end
    if type(a) ~= "table" or type(b) ~= "table" then
        -- NaN equals NaN in expectations.
        return type(a) == "number" and type(b) == "number" and a ~= a and b ~= b
    end
    if not secret.readable(a) or not secret.readable(b) then
        return nil
    end
    if seen[a] == b then
        return true
    end
    seen[a] = b
    local result: boolean? = true
    for k, v in pairs(a) do
        result = both(result, deepEqual(v, rawget(b, k), seen))
        if result == false then
            return false
        end
    end
    for k, _ in pairs(b) do
        if rawget(a, k) == nil then
            return false
        end
    end
    return result
end

local function lengthOf(v: any): number?
    if type(v) == "string" or type(v) == "table" then
        return #v
    end
    return nil
end

local function isInstance(v: any, cls: any): boolean
    if wl.isInstance then
        return wl.isInstance(v, cls)
    end
    local mt = type(v) == "table" and getmetatable(v)
    while mt do
        if mt == cls or rawget(mt, "__index") == cls then
            return true
        end
        mt = getmetatable(mt)
    end
    return false
end

-- A spy's calls (wowlua:mock's spies keep them here, by spy).
local function callsOf(v: any): any[]?
    local spies = wl.spies
    return spies and spies[v]
end

local function sameArgs(call: any, args: any): boolean?
    if call.n ~= args.n then
        return false
    end
    local result: boolean? = true
    for i = 1, args.n do
        result = both(result, deepEqual(call[i], args[i], {}))
    end
    return result
end

local function showArgs(args: any): string
    local parts: string[] = {}
    for i = 1, args.n do
        parts[i] = show(args[i])
    end
    return "(" .. table.concat(parts, ", ") .. ")"
end

--- What `expect(value)` checks (decision T214): matchers are called with a
--- dot (`expect(x).toBe(y)`); `never` holds the negated ones. Tests run
--- tainted, like the addon: a matcher whose answer needs a secret's value
--- fails, negated or not, saying so (a secret differs from a value of
--- another type, and two secrets compare by the values inside them;
--- `toBeNil`, `toBeSecret`, snapshots and the truth of a secret that is
--- not a boolean need no value).
export type Expect<T> = {
    --- The same value (`==`).
    toBe: (expected: T) -> (),
    --- An equal value: tables compared key by key, deeply.
    toEqual: (expected: T) -> (),
    toBeNil: () -> (),
    toBeTruthy: () -> (),
    toBeFalsy: () -> (),
    --- An instance of a class (or one of its subclasses).
    toBeInstanceOf: (cls: any) -> (),
    --- A string containing `item` (plainly), or a table with `item` as a
    --- value.
    toContain: (item: any) -> (),
    --- `#value` (a string or a table).
    toHaveLength: (n: number) -> (),
    --- A number within `10^-digits / 2` of `n` (`digits`: 2).
    toBeCloseTo: (n: number, digits: number?) -> (),
    --- A function that raises an error (containing `text`, when given).
    toThrow: (text: string?) -> (),
    --- A spy (wowlua:mock) that was called.
    toHaveBeenCalled: () -> (),
    --- A spy called `n` times.
    toHaveBeenCalledTimes: (n: number) -> (),
    --- A spy called with these arguments (compared deeply) at least once.
    toHaveBeenCalledWith: (...any) -> (),
    --- A widget that is shown (`IsShown`), or visible: shown with every
    --- parent (`IsVisible`) (decision T217).
    toBeShown: () -> (),
    toBeVisible: () -> (),
    --- A font string's, edit box's or button's text, or that of a frame's
    --- only font string.
    toHaveText: (text: string) -> (),
    --- A widget's size (within 0.01).
    toHaveSize: (width: number, height: number) -> (),
    --- A widget with a point on `other` (and these points, when given).
    toBeAnchoredTo: (other: any, point: string?, relativePoint: string?) -> (),
    --- A tooltip's lines: each the left text, or `{ left, right }`.
    toHaveLines: (lines: any[]) -> (),
    --- A function whose protected action the client refuses because of
    --- taint (spec Tooling §16.1.4).
    toBeBlocked: () -> (),
    --- An untainted variable: a global by name (`expect("MyGlobal")`), or a
    --- table's field (`expect(t).toBeSecure("key")`), as
    --- `issecurevariable` tells.
    toBeSecure: (key: any?) -> (),
    --- The value's text matches the stored snapshot (decision T218);
    --- `name` tells several of a test apart (else they are numbered).
    toMatchSnapshot: (name: string?) -> (),
    --- A secret value (`issecretvalue`).
    toBeSecret: () -> (),
    --- The frame's image (`mock.screen`: the whole screen's) matches the
    --- stored `__screenshots__/<test file>/<test>-<name>.png`: at most
    --- `maxDiffRatio` (0.001) of its pixels differ by more than
    --- `threshold` (0.1); a missing one is written, `wowlua test -u`
    --- updates it (decision T315).
    toMatchScreenshot: (name: string?, options: { threshold: number?, maxDiffRatio: number? }?) -> (),
    --- The negated matchers: `expect(x).never.toBe(y)`.
    never: Expect<T>,
}

local function widgetText(w: any): any
    if type(w.GetText) == "function" then
        return w:GetText()
    end
    if type(w.GetRegions) == "function" then
        local found: any = nil
        for _, r in ipairs({ w:GetRegions() }) do
            if r.GetObjectType and r:GetObjectType() == "FontString" then
                if found then
                    return nil
                end
                found = r
            end
        end
        return found and found:GetText()
    end
    return nil
end

-- A number as snapshots show it: at most two decimals.
local function shortNumber(n: number): string
    if secret.isSecret(n) then
        return "<secret>"
    end
    if n == math.floor(n) and math.abs(n) < 1e15 then
        return string.format("%d", n)
    end
    local s = string.format("%.2f", n):gsub("0+$", ""):gsub("%.$", "")
    return s
end

local function isWidget(v: any): boolean
    return type(v) == "table" and secret.readable(v) and type(v.GetObjectType) == "function"
end

-- A widget's name in a snapshot.
local function widgetLabel(w: any, from: any): string
    if w == nil then
        return "nil"
    end
    local name = w.GetName and w:GetName()
    if name then
        return name
    end
    if from and from.GetParent and w == from:GetParent() then
        return "$parent"
    end
    return "<" .. (w.GetObjectType and w:GetObjectType() or "?") .. ">"
end

-- A value's text for snapshots: tables with their keys sorted, widgets as
-- their tree (shown, size, points, text, then regions and children);
-- secrets as `<secret>`.
local function serialize(v: any, indent: string, seen: { [any]: boolean }): string
    if secret.isSecret(v) then
        return "<secret>"
    end
    local t = type(v)
    if t == "string" then
        return string.format("%q", v)
    elseif t == "number" then
        return shortNumber(v)
    elseif t ~= "table" then
        return t == "function" and "<function>" or tostring(v)
    end
    if not secret.readable(v) then
        return "<inaccessible table>"
    end
    if seen[v] then
        return "<cycle>"
    end
    seen[v] = true
    local inner = indent .. "  "
    local lines: string[] = {}
    if isWidget(v) then
        local head = v:GetObjectType() .. " " .. widgetLabel(v, nil)
        if v.IsShown then
            lines[#lines + 1] = inner .. (v:IsShown() and "shown" or "hidden")
        end
        if v.GetSize then
            local w, h = v:GetSize()
            lines[#lines + 1] = `{inner}size {shortNumber(w)} x {shortNumber(h)}`
        end
        if v.GetNumPoints then
            for i = 1, v:GetNumPoints() do
                local p, rel, rp, x, y = v:GetPoint(i)
                lines[#lines + 1] = `{inner}{p} on {widgetLabel(rel, v)} {rp} ({shortNumber(x or 0)}, {shortNumber(y or 0)})`
            end
        end
        local text = widgetText(v)
        if text ~= nil then
            lines[#lines + 1] = inner .. "text " .. serialize(text, inner, seen)
        end
        local kids: any[] = {}
        if v.GetRegions then
            for _, r in ipairs({ v:GetRegions() }) do
                kids[#kids + 1] = r
            end
        end
        if v.GetChildren then
            for _, c in ipairs({ v:GetChildren() }) do
                kids[#kids + 1] = c
            end
        end
        for _, k in ipairs(kids) do
            lines[#lines + 1] = inner .. serialize(k, inner, seen)
        end
        seen[v] = nil
        return head .. (#lines > 0 and "\n" .. table.concat(lines, "\n") or "")
    end
    local keys: any[] = {}
    for k in pairs(v) do
        keys[#keys + 1] = k
    end
    table.sort(keys, function(a: any, b: any): boolean
        local ta, tb = type(a), type(b)
        if ta ~= tb then
            return ta == "number"
        end
        if ta == "number" or ta == "string" then
            return a < b
        end
        return tostring(a) < tostring(b)
    end)
    local n = #v
    for _, k in ipairs(keys) do
        local key = ""
        if not (type(k) == "number" and k >= 1 and k <= n and k % 1 == 0) then
            key = (type(k) == "string" and k:match("^[%a_][%w_]*$")) and k .. " = " or `[{serialize(k, inner, seen)}] = `
        end
        lines[#lines + 1] = inner .. key .. serialize(v[k], inner, seen) .. ","
    end
    seen[v] = nil
    if #lines == 0 then
        return "{}"
    end
    return "{\n" .. table.concat(lines, "\n") .. "\n" .. indent .. "}"
end

-- Custom matchers (decision T220), by name.
local custom: { [string]: Fn } = {}

local function tooltipLines(tip: any): { left: string?, right: string? }[]
    local lines: { left: string?, right: string? }[] = {}
    local name = tip.GetName and tip:GetName()
    if not name or not tip.NumLines then
        return lines
    end
    for i = 1, tip:NumLines() do
        local left = _G[`{name}TextLeft{i}`]
        local right = _G[`{name}TextRight{i}`]
        local r = right and right:IsShown() and right:GetText() or nil
        lines[i] = { left = left and left:GetText(), right = r }
    end
    return lines
end

-- The matchers that take a secret value, and those that take secret
-- arguments; the others fail on one (they would need its value).
local secretValues = { toBe = true, toEqual = true, toBeNil = true, toBeTruthy = true, toBeFalsy = true, toBeSecret = true, toMatchSnapshot = true }
local secretArgs = { toBe = true, toEqual = true, toContain = true, toHaveBeenCalledWith = true }
const tainted = " (tests run tainted, like the addon)"

-- The matchers on a value: `negated` flips each check.
local function matchers(value: any, negated: boolean): any
    -- `pass` nil: the answer needs a secret's value, so it fails either way.
    local function check(pass: boolean?, message: string, opposite: string)
        if pass == nil then
            fail(`{negated and opposite or message}: cannot tell with a secret value{tainted}`, 3)
        elseif pass == negated then
            fail(negated and opposite or message, 3)
        end
    end
    local function calls(): any[]
        local list = callsOf(value)
        if list == nil then
            fail(`expected a spy (mock.spy), got {show(value)}`, 4)
        end
        return list :: any[]
    end
    local m: any = {}
    function m.toBe(expected: any)
        check(same(value, expected), `expected {show(value)} to be {show(expected)}`, `expected {show(value)} not to be {show(expected)}`)
    end
    function m.toEqual(expected: any)
        check(deepEqual(value, expected, {}), `expected {show(value)} to equal {show(expected)}`, `expected {show(value)} not to equal {show(expected)}`)
    end
    function m.toBeNil()
        check(value == nil, `expected {show(value)} to be nil`, "expected a value, got nil")
    end
    -- A secret boolean's truth is its value; other secrets are truthy.
    local function truthy(): boolean?
        if secret.isSecret(value) and type(value) == "boolean" then
            return nil
        end
        return not not value
    end
    function m.toBeTruthy()
        check(truthy(), `expected {show(value)} to be truthy`, `expected {show(value)} to be falsy`)
    end
    function m.toBeFalsy()
        local t = truthy()
        local falsy: boolean? = nil
        if t ~= nil then
            falsy = not t
        end
        check(falsy, `expected {show(value)} to be falsy`, `expected {show(value)} to be truthy`)
    end
    function m.toBeSecret()
        check(secret.isSecret(value), `expected {show(value)} to be a secret value`, "expected a value that is not secret, got <secret>")
    end
    function m.toBeInstanceOf(cls: any)
        check(isInstance(value, cls), `expected {show(value)} to be an instance of the class`, `expected {show(value)} not to be an instance of the class`)
    end
    function m.toContain(item: any)
        local found: boolean? = false
        if type(value) == "string" then
            if type(item) ~= "string" then
                found = false
            elseif secret.isSecret(item) then
                found = nil
            else
                found = value:find(item, 1, true) ~= nil
            end
        elseif type(value) == "table" then
            if not secret.readable(value) then
                found = nil
            else
                for _, x in pairs(value) do
                    local eq = deepEqual(x, item, {})
                    if eq then
                        found = true
                        break
                    elseif eq == nil then
                        found = nil
                    end
                end
            end
        else
            fail(`toContain needs a string or a table, got {show(value)}`, 2)
        end
        check(found, `expected {show(value)} to contain {show(item)}`, `expected {show(value)} not to contain {show(item)}`)
    end
    function m.toHaveLength(n: number)
        if type(value) == "table" and not secret.readable(value) then
            check(nil, `expected length {n}, got {show(value)}`, `expected a length other than {n}`)
        end
        local len = lengthOf(value)
        if len == nil then
            fail(`toHaveLength needs a string or a table, got {show(value)}`, 2)
        end
        check(len == n, `expected length {n}, got {show(len)}`, `expected a length other than {n}`)
    end
    function m.toBeCloseTo(n: number, digits: number?)
        local tolerance = 10 ^ -(digits ?? 2) / 2
        local pass = type(value) == "number" and math.abs(value - n) < tolerance
        check(pass, `expected {show(value)} to be close to {n}`, `expected {show(value)} not to be close to {n}`)
    end
    function m.toThrow(text: string?)
        if type(value) ~= "function" then
            fail(`toThrow needs a function, got {show(value)}`, 2)
        end
        local ok, err = pcall(value)
        local message: any = nil
        if not secret.isSecret(err) then
            message = type(err) == "table" and secret.readable(err) and err.__wowluaFailure and err.message or tostring(err)
        end
        local pass: boolean? = not ok
        if not ok and text ~= nil then
            -- A secret error's text cannot be searched.
            if message == nil or secret.isSecret(message) then
                pass = nil
            else
                pass = message:find(text, 1, true) ~= nil
            end
        end
        local wanted = text and ` containing {show(text)}` or ""
        local got = ok and "it did not" or `it raised {show(message ?? err)}`
        check(pass, `expected an error{wanted}; {got}`, `expected no error{wanted}; {got}`)
    end
    function m.toHaveBeenCalled()
        local list = calls()
        check(#list > 0, "expected the spy to have been called", `expected the spy not to have been called; it was called {#list} times`)
    end
    function m.toHaveBeenCalledTimes(n: number)
        local list = calls()
        check(#list == n, `expected {n} calls, got {#list}`, `expected a number of calls other than {n}`)
    end
    -- The widget matchers need a widget, negated or not.
    local function widget(method: string)
        if type(value) ~= "table" or not secret.readable(value) or type(value[method]) ~= "function" then
            fail(`expected a frame, got {show(value)}`, 3)
        end
    end
    function m.toBeShown()
        widget("IsShown")
        check(value:IsShown() == true, `expected {show(value)} to be shown`, `expected {show(value)} to be hidden`)
    end
    function m.toBeVisible()
        widget("IsVisible")
        check(value:IsVisible() == true, `expected {show(value)} to be visible`, `expected {show(value)} not to be visible`)
    end
    function m.toHaveText(text: string)
        local got = widgetText(value)
        check(same(got, text), `expected the text {show(text)}, got {show(got)}`, `expected a text other than {show(text)}`)
    end
    function m.toHaveSize(width: number, height: number)
        widget("GetSize")
        local w, h = value:GetSize()
        local pass: boolean? = nil
        if not secret.isSecret(w) and not secret.isSecret(h) then
            pass = math.abs(w - width) < 0.01 and math.abs(h - height) < 0.01
        end
        check(pass, `expected the size {width} x {height}, got {show(w)} x {show(h)}`, `expected a size other than {width} x {height}`)
    end
    function m.toBeAnchoredTo(other: any, point: string?, relativePoint: string?)
        widget("GetNumPoints")
        local found = false
        local points: string[] = {}
        for i = 1, value:GetNumPoints() do
            local p, rel, rp = value:GetPoint(i)
            points[#points + 1] = `{p} on {show(rel)} {rp}`
            if rel == other and (point == nil or p == point) and (relativePoint == nil or rp == relativePoint) then
                found = true
            end
        end
        local which = (point or "a point") .. (relativePoint and ` to {relativePoint}` or "")
        local got = #points > 0 and table.concat(points, ", ") or "no points"
        check(found, `expected {which} on {show(other)}; it has {got}`, `expected no {which} on {show(other)}`)
    end
    function m.toHaveLines(lines: any[])
        local got = tooltipLines(value)
        local pass: boolean? = #got == #lines
        for i, want in ipairs(lines) do
            local line = got[i]
            if line == nil then
                pass = false
            elseif type(want) == "table" then
                pass = both(pass, both(same(line.left, want[1]), same(line.right, want[2])))
            else
                pass = both(pass, same(line.left, want))
            end
        end
        local shown: string[] = {}
        for i, line in ipairs(got) do
            shown[i] = line.right and `{show(line.left)} | {show(line.right)}` or show(line.left)
        end
        local text = #shown > 0 and table.concat(shown, "; ") or "none"
        check(pass, `expected the lines {show(lines)}; got {text}`, "expected other lines")
    end
    function m.toBeBlocked()
        local engine = wl.mockEngine
        if engine == nil then
            fail("toBeBlocked needs `wowlua test`", 2)
        end
        local before = #engine.refusals()
        pcall(value)
        local after = engine.refusals()
        local actions: string[] = {}
        for i = before + 1, #after do
            actions[#actions + 1] = after[i].action
        end
        local got = #actions > 0 and table.concat(actions, ", ") or "nothing"
        check(#after > before, `expected a protected action to be refused; refused: {got}`, `expected no protected action to be refused; refused: {got}`)
    end
    function m.toBeSecure(key: any?)
        local secure, taint = false, nil
        if key == nil then
            secure, taint = issecurevariable(value)
        else
            secure, taint = issecurevariable(value, key)
        end
        local what = key == nil and show(value) or `the field {show(key)}`
        check(secure, `expected {what} to be secure; {taint ?? "an addon"} tainted it`, `expected {what} to be tainted`)
    end
    function m.toMatchScreenshot(name: string?, options: { threshold: number?, maxDiffRatio: number? }?)
        if negated then
            fail("toMatchScreenshot cannot be negated", 2)
        end
        local engine = wl.mockEngine
        if engine == nil then
            fail("screenshots need `wowlua test`", 2)
        end
        snapshotCount = snapshotCount + 1
        local pass = (wl.reloads ?? 0) > 0 and ` (after reload {wl.reloads})` or ""
        local key = currentName .. pass .. " " .. (name ?? tostring(snapshotCount))
        local frame: any = value
        if type(value) == "table" and (value :: any).__wowluaScreen == true then
            frame = nil
        end
        local same, why = engine.screenshotMatch(key, frame, options and options.threshold, options and options.maxDiffRatio)
        if not same then
            fail(why, 2)
        end
    end
    function m.toMatchSnapshot(name: string?)
        if negated then
            fail("toMatchSnapshot cannot be negated", 2)
        end
        local engine = wl.mockEngine
        if engine == nil then
            fail("snapshots need `wowlua test`", 2)
        end
        snapshotCount = snapshotCount + 1
        -- A pass after `mock.reloadUI` has its own snapshots.
        local pass = (wl.reloads ?? 0) > 0 and ` (after reload {wl.reloads})` or ""
        local key = currentName .. pass .. " › " .. (name ?? tostring(snapshotCount))
        local same, diff = engine.snapshot(key, serialize(value, "", {}))
        if not same then
            fail(`the snapshot "{key}" differs (- stored, + now; wowlua test -u updates it):\n{diff}`, 2)
        end
    end
    for name, fn in pairs(custom) do
        m[name] = function(...: any)
            local pass, message, opposite = fn(value, ...)
            if secret.isSecret(pass) then
                fail(`the matcher {name} answered with a secret value`, 2)
            end
            check(pass == true, message ?? `expected {show(value)} to pass {name}`, opposite ?? `expected {show(value)} not to pass {name}`)
        end
    end
    function m.toHaveBeenCalledWith(...: any)
        local list = calls()
        local args = { n = select("#", ...), ... }
        local found: boolean? = false
        for _, call in ipairs(list) do
            local eq = sameArgs(call, args)
            if eq then
                found = true
                break
            elseif eq == nil then
                found = nil
            end
        end
        local seen: string[] = {}
        for i, call in ipairs(list) do
            seen[i] = showArgs(call)
        end
        local got = #seen > 0 and "its calls: " .. table.concat(seen, ", ") or "it was not called"
        check(found, `expected a call with {showArgs(args)}; {got}`, `expected no call with {showArgs(args)}`)
    end
    -- The value or an argument is a secret a built-in matcher cannot take:
    -- it fails (custom matchers get secrets as they are). Every matcher is
    -- wrapped, so the failures' levels above count this call.
    for name, fn in pairs(m) do
        m[name] = function(...: any)
            local why: string? = nil
            if custom[name] == nil and not secretValues[name] and secret.isSecret(value) then
                why = "received a secret value"
            elseif custom[name] == nil and not secretArgs[name] then
                for i = 1, select("#", ...) do
                    if secret.isSecret((select(i, ...))) then
                        why = "an argument is a secret value"
                    end
                end
            end
            if why then
                fail(`{name}: {why}, which it cannot read{tainted}`, 1)
            end
            return fn(...)
        end
    end
    return m
end

--- Defines a matcher (decision T220): `fn(actual, ...)` returns whether
--- it passed, the message, and the negated one; `expect(x).name(...)` runs
--- it, checked against `fn`'s signature. Export it under the same name:
--- `export const toBeEven = matcher("toBeEven", function(n: number) … end)`.
export function matcher<F>(name: string, fn: F): F
    if (matchers(nil, false) :: any)[name] ~= nil then
        error(`matcher: {name} is a matcher of wowlua:test`, 2)
    end
    custom[name] = fn :: any
    return fn
end

--- Expectations on `value`.
export function expect<T>(value: T): Expect<T>
    local m = matchers(value, false)
    m.never = matchers(value, true)
    return m :: Expect<T>
end

-- ---------------------------------------------------------------- runner

local function selected(e: Entry, flavor: string): boolean
    if not e.flavors then
        return true
    end
    for _, f in ipairs(e.flavors :: string[]) do
        if f == flavor then
            return true
        end
    end
    return false
end

local function failureOf(err: any, co: thread): { message: string, stack: string }
    if type(err) == "table" and secret.readable(err) and err.__wowluaFailure then
        return { message = err.message, stack = err.stack }
    end
    local stack = debugstack and debugstack(co, 0, 12, 0) or ""
    local message = tostring(err)
    if secret.isSecret(message) then
        message = "the test raised a secret value as its error"
    end
    return { message = message, stack = stack }
end

-- Whether a resumed test raised or yielded `token` (a secret is no token).
local function isToken(v: any, token: any): boolean
    return not secret.isSecret(v) and v ~= nil and v == token
end

local function hookPhases(kind: string): Fn[]
    local out: Fn[] = {}
    for _, h in ipairs((hooks :: any)[kind] :: Fn[]) do
        out[#out + 1] = h
    end
    return out
end

-- The runner's side (`ns.__wowlua.tests`): the registered tests, and jobs
-- (a test with its hooks, or a file's hook) stepped until they finish or
-- wait for the game.
wl.tests = {
    settings = settings,
    show = show,
    count = function(): number
        local n = 0
        for _, e in ipairs(tests) do
            if e.test then
                n = n + 1
            end
        end
        return n
    end,
    -- The i-th test: name, file, line, skip reason, only, whether the
    -- flavor runs it, and its number of cases.
    info = function(i: number, flavor: string): (string, string, number, string?, boolean, boolean, number)
        local n = 0
        for _, e in ipairs(tests) do
            if e.test then
                n = n + 1
                if n == i then
                    return e.name, e.file, e.line, e.skip, e.only, selected(e, flavor), e.cases and #(e.cases :: any[]) or 0
                end
            end
        end
        error("no test " .. i)
    end,
    caseName = function(i: number, c: number): string
        local n = 0
        for _, e in ipairs(tests) do
            if e.test then
                n = n + 1
                if n == i then
                    local case: any = (e.cases :: any[])[c]
                    local list = type(case) == "table" and secret.readable(case)
                    return e.name .. " " .. (list and show(case):gsub("^{ ", "["):gsub(" }$", "]") or show(case))
                end
            end
        end
        return "?"
    end,
    -- A job: "test" (with its hooks; case `c` of a parametrized one), or a
    -- file hook ("beforeAll", "afterAll").
    start = function(kind: string, i: number?, c: number?): Job
        local job: Job = { phases = {}, teardown = {}, i = 1 }
        local function add(fn: Fn, teardown: boolean)
            job.phases[#job.phases + 1] = fn
            job.teardown[#job.teardown + 1] = teardown
        end
        if kind ~= "test" then
            for _, h in ipairs(hookPhases(kind)) do
                add(h, kind == "afterAll")
            end
            return job
        end
        local n = 0
        local target: Entry? = nil
        for _, e in ipairs(tests) do
            if e.test then
                n = n + 1
                if n == i then
                    target = e
                end
            end
        end
        local e = target :: Entry
        -- The compiler checked a compile-time test; nothing runs.
        if e.compileTime then
            return job
        end
        for _, h in ipairs(hookPhases("beforeEach")) do
            add(h, false)
        end
        add(function()
            current = e
            snapshotCount = 0
            currentName = c and wl.tests.caseName(i :: number, c) or e.name
            if e.compileTime then
                return
            end
            local case: any = c and (e.cases :: any[])[c]
            -- A secret case (or one tests may not read) is one argument.
            if type(case) == "table" and secret.readable(case) then
                local list = case :: any[]
                e.fn(unpack(list, 1, (case :: any).n or #list))
            elseif c then
                e.fn(case)
            else
                e.fn()
            end
        end, false)
        for _, h in ipairs(hookPhases("afterEach")) do
            add(h, true)
        end
        for _, h in ipairs(wl.afterTest ?? {}) do
            add(h, true)
        end
        add(function()
            current = nil
        end, true)
        return job
    end,
    -- Runs a job until it finishes ("pass", or "fail" with the message and
    -- stack) or waits ("wait", "seconds" | "frames" | "reload", amount).
    step = function(job: Job): (string, any, any)
        while job.i <= #job.phases do
            if job.co == nil then
                if job.failure and not job.teardown[job.i] then
                    job.i = job.i + 1
                    continue
                end
                job.co = coroutine.create(job.phases[job.i])
            end
            local co = job.co :: thread
            local ok, a, b, c = coroutine.resume(co)
            if not ok and isToken(a, wl.reloadSignal) then
                -- `mock.reloadUI`: the pass ended; the teardown still runs.
                job.co = nil
                job.i = job.i + 1
            elseif not ok then
                job.failure = job.failure ?? failureOf(a, co)
                job.co = nil
                job.i = job.i + 1
            elseif coroutine.status(co) == "dead" then
                job.co = nil
                job.i = job.i + 1
            elseif isToken(a, wl.waitToken) then
                return "wait", b, c
            else
                job.failure = job.failure ?? { message = "the test yielded outside mock.wait…", stack = "" }
                job.co = nil
                job.i = job.i + 1
            end
        end
        if job.failure then
            local f = job.failure :: { message: string, stack: string }
            return "fail", f.message, f.stack
        end
        return "pass", nil, nil
    end,
    -- How long the running test's waits may take (virtual seconds).
    timeout = function(): number
        return current and current.timeout or settings.timeout
    end,
}

