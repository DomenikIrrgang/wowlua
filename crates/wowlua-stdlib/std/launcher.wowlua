-- wowlua:launcher (spec stdlib "launcher"): a minimap button, an Addon
-- Compartment entry and an LDB launcher from one declaration, created at
-- PLAYER_LOGIN. The minimap button is LibDBIcon's when that library is
-- loaded, else a built-in one; its position uses LibDBIcon's table shape
-- (`hide`, `minimapPos`), so switching between them keeps it. Secret icons,
-- labels and texts are not published (LibDataBroker compares them, the
-- compartment's menu measures them): the previous value stays.
import isLoggedIn from "wowlua:lifecycle"
import on from "wowlua:events"
import type Subscription from "wowlua:events"
import callIn from "wowlua:errors"
import type WidgetTheme from "wowlua:frames"
import * as secret from "wowlua:secret"

local addonName, ns = ...
local wl = ns.__wowlua

type Options = {
    icon: string,
    label: string,
    onClick: (button: string) -> (),
    tooltip?: ((tip: GameTooltip) -> ()),
    minimap?: { store: table, key: string },
    compartment?: boolean,
    ldb?: boolean,
    --- Restyles the built-in minimap button (decision S31).
    theme?: WidgetTheme,
}

--- LibDBIcon's position table.
type Position = LibDBIconPosition

--- An Addon Compartment entry.
type CompartmentEntry = {
    text: string,
    icon: string,
    notCheckable: boolean,
    registerForAnyClick: boolean,
    func: (button: any, input: { buttonName?: string }?) -> (),
    funcOnEnter: (entry: any) -> (),
    funcOnLeave: () -> (),
}

local registered = false
local opts: Options? = nil
local compartmentEntry: CompartmentEntry? = nil
local dataObject: LibDataBrokerObject? = nil
local libIcon: LibDBIcon? = nil
local button: MinimapButton? = nil

-- The minimap position table in the store (created if missing).
local function position(): Position?
    local m = opts?.minimap
    if not m then
        return nil
    end
    local t = m.store[m.key]
    if type(t) ~= "table" or not secret.readable(t) then
        t = {}
        m.store[m.key] = t
    end
    -- The store's data has no declared shape.
    local p = t :: Position
    if p.minimapPos == nil then
        p.minimapPos = 225
    end
    return p
end

local function click(mouse: string)
    if opts then
        callIn({ component = "launcher: onClick" }, opts.onClick, mouse)
    end
end

local function showTooltip(owner: any)
    local tooltip = opts?.tooltip
    if not tooltip then
        return
    end
    GameTooltip:SetOwner(owner, "ANCHOR_LEFT")
    callIn({ component = "launcher: tooltip" }, tooltip, GameTooltip)
    GameTooltip:Show()
end

-- Built-in minimap button ------------------------------------------------------

-- Which quadrants of each minimap shape are round (the others are square):
-- top right, top left, bottom left, bottom right.
const ROUNDED: { [string]: boolean[] } = {
    ROUND = { true, true, true, true },
    SQUARE = { false, false, false, false },
    ["CORNER-TOPRIGHT"] = { true, false, false, false },
    ["CORNER-TOPLEFT"] = { false, true, false, false },
    ["CORNER-BOTTOMLEFT"] = { false, false, true, false },
    ["CORNER-BOTTOMRIGHT"] = { false, false, false, true },
    ["SIDE-TOP"] = { true, true, false, false },
    ["SIDE-LEFT"] = { false, true, true, false },
    ["SIDE-BOTTOM"] = { false, false, true, true },
    ["SIDE-RIGHT"] = { true, false, false, true },
    ["TRICORNER-TOPRIGHT"] = { true, true, false, true },
    ["TRICORNER-TOPLEFT"] = { true, true, true, false },
    ["TRICORNER-BOTTOMLEFT"] = { false, true, true, true },
    ["TRICORNER-BOTTOMRIGHT"] = { true, false, true, true },
}
const ALL_ROUND = { true, true, true, true }

local function place()
    local t = position()
    if not (button and t) then
        return
    end
    local angle = math.rad(secret.known(t.minimapPos, 225))
    local x, y = math.cos(angle), math.sin(angle)
    local quadrant = y >= 0 and (x >= 0 and 1 or 2) or (x < 0 and 3 or 4)
    local shape = GetMinimapShape and GetMinimapShape() or "ROUND"
    local rounded = (ROUNDED[shape] ?? ALL_ROUND)[quadrant]
    local w = Minimap:GetWidth() / 2 + 10
    local h = Minimap:GetHeight() / 2 + 10
    if rounded then
        x, y = x * w, y * h
    else
        -- Along the square's edge.
        local d = math.sqrt(2)
        x = math.max(-w, math.min(x * d * w, w))
        y = math.max(-h, math.min(y * d * h, h))
    end
    button:ClearAllPoints()
    button:SetPoint("CENTER", Minimap, "CENTER", x, y)
end

local function dragUpdate()
    local t = position()
    if not t then
        return
    end
    local mx, my = Minimap:GetCenter()
    local px, py = GetCursorPosition()
    local scale = Minimap:GetEffectiveScale()
    t.minimapPos = math.deg(math.atan2(py / scale - my, px / scale - mx)) % 360
    place()
end

-- The client's round button: the tracking ring (its art sits in the top
-- left of the texture), a dark disc and the icon at the button's center,
-- cropped of its square frame; the ring covers its corners (a mask distorts
-- cropped icons).
class MinimapButton extends Button
    readonly icon: Texture
    private readonly ring: Texture
    private readonly disc: Texture
    -- The flat look's round border and disc, made when first needed.
    private flatBorder?: Texture
    private flatDisc?: Texture

    constructor(texture: string)
        super(addonName .. "MinimapButton", Minimap)
        self:SetSize(31, 31)
        self:SetFrameStrata("MEDIUM")
        self:SetFrameLevel(8)
        self:RegisterForClicks("AnyUp")
        self:RegisterForDrag("LeftButton")
        self:SetHighlightTexture("Interface\\Minimap\\UI-Minimap-ZoomButton-Highlight")
        local overlay = self:CreateTexture(nil, "OVERLAY")
        overlay:SetSize(50, 50)
        overlay:SetTexture("Interface\\Minimap\\MiniMap-TrackingBorder")
        overlay:SetPoint("TOPLEFT")
        self.ring = overlay
        local background = self:CreateTexture(nil, "BACKGROUND")
        background:SetSize(24, 24)
        background:SetTexture("Interface\\Minimap\\UI-Minimap-Background")
        background:SetPoint("CENTER", self, "CENTER", 0, 1)
        self.disc = background
        local icon = self:CreateTexture(nil, "ARTWORK")
        icon:SetSize(18, 18)
        icon:SetTexture(texture)
        icon:SetTexCoord(0.05, 0.95, 0.05, 0.95)
        icon:SetPoint("CENTER", self, "CENTER", 0, 1)
        self.icon = icon
    end

    -- A round texture of `size` in `color` (masked to a circle).
    private function round(size: number, layer: DrawLayer, sublevel: number): Texture
        const t = self:CreateTexture(nil, layer, nil, sublevel)
        t:SetSize(size, size)
        t:SetPoint("CENTER", self, "CENTER", 0, 1)
        t:SetTexture("Interface\\Buttons\\WHITE8X8")
        const mask = self:CreateMaskTexture()
        mask:SetTexture("Interface\\CHARACTERFRAME\\TempPortraitAlphaMask", "CLAMPTOBLACKADDITIVE", "CLAMPTOBLACKADDITIVE")
        mask:SetAllPoints(t)
        t:AddMaskTexture(mask)
        return t
    end

    --- The client's look tinted by the theme's colors, or with
    --- `button = "flat"` a plain round disc with a thin border.
    function applyTheme(theme: WidgetTheme?)
        const border = theme?.colors?.border
        const background = theme?.colors?.background
        const flat = theme?.button == "flat"
        self.ring:SetShown(not flat)
        self.disc:SetShown(not flat)
        self.ring:SetVertexColor(border?.[1] ?? 1, border?.[2] ?? 1, border?.[3] ?? 1, border?.[4] ?? 1)
        self.disc:SetVertexColor(background?.[1] ?? 1, background?.[2] ?? 1, background?.[3] ?? 1, background?.[4] ?? 1)
        if flat then
            const edge = self.flatBorder ?? self:round(26, "BACKGROUND", 0)
            const disc = self.flatDisc ?? self:round(24 - 2 * ((theme?.borderSize ?? 1) - 1), "BACKGROUND", 1)
            self.flatBorder, self.flatDisc = edge, disc
            edge:SetVertexColor(border?.[1] ?? 0.5, border?.[2] ?? 0.5, border?.[3] ?? 0.5, border?.[4] ?? 1)
            disc:SetVertexColor(background?.[1] ?? 0, background?.[2] ?? 0, background?.[3] ?? 0, background?.[4] ?? 0.85)
        end
        self.flatBorder?:SetShown(flat)
        self.flatDisc?:SetShown(flat)
    end

    @script("OnClick")
    function clicked(mouse: string)
        click(mouse)
    end

    @script("OnEnter")
    function entered()
        showTooltip(self)
    end

    @script("OnLeave")
    function left()
        GameTooltip:Hide()
    end

    @script("OnDragStart")
    function dragStarted()
        self:SetScript("OnUpdate", dragUpdate)
    end

    @script("OnDragStop")
    function dragStopped()
        self:SetScript("OnUpdate", nil)
    end
end

local function applyVisibility()
    local t = position()
    if not t then
        return
    end
    if libIcon then
        if secret.flag(t.hide) then
            libIcon:Hide(addonName)
        else
            libIcon:Show(addonName)
        end
    elseif button then
        button:SetShown(not secret.flag(t.hide))
    end
end

-- Surfaces ---------------------------------------------------------------------

-- What a secret icon shows instead.
const QUESTION_MARK = "Interface\\Icons\\INV_Misc_QuestionMark"

local function create()
    local o = opts
    if not o then
        return
    end
    o.icon = secret.known(o.icon, QUESTION_MARK)
    o.label = secret.known(o.label, addonName)
    -- LibStub is embedded by addons: it may be missing.
    local libStub = _G.LibStub :: typeof(LibStub)?
    local ldb = libStub and libStub("LibDataBroker-1.1", true)
    local dbicon = o.minimap and libStub and libStub("LibDBIcon-1.0", true) or nil
    -- LibDBIcon draws from an LDB object, so it needs one too.
    if ldb and (o.ldb or dbicon) then
        dataObject = ldb:NewDataObject(addonName, {
            type = "launcher",
            icon = o.icon,
            label = o.label,
            text = o.label,
            OnClick = function(_: any, mouse: string) click(mouse) end,
            OnTooltipShow = function(tip: GameTooltip)
                if o.tooltip then
                    callIn({ component = "launcher: tooltip" }, o.tooltip, tip)
                end
            end,
        })
    end
    if o.minimap then
        if dbicon and dataObject then
            libIcon = dbicon
            dbicon:Register(addonName, dataObject, position())
        else
            button = MinimapButton.new(o.icon)
            button:applyTheme(o.theme)
            place()
        end
        applyVisibility()
    end
    if o.compartment ~= false and AddonCompartmentFrame and AddonCompartmentFrame.RegisterAddon then
        local entry: CompartmentEntry = {
            text = o.label,
            icon = o.icon,
            notCheckable = true,
            registerForAnyClick = true,
            func = function(_: any, input: { buttonName?: string }?)
                click(input?.buttonName ?? "LeftButton")
            end,
            funcOnEnter = function(owner: any) showTooltip(owner) end,
            funcOnLeave = function() GameTooltip:Hide() end,
        }
        compartmentEntry = entry
        AddonCompartmentFrame:RegisterAddon(entry)
    end
end

--- Declares the addon's launcher (once); its surfaces appear at login.
export function register(options: Options)
    if registered then
        error("launcher.register: called more than once", 2)
    end
    registered = true
    opts = options
    if isLoggedIn() then
        callIn({ component = "launcher: register" }, create)
    else
        local tasks = assert(wl.lifecycleTasks)
        tasks.afterLogin[#tasks.afterLogin + 1] = create
    end
end

--- Changes the icon everywhere.
export function setIcon(icon: string)
    if not opts or secret.isSecret(icon) then
        return
    end
    opts.icon = icon
    if dataObject then
        dataObject.icon = icon
    end
    if compartmentEntry then
        compartmentEntry.icon = icon
    end
    if button then
        button.icon:SetTexture(icon)
    end
end

--- Changes the label everywhere.
export function setLabel(label: string)
    if not opts or secret.isSecret(label) then
        return
    end
    opts.label = label
    if dataObject then
        dataObject.label = label
        dataObject.text = label
    end
    if compartmentEntry then
        compartmentEntry.text = label
    end
end

--- Shows or hides the minimap button (stored with its position).
export function showMinimap(show: boolean)
    local t = position()
    if not t or secret.isSecret(show) then
        return
    end
    t.hide = not show
    applyVisibility()
end

--- Re-reads the stored position and visibility (after a profile switch).
export function refresh()
    if not opts then
        return
    end
    if libIcon then
        libIcon:Refresh(addonName, position())
    else
        place()
    end
    applyVisibility()
end

--- Restyles the built-in minimap button (nil: the client's look).
export function setTheme(theme: WidgetTheme?)
    if opts then
        opts.theme = theme
    end
    button?:applyTheme(theme)
end

-- LDB data sources ------------------------------------------------------------

export type DataSourceOptions = {
    text: string,
    label?: string,
    icon?: string,
    onClick?: (button: string) -> (),
    tooltip?: (tip: GameTooltip) -> (),
}

--- A LibDataBroker data source: text that display addons (Titan Panel,
--- ChocolateBar, ...) show and keep current.
class DataSource
    readonly name: string
    readonly opts: DataSourceOptions
    object: LibDataBrokerObject? = nil

    constructor(name: string, opts: DataSourceOptions)
        self.name = name
        self.opts = opts
    end

    -- Creates the LDB object once LibDataBroker is there.
    function attach(ldb: LibDataBroker)
        const o = self.opts
        const object = ldb:NewDataObject(self.name, {
            type = "data source",
            text = secret.known(o.text, ""),
            label = secret.known(o.label, self.name),
            icon = not secret.isSecret(o.icon) and o.icon or nil,
            OnClick = function(_: any, mouse: string)
                if o.onClick then
                    callIn({ component = "launcher: data source onClick" }, o.onClick, mouse)
                end
            end,
            OnTooltipShow = function(tip: GameTooltip)
                if o.tooltip then
                    callIn({ component = "launcher: data source tooltip" }, o.tooltip, tip)
                end
            end,
        })
        if not object then
            error(`launcher.dataSource: LibDataBroker already has a data object named "{self.name}"`)
        end
        self.object = object
    end

    function setText(text: string)
        if secret.isSecret(text) then
            return
        end
        self.opts.text = text
        if self.object then
            self.object.text = text
        end
    end

    function setIcon(icon: string)
        if secret.isSecret(icon) then
            return
        end
        self.opts.icon = icon
        if self.object then
            self.object.icon = icon
        end
    end

    function setLabel(label: string)
        if secret.isSecret(label) then
            return
        end
        self.opts.label = label
        if self.object then
            self.object.label = label
        end
    end
end

-- Data sources waiting for LibDataBroker (another addon may embed it and
-- load later).
local waiting: DataSource[] = {}
local watch: Subscription? = nil

local function attachWaiting()
    const libStub = _G.LibStub :: typeof(LibStub)?
    const ldb = libStub and libStub("LibDataBroker-1.1", true)
    if not ldb then
        return
    end
    const ready = waiting
    waiting = {}
    watch?:cancel()
    watch = nil
    for _, source in ipairs(ready) do
        callIn({ component = "launcher: dataSource" }, function() source:attach(ldb) end)
    end
end

--- Publishes `name` as a LibDataBroker data source; without the library
--- (embedded by any addon) it waits for it.
export function dataSource(name: string, opts: DataSourceOptions): DataSource
    const source = DataSource.new(name, opts)
    waiting[#waiting + 1] = source
    attachWaiting()
    if #waiting > 0 and not watch then
        watch = on("ADDON_LOADED", attachWaiting)
    end
    return source
end
