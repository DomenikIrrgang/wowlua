-- wowlua:hooks (spec stdlib "hooks"): post-hooks through hooksecurefunc and
-- HookScript, never pre-hooks or replacements (those taint secure code).
-- Targets may be strings naming globals; `opts.addon` installs the hook once
-- that load-on-demand addon has loaded, and `opts.owner` names whose hook it
-- is to error listeners.
import onAddonLoaded from "wowlua:lifecycle"
import callOwned from "wowlua:errors"

--- Options of `hook` and `hookScript`: `addon` installs the hook once that
--- load-on-demand addon has loaded; `owner` is passed to error listeners
--- as the hook's owner.
export type Options = { addon?: string, owner?: unknown }

--- What `@hook(…)` and `@hookScript(…)` give: the decorator, which hooks the
--- function it decorates.
export type HookDecorator = (fn: function, ctx: DecoratorContext?) -> ()

local function resolve(target: any): any
    if type(target) == "string" then
        return _G[target]
    end
    return target
end

local function install(addon: string?, fn: () -> ())
    if addon then
        onAddonLoaded(addon, fn)
    else
        fn()
    end
end

local function isolated(fn: any, what: string, owner: any): any
    local context = { component = "hooks: " .. what }
    return function(...)
        callOwned(context, owner, fn, ...)
    end
end

local function hookNow(target: any, name: any, fn: any, opts: Options?)
    if name == nil then
        -- A global function: `hook(name, fn)`.
        install(nil, function() hooksecurefunc(target, isolated(fn, target, nil)) end)
        return
    end
    install(opts?.addon, function()
        local t = resolve(target)
        if t == nil then
            error("hook: `" .. tostring(target) .. "` does not exist", 0)
        end
        hooksecurefunc(t, name, isolated(fn, tostring(name), opts?.owner))
    end)
end

local function hookScriptNow(frame: any, script: string, fn: any, opts: Options?)
    install(opts?.addon, function()
        local f = resolve(frame)
        if f == nil then
            error("hookScript: `" .. tostring(frame) .. "` does not exist", 0)
        end
        f:HookScript(script, isolated(fn, script, opts?.owner))
    end)
end

--- A post-hook: `hook(name, fn)` or `hook(target, name, fn, opts?)`. As a
--- decorator: `@hook(name)` or `@hook(target, name, opts?)`.
export overload function hook(name: string, fn: function)
export overload function hook(target: unknown, name: string, fn: function, opts: Options?)
export overload function hook(name: string): HookDecorator
export overload function hook(target: unknown, name: string, opts: Options?): HookDecorator
export function hook(
    a: unknown,
    b: string | function | nil,
    c: function | Options | nil,
    d: Options?
): HookDecorator?
    if type(b) == "function" then
        hookNow(a, nil, b, nil)
        return nil
    end
    if type(c) == "function" then
        hookNow(a, b, c, d)
        return nil
    end
    local opts = c :: Options?
    return function(fn: function, _: DecoratorContext?)
        if b == nil then
            hookNow(a, nil, fn, nil)
        else
            hookNow(a, b, fn, opts)
        end
    end
end

--- `frame:HookScript(script, fn)`: `hookScript(frame, script, fn, opts?)`,
--- or as a decorator `@hookScript(frame, script, opts?)`.
export overload function hookScript(frame: ScriptRegion | string, script: string, fn: function, opts: Options?)
export overload function hookScript(frame: ScriptRegion | string, script: string, opts: Options?): HookDecorator
export function hookScript(
    frame: ScriptRegion | string,
    script: string,
    c: function | Options | nil,
    d: Options?
): HookDecorator?
    if type(c) == "function" then
        hookScriptNow(frame, script, c, d)
        return nil
    end
    local opts = c :: Options?
    return function(fn: function, _: DecoratorContext?)
        hookScriptNow(frame, script, fn, opts)
    end
end
