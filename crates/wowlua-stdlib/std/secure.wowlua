-- wowlua:secure (spec stdlib "secure"): the client's secure state drivers.
-- A macro conditional ("[combat] show; hide") is evaluated by the client,
-- also in combat, where addon code may not show or hide protected frames.
-- Registering or removing a driver is itself blocked in combat, so it waits
-- for the end of combat (wowlua:combat). Literal conditionals are checked
-- at compile time (E8440, E8441).
import * as combat from "wowlua:combat"
import type Subscription from "wowlua:events"
import callIn from "wowlua:errors"

--- Shows and hides `frame` by a macro conditional whose values are `show`
--- and `hide`; nil removes the driver (the frame stays as it is).
export function visibility(frame: Frame, conditional: string?)
    combat.defer(function()
        if conditional then
            RegisterStateDriver(frame, "visibility", conditional)
        else
            UnregisterStateDriver(frame, "visibility")
        end
    end)
end

class StateWatch implements Subscription
    active: boolean = true
    readonly frame: Frame
    readonly name: string

    constructor(frame: Frame, name: string)
        self.frame = frame
        self.name = name
    end

    function cancel()
        if not self.active then
            return
        end
        self.active = false
        combat.defer(function() UnregisterStateDriver(self.frame, self.name) end)
    end
end

--- Evaluates a macro conditional on `frame` as the state `name` and calls
--- `fn(value)` with each new value (the first right away), also in combat.
--- Without `fn` only the driver is registered (for an `_onstate-<name>`
--- snippet), and nothing is hooked.
export function state(frame: Frame, name: string, conditional: string, fn: ((value: string) -> ())?): Subscription
    const watch = StateWatch.new(frame, name)
    if fn then
        -- The driver sets the attribute `state-<name>` (names are lowercase).
        const attribute = `state-{name:lower()}`
        frame:HookScript("OnAttributeChanged", function(_: any, key: string, value: any)
            if watch.active and key == attribute then
                callIn({ component = "secure: state" }, fn, tostring(value))
            end
        end)
    end
    combat.defer(function()
        if watch.active then
            RegisterStateDriver(frame, name, conditional)
        end
    end)
    return watch
end

--- What a macro conditional gives now (nil: no clause matches).
export function evaluate(conditional: string): string?
    const value = SecureCmdOptionParse(conditional)
    return value
end

export type OverlayOptions = {
    --- The layer it sits in (default "DIALOG": above a window that comes to
    --- the front when clicked).
    strata?: FrameStrata,
}

--- A secure button over one of the addon's own (see `overlay`).
export type Overlay = {
    --- The secure button: hook its `PreClick`/`PostClick` for what happens
    --- around the action.
    button: Button,
    --- Sets an attribute (`type1`, `macrotext1`, `clickbutton1`, …); false
    --- in combat, where it can't.
    set: (name: string, value: string | Frame | nil) -> boolean,
    --- Anchors it over the target, or over `other` (a row it moves between),
    --- and shows it; false in combat. Hovering it is hovering what it is over.
    show: (other: Frame?) -> boolean,
    --- Hides it and lets go of the target; false in combat.
    hide: () -> boolean,
}

--- A secure action button over `target`, a button of the addon's own that
--- looks the part, for what only a click on a secure button may do (a
--- slash command through `macro`, a click on one of the game's protected
--- buttons through `click`). It hangs off `UIParent` and is anchored to the
--- target only while shown, so the target's window never turns protected
--- (it would no longer open or close in combat). A press and a release both
--- reach it (`LeftButtonDown`, `LeftButtonUp`: the action runs on the one
--- the client's ActionButtonUseKeyDown picks); hovering it is hovering the
--- target. Made out of combat.
export function overlay(target: Frame, opts: OverlayOptions?): Overlay
    const button = CreateFrame("Button", nil, UIParent, "SecureActionButtonTemplate")
    local over = target
    button:RegisterForClicks("LeftButtonDown", "LeftButtonUp")
    button:SetScript("OnEnter", function()
        const fn = over:GetScript("OnEnter")
        if fn then
            fn(over, true)
        end
    end)
    button:SetScript("OnLeave", function()
        const fn = over:GetScript("OnLeave")
        if fn then
            fn(over, true)
        end
    end)
    button:Hide()
    const strata: FrameStrata = opts?.strata ?? "DIALOG"
    return {
        button = button,
        set = function(name: string, value: string | Frame | nil): boolean
            if InCombatLockdown() then
                return false
            end
            button:SetAttribute(name, value)
            return true
        end,
        show = function(other: Frame?): boolean
            if InCombatLockdown() then
                return false
            end
            over = other ?? target
            button:SetFrameStrata(strata)
            button:ClearAllPoints()
            button:SetAllPoints(over)
            button:Show()
            return true
        end,
        hide = function(): boolean
            if InCombatLockdown() then
                return false
            end
            button:Hide()
            button:ClearAllPoints()
            return true
        end,
    }
end
