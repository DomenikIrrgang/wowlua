-- wowlua:tooltip (spec stdlib "tooltip"): typed post-hooks for tooltips.
-- With the client's tooltip data system, one `TooltipDataProcessor` post-call
-- per kind covers every tooltip; elsewhere the standard tooltips'
-- `OnTooltipSet*` scripts are hooked and the item, spell or unit is read
-- from the tooltip. Post-hooks only: handlers add to tooltips, they cannot
-- suppress or replace what the client shows.
import * as secret from "wowlua:secret"
import callIn from "wowlua:errors"

--- An `Enum.TooltipDataType` name: `"Item"`, `"Spell"`, `"Unit"`, … (the
--- compiler checks it per flavor, E8330 and E8300).
export type TooltipKind = string

--- What a tooltip shows, the same on every client. `id`, `unit` and
--- `link` are nil when the client's are secret; `guid` is passed through.
export type TooltipData = {
    kind: TooltipKind,
    id?: number,
    guid?: string | Secret<string>,
    unit?: string,
    link?: string,
    --- The client's tooltip data, where it has the data system (and addons
    --- may read it).
    raw?: table,
}

type Handler = (tip: GameTooltip, data: TooltipData) -> ()

--- The data system's entry point (declared only as a table).
interface DataProcessor
    AddTooltipPostCall: (kind: number, fn: (tip: GameTooltip, data: table) -> ()) -> ()
end

--- The tooltip getters the API declarations leave untyped.
interface Getters
    function GetItem(): (string?, string?)
    function GetSpell(): (string?, any, any)
    function GetUnit(): (string?, string?)
end

const processor = _G.TooltipDataProcessor :: DataProcessor?
const dataTypes = (_G.Enum?.TooltipDataType ?? {}) :: { [string]: number }
-- The data system is the client's `C_TooltipInfo`, as the compiler decides
-- per flavor (spec stdlib "tooltip"): classic clients' UI defines
-- `TooltipDataProcessor` too, but their tooltips never call its post-calls.
const modern = (_G :: { [string]: unknown }).C_TooltipInfo ~= nil and processor?.AddTooltipPostCall ~= nil

-- Without the data system: the kinds there are, by the script that shows
-- them, and the standard tooltips.
const SCRIPTS: { [string]: string } = {
    Item = "OnTooltipSetItem",
    Spell = "OnTooltipSetSpell",
    Unit = "OnTooltipSetUnit",
}
const STANDARD_TOOLTIPS = { "GameTooltip", "ItemRefTooltip", "ShoppingTooltip1", "ShoppingTooltip2" }

-- `v`, or nil when it is secret: the fields typed without secrets are for
-- lookups, which a secret refuses.
local function nonSecret<T>(v: T | Secret<T> | nil): T?
    if secret.isSecret(v) then
        return nil
    end
    return v
end

--- A registered handler. Hooks cannot be removed: disabling one stops
--- calling its handler.
export class TooltipHook
    readonly kind: TooltipKind
    private readonly fn: Handler
    private enabled: boolean = true

    --- A hook of `fn` on tooltips of `kind`, enabled (`hook` makes and
    --- registers one).
    constructor(kind: TooltipKind, fn: Handler)
        self.kind = kind
        self.fn = fn
    end

    --- Calls the handler again.
    function enable()
        self.enabled = true
    end

    --- Stops calling the handler (the hook itself stays).
    function disable()
        self.enabled = false
    end

    --- Whether the handler is called.
    function isEnabled(): boolean
        return self.enabled
    end

    --- Calls the handler with `tip` and `data` (through the error policy)
    --- when the hook is enabled.
    function run(tip: GameTooltip, data: TooltipData)
        if self.enabled then
            callIn({ component = `tooltip: {self.kind}` }, self.fn, tip, data)
        end
    end
end

local hooks: { [string]: TooltipHook[] } = {}

local function dispatch(kind: TooltipKind, tip: GameTooltip, data: TooltipData)
    for _, h in ipairs(hooks[kind] ?? {}) do
        h:run(tip, data)
    end
end

-- What the tooltip itself says it shows.
local function read(kind: TooltipKind, tip: GameTooltip, data: TooltipData): TooltipData
    const getters = tip :: Getters
    if kind == "Item" then
        local _, shown = getters:GetItem()
        const link = nonSecret(shown)
        data.link = data.link ?? link
        data.id = data.id ?? (link and tonumber(link:match("item:(%d+)")))
    elseif kind == "Spell" then
        -- Clients return the spell id second or (with a rank) third.
        local _, a, b = getters:GetSpell()
        a, b = nonSecret(a), nonSecret(b)
        data.id = data.id ?? (type(a) == "number" and a or type(b) == "number" and b or nil)
    elseif kind == "Unit" then
        local _, token = getters:GetUnit()
        const unit = nonSecret(token)
        data.unit = unit
        if unit and not data.guid then
            data.guid = UnitGUID(unit)
        end
    end
    return data
end

-- With the data system, from the client's data as Blizzard's `TooltipUtil`
-- reads it: the tooltip's getters fail during a post-call (Forever 70425,
-- `SetBagItem`: "attempt to call a nil value" in `GetItem`).
local function fromData(kind: TooltipKind, raw: table, data: TooltipData): TooltipData
    const r = raw :: any
    if kind == "Item" then
        -- The client takes no secret GUID here.
        if r.guid and not secret.isSecret(r.guid) and C_Item.GetItemLinkByGUID then
            data.link = C_Item.GetItemLinkByGUID(r.guid) ?? data.link
        end
    elseif kind == "Unit" then
        data.unit = nonSecret(r.guid and UnitTokenFromGUID and UnitTokenFromGUID(r.guid) or nil)
    end
    return data
end

-- With the data system: one post-call per kind, for every tooltip.
local registered: { [string]: boolean } = {}

local function listen(kind: TooltipKind)
    const dataType = dataTypes[kind]
    if registered[kind] or not processor or not dataType then
        return
    end
    registered[kind] = true
    processor.AddTooltipPostCall(dataType, function(tip: GameTooltip, raw: table)
        if tip:IsForbidden() then
            return
        end
        if not secret.readable(raw) then
            dispatch(kind, tip, { kind = kind })
            return
        end
        const data: TooltipData = { kind = kind, id = nonSecret(raw.id), guid = raw.guid, link = nonSecret(raw.hyperlink), raw = raw }
        dispatch(kind, tip, fromData(kind, raw, data))
    end)
end

-- Without it: the scripts of each attached tooltip.
local attached: { [GameTooltip]: boolean } = {}

--- Applies the hooks to another tooltip too (clients without the data
--- system; with it, every tooltip is covered already).
export function attach(tip: GameTooltip)
    if modern or attached[tip] then
        return
    end
    attached[tip] = true
    for kind, script in pairs(SCRIPTS) do
        tip:HookScript(script, function(self: GameTooltip)
            if hooks[kind] then
                dispatch(kind, self, read(kind, self, { kind = kind }))
            end
        end)
    end
end

if not modern then
    for _, name in ipairs(STANDARD_TOOLTIPS) do
        const tip = _G[name] :: GameTooltip?
        if tip then
            attach(tip)
        end
    end
end

--- Calls `fn` after the client fills a tooltip of `kind`.
export function hook(kind: TooltipKind, fn: Handler): TooltipHook
    local known = SCRIPTS[kind] ~= nil
    if modern then
        known = dataTypes[kind] ~= nil
    end
    if not known then
        error(`tooltip.hook: no "{kind}" tooltips on this client`, 2)
    end
    const h = TooltipHook.new(kind, fn)
    const list = hooks[kind] ?? {}
    list[#list + 1] = h
    hooks[kind] = list
    listen(kind)
    return h
end

--- `@onTooltip(kind)`: the function is a post-hook of that kind's tooltips.
export function onTooltip(kind: TooltipKind)
    return function(fn: Handler, _: DecoratorContext?)
        hook(kind, fn)
    end
end
