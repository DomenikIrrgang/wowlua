-- wowlua:events (spec stdlib "events"): WoW events and addon-internal
-- messages. WoW events are registered on a shared hidden frame while
-- handlers exist; unit events get frames of their own, so their unit filters
-- never clear each other. Messages are dispatched in Lua only.
import callIn from "wowlua:errors"
import * as secret from "wowlua:secret"

export interface Subscription
    active: boolean
    function cancel()
end

type Handler = {
    fn: (...any) -> (),
    owner: any,
    sub: Subscription,
}

-- Handlers by event or message name, in registration order.
local handlers: { [string]: Handler[] } = {}
-- Unit-event registrations: one frame per event and unit set.
local unitFrames: { [string]: { frame: Frame, handlers: Handler[] } } = {}
local driver = CreateFrame("Frame")
local gameEvents: { [string]: boolean } = {}

-- Whether `name` is an event of this client (not a message).
local function isGameEvent(name: string): boolean
    local known = gameEvents[name]
    if known ~= nil then
        return known
    end
    local valid: boolean
    if C_EventUtils and C_EventUtils.IsEventValid then
        valid = C_EventUtils.IsEventValid(name) and true or false
    else
        valid = pcall(driver.RegisterEvent, driver, name)
        if valid and not handlers[name] then
            driver:UnregisterEvent(name)
        end
    end
    gameEvents[name] = valid
    return valid
end

-- The error context of each name's handlers, made once.
local contexts: { [string]: { component: string } } = {}

local function contextOf(name: string): { component: string }
    local context = contexts[name]
    if not context then
        context = { component = "events: " .. name .. " handler" }
        contexts[name] = context
    end
    return context
end

-- Handler lists are never changed in place: registering or unregistering
-- makes a new list, and a dispatch runs the list it started with, so
-- changes during it apply to the next one without a copy per dispatch.
local function run(list: Handler[], name: string, ...: any)
    local context = contextOf(name)
    for _, h in ipairs(list) do
        callIn(context, h.fn, ...)
    end
end

local function dispatch(name: string, ...: any)
    local list = handlers[name]
    if list then
        run(list, name, ...)
    end
end

driver:SetScript("OnEvent", function(_, name: string, ...: any)
    dispatch(name, ...)
end)

-- `list` with `h` added, as a new list.
local function with(list: Handler[]?, h: Handler): Handler[]
    local copy: Handler[] = {}
    if list then
        for i, x in ipairs(list) do
            copy[i] = x
        end
    end
    copy[#copy + 1] = h
    return copy
end

-- `list` without `sub`'s handler, as a new list; nil when it has none.
local function without(list: Handler[], sub: Subscription): Handler[]?
    for i, h in ipairs(list) do
        if h.sub == sub then
            local copy: Handler[] = {}
            for j, x in ipairs(list) do
                if j ~= i then
                    copy[#copy + 1] = x
                end
            end
            return copy
        end
    end
    return nil
end

local function cancel(name: string, sub: Subscription)
    sub.active = false
    local list = handlers[name]
    local rest = list and without(list, sub)
    if not rest then
        return
    end
    if #rest > 0 then
        handlers[name] = rest
        return
    end
    handlers[name] = nil
    if isGameEvent(name) then
        driver:UnregisterEvent(name)
    end
end

local function subscribe(name: string, fn: (...any) -> (), owner: any): Subscription
    local sub: Subscription = {
        active = true,
        cancel = function(self: Subscription) cancel(name, self) end,
    }
    local list = handlers[name]
    handlers[name] = with(list, { fn = fn, owner = owner, sub = sub })
    if not list and isGameEvent(name) then
        driver:RegisterEvent(name)
    end
    return sub
end

--- Calls `handler` with every `event` (or message) from now on.
export function on(event: string, handler: (...any) -> (), owner: any?): Subscription
    return subscribe(event, handler, owner)
end

--- Calls `handler` with the next `event` only.
export function once(event: string, handler: (...any) -> (), owner: any?): Subscription
    local sub: Subscription
    sub = subscribe(event, function(...)
        sub:cancel()
        handler(...)
    end, owner)
    return sub
end

--- `RegisterUnitEvent` for one or two units, on a frame of its own.
export function onUnit(event: string, units: string[], handler: (...any) -> (), owner: any?): Subscription
    if #units < 1 or #units > 2 then
        error("onUnit: one or two units (WoW's limit), not " .. #units, 2)
    end
    local key = event .. "\0" .. table.concat(units, "\0")
    local entry = unitFrames[key]
    if not entry then
        local frame = CreateFrame("Frame")
        local none: Handler[] = {}
        entry = { frame = frame, handlers = none }
        unitFrames[key] = entry
        frame:SetScript("OnEvent", function(_, name: string, ...: any)
            run(entry.handlers, name, ...)
        end)
    end
    if #entry.handlers == 0 then
        entry.frame:RegisterUnitEvent(event, units[1], units[2])
    end
    local sub: Subscription = {
        active = true,
        cancel = function(self: Subscription)
            self.active = false
            local rest = without(entry.handlers, self)
            if rest then
                entry.handlers = rest
                if #rest == 0 then
                    entry.frame:UnregisterEvent(event)
                end
            end
        end,
    }
    entry.handlers = with(entry.handlers, { fn = handler, owner = owner, sub = sub })
    return sub
end

export function off(sub: Subscription)
    sub:cancel()
end

--- Cancels every subscription registered with `owner`.
export function offAll(owner: any)
    -- nil would match every subscription without an owner, the standard
    -- library's own among them.
    if owner == nil then
        error("offAll: the owner is nil", 2)
    end
    local subs: Subscription[] = {}
    for _, list in pairs(handlers) do
        for _, h in ipairs(list) do
            if h.owner == owner then
                subs[#subs + 1] = h.sub
            end
        end
    end
    for _, entry in pairs(unitFrames) do
        for _, h in ipairs(entry.handlers) do
            if h.owner == owner then
                subs[#subs + 1] = h.sub
            end
        end
    end
    for _, sub in ipairs(subs) do
        sub:cancel()
    end
end

--- Dispatches a message to this addon's handlers, synchronously.
export function send(name: string, ...: any)
    if isGameEvent(name) then
        error("send: `" .. name .. "` is a WoW event, not a message", 2)
    end
    dispatch(name, ...)
end

local bucketContext = { component = "events: bucket handler" }

--- What a bucket collected: counts by first argument (units, bag IDs) and
--- by event.
export type BucketCounts = { args: { [any]: number }, events: { [string]: number } }

class Bucket implements Subscription
    active: boolean = true
    readonly subs: Subscription[] = {}

    function cancel()
        self.active = false
        for _, sub in ipairs(self.subs) do
            sub:cancel()
        end
    end
end

--- Coalesces bursts: the first of `events` starts an `interval`-second
--- wait, and `handler` then gets everything that arrived in it, counted
--- by first argument and by event (like AceBucket).
export function onBucket(events: string | string[], interval: number, handler: (counts: BucketCounts) -> (), owner: any?): Subscription
    local names: string[]
    if type(events) == "string" then
        names = { events }
    else
        names = events
    end
    const bucket = Bucket.new()
    local pending: BucketCounts? = nil
    local function flush()
        const counts = pending
        pending = nil
        if counts and bucket.active then
            callIn(bucketContext, handler, counts)
        end
    end
    for _, name in ipairs(names) do
        bucket.subs[#bucket.subs + 1] = subscribe(name, function(first: any)
            local counts = pending
            if not counts then
                counts = { args = {}, events = {} }
                pending = counts
                C_Timer.After(interval, flush)
            end
            counts.events[name] = (counts.events[name] ?? 0) + 1
            -- Secrets cannot be table keys; nil has no count.
            if first ~= nil and not secret.isSecret(first) then
                counts.args[first] = (counts.args[first] ?? 0) + 1
            end
        end, owner)
    end
    return bucket
end

local function decorated(ctx: DecoratorContext?, what: string)
    if ctx and ctx.kind == "method" and not ctx.static then
        error("@" .. what .. " on the instance method `" .. tostring(ctx.name) .. "`: use on() in the constructor", 3)
    end
end

--- `@event(name, ...)`: one name, the handler gets the payload; several,
--- the handler gets the name first.
export function event(...: string)
    local names = { ... }
    return function(fn: (...any) -> (), ctx: DecoratorContext?)
        decorated(ctx, "event")
        if #names == 1 then
            subscribe(names[1], fn, nil)
        else
            for _, name in ipairs(names) do
                subscribe(name, function(...: any) fn(name, ...) end, nil)
            end
        end
    end
end

--- `@unitEvent(name, unit, unit?)`.
export function unitEvent(name: string, ...: string)
    local units = { ... }
    return function(fn: (...any) -> (), ctx: DecoratorContext?)
        decorated(ctx, "unitEvent")
        onUnit(name, units, fn, nil)
    end
end

--- `@bucket(interval, name, ...)`: `onBucket` for a function.
export function bucket(interval: number, ...: string)
    local names = { ... }
    return function(fn: (counts: BucketCounts) -> (), ctx: DecoratorContext?)
        decorated(ctx, "bucket")
        onBucket(names, interval, fn, nil)
    end
end
