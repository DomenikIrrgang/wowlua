-- wowlua:events (spec stdlib "events"): WoW events and addon-internal
-- messages. WoW events are registered on a shared hidden frame while
-- handlers exist; unit events get frames of their own, so their unit filters
-- never clear each other. Messages are dispatched in Lua only.
import callOwned from "wowlua:errors"
import * as secret from "wowlua:secret"

--- A registered handler: `active` until `cancel` unregisters it.
export interface Subscription
    active: boolean
    --- Unregisters the handler (the event too, when it was the last one);
    --- `active` becomes false.
    function cancel()
end

type Handler = {
    fn: (...any) -> (),
    owner: any,
    sub: Subscription,
}

-- Handlers by event or message name, in registration order.
local handlers: { [string]: Handler[] } = {}
-- Unit-event registrations: one frame per event and pair of units.
type UnitEntry = { frame: Frame, event: string, unit: string, unit2: string?, handlers: Handler[] }
local unitFrames: { [string]: UnitEntry } = {}
local driver = CreateFrame("Frame")
local gameEvents: { [string]: boolean } = {}

-- Whether `name` is an event of this client (not a message).
local function isGameEvent(name: string): boolean
    local known = gameEvents[name]
    if known ~= nil then
        return known
    end
    local valid: boolean
    if C_EventUtils and C_EventUtils.IsEventValid then
        valid = C_EventUtils.IsEventValid(name) and true or false
    else
        valid = pcall(driver.RegisterEvent, driver, name)
        if valid and not handlers[name] then
            driver:UnregisterEvent(name)
        end
    end
    gameEvents[name] = valid
    return valid
end

-- `RegisterUnitEvent` for one unit or two.
local function registerUnits(frame: Frame, event: string, unit: string, unit2: string?)
    if unit2 then
        frame:RegisterUnitEvent(event, unit, unit2)
    else
        frame:RegisterUnitEvent(event, unit)
    end
end

-- The error context of each name's handlers, made once.
local contexts: { [string]: { component: string } } = {}

local function contextOf(name: string): { component: string }
    local context = contexts[name]
    if not context then
        context = { component = "events: " .. name .. " handler" }
        contexts[name] = context
    end
    return context
end

-- Handler lists are never changed in place: registering or unregistering
-- makes a new list, and a dispatch runs the list it started with, so a
-- handler added during it waits for the next one without a copy per
-- dispatch. A handler cancelled during it (by an earlier one) is skipped.
local function run(list: Handler[], name: string, ...: any)
    local context = contextOf(name)
    for _, h in ipairs(list) do
        if h.sub.active then
            callOwned(context, h.owner, h.fn, ...)
        end
    end
end

local function dispatch(name: string, ...: any)
    local list = handlers[name]
    if list then
        run(list, name, ...)
    end
end

driver:SetScript("OnEvent", function(_, name: string, ...: any)
    dispatch(name, ...)
end)

-- `list` with `h` added, as a new list.
local function with(list: Handler[]?, h: Handler): Handler[]
    local copy: Handler[] = {}
    if list then
        for i, x in ipairs(list) do
            copy[i] = x
        end
    end
    copy[#copy + 1] = h
    return copy
end

-- `list` without `sub`'s handler, as a new list; nil when it has none.
local function without(list: Handler[], sub: Subscription): Handler[]?
    for i, h in ipairs(list) do
        if h.sub == sub then
            local copy: Handler[] = {}
            for j, x in ipairs(list) do
                if j ~= i then
                    copy[#copy + 1] = x
                end
            end
            return copy
        end
    end
    return nil
end

local function cancel(name: string, sub: Subscription)
    sub.active = false
    local list = handlers[name]
    local rest = list and without(list, sub)
    if not rest then
        return
    end
    if #rest > 0 then
        handlers[name] = rest
        return
    end
    handlers[name] = nil
    if isGameEvent(name) then
        driver:UnregisterEvent(name)
    end
end

local function subscribe(name: string, fn: (...any) -> (), owner: any): Subscription
    local sub: Subscription = {
        active = true,
        cancel = function(self: Subscription) cancel(name, self) end,
    }
    local list = handlers[name]
    handlers[name] = with(list, { fn = fn, owner = owner, sub = sub })
    if not list and isGameEvent(name) then
        driver:RegisterEvent(name)
    end
    return sub
end

--- Calls `handler` with every `event` (or message) from now on.
export function on(event: string, handler: (...any) -> (), owner: unknown?): Subscription
    return subscribe(event, handler, owner)
end

--- Calls `handler` with each of Blizzard's EventRegistry callbacks `name`
--- (`"MapCanvas.MapSet"`, `"ChatFrame.OnEditBoxFocusGained"`) from now on,
--- with the callback's values (not the owner the registry passes first),
--- isolated as every handler here; nothing on a client without
--- EventRegistry. Cancelling the subscription unregisters it.
export function onRegistry(name: string, handler: (...any) -> (), owner: unknown?): Subscription
    const key = {}
    const context = { component = "events: " .. name .. " callback" }
    const registry = _G.EventRegistry :: unknown
    local function call(method: string, ...: unknown)
        if type(registry) ~= "table" or not secret.readable(registry) then
            return
        end
        const fn = (registry :: { [string]: unknown })[method]
        if type(fn) == "function" then
            pcall(fn :: (...unknown) -> (), registry, ...)
        end
    end
    local sub: Subscription
    sub = {
        active = true,
        cancel = function(self: Subscription)
            if self.active then
                self.active = false
                call("UnregisterCallback", name, key)
            end
        end,
    }
    call("RegisterCallback", name, function(_: unknown, ...: any)
        if sub.active then
            callOwned(context, owner, handler, ...)
        end
    end, key)
    return sub
end

--- Calls `handler` with the next `event` only.
export function once(event: string, handler: (...any) -> (), owner: unknown?): Subscription
    local sub: Subscription
    sub = subscribe(event, function(...)
        sub:cancel()
        handler(...)
    end, owner)
    return sub
end

-- The frame of `event` for `unit` (and `unit2`), shared by equal pairs.
local function unitEntry(event: string, unit: string, unit2: string?): UnitEntry
    local key = event .. "\0" .. unit .. "\0" .. (unit2 ?? "")
    local entry = unitFrames[key]
    if not entry then
        local frame = CreateFrame("Frame")
        local none: Handler[] = {}
        const e: UnitEntry = { frame = frame, event = event, unit = unit, unit2 = unit2, handlers = none }
        frame:SetScript("OnEvent", function(_, name: string, ...: any)
            run(e.handlers, name, ...)
        end)
        unitFrames[key] = e
        entry = e
    end
    return entry
end

--- An `onUnit` subscription: one handler on the frame of each pair.
class UnitSubscription implements Subscription
    active: boolean = true
    readonly entries: UnitEntry[] = {}

    function cancel()
        if not self.active then
            return
        end
        self.active = false
        for _, entry in ipairs(self.entries) do
            local rest = without(entry.handlers, self)
            if rest then
                entry.handlers = rest
                if #rest == 0 and isGameEvent(entry.event) then
                    entry.frame:UnregisterEvent(entry.event)
                end
            end
        end
    end

    function attach(entry: UnitEntry, h: Handler)
        self.entries[#self.entries + 1] = entry
        -- In flavors without the event, the handler is never called.
        if #entry.handlers == 0 and isGameEvent(entry.event) then
            registerUnits(entry.frame, entry.event, entry.unit, entry.unit2)
        end
        entry.handlers = with(entry.handlers, h)
    end
end

--- `RegisterUnitEvent` for any number of units: WoW filters a frame by at
--- most two, so each pair gets a frame of its own.
export function onUnit(event: string, units: string[], handler: (...any) -> (), owner: unknown?): Subscription
    if #units == 0 then
        error("onUnit: no units", 2)
    end
    const sub = UnitSubscription.new()
    const h: Handler = { fn = handler, owner = owner, sub = sub }
    local seen: { [string]: boolean } = {}
    local single: string? = nil
    for _, unit in ipairs(units) do
        -- A unit listed twice would get its events twice. A secret unit
        -- cannot be a key, nor registered by an addon: it is skipped.
        if secret.isSecret(unit) or seen[unit] then
            continue
        end
        seen[unit] = true
        if single then
            sub:attach(unitEntry(event, single, unit), h)
            single = nil
        else
            single = unit
        end
    end
    if single then
        sub:attach(unitEntry(event, single, nil), h)
    end
    return sub
end

--- A unit watch (`watchUnit`): its events on a frame of its own, pointed
--- at other units without subscribing again.
export interface UnitWatch
    active: boolean
    --- Registers every event for `unit` (and `unit2`); nil (or a secret)
    --- unregisters them.
    function setUnit(unit: string?, unit2: string?)
    --- Stops the watch: unregisters its events and frees its frame for the
    --- next watch.
    function cancel()
end

-- Frames of cancelled watches, for the next ones.
local spareFrames: Frame[] = {}
-- The watch of each frame in use.
local watchOf: { [Frame]: Watch } = {}
-- The active watches, for `offAll`.
local watches: { [Watch]: boolean } = setmetatable({}, { __mode = "k" })

local function onWatchEvent(frame: Frame, name: string, ...: any)
    local w = watchOf[frame]
    if w then
        w:dispatch(name, ...)
    end
end

class Watch implements UnitWatch
    active: boolean = true
    readonly owner: any
    private readonly names: string[] = {}
    private readonly fn: (...any) -> ()
    private frame: Frame? = nil
    private unit: string? = nil
    private unit2: string? = nil

    constructor(names: string[], fn: (...any) -> (), owner: any)
        self.fn = fn
        self.owner = owner
        for _, name in ipairs(names) do
            -- In flavors without the event, the handler is never called.
            if isGameEvent(name) then
                self.names[#self.names + 1] = name
            end
        end
    end

    function dispatch(name: string, ...: any)
        callOwned(contextOf(name), self.owner, self.fn, name, ...)
    end

    function setUnit(unit: string?, unit2: string?)
        -- A secret unit cannot be compared, nor registered by an addon: it
        -- reads as none.
        if secret.isSecret(unit) then
            unit = nil
        end
        if unit == nil or secret.isSecret(unit2) then
            unit2 = nil
        end
        if not self.active or (unit == self.unit and unit2 == self.unit2) then
            return
        end
        self.unit, self.unit2 = unit, unit2
        local frame = self.frame
        if unit == nil then
            if frame then
                frame:UnregisterAllEvents()
            end
            return
        end
        if not frame then
            frame = table.remove(spareFrames) ?? CreateFrame("Frame")
            frame:SetScript("OnEvent", onWatchEvent)
            watchOf[frame] = self
            self.frame = frame
        end
        -- Registering again replaces the units (Blizzard's
        -- CompactUnitFrame_UpdateUnitEvents relies on it).
        for _, name in ipairs(self.names) do
            registerUnits(frame, name, unit, unit2)
        end
    end

    --- Stops watching `name` only (`offAll(owner, name)`).
    function drop(name: string)
        for i, n in ipairs(self.names) do
            if n == name then
                table.remove(self.names, i)
                if self.frame and self.unit then
                    self.frame:UnregisterEvent(name)
                end
                return
            end
        end
    end

    function cancel()
        if not self.active then
            return
        end
        self.active = false
        watches[self] = nil
        local frame = self.frame
        if frame then
            frame:UnregisterAllEvents()
            watchOf[frame] = nil
            spareFrames[#spareFrames + 1] = frame
            self.frame = nil
        end
    end
end

--- Unit events on a frame of the watch's own, re-pointed with `setUnit`
--- (unit frames, nameplates); `handler` gets the event name first.
export function watchUnit(events: string[], handler: (...any) -> (), owner: unknown?): UnitWatch
    const w = Watch.new(events, handler, owner)
    watches[w] = true
    return w
end

--- Cancels `sub` (the same as `sub:cancel()`).
export function off(sub: Subscription)
    sub:cancel()
end

--- Cancels every subscription registered with `owner`, or only those to
--- `name`.
export function offAll(owner: unknown, name: string?)
    -- nil would match every subscription without an owner, the standard
    -- library's own among them.
    if owner == nil then
        error("offAll: the owner is nil", 2)
    end
    local subs: Subscription[] = {}
    local function collect(list: Handler[]?)
        for _, h in ipairs(list ?? {}) do
            if h.owner == owner then
                subs[#subs + 1] = h.sub
            end
        end
    end
    if name then
        collect(handlers[name])
    else
        for _, list in pairs(handlers) do
            collect(list)
        end
    end
    for _, entry in pairs(unitFrames) do
        if name == nil or entry.event == name then
            collect(entry.handlers)
        end
    end
    for _, sub in ipairs(subs) do
        sub:cancel()
    end
    for w in pairs(watches) do
        if w.owner == owner then
            if name then
                w:drop(name)
            else
                w:cancel()
            end
        end
    end
end

--- Dispatches a message to this addon's handlers, synchronously.
export function send(name: string, ...: unknown)
    if isGameEvent(name) then
        error("send: `" .. name .. "` is a WoW event, not a message", 2)
    end
    dispatch(name, ...)
end

local bucketContext = { component = "events: bucket handler" }

--- What a bucket collected: counts by first argument (units, bag IDs) and
--- by event.
export type BucketCounts = { args: { [any]: number }, events: { [string]: number } }

class Bucket implements Subscription
    active: boolean = true
    readonly subs: Subscription[] = {}

    function cancel()
        self.active = false
        for _, sub in ipairs(self.subs) do
            sub:cancel()
        end
    end
end

--- Coalesces bursts: the first of `events` starts an `interval`-second
--- wait, and `handler` then gets everything that arrived in it, counted
--- by first argument and by event (like AceBucket).
export function onBucket(events: string | string[], interval: number, handler: (counts: BucketCounts) -> (), owner: unknown?): Subscription
    local names: string[]
    if type(events) == "string" then
        names = { events }
    else
        names = events
    end
    const bucket = Bucket.new()
    local pending: BucketCounts? = nil
    local function flush()
        const counts = pending
        pending = nil
        if counts and bucket.active then
            callOwned(bucketContext, owner, handler, counts)
        end
    end
    for _, name in ipairs(names) do
        bucket.subs[#bucket.subs + 1] = subscribe(name, function(first: any)
            local counts = pending
            if not counts then
                counts = { args = {}, events = {} }
                pending = counts
                C_Timer.After(interval, flush)
            end
            counts.events[name] = (counts.events[name] ?? 0) + 1
            -- Secrets cannot be table keys; nil has no count.
            if first ~= nil and not secret.isSecret(first) then
                counts.args[first] = (counts.args[first] ?? 0) + 1
            end
        end, owner)
    end
    return bucket
end

local function decorated(ctx: DecoratorContext?, what: string)
    if ctx and ctx.kind == "method" and not ctx.static then
        error("@" .. what .. " on the instance method `" .. tostring(ctx.name) .. "`: use on() in the constructor", 3)
    end
end

--- `@event(name, ...)`: one name, the handler gets the payload; several,
--- the handler gets the name first.
export function event(...: string)
    local names = { ... }
    return function(fn: (...any) -> (), ctx: DecoratorContext?)
        decorated(ctx, "event")
        if #names == 1 then
            subscribe(names[1], fn, nil)
        else
            for _, name in ipairs(names) do
                subscribe(name, function(...: any) fn(name, ...) end, nil)
            end
        end
    end
end

--- `@unitEvent(name, ...units)`.
export function unitEvent(name: string, ...: string)
    local units = { ... }
    return function(fn: (...any) -> (), ctx: DecoratorContext?)
        decorated(ctx, "unitEvent")
        onUnit(name, units, fn, nil)
    end
end

--- `@bucket(interval, name, ...)`: `onBucket` for a function.
export function bucket(interval: number, ...: string)
    local names = { ... }
    return function(fn: (counts: BucketCounts) -> (), ctx: DecoratorContext?)
        decorated(ctx, "bucket")
        onBucket(names, interval, fn, nil)
    end
end
