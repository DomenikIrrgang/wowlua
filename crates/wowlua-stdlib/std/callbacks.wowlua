-- wowlua:callbacks (spec stdlib "callbacks"): publish/subscribe on objects,
-- like CallbackHandler. Handlers run through the error policy, `fire`
-- iterates a snapshot, and owners are held weakly. With
-- `compat = "CallbackHandler"` a registry also offers RegisterCallback,
-- UnregisterCallback and UnregisterAllCallbacks for plain Lua consumers.
-- The compiler checks `on`, `once` and `fire` against the event type `E`:
-- names are its keys (E8420), handlers and arguments its function types.
import callIn from "wowlua:errors"
import Subscription from "wowlua:events"

type Record = { fn: (...any) -> (), sub: Subscription }

export type RegistryOptions = { compat?: "CallbackHandler" }

--- A registry of the events `E` (an interface of function types).
export interface Registry<E>
    function on(name: string, handler: (...any) -> (), owner: any?): Subscription
    function once(name: string, handler: (...any) -> (), owner: any?): Subscription
    function off(sub: Subscription)
    --- Cancels every subscription of `owner`.
    function offAll(owner: any)
    function fire(name: string, ...: any)
    --- Whether any handler is subscribed to `name`.
    function has(name: string): boolean
    -- `compat = "CallbackHandler"` only.
    RegisterCallback?: (owner: any, name: string, method: any, ...any) -> ()
    UnregisterCallback?: (owner: any, name: string) -> ()
    UnregisterAllCallbacks?: (owner: any) -> ()
end

--- A callback registry; `E` comes from the expected type.
export function registry<E>(opts: RegistryOptions?): Registry<E>
    local handlers: { [string]: Record[] } = {}
    -- Owners by record, weakly: a registry never keeps an owner alive.
    local owners: { [Record]: any } = setmetatable({}, { __mode = "v" })

    local function remove(name: string, record: Record)
        local list = handlers[name]
        if not list then
            return
        end
        for i, rec in ipairs(list) do
            if rec == record then
                table.remove(list, i)
                break
            end
        end
        if #list == 0 then
            handlers[name] = nil
        end
    end

    local function subscribe(name: string, fn: (...any) -> (), owner: any): Subscription
        local list = handlers[name]
        if not list then
            list = {}
            handlers[name] = list
        end
        local record: Record
        local sub: Subscription = {
            active = true,
            cancel = function(self: Subscription)
                self.active = false
                remove(name, record)
            end,
        }
        record = { fn = fn, sub = sub }
        owners[record] = owner
        list[#list + 1] = record
        return sub
    end

    local r: Registry<E> = {
        on = function(_, name: string, fn: (...any) -> (), owner: any?): Subscription
            return subscribe(name, fn, owner)
        end,

        once = function(_, name: string, fn: (...any) -> (), owner: any?): Subscription
            local sub: Subscription
            sub = subscribe(name, function(...: any)
                sub:cancel()
                fn(...)
            end, owner)
            return sub
        end,

        off = function(_, sub: Subscription)
            sub:cancel()
        end,

        offAll = function(_, owner: any)
            if owner == nil then
                error("offAll: the owner is nil", 2)
            end
            local subs: Subscription[] = {}
            for _, list in pairs(handlers) do
                for _, rec in ipairs(list) do
                    if owners[rec] == owner then
                        subs[#subs + 1] = rec.sub
                    end
                end
            end
            for _, sub in ipairs(subs) do
                sub:cancel()
            end
        end,

        fire = function(_, name: string, ...: any)
            local list = handlers[name]
            if not list then
                return
            end
            for _, rec in ipairs({ unpack(list) }) do
                callIn({ component = "callbacks: " .. name }, rec.fn, ...)
            end
        end,

        has = function(_, name: string): boolean
            return handlers[name] ~= nil
        end,
    }

    if opts and opts.compat == "CallbackHandler" then
        -- `Registry.RegisterCallback(owner, name, method?, arg?)`, as in
        -- CallbackHandler: a method name is called on the owner, a function
        -- directly; either gets `arg` first when one is passed (even nil),
        -- then the event name and the payload.
        local byOwner: { [any]: { [string]: Subscription } } = setmetatable({}, { __mode = "k" })
        r.RegisterCallback = function(owner: any, name: string, method: any, ...: any)
            method = method or name
            local hasArg = select("#", ...) > 0
            -- Not named `arg`: Lua 5.1 gives every vararg function an
            -- implicit local of that name, which would shadow it below.
            local extra = (...)
            local fn: (...any) -> ()
            if type(method) == "string" then
                if hasArg then
                    fn = function(...: any) owner[method](owner, extra, name, ...) end
                else
                    fn = function(...: any) owner[method](owner, name, ...) end
                end
            elseif hasArg then
                fn = function(...: any) method(extra, name, ...) end
            else
                fn = function(...: any) method(name, ...) end
            end
            local subs = byOwner[owner]
            if not subs then
                subs = {}
                byOwner[owner] = subs
            end
            local old = subs[name]
            if old then
                old:cancel()
            end
            subs[name] = subscribe(name, fn, owner)
        end
        r.UnregisterCallback = function(owner: any, name: string)
            local subs = byOwner[owner]
            local sub = subs and subs[name]
            if subs and sub then
                sub:cancel()
                subs[name] = nil
            end
        end
        r.UnregisterAllCallbacks = function(owner: any)
            local subs = byOwner[owner]
            if subs then
                for _, sub in pairs(subs) do
                    sub:cancel()
                end
                byOwner[owner] = nil
            end
        end
    end

    return r
end
