-- wowlua:callbacks (spec stdlib "callbacks"): publish/subscribe on objects,
-- like CallbackHandler. Handlers run through the error policy, `fire`
-- iterates a snapshot (a handler cancelled meanwhile is skipped), and
-- owners are held weakly. With
-- `compat = "CallbackHandler"` a registry also offers RegisterCallback,
-- UnregisterCallback and UnregisterAllCallbacks for plain Lua consumers.
-- The compiler checks `on`, `once`, `off`, `offAll` and `fire` against the
-- event type `E`: names are its keys (E8420), handlers and arguments its
-- function types.
import callOwned from "wowlua:errors"
import Subscription from "wowlua:events"

--- Options of `registry`: `compat = "CallbackHandler"` adds
--- CallbackHandler's methods for plain Lua consumers.
export type RegistryOptions = { compat?: "CallbackHandler" }

--- A registry of the events `E` (an interface of function types).
export interface Registry<E>
    --- Calls `handler` with the event's arguments every time `name` fires;
    --- `owner` is for `offAll`.
    function on(name: string, handler: (...any) -> (), owner: any?): Subscription
    --- Like `on`, but cancelled before its first call.
    function once(name: string, handler: (...any) -> (), owner: any?): Subscription
    --- Cancels `sub`, or with a name every subscription of `handler` to it.
    function off(target: Subscription | string, handler: ((...any) -> ())?)
    --- Cancels every subscription of `owner` (to `name` only, when given).
    function offAll(owner: any, name: string?)
    --- Calls the handlers of `name` with the arguments (each through the
    --- error policy). Handlers added during the call wait for the next
    --- `fire`; ones cancelled during it are skipped.
    function fire(name: string, ...: any)
    --- Whether any handler is subscribed to `name`.
    function has(name: string): boolean
    -- `compat = "CallbackHandler"` only.
    RegisterCallback?: (owner: any, name: string, method: any, ...any) -> ()
    UnregisterCallback?: (owner: any, name: string) -> ()
    UnregisterAllCallbacks?: (owner: any) -> ()
end

--- One subscription: its handler, until cancelled.
class Handler implements Subscription
    active: boolean = true
    readonly fn: (...any) -> ()
    -- The function `on` or `once` was given (`off(name, handler)` finds it).
    readonly given: (...any) -> ()
    private readonly registry: CallbackRegistry<any>
    private readonly name: string

    constructor(registry: CallbackRegistry<any>, name: string, fn: (...any) -> (), given: (...any) -> ())
        self.registry = registry
        self.name = name
        self.fn = fn
        self.given = given
    end

    function cancel()
        self.active = false
        self.registry:detach(self.name, self)
    end
end

class CallbackRegistry<E> implements Registry<E>
    private handlers: { [string]: Handler[] } = {}
    -- Owners by handler, weakly: a registry never keeps an owner alive.
    private owners: { [Handler]: any } = setmetatable({}, { __mode = "v" })
    RegisterCallback?: (owner: any, name: string, method: any, ...any) -> ()
    UnregisterCallback?: (owner: any, name: string) -> ()
    UnregisterAllCallbacks?: (owner: any) -> ()

    constructor(opts: RegistryOptions?)
        if opts?.compat == "CallbackHandler" then
            self:installCompat()
        end
    end

    --- Removes a cancelled handler (for `Handler`).
    function detach(name: string, handler: Handler)
        local list = self.handlers[name]
        if not list then
            return
        end
        for i, h in ipairs(list) do
            if h == handler then
                table.remove(list, i)
                break
            end
        end
        if #list == 0 then
            self.handlers[name] = nil
        end
    end

    private function subscribe(name: string, fn: (...any) -> (), owner: any, given: (...any) -> ()): Handler
        local list = self.handlers[name]
        if not list then
            list = {}
            self.handlers[name] = list
        end
        local handler = Handler.new(self, name, fn, given)
        self.owners[handler] = owner
        list[#list + 1] = handler
        return handler
    end

    function on(name: string, fn: (...any) -> (), owner: any?): Subscription
        return self:subscribe(name, fn, owner, fn)
    end

    function once(name: string, fn: (...any) -> (), owner: any?): Subscription
        local sub: Subscription
        sub = self:subscribe(name, function(...: any)
            sub:cancel()
            fn(...)
        end, owner, fn)
        return sub
    end

    -- Cancels the handlers of `name` (every name when nil) that `keep`
    -- selects; collected first, as cancelling edits the lists.
    private function cancelWhere(name: string?, keep: (h: Handler) -> boolean)
        local subs: Handler[] = {}
        for n, list in pairs(self.handlers) do
            if name == nil or n == name then
                for _, h in ipairs(list) do
                    if keep(h) then
                        subs[#subs + 1] = h
                    end
                end
            end
        end
        for _, h in ipairs(subs) do
            h:cancel()
        end
    end

    function off(target: Subscription | string, handler: ((...any) -> ())?)
        if type(target) ~= "string" then
            target:cancel()
            return
        end
        if handler == nil then
            error("off: the handler is nil", 2)
        end
        self:cancelWhere(target, function(h: Handler): boolean return h.given == handler end)
    end

    function offAll(owner: any, name: string?)
        if owner == nil then
            error("offAll: the owner is nil", 2)
        end
        self:cancelWhere(name, function(h: Handler): boolean return self.owners[h] == owner end)
    end

    -- A snapshot: handlers added meanwhile wait for the next `fire`, and
    -- handlers cancelled meanwhile are skipped.
    function fire(name: string, ...: any)
        local list = self.handlers[name]
        if not list then
            return
        end
        for _, h in ipairs({ unpack(list) }) do
            if h.active then
                callOwned({ component = "callbacks: " .. name }, self.owners[h], h.fn, ...)
            end
        end
    end

    function has(name: string): boolean
        return self.handlers[name] ~= nil
    end

    -- `Registry.RegisterCallback(owner, name, method?, arg?)`, as in
    -- CallbackHandler: a method name is called on the owner, a function
    -- directly; either gets `arg` first when one is passed (even nil), then
    -- the event name and the payload.
    private function installCompat()
        local byOwner: { [any]: { [string]: Subscription } } = setmetatable({}, { __mode = "k" })
        self.RegisterCallback = function(owner: any, name: string, method: any, ...: any)
            method = method or name
            local hasArg = select("#", ...) > 0
            -- Not named `arg`: Lua 5.1 gives every vararg function an
            -- implicit local of that name, which would shadow it below.
            local extra = (...)
            local fn: (...any) -> ()
            if type(method) == "string" then
                if hasArg then
                    fn = function(...: any) owner[method](owner, extra, name, ...) end
                else
                    fn = function(...: any) owner[method](owner, name, ...) end
                end
            elseif hasArg then
                fn = function(...: any) method(extra, name, ...) end
            else
                fn = function(...: any) method(name, ...) end
            end
            local subs = byOwner[owner]
            if not subs then
                subs = {}
                byOwner[owner] = subs
            end
            local old = subs[name]
            if old then
                old:cancel()
            end
            subs[name] = self:subscribe(name, fn, owner, fn)
        end
        self.UnregisterCallback = function(owner: any, name: string)
            local subs = byOwner[owner]
            local sub = subs?.[name]
            if subs and sub then
                sub:cancel()
                subs[name] = nil
            end
        end
        self.UnregisterAllCallbacks = function(owner: any)
            local subs = byOwner[owner]
            if subs then
                for _, sub in pairs(subs) do
                    sub:cancel()
                end
                byOwner[owner] = nil
            end
        end
    end
end

--- A callback registry; `E` comes from the expected type.
export function registry<E>(opts: RegistryOptions?): Registry<E>
    return CallbackRegistry.new(opts)
end
